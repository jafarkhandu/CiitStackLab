@model CIITStackLab.WebApp.Models.VerifyPasswordResetOtpViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Verify OTP";
    var expiryValue = Context.Session.GetString("PasswordResetExpiry");
    var resendAvailableValue = Context.Session.GetString("PasswordResetResendAvailable");
    var expiryIso = DateTime.TryParse(expiryValue, null, System.Globalization.DateTimeStyles.RoundtripKind, out var expiry)
        ? expiry.ToUniversalTime().ToString("O")
        : string.Empty;
    var resendIso = DateTime.TryParse(resendAvailableValue, null, System.Globalization.DateTimeStyles.RoundtripKind, out var resendAvailable)
        ? resendAvailable.ToUniversalTime().ToString("O")
        : string.Empty;
}

<section class="ciit-auth-section ciit-otp-page">
    <div class="container">
        <div class="ciit-auth-shell ciit-auth-shell-sm ciit-otp-shell">
            <div class="ciit-auth-card ciit-otp-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />PASSWORD RECOVERY</div>
                </div>

                <div class="ciit-otp-heading text-center">
                    <div class="ciit-otp-step">SECURE VERIFICATION</div>
                    <h1>Verify OTP</h1>
                    <p class="ciit-auth-subtitle">Enter the 6-digit code sent to your registered email address.</p>
                </div>

                @if (ViewData["PasswordResetMessage"] is string message)
                {
                    <div class="ciit-auth-alert ciit-otp-alert mb-4" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        <span>@message</span>
                    </div>
                }

                <form asp-action="VerifyPasswordResetOtp" method="post" id="otpForm">
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="ciit-otp-field mb-4">
                        <div class="ciit-otp-label-row">
                            <label class="form-label fw-semibold mb-0" for="otpDigit0">One-time password</label>
                            <span>6 digits</span>
                        </div>

                        <div class="ciit-otp-boxes" role="group" aria-label="Six-digit one-time password">
                            @for (var i = 0; i < 6; i++)
                            {
                                <input type="text"
                                       class="ciit-otp-digit"
                                       id="otpDigit@(i)"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]"
                                       autocomplete="@(i == 0 ? "one-time-code" : "off")"
                                       aria-label="OTP digit @(i + 1)"
                                       @(i == 0 ? "autofocus" : string.Empty) />
                            }
                        </div>
                        <input asp-for="Otp" type="hidden" id="Otp" />
                        <span asp-validation-for="Otp" class="text-danger small"></span>
                    </div>

                    <div class="ciit-otp-meta ciit-otp-timer-row mb-4" role="status" aria-live="polite">
                        <span class="ciit-otp-timer-label">
                            <i class="bi bi-clock" aria-hidden="true"></i>
                            Code expires in
                            <strong id="otpTimer" class="ciit-otp-timer">10:00</strong>
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold ciit-otp-submit" id="verifyOtpButton">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>Verify OTP</span>
                    </button>
                </form>

                <div class="ciit-otp-divider" aria-hidden="true"><span></span></div>

                <form asp-controller="PasswordReset" asp-action="ResendOtp" method="post" class="ciit-otp-resend" id="resendForm">
                    <span class="ciit-otp-resend-text">Didn't receive the code?</span>
                    <button type="submit" class="ciit-resend-btn" id="resendButton" disabled>
                        Resend OTP <span id="resendTimer">in 60s</span>
                    </button>
                </form>

                <div class="ciit-security-note ciit-otp-security">
                    <span class="ciit-security-icon" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                    <span>For your security, the OTP is valid for 10 minutes. Requesting a new OTP replaces the previous code.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .ciit-otp-page .ciit-otp-shell {
            width: min(100%, 520px);
        }

        .ciit-otp-page .ciit-otp-card {
            padding: 30px 34px 28px;
        }

        .ciit-otp-page .ciit-auth-brand {
            margin-bottom: 28px;
        }

        .ciit-otp-heading {
            margin-bottom: 26px;
        }

        .ciit-otp-step {
            display: inline-flex;
            align-items: center;
            min-height: 26px;
            padding: 5px 10px;
            margin-bottom: 10px;
            border: 1px solid rgba(23, 105, 255, .14);
            border-radius: 999px;
            background: rgba(239, 246, 255, .8);
            color: #1769ff;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .13em;
        }

        .ciit-otp-heading h1 {
            margin-bottom: 8px;
        }

        .ciit-otp-heading .ciit-auth-subtitle {
            max-width: 390px;
            margin: 0 auto;
        }

        .ciit-otp-alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 22px !important;
        }

        .ciit-otp-alert > i {
            flex: 0 0 auto;
            margin-top: 2px;
            color: #1769ff;
        }

        .ciit-otp-field {
            margin-bottom: 22px !important;
        }

        .ciit-otp-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 9px;
        }

        .ciit-otp-label-row > span {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
        }

        .ciit-otp-page .ciit-otp-boxes {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 10px;
            width: 100%;
        }

        .ciit-otp-page .ciit-otp-digit {
            width: 100%;
            height: 64px;
            min-width: 0;
            padding: 0;
            border: 1px solid #d6e1ef;
            border-radius: 13px;
            background: rgba(255, 255, 255, .96);
            color: #172033;
            font-size: 25px;
            font-weight: 800;
            line-height: 1;
            text-align: center;
            outline: 0;
            box-shadow: 0 5px 16px rgba(23, 105, 255, .04), inset 0 1px 0 rgba(255, 255, 255, .95);
            caret-color: #1769ff;
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease, background .15s ease;
        }

        .ciit-otp-page .ciit-otp-digit:hover {
            border-color: #b9cce4;
        }

        .ciit-otp-page .ciit-otp-digit:focus {
            border-color: #1769ff;
            background: #fff;
            box-shadow: 0 0 0 .22rem rgba(23, 105, 255, .10), 0 8px 20px rgba(23, 105, 255, .08);
            transform: translateY(-1px);
        }

        .ciit-otp-page .ciit-otp-digit:valid:not(:placeholder-shown) {
            border-color: #b9d2f7;
        }

        .ciit-otp-timer-row {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            margin-bottom: 18px !important;
            padding: 9px 13px;
            border: 1px solid #e2eaf4;
            border-radius: 12px;
            background: #f8fbff;
        }

        .ciit-otp-timer-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
        }

        .ciit-otp-timer-label > i {
            color: #1769ff;
        }

        .ciit-otp-timer {
            color: #1769ff;
            font-variant-numeric: tabular-nums;
        }

        .ciit-otp-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 50px !important;
            font-size: 14px;
        }

        .ciit-otp-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0 17px;
        }

        .ciit-otp-divider::before,
        .ciit-otp-divider::after {
            content: "";
            height: 1px;
            flex: 1;
            background: #e6edf5;
        }

        .ciit-otp-divider span {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #cbd5e1;
        }

        .ciit-otp-resend {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 5px;
            text-align: center;
        }

        .ciit-otp-resend-text {
            color: #64748b;
            font-size: 12px;
        }

        .ciit-otp-page .ciit-resend-btn {
            margin: 0;
            font-size: 12px;
        }

        .ciit-otp-page .ciit-resend-btn:not(:disabled):hover {
            text-decoration: underline;
        }

        .ciit-otp-security {
            margin-top: 20px;
        }

        .ciit-security-icon {
            display: grid;
            flex: 0 0 28px;
            width: 28px;
            height: 28px;
            place-items: center;
            border-radius: 9px;
            background: #eaf2ff;
        }

        .ciit-security-icon i {
            margin: 0;
            color: #1769ff;
        }

        @media (max-width: 576px) {
            .ciit-otp-page .ciit-otp-card {
                padding: 25px 20px 23px;
            }

            .ciit-otp-page .ciit-otp-boxes {
                gap: 7px;
            }

            .ciit-otp-page .ciit-otp-digit {
                height: 56px;
                border-radius: 11px;
                font-size: 22px;
            }
        }

        @media (max-width: 380px) {
            .ciit-otp-page .ciit-otp-boxes {
                gap: 5px;
            }

            .ciit-otp-page .ciit-otp-digit {
                height: 50px;
                border-radius: 10px;
                font-size: 20px;
            }

            .ciit-otp-page .ciit-otp-card {
                padding-left: 16px;
                padding-right: 16px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .ciit-otp-page .ciit-otp-digit {
                transition: none;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const expiryRaw = '@expiryIso';
            const resendRaw = '@resendIso';
            const otpTimer = document.getElementById('otpTimer');
            const resendTimer = document.getElementById('resendTimer');
            const resendButton = document.getElementById('resendButton');
            const verifyOtpButton = document.getElementById('verifyOtpButton');
            const hiddenOtp = document.getElementById('Otp');
            const otpInputs = Array.from(document.querySelectorAll('.ciit-otp-digit'));

            const syncOtp = () => {
                if (hiddenOtp) {
                    hiddenOtp.value = otpInputs.map(input => input.value).join('');
                }
            };

            otpInputs.forEach((input, index) => {
                input.addEventListener('input', event => {
                    const value = event.target.value.replace(/\D/g, '');
                    event.target.value = value.slice(-1);
                    syncOtp();

                    if (event.target.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }
                });

                input.addEventListener('keydown', event => {
                    if (event.key === 'Backspace' && !input.value && index > 0) {
                        otpInputs[index - 1].focus();
                    }

                    if (event.key === 'ArrowLeft' && index > 0) {
                        event.preventDefault();
                        otpInputs[index - 1].focus();
                    }

                    if (event.key === 'ArrowRight' && index < otpInputs.length - 1) {
                        event.preventDefault();
                        otpInputs[index + 1].focus();
                    }
                });

                input.addEventListener('paste', event => {
                    event.preventDefault();
                    const pasted = (event.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                    pasted.split('').forEach((digit, digitIndex) => {
                        if (otpInputs[digitIndex]) {
                            otpInputs[digitIndex].value = digit;
                        }
                    });
                    syncOtp();
                    const nextIndex = Math.min(pasted.length, otpInputs.length - 1);
                    otpInputs[nextIndex].focus();
                });
            });

            const toMillis = value => value ? Date.parse(value) : NaN;
            const expiryMs = toMillis(expiryRaw);
            const resendMs = toMillis(resendRaw);

            const formatTime = seconds => {
                const safeSeconds = Math.max(0, seconds);
                const minutes = Math.floor(safeSeconds / 60).toString().padStart(2, '0');
                const remainder = (safeSeconds % 60).toString().padStart(2, '0');
                return `${minutes}:${remainder}`;
            };

            const updateTimers = () => {
                const now = Date.now();
                const otpSeconds = Number.isNaN(expiryMs) ? 0 : Math.ceil((expiryMs - now) / 1000);
                const resendSeconds = Number.isNaN(resendMs) ? 0 : Math.ceil((resendMs - now) / 1000);
                const otpExpired = otpSeconds <= 0;

                if (otpTimer) {
                    otpTimer.textContent = formatTime(otpSeconds);
                    otpTimer.classList.toggle('text-danger', otpExpired);
                }

                if (verifyOtpButton) {
                    verifyOtpButton.disabled = otpExpired;
                }

                if (resendButton && resendTimer) {
                    resendButton.disabled = resendSeconds > 0;
                    resendTimer.textContent = resendSeconds > 0 ? `in ${resendSeconds}s` : '';
                }
            };

            updateTimers();
            window.setInterval(updateTimers, 1000);
        })();
    </script>
}
