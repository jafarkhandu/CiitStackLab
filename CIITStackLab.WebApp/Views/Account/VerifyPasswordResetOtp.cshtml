@model CIITStackLab.WebApp.Models.VerifyPasswordResetOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-card">
            <div class="text-center mb-4">
                <h1>Verify OTP</h1>
                <p>Enter the 6-digit OTP sent to your registered email address.</p>
            </div>

            @if (ViewData["PasswordResetMessage"] is string message)
            {
                <div class="alert alert-info" role="alert">@message</div>
            }

            <form asp-action="VerifyPasswordResetOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Otp" class="form-label fw-semibold"></label>
                    <input asp-for="Otp"
                           class="form-control form-control-lg text-center"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="one-time-code" />
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Verify OTP</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
