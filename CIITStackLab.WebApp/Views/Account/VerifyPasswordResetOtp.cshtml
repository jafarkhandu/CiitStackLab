@model CIITStackLab.WebApp.Models.VerifyPasswordResetOtpViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Verify OTP";
    var expiryValue = Context.Session.GetString("PasswordResetExpiry");
    var resendAvailableValue = Context.Session.GetString("PasswordResetResendAvailable");
    var expiryIso = DateTime.TryParse(expiryValue, null, System.Globalization.DateTimeStyles.RoundtripKind, out var expiry)
        ? expiry.ToUniversalTime().ToString("O")
        : string.Empty;
    var resendIso = DateTime.TryParse(resendAvailableValue, null, System.Globalization.DateTimeStyles.RoundtripKind, out var resendAvailable)
        ? resendAvailable.ToUniversalTime().ToString("O")
        : string.Empty;
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-shell">
            <div class="ciit-auth-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />PASSWORD RECOVERY</div>
                </div>

                <div class="text-center mb-4">
                    <h1>Verify OTP</h1>
                    <p class="ciit-auth-subtitle">Enter the 6-digit code sent to your registered email address.</p>
                </div>

                @if (ViewData["PasswordResetMessage"] is string message)
                {
                    <div class="ciit-auth-alert mb-3" role="status">
                        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@message
                    </div>
                }

                <form asp-action="VerifyPasswordResetOtp" method="post" id="otpForm">
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Otp" class="form-label fw-semibold">One-time password</label>
                        <input asp-for="Otp" class="form-control form-control-lg ciit-otp-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" minlength="6" autocomplete="one-time-code" placeholder="000000" autofocus />
                        <span asp-validation-for="Otp" class="text-danger small"></span>
                    </div>

                    <div class="ciit-otp-meta mb-4">
                        <span><i class="bi bi-clock me-1" aria-hidden="true"></i>Code expires in <strong id="otpTimer" class="ciit-otp-timer">10:00</strong></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold" id="verifyOtpButton">
                        <i class="bi bi-shield-check me-2" aria-hidden="true"></i>Verify OTP
                    </button>
                </form>

                <form asp-controller="PasswordReset" asp-action="ResendOtp" method="post" class="text-center mt-4" id="resendForm">
                    <span class="text-secondary small">Didn't receive the code?</span>
                    <button type="submit" class="ciit-resend-btn ms-1" id="resendButton" disabled>
                        Resend OTP <span id="resendTimer">in 60s</span>
                    </button>
                </form>

                <div class="ciit-security-note">
                    <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                    <span>For your security, the OTP is valid for 10 minutes and incorrect attempts are limited.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const expiryRaw = '@expiryIso';
            const resendRaw = '@resendIso';
            const otpTimer = document.getElementById('otpTimer');
            const resendTimer = document.getElementById('resendTimer');
            const resendButton = document.getElementById('resendButton');
            const otpInput = document.getElementById('Otp');

            if (otpInput) {
                otpInput.addEventListener('input', () => {
                    otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6);
                });
            }

            const toMillis = value => value ? Date.parse(value) : NaN;
            const expiryMs = toMillis(expiryRaw);
            const resendMs = toMillis(resendRaw);

            const formatTime = seconds => {
                const safeSeconds = Math.max(0, seconds);
                const minutes = Math.floor(safeSeconds / 60).toString().padStart(2, '0');
                const remainder = (safeSeconds % 60).toString().padStart(2, '0');
                return `${minutes}:${remainder}`;
            };

            const updateTimers = () => {
                const now = Date.now();
                const otpSeconds = Number.isNaN(expiryMs) ? 0 : Math.ceil((expiryMs - now) / 1000);
                const resendSeconds = Number.isNaN(resendMs) ? 0 : Math.ceil((resendMs - now) / 1000);

                if (otpTimer) {
                    otpTimer.textContent = formatTime(otpSeconds);
                    otpTimer.classList.toggle('text-danger', otpSeconds <= 0);
                }

                if (resendButton && resendTimer) {
                    resendButton.disabled = resendSeconds > 0 || otpSeconds <= 0;
                    resendTimer.textContent = resendSeconds > 0 ? `in ${resendSeconds}s` : '';
                }

                if (otpSeconds <= 0) {
                    window.clearInterval(timerId);
                }
            };

            const timerId = window.setInterval(updateTimers, 1000);
            updateTimers();
        })();
    </script>
}
