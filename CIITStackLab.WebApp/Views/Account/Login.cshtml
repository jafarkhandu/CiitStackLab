@model CIITStackLab.WebApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-shell ciit-auth-shell-sm">
            <div class="ciit-auth-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />STUDENT ACCESS</div>
                </div>

                <div class="mb-4">
                    <h1>Welcome back</h1>
                    <p class="ciit-auth-subtitle">Sign in to continue learning with CIIT Stack Lab.</p>
                </div>

                @if (TempData["PasswordResetSuccess"] is string passwordResetSuccess)
                {
                    <div class="ciit-auth-alert mb-3" role="alert">
                        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@passwordResetSuccess
                    </div>
                }

                <form asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check mb-0">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>
                        <a asp-action="ForgotPassword" class="ciit-auth-link small">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold">Sign In</button>
                </form>

                <div class="ciit-auth-divider"><span>New to CIIT Stack Lab?</span></div>

                <div class="text-center">
                    <a asp-action="Register" class="ciit-auth-link">Create an account</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
