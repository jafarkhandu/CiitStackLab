@model CIITStackLab.WebApp.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-shell">
            <div class="ciit-auth-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />SECURE PASSWORD RESET</div>
                </div>

                <div class="mb-4">
                    <h1>Set a new password</h1>
                    <p class="ciit-auth-subtitle">Your OTP has been verified. Choose a strong new password for your account.</p>
                </div>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">New password</label>
                        <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" placeholder="Enter a new password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm new password</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" placeholder="Re-enter your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="bi bi-key-fill me-2" aria-hidden="true"></i>Reset Password
                    </button>
                </form>

                <div class="ciit-security-note">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Your password is handled through the existing ASP.NET Identity reset flow.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
