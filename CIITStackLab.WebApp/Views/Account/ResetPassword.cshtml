@model CIITStackLab.WebApp.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-card">
            <div class="text-center mb-4">
                <h1>Set a new password</h1>
                <p>Choose a new password for your CIIT Stack Lab account.</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Reset Password</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
