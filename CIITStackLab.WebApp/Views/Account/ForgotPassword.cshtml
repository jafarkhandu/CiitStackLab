@model CIITStackLab.WebApp.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-card">
            <div class="text-center mb-4">
                <h1>Forgot your password?</h1>
                <p>Enter your registered email address and we will send you a one-time password.</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Send OTP</button>
            </form>

            <div class="text-center mt-4">
                <a asp-action="Login" class="fw-semibold text-decoration-none">Back to Sign In</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
