@model CIITStackLab.WebApp.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-shell">
            <div class="ciit-auth-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />SECURE ACCOUNT ACCESS</div>
                </div>

                <div class="mb-4">
                    <h1>Forgot your password?</h1>
                    <p class="ciit-auth-subtitle">Enter your registered email address. We’ll send a secure 6-digit OTP to verify your request.</p>
                </div>

                <form asp-controller="PasswordReset" asp-action="RequestOtp" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                        <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="bi bi-envelope-arrow-up me-2" aria-hidden="true"></i>Send OTP
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" class="ciit-auth-link">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
