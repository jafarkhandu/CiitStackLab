@model CIITStackLab.WebApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

@section Styles {
    <link rel="stylesheet" href="~/css/global/auth.css" asp-append-version="true" />
}

<section class="ciit-auth-section">
    <div class="container">
        <div class="ciit-auth-shell ciit-auth-shell-register">
            <div class="ciit-auth-card">
                <div class="ciit-auth-brand">
                    <div class="ciit-auth-logo">CIIT</div>
                    <div class="ciit-auth-brand-text">STACK LAB<br />STUDENT REGISTRATION</div>
                </div>

                <div class="mb-4">
                    <h1>Create your account</h1>
                    <p class="ciit-auth-subtitle">Register as a student and start your learning journey with CIIT Stack Lab.</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="ciit-auth-error mb-3" role="alert"></div>

                    <div class="ciit-register-grid">
                        <div>
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="UserName" class="form-label fw-semibold"></label>
                            <input asp-for="UserName" class="form-control" autocomplete="username" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="ciit-register-full">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold mt-4">Create Student Account</button>
                </form>

                <div class="ciit-auth-divider"><span>Already have an account?</span></div>

                <div class="text-center">
                    <a asp-action="Login" class="ciit-auth-link">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
