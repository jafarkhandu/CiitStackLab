@model CIITStackLab.Application.DTOs.TopicExamSessionDto
@{
    Layout = "_CourseLayout";
    ViewData["Title"] = "Exam Instructions";
}

<section class="ciit-exam-verify-page" data-exam-instructions
         data-scheduled="@DateTime.SpecifyKind(Model.ScheduledAtUtc, DateTimeKind.Utc).ToString("O")"
         data-attempt-id="@Model.AttemptId">
    <div class="ciit-exam-verify-glow ciit-exam-verify-glow-one"></div>
    <div class="ciit-exam-verify-glow ciit-exam-verify-glow-two"></div>

    <article class="ciit-exam-verify-card">
        <header class="ciit-exam-verify-header">
            <div class="ciit-exam-verify-brand">
                <span class="ciit-exam-verify-brand-icon"><i class="bi bi-shield-lock"></i></span>
                <span>CIIT STACK LAB <small>SECURE EXAMINATION</small></span>
            </div>
            <span class="ciit-exam-verify-step"><span></span> PRE-EXAM CHECK</span>
            <h1>Prepare for your examination</h1>
            <p class="ciit-exam-verify-lead">Review the exam rules, complete the identity and camera checks, then start when your scheduled session unlocks.</p>
        </header>

        <section class="ciit-exam-verify-rules">
            <div class="ciit-exam-verify-section-heading">
                <span class="ciit-exam-verify-section-icon"><i class="bi bi-shield-check"></i></span>
                <div><h2>Examination rules</h2><p>Please read before continuing</p></div>
            </div>
            <ul>
                <li>Switching tabs/windows or leaving the exam page may terminate the exam. Saved answers will be submitted.</li>
                <li>Copy, paste, cut and restricted screenshot/recording shortcuts are prohibited and may be logged.</li>
                <li>Keep camera permission enabled throughout the exam. Camera loss and detected suspicious events are recorded.</li>
                <li>Two proctoring warnings are allowed. A further detected suspicious event may terminate the attempt.</li>
                <li>This attempt is locked to the first device. Do not clear site cookies or switch devices.</li>
                <li>The exam lasts 60 minutes, contains 50 random MCQs, and each question carries 1 mark.</li>
                <li>Answers are saved periodically. At the deadline, the server submits saved answers automatically.</li>
                <li>Passing score is 35/50. Re-exams exclude questions used in previous attempts.</li>
            </ul>
        </section>

        <div class="ciit-exam-verify-checks">
            <section class="ciit-exam-verify-timing">
                <div class="ciit-exam-verify-section-heading">
                    <span class="ciit-exam-verify-section-icon"><i class="bi bi-stopwatch"></i></span>
                    <div><h2>Verification countdown</h2><p>One-minute pre-exam check</p></div>
                </div>
                <div class="ciit-exam-verify-countdown" id="exam-countdown" aria-live="polite">01:00</div>
                <div class="ciit-exam-verify-progress"><span id="verification-progress"></span></div>
                <p id="exam-countdown-help" class="ciit-exam-verify-muted">Complete the camera and face checks to continue.</p>
                <div class="ciit-exam-verify-schedule">
                    <i class="bi bi-calendar-event"></i>
                    <div><small>Scheduled start</small><strong id="exam-scheduled-time">Checking schedule…</strong></div>
                </div>
                <form asp-action="Start" asp-route-attemptId="@Model.AttemptId" method="post" id="exam-start-form">
                    @Html.AntiForgeryToken()
                    <button id="exam-start-button" type="submit" class="ciit-exam-verify-start" disabled>
                        <span>Verifying…</span><i class="bi bi-arrow-right"></i>
                    </button>
                </form>
                <p class="ciit-exam-verify-privacy"><i class="bi bi-lock-fill"></i> Face analysis runs in this browser. Camera frames are not uploaded by the face detector.</p>
            </section>

            <section class="ciit-exam-verify-camera-panel">
                <div class="ciit-exam-verify-camera-heading">
                    <div><h2>Camera &amp; face check</h2><p>Position your face clearly in the frame</p></div>
                    <span id="face-status-pill" class="ciit-exam-verify-status is-pending"><span></span> Checking</span>
                </div>
                <div class="ciit-exam-verify-video-wrap">
                    <video id="exam-camera" autoplay muted playsinline></video>
                    <div class="ciit-exam-verify-camera-overlay">
                        <span class="ciit-exam-face-corner top-left"></span><span class="ciit-exam-face-corner top-right"></span>
                        <span class="ciit-exam-face-corner bottom-left"></span><span class="ciit-exam-face-corner bottom-right"></span>
                        <div class="ciit-exam-face-guide"></div>
                    </div>
                    <div id="camera-placeholder" class="ciit-exam-camera-placeholder">
                        <span><i class="bi bi-camera-video"></i></span><strong>Connecting to your camera</strong><small>Allow camera access when prompted</small>
                    </div>
                </div>
                <div class="ciit-exam-verify-diagnostics">
                    <div class="ciit-exam-verify-diagnostic"><span id="camera-check-dot" class="ciit-exam-check-dot"></span><span><strong>Camera permission</strong><small id="camera-status">Requesting camera permission…</small></span></div>
                    <div class="ciit-exam-verify-diagnostic"><span id="face-check-dot" class="ciit-exam-check-dot"></span><span><strong>Face detection</strong><small id="face-status">Loading on-device face detector…</small></span></div>
                </div>
                <p class="ciit-exam-verify-note"><i class="bi bi-info-circle"></i> Keep only your face in view, use good lighting and look toward the camera.</p>
            </section>
        </div>
    </article>
</section>

<style>
