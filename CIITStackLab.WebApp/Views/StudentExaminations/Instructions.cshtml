.ciit-exam-verify-diagnostics{display:grid;gap:12px;margin-top:18px}.ciit-exam-verify-diagnostic{display:flex;align-items:flex-start;gap:11px}.ciit-exam-check-dot{flex:0 0 9px;width:9px;height:9px;margin-top:5px;border-radius:50%;background:#9cabc0;box-shadow:0 0 0 4px rgba(156,171,192,.12)}.ciit-exam-check-dot.is-good{background:#1bb47a;box-shadow:0 0 0 4px rgba(27,180,122,.12)}.ciit-exam-check-dot.is-bad{background:#df4d5c;box-shadow:0 0 0 4px rgba(223,77,92,.12)}.ciit-exam-verify-diagnostic strong,.ciit-exam-verify-diagnostic small{display:block}.ciit-exam-verify-diagnostic strong{color:#304667;font-size:11px}.ciit-exam-verify-diagnostic small{margin-top:3px;color:#8290a5;font-size:10px;line-height:1.55}
