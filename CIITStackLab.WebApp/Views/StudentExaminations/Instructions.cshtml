@@media(max-width:760px){.ciit-exam-verify-page{padding:16px 10px 32px}.ciit-exam-verify-card{border-radius:22px}.ciit-exam-verify-checks{grid-template-columns:1fr;padding-top:20px}.ciit-exam-verify-rules{padding:18px;margin:16px 14px 0}.ciit-exam-verify-rules ul{font-size:11.5px}.ciit-exam-verify-camera-panel,.ciit-exam-verify-timing{padding:17px}.ciit-exam-verify-video-wrap video{height:230px}.ciit-exam-verify-header{padding:24px 20px}}
@@media(prefers-reduced-motion:reduce){.ciit-exam-verify-start,.ciit-exam-verify-progress span{transition:none}}
</style>

@section Scripts {
<script type="module">
(async function () {
    const root = document.querySelector('[data-exam-instructions]');
    if (!root) return;

    const attemptId = root.dataset.attemptId;
    const scheduledAt = new Date(root.dataset.scheduled).getTime();
    const scheduledEndAt = scheduledAt + 60 * 60 * 1000;
    const countdown = document.getElementById('exam-countdown');
    const button = document.getElementById('exam-start-button');
    const help = document.getElementById('exam-countdown-help');
    const progress = document.getElementById('verification-progress');
    const video = document.getElementById('exam-camera');
    const cameraStatus = document.getElementById('camera-status');
    const faceStatus = document.getElementById('face-status');
    const facePill = document.getElementById('face-status-pill');
    const cameraDot = document.getElementById('camera-check-dot');
    const faceDot = document.getElementById('face-check-dot');
    const placeholder = document.getElementById('camera-placeholder');
    const scheduledLabel = document.getElementById('exam-scheduled-time');
    const verificationStorageKey = 'ciit-exam-verification-end-' + attemptId;
    let verificationEndsAt = Number(sessionStorage.getItem(verificationStorageKey));
    if (!Number.isFinite(verificationEndsAt) || verificationEndsAt <= 0) {
        verificationEndsAt = Date.now() + 60 * 1000;
        sessionStorage.setItem(verificationStorageKey, String(verificationEndsAt));
    }
    const csrf = document.querySelector('#exam-start-form input[name="__RequestVerificationToken"]')?.value || '';
    let cameraReady = false;
    let faceDetector = null;
    let cameraStream = null;
    let faceCheckTimer = null;
    let lastFaceState = null;
    let detectionBusy = false;

    scheduledLabel.textContent = Number.isFinite(scheduledAt)
        ? new Date(scheduledAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })
        : 'Schedule unavailable';

    function setDot(element, state) {
        element.classList.toggle('is-good', state === 'good');
        element.classList.toggle('is-bad', state === 'bad');
    }

    function setFaceState(state, message) {
        faceStatus.textContent = message;
        facePill.classList.toggle('is-good', state === 'good');
        facePill.classList.toggle('is-bad', state === 'bad');
        facePill.classList.toggle('is-pending', state === 'pending');
        facePill.querySelector('span').style.background = state === 'pending' ? '' : state === 'good' ? '#20b77a' : '#d94b58';
        facePill.lastChild.textContent = state === 'good' ? ' Verified' : state === 'bad' ? ' Attention' : ' Checking';
        setDot(faceDot, state);
    }

    async function recordEvent(type, details) {
        const data = new URLSearchParams({ EventType: type, Details: details || '' });
        data.append('__RequestVerificationToken', csrf);
        try {
            await fetch('/Examinations/' + attemptId + '/SecurityEvent', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: data,
                keepalive: true
            });
        } catch (_) { /* Do not block local verification on a transient logging failure. */ }
    }

    async function loadFaceDetector() {
        const sources = [
            {
                module: 'https://cdn.jsdelivr.net/npm/@@mediapipe/tasks-vision@0.10.22/+esm',
                wasm: 'https://cdn.jsdelivr.net/npm/@@mediapipe/tasks-vision@0.10.22/wasm'
            },
            {
                module: 'https://unpkg.com/@@mediapipe/tasks-vision@0.10.22/vision_bundle.mjs',
                wasm: 'https://unpkg.com/@@mediapipe/tasks-vision@0.10.22/wasm'
            }
        ];
        let lastError;
        for (const source of sources) {
            try {
                const vision = await import(source.module);
                const files = await vision.FilesetResolver.forVisionTasks(source.wasm);
                return await vision.FaceDetector.createFromOptions(files, {
                    baseOptions: {
                        modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite',
                        delegate: 'CPU'
                    },
                    runningMode: 'VIDEO',
                    minDetectionConfidence: 0.6
                });
            } catch (error) {
                lastError = error;
                console.warn('Face detector source failed; trying fallback.', error);
            }
        }
        throw lastError || new Error('No face detector source could be loaded.');
    }

    async function detectFace() {
        if (!cameraReady || !faceDetector || detectionBusy || video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) return;
        detectionBusy = true;
        try {
            const result = faceDetector.detectForVideo(video, performance.now());
            const faces = result.detections || [];
            const nextState = faces.length === 1 ? 'good' : 'bad';
            if (nextState !== lastFaceState) {
                lastFaceState = nextState;
                if (faces.length === 1) {
                    setFaceState('good', 'One face detected. Keep your face in frame.');
                    await recordEvent('FaceDetected', 'Exactly one face detected during pre-exam verification');
                } else if (faces.length === 0) {
                    setFaceState('bad', 'No face detected. Center your face in the frame.');
                    await recordEvent('FaceMissing', 'No face detected during pre-exam verification');
                } else {
                    setFaceState('bad', 'Multiple faces detected. Ensure you are alone.');
                    await recordEvent('MultipleFaces', 'Multiple faces detected during pre-exam verification');
                }
            }
        } catch (_) {
            setFaceState('bad', 'Face detection paused. Adjust lighting and keep the camera visible.');
        } finally {
            detectionBusy = false;
        }
        updateButton();
    }

    async function initCamera() {
        try {
            if (!navigator.mediaDevices?.getUserMedia) {
                throw new Error('Camera access requires HTTPS or localhost and a supported browser.');
            }
            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
                audio: false
            });
            video.srcObject = cameraStream;
            await video.play();
            cameraReady = true;
            placeholder.hidden = true;
            cameraStatus.textContent = 'Camera connected and streaming.';
            setDot(cameraDot, 'good');
            cameraStream.getVideoTracks().forEach(track => track.addEventListener('ended', () => {
                cameraReady = false;
                cameraStatus.textContent = 'Camera disconnected. Re-enable camera to continue.';
                setDot(cameraDot, 'bad');
                setFaceState('bad', 'Camera unavailable.');
                recordEvent('CameraLost', 'Camera track ended during pre-exam verification');
                updateButton();
            }));

            try {
                if ('FaceDetector' in window) {
                    try { faceDetector = new FaceDetector({ fastMode: true, maxDetectedFaces: 3 }); } catch (_) {}
                }
                if (!faceDetector) faceDetector = await loadFaceDetector();
                faceStatus.textContent = 'Detector loaded. Checking for one visible face…';
                setFaceState('pending', 'Looking for your face…');
                await detectFace();
                faceCheckTimer = window.setInterval(detectFace, 1200);
            } catch (error) {
                console.error('Face detector initialization failed:', error);
                faceStatus.textContent = 'Face detection could not load. Check internet access, then retry.';
                setFaceState('bad', 'Detector unavailable.');
            }
        } catch (error) {
            cameraReady = false;
            cameraStatus.textContent = error.message || 'Camera permission is required.';
            setDot(cameraDot, 'bad');
            setFaceState('bad', 'Camera is required before face detection can run.');
            placeholder.hidden = false;
            placeholder.querySelector('strong').textContent = 'Camera access required';
            placeholder.querySelector('small').textContent = 'Allow camera access and reload this page';
        }
        updateButton();
    }

    function updateButton() {
        const now = Date.now();
        const verificationRemaining = verificationEndsAt - now;
        const scheduledRemaining = scheduledAt - now;
        const verificationTotal = Math.max(0, verificationRemaining);
        progress.style.width = ((60 - verificationTotal / 1000) / 60 * 100) + '%';

        if (verificationRemaining > 0) {
            const total = Math.ceil(verificationRemaining / 1000);
            countdown.textContent = [Math.floor(total / 60), total % 60].map(x => String(x).padStart(2, '0')).join(':');
            help.textContent = 'Security and face checks are running. Verification completes after one minute.';
            button.disabled = true;
            button.querySelector('span').textContent = 'Verifying…';
        } else if (!cameraReady || !faceDetector || lastFaceState !== 'good') {
            countdown.textContent = 'CHECK';
            help.textContent = 'A connected camera and exactly one detected face are required to continue.';
            button.disabled = true;
            button.querySelector('span').textContent = 'Complete face check';
        } else if (now >= scheduledEndAt) {
            countdown.textContent = 'TIME UP';
            help.textContent = 'The scheduled examination window has ended. Starting is no longer available.';
            button.disabled = true;
            button.querySelector('span').textContent = "Time's up";
        } else if (scheduledRemaining > 0) {
            const total = Math.ceil(scheduledRemaining / 1000);
            const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60;
            countdown.textContent = [h, m, s].map(x => String(x).padStart(2, '0')).join(':');
            help.textContent = 'Verification complete. The exam unlocks at its scheduled start time.';
            button.disabled = true;
            button.querySelector('span').textContent = 'Available at scheduled time';
        } else {
            countdown.textContent = 'READY';
            help.textContent = 'Verification complete. You can now start your 60-minute examination.';
            button.disabled = false;
            button.querySelector('span').textContent = 'Start examination';
        }
    }

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) recordEvent('TabSwitch', 'Page became hidden before exam start');
    });
    document.addEventListener('copy', e => { e.preventDefault(); recordEvent('Copy', 'Copy action blocked'); });
    document.addEventListener('cut', e => { e.preventDefault(); recordEvent('Cut', 'Cut action blocked'); });
    document.addEventListener('paste', e => { e.preventDefault(); recordEvent('Paste', 'Paste action blocked'); });
    document.addEventListener('keydown', e => {
        const key = e.key.toLowerCase();
        if ((e.ctrlKey || e.metaKey) && ['c', 'v', 'x', 'p', 's'].includes(key)) {
            e.preventDefault();
            recordEvent(['c', 'v', 'x'].includes(key) ? ({ c: 'Copy', v: 'Paste', x: 'Cut' }[key]) : 'ScreenshotShortcut', 'Restricted keyboard shortcut');
        }
        if (e.key === 'PrintScreen') recordEvent('ScreenshotShortcut', 'PrintScreen key');
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && key === '5') {
            e.preventDefault();
            recordEvent('ScreenshotShortcut', 'Screenshot keyboard shortcut');
        }
        if (((e.ctrlKey || e.metaKey) && e.shiftKey && key === 'r') || (e.metaKey && e.altKey && key === 'r')) {
            e.preventDefault();
            recordEvent('RecordingShortcut', 'Possible screen recording shortcut');
        }
    });
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.getElementById('exam-start-form').addEventListener('submit', e => {
        if (!cameraReady || !faceDetector || lastFaceState !== 'good' || Date.now() < verificationEndsAt || Date.now() < scheduledAt) {
            e.preventDefault();
            updateButton();
        }
    });
    window.addEventListener('beforeunload', () => {
        if (faceCheckTimer) clearInterval(faceCheckTimer);
        cameraStream?.getTracks().forEach(track => track.stop());
        faceDetector?.close?.();
    });

    updateButton();
    await initCamera();
    window.setInterval(updateButton, 250);
})();
</script>
}