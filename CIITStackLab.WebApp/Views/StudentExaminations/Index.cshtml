@model IReadOnlyList<CIITStackLab.Application.DTOs.TopicExamSummaryDto>
@{
    ViewData["Title"] = "Examinations";
    var options = ViewBag.AvailableTopics as IReadOnlyList<CIITStackLab.WebApp.Controllers.StudentExaminationsController.ExamTopicOption>
        ?? Array.Empty<CIITStackLab.WebApp.Controllers.StudentExaminationsController.ExamTopicOption>();
}
<section class="container py-4">
    <div class="mb-4">
        <span class="text-uppercase text-primary small fw-bold">Student Workspace</span>
        <h1 class="h2 mt-2">Examinations</h1>
        <p class="text-secondary">Schedule topic exams, review upcoming sessions, and track your results.</p>
    </div>
    @if (TempData["ExamMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
    @if (TempData["ExamError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5">Apply for a topic exam</h2>
            <p class="text-secondary">You can schedule an exam only after completing the topic. Choose a date and time at least 30 minutes ahead.</p>
            <form asp-controller="StudentExaminations" asp-action="Schedule" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label class="form-label" for="topicOption">Course / topic</label>
                    <select id="topicOption" class="form-select" required>
                        <option value="">Select a topic</option>
                        @foreach (var option in options)
                        {
                            <option value="@option.CourseId|@option.TopicId">@option.CourseTitle — @option.TopicTitle</option>
                        }
                    </select>
                    <input type="hidden" name="CourseId" id="courseId" />
                    <input type="hidden" name="TopicId" id="topicId" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="ScheduledAtLocal">Exam date and time</label>
                    <input class="form-control" type="datetime-local" id="ScheduledAtLocal" name="ScheduledAtLocal" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Schedule</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Your exam records</h2>
            @if (Model.Count == 0)
            {
                <p class="text-secondary mb-0">No examinations scheduled yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Topic</th><th>Scheduled time (local)</th><th>Status</th><th>Result</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                        @foreach (var exam in Model)
                        {
                            <tr>
                                <td><strong>@exam.TopicTitle</strong><div class="small text-secondary">Attempt #@exam.AttemptId</div></td>
                                <td><time class="exam-local-time" datetime="@exam.ScheduledAtUtc.ToString("O")">@exam.ScheduledAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></td>
                                <td>@exam.Status</td>
                                <td>
                                    @if (exam.Status is "Passed" or "Failed" or "Terminated")
                                    {
                                        <strong>@exam.Score / @exam.TotalQuestions</strong>
                                        <div class="small">@((exam.Passed) ? "Passed" : "Not passed")</div>
                                    }
                                    else { <span class="text-secondary">Pending</span> }
                                </td>
                                <td class="text-end">
                                    @if (exam.Status is "Scheduled" or "Ready")
                                    {
                                        <a class="btn btn-outline-primary btn-sm" asp-action="Instructions" asp-route-attemptId="@exam.AttemptId">Start / Instructions</a>
                                    }
                                    else if (exam.Status == "InProgress")
                                    {
                                        <a class="btn btn-primary btn-sm" asp-action="Instructions" asp-route-attemptId="@exam.AttemptId">Resume exam</a>
                                    }
                                    else
                                    {
                                        <span class="small text-secondary">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
@section Scripts {
<script>
    document.getElementById('topicOption')?.addEventListener('change', function () {
        const parts = this.value.split('|');
        document.getElementById('courseId').value = parts[0] || '';
        document.getElementById('topicId').value = parts[1] || '';
    });
    document.querySelectorAll('.exam-local-time').forEach(function (element) {
        const date = new Date(element.dateTime);
        if (!Number.isNaN(date.getTime())) element.textContent = date.toLocaleString();
    });
</script>
}
