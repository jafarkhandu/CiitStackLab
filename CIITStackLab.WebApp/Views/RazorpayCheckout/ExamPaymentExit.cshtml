@{
    Layout = null;
    var message = ViewData["ExitMessage"]?.ToString() ?? "Payment window closed. Payment not completed.";
    var learningUrl = ViewData["LearningUrl"]?.ToString() ?? "/Examinations";
    var outcome = ViewData["ExitOutcome"]?.ToString() ?? "cancelled";
    var exitPurpose = ViewData["ExitPurpose"]?.ToString() ?? "exam";
    var isCoursePayment = string.Equals(exitPurpose, "course", StringComparison.OrdinalIgnoreCase);
    var statusClass = outcome == "declined" ? "is-declined"
        : outcome == "completed" ? "is-completed"
        : outcome == "pending" ? "is-pending"
        : "is-cancelled";
    var statusTitle = outcome == "declined" ? "Payment Declined"
        : outcome == "completed" ? "Payment Confirmed"
        : outcome == "pending" ? "Payment Pending"
        : "Payment Cancelled";
    var statusIcon = outcome == "declined" ? "!" : outcome == "completed" ? "✓" : outcome == "pending" ? "…" : "×";
    var paymentContext = isCoursePayment ? "Course enrollment payment" : "Examination payment";
    var redirectDestination = isCoursePayment ? "course details" : "Learning Hub";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@statusTitle - CIIT Stack Lab</title>
    <style>
        * { box-sizing: border-box; }
        :root { color-scheme: light; }
        body {
            margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;
            background: radial-gradient(circle at 15% 12%, #e4edff 0, transparent 34%),
                        radial-gradient(circle at 88% 86%, #e4eaff 0, transparent 32%), #f4f7fc;
            color: #172744; font-family: Inter, "Segoe UI", Arial, sans-serif;
        }
        main {
            --status: #d99b13; --status-soft: #fff5d7; --status-border: #f4d98a;
            position: relative; overflow: hidden; width: min(100%, 470px); padding: 38px 30px 34px;
            text-align: center; background: rgba(255,255,255,.88); backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,.95); border-radius: 28px;
            box-shadow: 0 30px 90px rgba(32,56,98,.15), inset 0 1px 0 rgba(255,255,255,.95);
            animation: paymentCardEnter .55s cubic-bezier(.2,.8,.2,1) both;
        }
        main::before { content: ""; position: absolute; inset: 0 0 auto; height: 5px; background: linear-gradient(90deg, transparent, var(--status), transparent); }
        main.is-cancelled { --status: #d99b13; --status-soft: #fff5d7; --status-border: #f4d98a; }
        main.is-declined { --status: #dc3545; --status-soft: #fff0f1; --status-border: #f5bdc3; }
        main.is-completed { --status: #16835e; --status-soft: #e8f8f0; --status-border: #b9e8d2; }
        main.is-pending { --status: #2563eb; --status-soft: #edf4ff; --status-border: #bfd4ff; }
        .status-icon {
            display: grid; place-items: center; width: 72px; height: 72px; margin: 0 auto 20px;
            border-radius: 24px; color: var(--status); background: var(--status-soft);
            border: 1px solid var(--status-border); font-size: 38px; font-weight: 700;
            box-shadow: 0 10px 24px color-mix(in srgb, var(--status) 12%, transparent);
            animation: statusIconEnter .65s .12s cubic-bezier(.2,.8,.2,1) both;
        }
        .eyebrow { margin: 0 0 8px; color: #75829a; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
        h1 { margin: 0; color: var(--status); font-size: clamp(24px, 5vw, 29px); font-weight: 800; letter-spacing: -.035em; }
        .message { margin: 13px 0 22px; color: #61708a; line-height: 1.65; }
        .redirect-copy { margin: 0; color: #66758d; font-size: 14px; }
        .count-label { color: #233957; font-weight: 800; font-variant-numeric: tabular-nums; }
        #countdown {
            position: relative; margin: 18px auto 0; width: 60px; height: 60px; display: grid; place-items: center;
            border: 3px solid var(--status-border); border-top-color: var(--status); border-radius: 50%;
            color: var(--status); font-size: 23px; font-weight: 800; font-variant-numeric: tabular-nums;
            animation: timerPulse 1.8s ease-in-out infinite;
        }
        @@keyframes paymentCardEnter { from { opacity: 0; transform: translateY(18px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @@keyframes statusIconEnter { from { opacity: 0; transform: scale(.72) rotate(-8deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
        @@keyframes timerPulse { 0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--status) 0%, transparent); } 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--status) 10%, transparent); } }
        @@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
</head>
<body>
    <main class="@statusClass">
        <div class="status-icon" aria-hidden="true">@statusIcon</div>
        <p class="eyebrow">CIIT Stack Lab · @paymentContext</p>
        <h1>@statusTitle</h1>
        <p class="message" id="payment-message">@message</p>
        <p class="redirect-copy">Returning to @redirectDestination in <span class="count-label" id="count-label">5</span> seconds…</p>
        <div id="countdown" aria-label="Seconds until redirect">5</div>
    </main>
    <script>
        (() => {
            const destination = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(learningUrl));
            let remaining = 5;
            const number = document.getElementById("countdown");
            const label = document.getElementById("count-label");
            const timer = window.setInterval(() => {
                remaining -= 1;
                number.textContent = String(remaining);
                label.textContent = String(remaining);
                if (remaining <= 0) {
                    window.clearInterval(timer);
                    window.location.replace(destination);
                }
            }, 1000);
        })();
    </script>
</body>
</html>
