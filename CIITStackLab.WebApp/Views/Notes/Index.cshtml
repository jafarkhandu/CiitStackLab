@model CIITStackLab.Application.DTOs.CourseNotesDto
@{ViewData["Title"]=$"Notes — {Model.TopicTitle}";var chapters=Model.Chapters.ToList();var i=chapters.FindIndex(x=>x.PageId==Model.CurrentPageId);if(i<0)i=0;var prev=i>0?chapters[i-1]:null;var next=i<chapters.Count-1?chapters[i+1]:null;}
@section Styles{<link rel="stylesheet" href="~/css/notes.css" asp-append-version="true"/>}
<section class="ciit-notes-reader"><header class="ciit-notes-reader-header"><div class="container"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="ciit-notes-back"><i class="bi bi-arrow-left"></i> Course Overview</a><span class="ciit-notes-reader-kicker">@Model.CourseTitle</span><h1>@Model.TopicTitle</h1><p>Structured Notes chapters for this topic.</p></div></header>
<div class="container ciit-notes-reader-shell"><aside class="ciit-notes-reader-sidebar"><div class="ciit-notes-reader-sidebar-head"><span>Notes</span><strong>@chapters.Count chapters</strong></div><div class="ciit-notes-reader-list">@foreach(var ch in chapters){<a class="@(ch.PageId==Model.CurrentPageId?"is-active":"")" asp-controller="Notes" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-topicId="@Model.TopicId" asp-route-pageId="@ch.PageId"><span>@ch.Title</span><small>@ch.PageId</small></a>}</div></aside>
<main class="ciit-notes-reader-main"><article class="ciit-notes-reader-card"><div class="ciit-notes-reader-title"><span>Chapter @(i+1) of @chapters.Count</span><h2>@Model.CurrentChapter?.TitleWithNumber</h2></div><div class="ciit-notes-reader-content">@Html.Raw(Model.CurrentChapter?.HtmlContent)</div><nav class="ciit-notes-reader-pager">@if(prev is not null){<a asp-controller="Notes" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-topicId="@Model.TopicId" asp-route-pageId="@prev.PageId"><i class="bi bi-chevron-left"></i><span><small>Previous</small>@prev.TitleWithNumber</span></a>}else{<span/>}@if(next is not null){<a class="next" asp-controller="Notes" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-topicId="@Model.TopicId" asp-route-pageId="@next.PageId"><span><small>Next</small>@next.TitleWithNumber</span><i class="bi bi-chevron-right"></i></a>}</nav></article></main></div></section>