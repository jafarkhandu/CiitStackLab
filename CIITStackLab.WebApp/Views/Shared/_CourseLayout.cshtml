@using System.Security.Claims
@using CIITStackLab.Application.DTOs
@using CIITStackLab.Application.Interfaces
@inject CoursePurchaseService CoursePurchaseService
@inject ICourseService CourseService

@{
    var courseId = ViewContext.RouteData.Values["id"]?.ToString()
        ?? ViewData["CourseId"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isNotesPage = currentController.Equals("Notes", StringComparison.OrdinalIgnoreCase);
    var isLearnPage = currentController.Equals("Courses", StringComparison.OrdinalIgnoreCase)
        && currentAction.Equals("Learn", StringComparison.OrdinalIgnoreCase);
    var isCourseHome = currentController.Equals("Courses", StringComparison.OrdinalIgnoreCase)
        && (currentAction.Equals("CourseHome", StringComparison.OrdinalIgnoreCase)
            || currentAction.Equals("CourseEnvironment", StringComparison.OrdinalIgnoreCase));
    var isPracticeAssessmentPage = currentController.Equals("Courses", StringComparison.OrdinalIgnoreCase)
        && currentAction.Equals("PracticeAssessment", StringComparison.OrdinalIgnoreCase);
    var courseTitle = ViewData["CourseTitle"]?.ToString();
    var notesTopicId = ViewData["NotesTopicId"]?.ToString();
    var notesChapterId = ViewData["NotesChapterId"]?.ToString();
    var purchasedCourses = Array.Empty<CourseDto>();

    if (User.IsInRole("Student"))
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            var activeCourseIds = await CoursePurchaseService.GetAccessibleCourseIdsAsync(userId);
            var publishedCourses = await CourseService.GetPublishedAsync();
            var activeCourseIdSet = activeCourseIds.ToHashSet();

            purchasedCourses = publishedCourses
                .Where(course => activeCourseIdSet.Contains(course.Id))
                .OrderBy(course => course.Title)
                .ToArray();

            if (int.TryParse(courseId, out var currentCourseId)
                && purchasedCourses.All(course => course.Id != currentCourseId))
            {
                var currentCourse = await CourseService.GetByIdAsync(currentCourseId);

                if (currentCourse is not null)
                {
                    purchasedCourses = purchasedCourses
                        .Append(currentCourse)
                        .OrderBy(course => course.Title)
                        .ToArray();
                }
            }
        }
    }

    if (string.IsNullOrWhiteSpace(courseTitle))
    {
        var pageTitle = ViewData["Title"]?.ToString();
        if (!string.IsNullOrWhiteSpace(pageTitle) && pageTitle.StartsWith("Learn — ", StringComparison.Ordinal))
        {
            courseTitle = pageTitle[8..];
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIIT Stack Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/global/site.css" />
    <link rel="stylesheet" href="~/css/student/course-environment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student/course-switcher.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/student/course-learning-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/course-sidebar-art.css" asp-append-version="true" />
    @if (isLearnPage)
    {
        <link rel="stylesheet" href="~/css/student/learning-modern.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/student/learn-glass.css" asp-append-version="true" />
    }
</head>
<body class="ciit-course-environment-body @(isLearnPage ? "ciit-learning-mode" : "")">
    <header class="ciit-course-environment-header">
        <div class="container-fluid px-3 px-lg-4">
            <div class="ciit-course-environment-header-inner">
                <a class="ciit-course-environment-brand" asp-controller="Home" asp-action="Index" aria-label="CIIT Stack Lab home">
                    <span class="ciit-course-environment-brand-mark">C</span>
                    <span>CIIT<span> Stack Lab</span></span>
                </a>

                <div class="ciit-course-environment-context">
                    <span class="ciit-course-environment-label">@(string.IsNullOrWhiteSpace(courseId) ? "Learning Hub" : "Course Environment")</span>
                    @if (!string.IsNullOrWhiteSpace(courseTitle))
                    {
                        <strong>@courseTitle</strong>
                    }
                </div>

                <nav class="ciit-course-environment-nav" aria-label="Course environment navigation">
                    @if (!string.IsNullOrWhiteSpace(courseId))
                    {
                        <a asp-controller="Courses" asp-action="CourseHome">
                            <i class="bi bi-collection-play"></i>
                            <span>Home</span>
                        </a>
                    }
                </nav>

                <div class="ciit-course-environment-account">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="ciit-course-environment-user d-none d-md-inline">Hi, @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-primary ciit-course-signout">Sign Out</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="ciit-course-environment-workspace">
        @if (isLearnPage)
        {
            <button type="button"
                    class="ciit-learning-global-sidebar-toggle"
                    data-learning-global-sidebar-toggle
                    aria-controls="ciit-learning-global-sidebar"
                    aria-expanded="true"
                    aria-label="Hide main sidebar"
                    title="Hide main sidebar">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                <span class="visually-hidden">Hide main sidebar</span>
            </button>
        }

        @if (isNotesPage && ViewData["LearningPathModel"] is CourseLearningDto notesLearningPath)
        {
            <aside class="ciit-course-global-sidebar ciit-learning-path-sidebar ciit-notes-learning-path" aria-label="Learning path">
                <div class="ciit-notes-path-heading">
                    <span>YOUR LEARNING PATH</span>
                    <strong>@notesLearningPath.Title</strong>
                    <a asp-controller="Courses" asp-action="Learn" asp-route-id="@courseId">
                        <i class="bi bi-arrow-left-circle"></i> Back to learning
                    </a>
                </div>
                <div class="ciit-notes-path-topics">
                    @foreach (var pathTopic in notesLearningPath.Topics)
                    {
                        <details class="ciit-notes-path-topic" open="@(pathTopic.Id.ToString() == notesTopicId ? "open" : null)">
                            <summary>
                                <i class="bi bi-collection-play"></i>
                                <span>@pathTopic.Title</span>
                                <i class="bi bi-chevron-down"></i>
                            </summary>
                            @foreach (var pathChapter in pathTopic.Chapters)
                            {
                                <a class="ciit-notes-path-chapter @(pathTopic.Id.ToString() == notesTopicId && pathChapter.ChapterId == notesChapterId ? "active" : "")"
                                   asp-controller="Notes"
                                   asp-action="Index"
                                   asp-route-topicId="@pathTopic.Id"
                                   asp-route-chapterId="@pathChapter.ChapterId"
                                   asp-route-courseId="@courseId">
                                    <i class="bi bi-journal-text"></i>
                                    <span>@pathChapter.Title</span>
                                </a>
                            }
                        </details>
                    }
                </div>
            </aside>
        }
        else
        {
            <aside class="ciit-course-global-sidebar"
                   aria-label="Course sections"
                   id="@(isLearnPage ? "ciit-learning-global-sidebar" : null)">
                @if (!string.IsNullOrWhiteSpace(courseId))
                {
                    <details class="ciit-course-switcher">
                        <summary>
                            <span>COURSE</span>
                            <strong>@(string.IsNullOrWhiteSpace(courseTitle) ? "Learning" : courseTitle)</strong>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <div class="ciit-course-switcher-menu">
                            @foreach (var course in purchasedCourses)
                            {
                                <a class="@(course.Id.ToString() == courseId ? "active" : "")"
                                   asp-controller="Courses"
                                   asp-action="CourseEnvironment"
                                   asp-route-id="@course.Id">
                                    <span>@course.Title</span>
                                    @if (course.Id.ToString() == courseId)
                                    {
                                        <i class="bi bi-check2" aria-hidden="true"></i>
                                    }
                                </a>
                            }
                        </div>
                    </details>
                }
                else
                {
                    <div class="ciit-course-global-sidebar-heading">
                        <span>COURSE HOME</span>
                        <strong>My Courses</strong>
                    </div>
                }

                <nav class="ciit-course-global-nav">
                    <a class="@(currentController.Equals("Courses", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("CourseHome", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-controller="Courses" asp-action="CourseHome">
                        <i class="bi bi-collection-play"></i><span>My Courses</span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(courseId) && !isCourseHome)
                    {
                        <a class="@(isLearnPage ? "active" : "")"
                           asp-controller="Courses" asp-action="Learn" asp-route-id="@courseId">
                            <i class="bi bi-journal-bookmark"></i><span>Learning Path</span>
                        </a>
                    }
                    @if (User.IsInRole("Student"))
                    {
                        <a class="@(isPracticeAssessmentPage ? "active" : "")"
                           asp-controller="Courses"
                           asp-action="PracticeAssessment">
                            <i class="bi bi-patch-check"></i><span>Practice Assessment</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(courseId))
                    {
                        <a class="@(currentAction.Equals("CourseEnvironment", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           asp-controller="Courses" asp-action="CourseEnvironment" asp-route-id="@courseId">
                            <i class="bi bi-house"></i><span>Course Home</span>
                        </a>
                    }
                    <a class="@(currentAction.Equals("PaymentHistory", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-controller="Courses" asp-action="PaymentHistory">
                        <i class="bi bi-receipt"></i><span>Payment History</span>
                    </a>
                    @if (User.IsInRole("Student"))
                    {
                        <a class="@(currentController.Equals("StudentExaminations", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           asp-controller="StudentExaminations" asp-action="Index">
                            <i class="bi bi-shield-check"></i><span>Examinations</span>
                        </a>
                    }
                    <a class="@(currentController.Equals("Account", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-person-circle"></i><span>My Profile</span>
                    </a>
                </nav>

                <div class="ciit-course-sidebar-art" aria-hidden="true">
                    <div class="ciit-course-sidebar-art-copy">
                        <span>LEARN</span>
                        <span>GROW</span>
                        <span>ACHIEVE</span>
                    </div>
                    <svg class="ciit-course-sidebar-art-visual" viewBox="0 0 248 154" preserveAspectRatio="xMidYMax meet" role="presentation">
                        <ellipse cx="120" cy="142" rx="94" ry="18" fill="rgba(126,171,232,.18)" />
                        <circle cx="205" cy="73" r="22" fill="rgba(255,255,255,.26)" />
                        <circle cx="225" cy="96" r="8" fill="rgba(255,255,255,.38)" />
                        <g class="ciit-art-leaf">
                            <path d="M44 116 C28 107, 27 96, 29 88 C40 90, 49 98, 44 116Z" fill="#58a95d" />
                            <path d="M44 115 C51 100, 60 98, 66 101 C64 111, 56 117, 44 115Z" fill="#3e944c" />
                            <path d="M45 118 C47 104, 46 96, 42 87" fill="none" stroke="#3f8c51" stroke-width="3" stroke-linecap="round" />
                        </g>
                        <g>
                            <rect x="17" y="136" width="72" height="7" rx="3.5" fill="#e9a35d" />
                            <rect x="12" y="129" width="66" height="7" rx="3.5" fill="#d97f53" />
                            <rect x="22" y="143" width="62" height="7" rx="3.5" fill="#c98a4b" />
                        </g>
                        <g>
                            <circle cx="105" cy="64" r="20" fill="#d58d68" />
                            <path d="M84 62 C86 43, 97 36, 111 40 C123 43, 128 52, 126 66 C119 55, 106 51, 91 56Z" fill="#1d2d45" />
                            <path d="M91 82 C81 87, 75 101, 74 128 L76 151 L150 151 L146 113 C144 95, 135 84, 121 80Z" fill="#1d68c9" />
                            <path d="M92 84 C104 92, 118 92, 130 84 L139 106 L132 133 L87 132 L79 105Z" fill="#1762bd" />
                            <path d="M93 84 C99 90, 109 92, 119 89" fill="none" stroke="#2782e8" stroke-width="4" stroke-linecap="round" />
                            <path d="M78 105 L67 119 L81 128" fill="none" stroke="#d58d68" stroke-width="8" stroke-linecap="round" />
                            <path d="M130 105 L143 117" fill="none" stroke="#d58d68" stroke-width="8" stroke-linecap="round" />
                        </g>
                        <g class="ciit-art-laptop">
                            <path d="M119 101 L166 83 L190 99 L143 117Z" fill="#172b48" stroke="#fff" stroke-width="2" />
                            <path d="M143 117 L190 99 L181 115 L135 133Z" fill="#7d94b1" />
                            <path d="M123 101 L167 86 L183 98 L140 113Z" fill="#cfe4ff" />
                        </g>
                    </svg>
                </div>
            </aside>
        }

        <main class="ciit-course-environment-main">
            @RenderBody()
        </main>
    </div>

    <footer class="ciit-course-environment-footer">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year - CIIT Stack Lab</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/global/site.js"></script>
    @if (!string.IsNullOrWhiteSpace(courseId))
    {
        <script>
            document.addEventListener('click', function (event) {
                const link = event.target.closest('a.ciit-learning-read-notes');
                if (!link) {
                    return;
                }

                const url = new URL(link.href, window.location.origin);
                url.searchParams.set('courseId', '@courseId');
                link.href = url.toString();
            });
        </script>
    }
    @if (isLearnPage)
    {
        <script defer src="~/js/student/learning-modern.js" asp-append-version="true"></script>
        <script defer src="~/js/student/learn-glass.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
