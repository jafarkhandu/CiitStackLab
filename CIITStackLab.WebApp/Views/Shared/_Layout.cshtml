@using System.Security.Claims
@inject CIITStackLab.Infrastructure.Services.CoursePurchaseService CoursePurchaseService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIIT Stack Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .ciit-access-denied-modal .modal-dialog { max-width: 480px; padding: 14px; }
        .ciit-access-denied-modal .ciit-access-glass-card {
            position: relative; isolation: isolate; overflow: hidden; border-radius: 28px;
            border: 1px solid rgba(255,255,255,.78);
            background: linear-gradient(145deg, rgba(255,255,255,.86), rgba(242,247,255,.72));
            box-shadow: 0 32px 90px rgba(24,48,91,.22), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(32px) saturate(165%); -webkit-backdrop-filter: blur(32px) saturate(165%);
        }
        .ciit-access-denied-modal .ciit-access-glow { pointer-events:none; }
        .ciit-access-denied-modal .ciit-access-glass-glow { position:absolute; z-index:-1; width:220px; height:220px; border-radius:50%; filter:blur(2px); pointer-events:none; }
        .ciit-access-denied-modal .ciit-access-glass-glow-one { top:-130px; right:-55px; background:radial-gradient(circle,rgba(100,149,255,.27),transparent 70%); }
        .ciit-access-denied-modal .ciit-access-glass-glow-two { bottom:-150px; left:-90px; background:radial-gradient(circle,rgba(116,226,218,.23),transparent 70%); }
        .ciit-access-denied-modal .ciit-access-glass-header { position:relative; display:flex; flex-direction:column; align-items:center; text-align:center; padding:34px 30px 12px; border:0; }
        .ciit-access-denied-modal .ciit-access-close { position:absolute; top:20px; right:20px; opacity:.55; }
        .ciit-access-denied-modal .ciit-access-icon-wrap { display:grid; place-items:center; width:78px; height:78px; margin:0 0 20px; border-radius:25px; border:1px solid rgba(255,255,255,.92); background:linear-gradient(145deg,rgba(255,255,255,.96),rgba(255,232,235,.72)); box-shadow:0 12px 30px rgba(180,48,69,.12),inset 0 1px 0 white; }
        .ciit-access-denied-modal .ciit-access-icon-ring { display:grid; place-items:center; width:52px; height:52px; border-radius:18px; color:#c72c4a; background:linear-gradient(145deg,#fff0f2,#ffe1e7); box-shadow:inset 0 1px 0 rgba(255,255,255,.95); font-size:24px; }
        .ciit-access-denied-modal .ciit-access-eyebrow { display:flex; align-items:center; gap:8px; color:#71809a; font-size:10px; font-weight:800; letter-spacing:.16em; }
        .ciit-access-denied-modal .ciit-access-eyebrow-dot { width:5px; height:5px; border-radius:50%; background:#ed6b7d; box-shadow:0 0 0 4px rgba(237,107,125,.12); }
        .ciit-access-denied-modal .ciit-access-title { margin-top:12px; color:#172744; font-size:27px; font-weight:800; letter-spacing:-.045em; }
        .ciit-access-denied-modal .ciit-access-title span { color:#376de0; }
        .ciit-access-denied-modal .ciit-access-subtitle { margin:9px 0 0; color:#71809a; font-size:13px; line-height:1.6; }
        .ciit-access-denied-modal .ciit-access-glass-body { padding:12px 30px 24px; }
        .ciit-access-denied-modal .ciit-access-glass-body > p { margin:0 0 20px; color:#53627b; text-align:center; font-size:14px; line-height:1.7; }
        .ciit-access-denied-modal .ciit-access-requirement { display:flex; align-items:center; gap:12px; padding:15px; border:1px solid rgba(135,157,195,.2); border-radius:17px; background:linear-gradient(120deg,rgba(255,255,255,.75),rgba(244,248,255,.57)); box-shadow:inset 0 1px 0 rgba(255,255,255,.9); }
        .ciit-access-denied-modal .ciit-access-requirement-icon { display:grid; place-items:center; flex:0 0 40px; height:40px; border-radius:13px; color:#2863d8; background:linear-gradient(145deg,#e9f1ff,#dce8ff); font-size:18px; }
        .ciit-access-denied-modal .ciit-access-requirement > span:nth-child(2) { display:flex; flex:1; flex-direction:column; gap:3px; }
        .ciit-access-denied-modal .ciit-access-requirement strong { color:#243651; font-size:13px; font-weight:800; }
        .ciit-access-denied-modal .ciit-access-requirement small { color:#75839b; font-size:11px; line-height:1.5; }
        .ciit-access-denied-modal .ciit-access-requirement-arrow { color:#7890b6; }
        .ciit-access-denied-modal .ciit-access-glass-footer { display:flex; gap:10px; padding:0 30px 30px; border:0; }
        .ciit-access-denied-modal .ciit-access-secondary-btn, .ciit-access-denied-modal .ciit-access-primary-btn { display:inline-flex; min-height:46px; align-items:center; justify-content:center; gap:8px; padding:0 17px; border-radius:14px; font-size:12px; font-weight:800; text-decoration:none; transition:transform .18s ease,box-shadow .18s ease,background .18s ease; }
        .ciit-access-denied-modal .ciit-access-secondary-btn { border:1px solid rgba(135,157,195,.25); color:#65748d; background:rgba(255,255,255,.52); }
        .ciit-access-denied-modal .ciit-access-primary-btn { flex:1; border:1px solid rgba(255,255,255,.25); color:white; background:linear-gradient(115deg,#4a83f3,#2457d6); box-shadow:0 9px 20px rgba(37,99,235,.23),inset 0 1px 0 rgba(255,255,255,.3); }
        .ciit-access-denied-modal .ciit-access-secondary-btn:hover, .ciit-access-denied-modal .ciit-access-primary-btn:hover { transform:translateY(-1px); }
        .ciit-access-denied-modal .ciit-access-primary-btn:hover { color:white; box-shadow:0 12px 25px rgba(37,99,235,.3),inset 0 1px 0 rgba(255,255,255,.35); }
        .modal-backdrop.show { opacity:.48; backdrop-filter:blur(5px); -webkit-backdrop-filter:blur(5px); }
        @@media(max-width:480px) {
            .ciit-access-denied-modal .ciit-access-glass-header { padding:30px 22px 12px; }
            .ciit-access-denied-modal .ciit-access-glass-body { padding:12px 22px 22px; }
            .ciit-access-denied-modal .ciit-access-glass-footer { padding:0 22px 24px; flex-direction:column-reverse; }
            .ciit-access-denied-modal .ciit-access-secondary-btn, .ciit-access-denied-modal .ciit-access-primary-btn { width:100%; }
        }
        @@media(prefers-reduced-motion:reduce) {
            .ciit-access-denied-modal .ciit-access-secondary-btn, .ciit-access-denied-modal .ciit-access-primary-btn { transition:none; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var hasLearningHubPurchase = false;
        if (User.IsInRole("Student"))
        {
            var currentStudentId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!string.IsNullOrWhiteSpace(currentStudentId))
            {
                hasLearningHubPurchase = await CoursePurchaseService.HasAnyActivePurchaseAsync(currentStudentId);
            }
        }
    }
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top ciit-main-navbar">
        <div class="container-fluid">
            <a class="navbar-brand ciit-brand" asp-controller="Home" asp-action="Index">CIIT<span> Stack Lab</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ciitNavbar"
                    aria-controls="ciitNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ciitNavbar">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (ViewBag.ShowLearningHub == true)
                    {
                        <li class="nav-item">
                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="ciit-learning-hub-switch"
                               @if (hasLearningHubPurchase) { <text>data-learning-hub-transition</text> }>
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                <span>Switch to Learning Hub</span>
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link ciit-nav-link" href="#tutorials">Learning Paths</a></li>
                    }
                </ul>
                <div class="d-flex gap-2 ms-lg-3 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-secondary small d-none d-xl-inline">Hi, @User.Identity.Name</span>
                        @if (User.IsInRole("Admin") || User.IsInRole("Super User"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="ciit-admin-return-btn">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Admin Dashboard</span>
                            </a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-primary fw-semibold ciit-signin-btn">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-semibold ciit-signin-btn">Sign In</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <nav class="ciit-topics-navbar">
        <button type="button" class="ciit-topic-arrow" id="topicsPrev" aria-label="Previous topics"><i class="bi bi-chevron-left"></i></button>
        <div class="ciit-topics-title">Topics</div>
        <div class="ciit-topics-scroll" id="ciitTopicsScroll">
            <a href="#" class="ciit-topic-link">HTML</a><a href="#" class="ciit-topic-link">CSS</a>
            <a href="#" class="ciit-topic-link disabled-topic">Bootstrap</a><a href="#" class="ciit-topic-link">JavaScript</a>
            <a href="#" class="ciit-topic-link disabled-topic">TypeScript</a><a href="#" class="ciit-topic-link disabled-topic">React</a>
            <a href="#" class="ciit-topic-link disabled-topic">Angular</a><a href="#" class="ciit-topic-link disabled-topic">Node.js</a>
            <a href="#" class="ciit-topic-link">Core Java</a><a href="#" class="ciit-topic-link">Python</a><a href="#" class="ciit-topic-link">C#</a>
            <a href="#" class="ciit-topic-link">GitHub</a><a href="#" class="ciit-topic-link">Jenkins</a>
            <a href="#" class="ciit-topic-link disabled-topic">Azure</a><a href="#" class="ciit-topic-link">AWS</a>
            <a href="#" class="ciit-topic-link disabled-topic">SQL Server</a><a href="#" class="ciit-topic-link disabled-topic">Basic Excel</a>
            <a href="#" class="ciit-topic-link disabled-topic">Advanced Excel</a><a href="#" class="ciit-topic-link disabled-topic">Power BI</a>
            <a href="#" class="ciit-topic-link disabled-topic">Tableau</a><a href="#" class="ciit-topic-link disabled-topic">NumPy</a>
            <a href="#" class="ciit-topic-link disabled-topic">Pandas</a><a href="#" class="ciit-topic-link disabled-topic">Matplotlib</a>
        </div>
        <button type="button" class="ciit-topic-arrow" id="topicsNext" aria-label="Next topics"><i class="bi bi-chevron-right"></i></button>
    </nav>

    <div class="ciit-hub-transition" id="ciitHubTransition" aria-hidden="true">
        <div class="ciit-hub-transition-orbit ciit-hub-transition-orbit-one"></div>
        <div class="ciit-hub-transition-orbit ciit-hub-transition-orbit-two"></div>
        <div class="ciit-hub-transition-content" role="status" aria-live="polite">
            <span class="ciit-hub-transition-icon"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="ciit-hub-transition-eyebrow">CIIT STACK LAB</span>
            <strong>Preparing your learning space</strong>
            <span class="ciit-hub-transition-caption">Getting your courses ready…</span>
            <span class="ciit-hub-transition-progress"><span></span></span>
        </div>
    </div>

    <main>
        @if (TempData["CoursePaymentMessage"] is string coursePaymentMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-info d-flex align-items-start gap-2" role="status">
                    <i class="bi bi-credit-card mt-1"></i>
                    <span>@coursePaymentMessage</span>
                </div>
            </div>
        }

        @if (TempData["LearningHubAccessDenied"] is string learningHubAccessDenied)
        {
            <div class="modal fade ciit-access-denied-modal" id="learningHubAccessDeniedModal" tabindex="-1"
                 aria-labelledby="learningHubAccessDeniedTitle" aria-describedby="learningHubAccessDeniedDescription"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content ciit-access-glass-card">
                        <div class="ciit-access-glass-glow ciit-access-glass-glow-one"></div>
                        <div class="ciit-access-glass-glow ciit-access-glass-glow-two"></div>
                        <div class="modal-header ciit-access-glass-header">
                            <button type="button" class="btn-close ciit-access-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            <div class="ciit-access-icon-wrap" aria-hidden="true">
                                <span class="ciit-access-icon-ring"><i class="bi bi-shield-lock-fill"></i></span>
                            </div>
                            <span class="ciit-access-eyebrow">CIIT STACK LAB <span class="ciit-access-eyebrow-dot"></span> ACCESS CONTROL</span>
                            <h2 class="modal-title ciit-access-title" id="learningHubAccessDeniedTitle">Learning Hub <span>locked</span></h2>
                            <p class="ciit-access-subtitle">One step left before your learning journey begins.</p>
                        </div>
                        <div class="modal-body ciit-access-glass-body">
                            <p id="learningHubAccessDeniedDescription">@learningHubAccessDenied</p>
                            <div class="ciit-access-requirement">
                                <span class="ciit-access-requirement-icon"><i class="bi bi-bag-check-fill"></i></span>
                                <span><strong>Purchase a course</strong><small>Unlock your personal Learning Hub after your first course purchase.</small></span>
                                <i class="bi bi-arrow-right ciit-access-requirement-arrow" aria-hidden="true"></i>
                            </div>
                        </div>
                        <div class="modal-footer ciit-access-glass-footer">
                            <button type="button" class="ciit-access-secondary-btn" data-bs-dismiss="modal">Maybe later</button>
                            <a class="ciit-access-primary-btn" asp-controller="Home" asp-action="Index" asp-fragment="tutorials">
                                Explore courses <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var accessDeniedModal = document.getElementById('learningHubAccessDeniedModal');
                    if (accessDeniedModal && window.bootstrap) {
                        bootstrap.Modal.getOrCreateInstance(accessDeniedModal).show();
                    }
                });
            </script>
        }

        @RenderBody()
    </main>

    <footer class="ciit-footer">
        <div class="container"><div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
            <span>&copy; @DateTime.Now.Year - CIIT Stack Lab</span><a href="#">Privacy</a>
        </div></div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>