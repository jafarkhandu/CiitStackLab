<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIIT Stack Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top ciit-main-navbar">
        <div class="container-fluid">
            <a class="navbar-brand ciit-brand" asp-controller="Home" asp-action="Index">CIIT<span> Stack Lab</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ciitNavbar" aria-controls="ciitNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ciitNavbar">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (ViewBag.ShowLearningHub == true)
                    {
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Dashboard" class="ciit-learning-hub-switch" data-learning-hub-transition>
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                <span>Switch to Learning Hub</span>
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link ciit-nav-link" href="#tutorials">Learning Paths</a></li>
                    }
                </ul>
                <div class="d-flex gap-2 ms-lg-3 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-secondary small d-none d-xl-inline">Hi, @User.Identity.Name</span>
                        @if (User.IsInRole("Admin") || User.IsInRole("Super User"))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="ciit-admin-return-btn">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Admin Dashboard</span>
                            </a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-primary fw-semibold ciit-signin-btn">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-semibold ciit-signin-btn">Sign In</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <nav class="ciit-topics-navbar">
        <button type="button" class="ciit-topic-arrow" id="topicsPrev" aria-label="Previous topics"><i class="bi bi-chevron-left"></i></button>
        <div class="ciit-topics-title">Topics</div>
        <div class="ciit-topics-scroll" id="ciitTopicsScroll">
            <a href="#" class="ciit-topic-link">HTML</a><a href="#" class="ciit-topic-link">CSS</a>
            <a href="#" class="ciit-topic-link disabled-topic">Bootstrap</a><a href="#" class="ciit-topic-link">JavaScript</a>
            <a href="#" class="ciit-topic-link disabled-topic">TypeScript</a><a href="#" class="ciit-topic-link disabled-topic">React</a>
            <a href="#" class="ciit-topic-link disabled-topic">Angular</a><a href="#" class="ciit-topic-link disabled-topic">Node.js</a>
            <a href="#" class="ciit-topic-link">Core Java</a><a href="#" class="ciit-topic-link">Python</a><a href="#" class="ciit-topic-link">C#</a>
            <a href="#" class="ciit-topic-link">GitHub</a><a href="#" class="ciit-topic-link">Jenkins</a>
            <a href="#" class="ciit-topic-link disabled-topic">Azure</a><a href="#" class="ciit-topic-link">AWS</a>
            <a href="#" class="ciit-topic-link disabled-topic">SQL Server</a><a href="#" class="ciit-topic-link disabled-topic">Basic Excel</a>
            <a href="#" class="ciit-topic-link disabled-topic">Advanced Excel</a><a href="#" class="ciit-topic-link disabled-topic">Power BI</a>
            <a href="#" class="ciit-topic-link disabled-topic">Tableau</a><a href="#" class="ciit-topic-link disabled-topic">NumPy</a>
            <a href="#" class="ciit-topic-link disabled-topic">Pandas</a><a href="#" class="ciit-topic-link disabled-topic">Matplotlib</a>
        </div>
        <button type="button" class="ciit-topic-arrow" id="topicsNext" aria-label="Next topics"><i class="bi bi-chevron-right"></i></button>
    </nav>

    <div class="ciit-hub-transition" id="ciitHubTransition" aria-hidden="true">
        <div class="ciit-hub-transition-orbit ciit-hub-transition-orbit-one"></div>
        <div class="ciit-hub-transition-orbit ciit-hub-transition-orbit-two"></div>
        <div class="ciit-hub-transition-content" role="status" aria-live="polite">
            <span class="ciit-hub-transition-icon"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="ciit-hub-transition-eyebrow">CIIT STACK LAB</span>
            <strong>Preparing your learning space</strong>
            <span class="ciit-hub-transition-caption">Getting your courses ready…</span>
            <span class="ciit-hub-transition-progress"><span></span></span>
        </div>
    </div>

    <main>
        @if (TempData["CoursePaymentMessage"] is string coursePaymentMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-info d-flex align-items-start gap-2" role="status">
                    <i class="bi bi-credit-card mt-1"></i>
                    <span>@coursePaymentMessage</span>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="ciit-footer">
        <div class="container"><div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
            <span>&copy; @DateTime.Now.Year - CIIT Stack Lab</span><a href="#">Privacy</a>
        </div></div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
