@model CIITStackLab.WebApp.Models.MeetRoomViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - CIIT Meet</title>
    @if (!Model.IsHost && Model.ParticipantStatus == "Pending")
    {
        <meta http-equiv="refresh" content="8" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/meet/meet-room.css" asp-append-version="true" />
</head>
<body class="ciit-meet-body">
    <div class="ciit-meet-room-page">
        <header class="ciit-meet-room-header">
            <a href="@(Model.IsHost ? Url.Action("Index", "Meet", new { area = "Admin" }) : Url.Action("Index", "Meet", new { area = "Student" }))" class="ciit-meet-room-back" aria-label="Back to meetings">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="ciit-meet-room-heading">
                <span class="ciit-meet-room-eyebrow">CIIT MEET <span class="ciit-meet-preview-tag">PREVIEW</span></span>
                <h1>@Model.Title</h1>
                <p>@Model.BatchName <span>·</span> @Model.BatchCode</p>
            </div>
            <div class="ciit-meet-room-meta">
                <span class="ciit-meet-room-status"><span class="ciit-meet-room-status-dot"></span>@Model.Status</span>
                <span class="ciit-meet-room-duration"><i class="bi bi-clock"></i> @Model.DurationMinutes min</span>
                <span class="ciit-meet-participant-count"><i class="bi bi-people-fill"></i> 1</span>
            </div>
        </header>

        @if (Model.IsHost)
        {
            <section class="ciit-meet-host-panel">
                <div class="ciit-meet-host-panel-heading">
                    <div><strong>Meeting controls</strong><span>Manage access, participants and recording</span></div>
                    <form asp-area="Admin" asp-controller="Meet" asp-action="End" method="post" onsubmit="return confirm('End this meeting for everyone?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="ciit-meet-host-danger" @(Model.Status != "Live" ? "disabled" : null)>End meeting</button>
                    </form>
                </div>
                <div class="ciit-meet-host-settings">
                    <form asp-area="Admin" asp-controller="Meet" asp-action="SetWaitingRoom" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="enabled" value="@(!Model.WaitingRoomEnabled)" />
                        <span>Waiting room <strong>@(Model.WaitingRoomEnabled ? "On" : "Off")</strong></span>
                        <button type="submit" class="ciit-meet-host-secondary">Turn @(Model.WaitingRoomEnabled ? "off" : "on")</button>
                    </form>
                    <div class="ciit-meet-recording-settings">
                        <span>Recording <strong>@Model.RecordingStatus</strong></span>
                        @if (!Model.RecordingEnabled)
                        {
                            <form asp-area="Admin" asp-controller="Meet" asp-action="SetRecording" method="post">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="action" value="enable" />
                                <button type="submit" class="ciit-meet-host-secondary">Enable</button>
                            </form>
                        }
                        else if (Model.RecordingStatus == "Recording")
                        {
                            <form asp-area="Admin" asp-controller="Meet" asp-action="SetRecording" method="post">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="action" value="stop" />
                                <button type="submit" class="ciit-meet-host-secondary">Stop recording</button>
                            </form>
                        }
                        else
                        {
                            @if (Model.RecordingStatus == "Stopped")
                            {
                                <form asp-area="Admin" asp-controller="Meet" asp-action="SetRecording" method="post" onsubmit="return confirm('Mark this recording as deleted?');">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="action" value="delete" />
                                    <button type="submit" class="ciit-meet-host-danger">Delete recording</button>
                                </form>
                            }
                            <form asp-area="Admin" asp-controller="Meet" asp-action="SetRecording" method="post">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="action" value="start" />
                                <button type="submit" class="ciit-meet-host-secondary" @(Model.Status != "Live" ? "disabled" : null)>Start recording</button>
                            </form>
                            <form asp-area="Admin" asp-controller="Meet" asp-action="SetRecording" method="post">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="action" value="disable" />
                                <button type="submit" class="ciit-meet-host-secondary">Disable</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="ciit-meet-host-participants">
                    <h2>Participants <span>@Model.Participants.Count</span></h2>
                    @if (Model.Participants.Count == 0)
                    {
                        <p>No student has requested to join yet.</p>
                    }
                    @foreach (var participant in Model.Participants)
                    {
                        <article class="ciit-meet-host-participant">
                            <div><strong>@participant.StudentName</strong><small>@participant.Status</small></div>
                            @if (participant.Status == "Pending")
                            {
                                <form asp-area="Admin" asp-controller="Meet" asp-action="ReviewParticipant" method="post">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@participant.Id" /><input type="hidden" name="decision" value="admit" />
                                    <button type="submit" class="ciit-meet-host-secondary">Admit</button>
                                </form>
                                <form asp-area="Admin" asp-controller="Meet" asp-action="ReviewParticipant" method="post">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@participant.Id" /><input type="hidden" name="decision" value="reject" />
                                    <button type="submit" class="ciit-meet-host-danger">Reject</button>
                                </form>
                            }
                            @if (participant.Status == "Admitted")
                            {
                                <form asp-area="Admin" asp-controller="Meet" asp-action="UpdateParticipantPermissions" method="post" class="ciit-meet-permission-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@participant.Id" />
                                    <label><input type="checkbox" name="canUseMicrophone" value="true" checked="@participant.CanUseMicrophone" /> Mic</label>
                                    <label><input type="checkbox" name="canUseCamera" value="true" checked="@participant.CanUseCamera" /> Camera</label>
                                    <label><input type="checkbox" name="canShareScreen" value="true" checked="@participant.CanShareScreen" /> Share</label>
                                    <button type="submit" class="ciit-meet-host-secondary">Save permissions</button>
                                </form>
                            }
                        </article>
                    }
                </div>
            </section>
        }
        else if (Model.ParticipantStatus == "Pending")
        {
            <section class="ciit-meet-waiting-screen">
                <span class="ciit-meet-waiting-icon"><i class="bi bi-hourglass-split"></i></span>
                <h2>Waiting for the host to admit you</h2>
                <p>Your join request has been sent. Keep this page open; it will update after the host admits you.</p>
                <button type="button" class="ciit-meet-host-secondary" onclick="window.location.reload()">Check admission status</button>
                <form asp-area="Student" asp-controller="Meet" asp-action="Leave" method="post">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="ciit-meet-host-danger">Cancel request</button>
                </form>
            </section>
        }
        else if (Model.ParticipantStatus == "Rejected")
        {
            <section class="ciit-meet-waiting-screen">
                <h2>Join request was declined</h2>
                <p>Please contact your admin if you believe this was a mistake.</p>
            </section>
        }
        @if (Model.IsHost || Model.ParticipantStatus == "Admitted")
        {
        <main class="ciit-meet-room-stage">
            <div class="ciit-meet-room-video-grid">
                <article class="ciit-meet-video-tile ciit-meet-video-self">
                    <div class="ciit-meet-video-placeholder">
                        <span class="ciit-meet-avatar">@(Model.IsHost ? "A" : "S")</span>
                        <strong>You</strong>
                        <small>Your camera preview will appear here</small>
                    </div>
                    <span class="ciit-meet-video-name"><i class="bi bi-mic-mute"></i> You (@(Model.IsHost ? "Host" : "Student"))</span>
                    <span class="ciit-meet-video-you">YOU</span>
                </article>
                <article class="ciit-meet-video-tile ciit-meet-video-empty">
                    <div class="ciit-meet-video-placeholder">
                        <span class="ciit-meet-avatar ciit-meet-avatar-muted"><i class="bi bi-people"></i></span>
                        <strong>Waiting for others to join</strong>
                        <small>Participants will appear here</small>
                    </div>
                </article>
            </div>

            <div class="ciit-meet-room-controls" aria-label="Meeting controls">
                <button type="button" class="ciit-meet-control" data-room-toggle="mic" aria-pressed="false">
                    <i class="bi bi-mic-mute"></i><span>Unmute</span>
                </button>
                <button type="button" class="ciit-meet-control" data-room-toggle="camera" aria-pressed="false">
                    <i class="bi bi-camera-video-off"></i><span>Start video</span>
                </button>
                <button type="button" class="ciit-meet-control" data-room-toggle="share" aria-pressed="false">
                    <i class="bi bi-display"></i><span>Share screen</span>
                </button>
                @if (Model.IsHost)
                {
                    <a class="ciit-meet-leave-button" href="@Url.Action("Index", "Meet", new { area = "Admin" })">
                        <i class="bi bi-telephone-x-fill"></i><span>Leave room</span>
                    </a>
                }
                else
                {
                    <form asp-area="Student" asp-controller="Meet" asp-action="Leave" method="post">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="ciit-meet-leave-button"><i class="bi bi-telephone-x-fill"></i><span>Leave meeting</span></button>
                    </form>
                }
            </div>
            <p class="ciit-meet-room-footnote"><i class="bi bi-info-circle"></i> Meeting interface preview · Camera, microphone and participant connections will be enabled with LiveKit.</p>
        </main>
        }
    </div>
    <script src="~/js/meet/meet-room-ui.js" asp-append-version="true"></script>
</body>
</html>
