@model CIITStackLab.WebApp.Models.MeetRoomViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - CIIT Meet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/meet/meet-room.css" asp-append-version="true" />
</head>
<body class="ciit-meet-body">
    <div class="ciit-meet-room-page">
        <header class="ciit-meet-room-header">
            <a href="@(Model.IsHost ? Url.Action("Index", "Meet", new { area = "Admin" }) : Url.Action("Details", "Meet", new { area = "Student", id = ViewData["BatchId"] }))" class="ciit-meet-room-back" aria-label="Back to meetings">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="ciit-meet-room-heading">
                <span class="ciit-meet-room-eyebrow">CIIT MEET <span class="ciit-meet-preview-tag">PREVIEW</span></span>
                <h1>@Model.Title</h1>
                <p>@Model.BatchName <span>·</span> @Model.BatchCode</p>
            </div>
            <div class="ciit-meet-room-meta">
                <span class="ciit-meet-room-status"><span class="ciit-meet-room-status-dot"></span>@Model.Status</span>
                <span class="ciit-meet-room-duration"><i class="bi bi-clock"></i> @Model.DurationMinutes min</span>
                <span class="ciit-meet-participant-count"><i class="bi bi-people-fill"></i> 1</span>
            </div>
        </header>

        <main class="ciit-meet-room-stage">
            <div class="ciit-meet-room-video-grid">
                <article class="ciit-meet-video-tile ciit-meet-video-self">
                    <div class="ciit-meet-video-placeholder">
                        <span class="ciit-meet-avatar">@(Model.IsHost ? "A" : "S")</span>
                        <strong>You</strong>
                        <small>Your camera preview will appear here</small>
                    </div>
                    <span class="ciit-meet-video-name"><i class="bi bi-mic-mute"></i> You (@(Model.IsHost ? "Host" : "Student"))</span>
                    <span class="ciit-meet-video-you">YOU</span>
                </article>
                <article class="ciit-meet-video-tile ciit-meet-video-empty">
                    <div class="ciit-meet-video-placeholder">
                        <span class="ciit-meet-avatar ciit-meet-avatar-muted"><i class="bi bi-people"></i></span>
                        <strong>Waiting for others to join</strong>
                        <small>Participants will appear here</small>
                    </div>
                </article>
            </div>

            <div class="ciit-meet-room-controls" aria-label="Meeting controls">
                <button type="button" class="ciit-meet-control" data-room-toggle="mic" aria-pressed="false">
                    <i class="bi bi-mic-mute"></i><span>Unmute</span>
                </button>
                <button type="button" class="ciit-meet-control" data-room-toggle="camera" aria-pressed="false">
                    <i class="bi bi-camera-video-off"></i><span>Start video</span>
                </button>
                <button type="button" class="ciit-meet-control" data-room-toggle="share" aria-pressed="false">
                    <i class="bi bi-display"></i><span>Share screen</span>
                </button>
                <a class="ciit-meet-leave-button" href="@(Model.IsHost ? Url.Action("Index", "Meet", new { area = "Admin" }) : Url.Action("Details", "Meet", new { area = "Student", id = ViewData["BatchId"] }))">
                    <i class="bi bi-telephone-x-fill"></i><span>Leave meeting</span>
                </a>
            </div>
            <p class="ciit-meet-room-footnote"><i class="bi bi-info-circle"></i> Meeting interface preview · Camera, microphone and participant connections will be enabled with LiveKit.</p>
        </main>
    </div>
    <script src="~/js/meet/meet-room-ui.js" asp-append-version="true"></script>
</body>
</html>
