@model CIITStackLab.Application.DTOs.CourseDetailsDto

@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-payment-modal.css" />
}

<section class="ciit-course-details-section">
    <div class="container">
        <div class="ciit-course-details-card">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <div class="ciit-course-details-image">
                        <img src="@Model.ImageUrl" alt="@Model.Title" />
                    </div>
                </div>

                <div class="col-lg-7">
                    <span class="ciit-course-details-badge">@Model.Category</span>
                    <h1 class="ciit-course-details-title">@Model.Title</h1>
                    <p class="ciit-course-details-summary">@Model.ShortDescription</p>
                    <p class="ciit-course-details-description">@Model.Description</p>

                    <div class="ciit-course-meta-row">
                        <div><strong>@Model.Level</strong><span>Level</span></div>
                        <div><strong>@Model.DurationHours hrs</strong><span>Duration</span></div>
                        <div><strong>@Model.Topics.Count</strong><span>Topics</span></div>
                    </div>

                    <div class="ciit-course-price-card">
                        <span>Course price</span>
                        @if (Model.TotalPrice <= 0m)
                        {
                            <strong>Free</strong>
                            <small>Immediate access</small>
                        }
                        else
                        {
                            <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                            <small>Topic prices combined</small>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4 align-items-center">
                        @if (Model.TotalPrice <= 0m)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-id="@Model.Id"
                               class="btn btn-primary btn-lg">
                                <i class="bi bi-play-circle me-2"></i>Start Learning
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-primary btn-lg"
                                    data-bs-toggle="modal"
                                    data-bs-target="#coursePaymentModal">
                                <i class="bi bi-credit-card me-2"></i>Start Tutorial
                            </button>
                        }

                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="tutorials"
                           class="btn btn-outline-dark btn-lg">
                            Back to Courses
                        </a>
                    </div>

                    @if (User.Identity?.IsAuthenticated != true && Model.TotalPrice > 0m)
                    {
                        <small class="text-secondary d-block mt-2">
                            Sign in before completing payment for this course.
                        </small>
                    }
                </div>
            </div>
        </div>

        @if (Model.TotalPrice > 0m)
        {
            <div class="modal fade ciit-payment-modal"
                 id="coursePaymentModal"
                 tabindex="-1"
                 aria-labelledby="coursePaymentModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <div>
                                <span class="ciit-payment-modal-eyebrow">Secure checkout</span>
                                <h2 class="modal-title" id="coursePaymentModalLabel">Complete your purchase</h2>
                                <p class="ciit-payment-modal-subtitle">Review the course and continue to secure payment.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body pt-0">
                            <div class="ciit-payment-course-summary">
                                <img src="@Model.ImageUrl" alt="@Model.Title" />
                                <div>
                                    <span>@Model.Category</span>
                                    <h3>@Model.Title</h3>
                                    <p>@Model.ShortDescription</p>
                                    <div class="ciit-payment-course-meta">
                                        <span><i class="bi bi-bar-chart"></i>@Model.Level</span>
                                        <span><i class="bi bi-clock"></i>@Model.DurationHours hrs</span>
                                        <span><i class="bi bi-collection-play"></i>@Model.Topics.Count topics</span>
                                    </div>
                                </div>
                            </div>

                            <div class="ciit-payment-order-box">
                                <div>
                                    <span>Course price</span>
                                    <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                                </div>
                                <div class="ciit-payment-order-total">
                                    <span>Total payable</span>
                                    <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                                </div>
                            </div>

                            <div class="ciit-payment-method-box">
                                <div class="ciit-payment-section-heading">
                                    <div>
                                        <span>Payment method</span>
                                        <strong>Choose how you want to pay</strong>
                                    </div>
                                    <i class="bi bi-shield-check"></i>
                                </div>

                                <div class="ciit-payment-methods" role="radiogroup" aria-label="Payment method">
                                    <label class="ciit-payment-method">
                                        <input type="radio" name="paymentMethod" value="upi" checked />
                                        <span class="ciit-payment-method-icon"><i class="bi bi-phone"></i></span>
                                        <span>
                                            <strong>UPI</strong>
                                            <small>Google Pay, PhonePe, Paytm and more</small>
                                        </span>
                                        <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                    </label>

                                    <label class="ciit-payment-method">
                                        <input type="radio" name="paymentMethod" value="card" />
                                        <span class="ciit-payment-method-icon"><i class="bi bi-credit-card"></i></span>
                                        <span>
                                            <strong>Card</strong>
                                            <small>Credit or debit card</small>
                                        </span>
                                        <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                    </label>

                                    <label class="ciit-payment-method">
                                        <input type="radio" name="paymentMethod" value="netbanking" />
                                        <span class="ciit-payment-method-icon"><i class="bi bi-bank"></i></span>
                                        <span>
                                            <strong>Net banking</strong>
                                            <small>Pay directly through your bank</small>
                                        </span>
                                        <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                    </label>
                                </div>
                            </div>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Courses"
                                   asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-primary btn-lg w-100 ciit-payment-pay-button">
                                    <i class="bi bi-play-circle me-2"></i>
                                    Pay ₹@Model.TotalPrice.ToString("N2") (Demo)
                                </a>
                                <p class="ciit-payment-modal-note">
                                    Demo mode: no real payment is processed. This button only lets you preview the learning flow.
                                </p>
                            }
                            else
                            {
                                <a asp-controller="Account"
                                   asp-action="Login"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                   class="btn btn-primary btn-lg w-100 ciit-payment-pay-button">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Sign in to continue
                                </a>
                                <p class="ciit-payment-modal-note">
                                    Your course purchase must be linked to your signed-in student account.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div id="course-roadmap" class="ciit-course-outline-card mt-4">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="mb-1">Course Roadmap</h2>
                    <p class="text-secondary mb-0">Explore notes, learning content and assessments by topic.</p>
                </div>
                <span class="badge rounded-pill text-bg-light border">@Model.Topics.Count Topics</span>
            </div>

            @if (Model.Topics.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No active topics have been mapped to this course yet.
                </div>
            }
            else
            {
                <div class="accordion" id="courseTopicsAccordion">
                    @foreach (var topic in Model.Topics)
                    {
                        var headingId = $"heading-{topic.Id}";
                        var collapseId = $"collapse-{topic.Id}";

                        <div class="accordion-item">
                            <h3 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    <span class="fw-semibold">@topic.Title</span>
                                    <span class="ms-auto me-3 text-secondary small">
                                        @topic.Contents.Count lesson@(topic.Contents.Count == 1 ? "" : "s")
                                    </span>
                                </button>
                            </h3>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#courseTopicsAccordion">
                                <div class="accordion-body">
                                    @if (topic.Contents.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">No active content is available for this topic yet.</p>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var content in topic.Contents)
                                            {
                                                <article class="ciit-content-item">
                                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                                        <div>
                                                            <div class="fw-semibold ciit-roadmap-content-title">@content.Title</div>
                                                        </div>

                                                        <div class="ciit-roadmap-badges" aria-label="Available learning resources">
                                                            @if (topic.HasNotes)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-notes">
                                                                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                                                                    Notes
                                                                </span>
                                                            }
                                                            <span class="ciit-roadmap-badge ciit-roadmap-badge-content">
                                                                <i class="bi bi-play-circle" aria-hidden="true"></i>
                                                                Content
                                                            </span>
                                                            @if (content.Questions.Count > 0)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                                                    <i class="bi bi-patch-check" aria-hidden="true"></i>
                                                                    Assessment
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    @if (content.Questions.Count > 0)
                                                    {
                                                        <div class="ciit-assessment-launch">
                                                            <div class="ciit-assessment-launch-copy">
                                                                <span class="ciit-assessment-launch-icon">
                                                                    <i class="bi bi-patch-check"></i>
                                                                </span>
                                                                <div>
                                                                    <strong>Knowledge check</strong>
                                                                    <small>@content.Questions.Count question@(content.Questions.Count == 1 ? "" : "s") · Server-graded assessment</small>
                                                                </div>
                                                            </div>

                                                            <a asp-controller="Courses"
                                                               asp-action="Learn"
                                                               asp-route-id="@Model.Id"
                                                               asp-route-contentId="@content.Id"
                                                               asp-fragment="lesson-assessment"
                                                               class="btn btn-outline-primary ciit-assessment-launch-button">
                                                                Practice assessment
                                                                <i class="bi bi-arrow-up-right ms-1"></i>
                                                            </a>
                                                        </div>
                                                    }
                                                </article>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
