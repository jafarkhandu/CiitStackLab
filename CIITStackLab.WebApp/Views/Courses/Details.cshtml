@model CIITStackLab.Application.DTOs.CourseDetailsDto

@{
    ViewData["Title"] = Model.Title;
}

<section class="ciit-course-details-section">
    <div class="container">
        <div class="ciit-course-details-card">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <div class="ciit-course-details-image">
                        <img src="@Model.ImageUrl" alt="@Model.Title" />
                    </div>
                </div>

                <div class="col-lg-7">
                    <span class="ciit-course-details-badge">@Model.Category</span>
                    <h1 class="ciit-course-details-title">@Model.Title</h1>
                    <p class="ciit-course-details-summary">@Model.ShortDescription</p>
                    <p class="ciit-course-details-description">@Model.Description</p>

                    <div class="ciit-course-meta-row">
                        <div><strong>@Model.Level</strong><span>Level</span></div>
                        <div><strong>@Model.DurationHours hrs</strong><span>Duration</span></div>
                        <div><strong>@Model.Topics.Count</strong><span>Topics</span></div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a asp-controller="Courses"
                           asp-action="Learn"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary btn-lg">
                            Start Learning
                        </a>
                        <a asp-controller="Home" asp-action="Index" asp-fragment="tutorials" class="btn btn-outline-dark btn-lg">
                            Back to Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div id="course-roadmap" class="ciit-course-outline-card mt-4">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="mb-1">Course Roadmap</h2>
                    <p class="text-secondary mb-0">Explore notes, learning content and assessments by topic.</p>
                </div>
                <span class="badge rounded-pill text-bg-light border">@Model.Topics.Count Topics</span>
            </div>

            @if (Model.Topics.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No active topics have been mapped to this course yet.
                </div>
            }
            else
            {
                <div class="accordion" id="courseTopicsAccordion">
                    @foreach (var topic in Model.Topics)
                    {
                        var headingId = $"heading-{topic.Id}";
                        var collapseId = $"collapse-{topic.Id}";

                        <div class="accordion-item">
                            <h3 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    <span class="fw-semibold">@topic.Title</span>
                                    <span class="ms-auto me-3 text-secondary small">
                                        @topic.Contents.Count lesson@(topic.Contents.Count == 1 ? "" : "s")
                                    </span>
                                </button>
                            </h3>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#courseTopicsAccordion">
                                <div class="accordion-body">
                                    @if (topic.Contents.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">No active content is available for this topic yet.</p>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var content in topic.Contents)
                                            {
                                                <article class="ciit-content-item">
                                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                                        <div>
                                                            <div class="fw-semibold ciit-roadmap-content-title">@content.Title</div>
                                                        </div>

                                                        <div class="ciit-roadmap-badges" aria-label="Available learning resources">
                                                            @if (topic.HasNotes)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-notes">
                                                                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                                                                    Notes
                                                                </span>
                                                            }
                                                            <span class="ciit-roadmap-badge ciit-roadmap-badge-content">
                                                                <i class="bi bi-play-circle" aria-hidden="true"></i>
                                                                Content
                                                            </span>
                                                            @if (content.Questions.Count > 0)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                                                    <i class="bi bi-patch-check" aria-hidden="true"></i>
                                                                    Assessment
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    @if (content.Questions.Count > 0)
                                                    {
                                                        <div class="ciit-mcq-panel" data-mcq-panel>
                                                            <div class="ciit-mcq-header">
                                                                <div>
                                                                    <span class="ciit-mcq-kicker">
                                                                        <i class="bi bi-patch-question-fill me-1"></i> Knowledge Check
                                                                    </span>
                                                                    <h4>@content.Questions.Count MCQ@(content.Questions.Count == 1 ? "" : "s")</h4>
                                                                </div>
                                                                <span class="ciit-mcq-progress" data-mcq-progress>
                                                                    0 / @content.Questions.Count
                                                                </span>
                                                            </div>

                                                            @for (var questionIndex = 0; questionIndex < content.Questions.Count; questionIndex++)
                                                            {
                                                                var question = content.Questions[questionIndex];
                                                                var questionId = $"mcq-{content.Id}-{question.Id}";

                                                                <div class="ciit-mcq-question" data-mcq-question data-correct-option="@question.CorrectOptionNumber">
                                                                    <div class="ciit-mcq-question-title">
                                                                        <span>@(questionIndex + 1)</span>
                                                                        <p>@question.Question</p>
                                                                    </div>

                                                                    <div class="ciit-mcq-options">
                                                                        @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                                                                        {
                                                                            var optionNumber = optionIndex + 1;
                                                                            var optionValue = question.Options[optionIndex];

                                                                            if (!string.IsNullOrWhiteSpace(optionValue))
                                                                            {
                                                                                var inputId = $"{questionId}-option-{optionNumber}";

                                                                                <label class="ciit-mcq-option" for="@inputId" data-option-label>
                                                                                    <input id="@inputId"
                                                                                           type="radio"
                                                                                           name="@questionId"
                                                                                           value="@optionNumber"
                                                                                           data-mcq-option />
                                                                                    <span class="ciit-mcq-option-marker">@((char)('A' + optionIndex))</span>
                                                                                    <span class="ciit-mcq-option-text">@optionValue</span>
                                                                                    <i class="bi bi-check-lg ciit-mcq-option-icon"></i>
                                                                                </label>
                                                                            }
                                                                        }
                                                                    </div>

                                                                    <div class="ciit-mcq-feedback" data-mcq-feedback aria-live="polite"></div>
                                                                </div>
                                                            }

                                                            <div class="ciit-mcq-actions">
                                                                <span class="ciit-mcq-result" data-mcq-result></span>
                                                                <button type="button" class="btn btn-primary ciit-mcq-check" data-mcq-check>
                                                                    <i class="bi bi-check2-circle me-1"></i>Check Answers
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary ciit-mcq-reset" data-mcq-reset>
                                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Try Again
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </article>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const initializeMcqPanel = (panel) => {
        const questions = [...panel.querySelectorAll('[data-mcq-question]')];
        const checkButton = panel.querySelector('[data-mcq-check]');
        const resetButton = panel.querySelector('[data-mcq-reset]');
        const result = panel.querySelector('[data-mcq-result]');
        const progress = panel.querySelector('[data-mcq-progress]');

        if (!questions.length || !checkButton || !resetButton) {
            return;
        }

        const clearQuestionState = (question) => {
            question.classList.remove('is-correct', 'is-wrong');
            question.querySelectorAll('[data-option-label]').forEach(label => {
                label.classList.remove('is-correct-option', 'is-wrong-option');
            });
            const feedback = question.querySelector('[data-mcq-feedback]');
            if (feedback) {
                feedback.textContent = '';
                feedback.className = 'ciit-mcq-feedback';
            }
        };

        const updateProgress = () => {
            const answered = questions.filter(question =>
                question.querySelector('input[type="radio"]:checked')
            ).length;

            if (progress) {
                progress.textContent = answered + ' / ' + questions.length;
            }
        };

        panel.addEventListener('change', updateProgress);

        checkButton.addEventListener('click', () => {
            let score = 0;
            let unanswered = 0;

            questions.forEach(question => {
                clearQuestionState(question);

                const correctOption = Number(question.dataset.correctOption);
                const selectedInput = question.querySelector('input[type="radio"]:checked');
                const feedback = question.querySelector('[data-mcq-feedback]');
                const optionLabels = [...question.querySelectorAll('[data-option-label]')];

                optionLabels.forEach(label => {
                    const input = label.querySelector('input[type="radio"]');
                    if (Number(input.value) === correctOption) {
                        label.classList.add('is-correct-option');
                    }
                });

                if (!selectedInput) {
                    unanswered++;
                    question.classList.add('is-wrong');

                    if (feedback) {
                        feedback.classList.add('is-wrong');
                        feedback.textContent = 'Choose an option to answer this question.';
                    }
                    return;
                }

                const selectedOption = Number(selectedInput.value);
                const selectedLabel = selectedInput.closest('[data-option-label]');

                if (selectedOption === correctOption) {
                    score++;
                    question.classList.add('is-correct');

                    if (feedback) {
                        feedback.classList.add('is-correct');
                        feedback.textContent = 'Correct answer.';
                    }
                } else {
                    question.classList.add('is-wrong');

                    if (selectedLabel) {
                        selectedLabel.classList.add('is-wrong-option');
                    }

                    if (feedback) {
                        feedback.classList.add('is-wrong');
                        feedback.textContent = 'Not quite. The correct option is highlighted above.';
                    }
                }
            });

            result.textContent = score + ' / ' + questions.length + ' correct'
                + (unanswered ? ' • ' + unanswered + ' unanswered' : '');

            result.classList.add('is-visible');
        });

        resetButton.addEventListener('click', () => {
            questions.forEach(question => {
                clearQuestionState(question);
                question.querySelectorAll('input[type="radio"]').forEach(input => {
                    input.checked = false;
                });
            });

            if (result) {
                result.textContent = '';
                result.classList.remove('is-visible');
            }

            updateProgress();
        });
    };

    document.querySelectorAll('[data-mcq-panel]').forEach(initializeMcqPanel);
})();
</script>
}
