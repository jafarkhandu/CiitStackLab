@model CIITStackLab.Application.DTOs.CourseLearningDto

@{
    Layout = "_CourseLayout";

    ViewData["Title"] = $"{Model.Title} - Course Home";
    ViewData["CourseTitle"] = Model.Title;

    var progress = Model.Progress;
    var percentage = progress?.Percentage ?? 0;
    var totalLessons = progress?.TotalLessons ?? Model.ContentCount;
    var completedLessons = progress?.CompletedLessons ?? 0;
    var orderedLessons = Model.Topics
        .SelectMany(topic => topic.Contents)
        .ToList();
    var firstLesson = orderedLessons.FirstOrDefault();
    var completedContentIds = progress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var hasStartedLearning = completedContentIds.Count > 0;
    var lastAccessedLesson = progress?.LastAccessedContentId is int lastAccessedId
        ? orderedLessons.FirstOrDefault(lesson => lesson.Id == lastAccessedId)
        : null;
    var lastAccessedLessonIsIncomplete = lastAccessedLesson is not null
        && !completedContentIds.Contains(lastAccessedLesson.Id);
    var continueLesson = lastAccessedLessonIsIncomplete
        ? lastAccessedLesson
        : orderedLessons.FirstOrDefault(lesson => !completedContentIds.Contains(lesson.Id));
    var continueTopic = continueLesson is null
        ? Model.Topics.FirstOrDefault(topic => topic.Contents.Count == 0 && topic.Chapters.Count > 0)
            ?? Model.Topics.FirstOrDefault(topic => topic.Chapters.Count > 0)
        : null;
    var continueContentId = continueLesson?.Id
        ?? (!hasStartedLearning ? firstLesson?.Id : null);
    var continueTopicId = continueContentId.HasValue ? null : continueTopic?.Id;
    var totalTopicDurationMinutes = Model.Topics.Sum(topic => topic.DurationMinutes ?? 0);
    var totalDurationHours = totalTopicDurationMinutes / 60m;
    var totalChapters = Model.Topics.Sum(topic => topic.Chapters.Count);
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-experience.css" asp-append-version="true" />
}

<section class="ciit-course-experience">
    <div class="container-fluid px-3 px-lg-4">
        <main class="ciit-course-experience-main">
            <section class="ciit-course-experience-card ciit-course-experience-hero">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img class="ciit-course-hero-image"
                         src="@Model.ImageUrl"
                         alt="@Model.Title course cover"
                         loading="eager" />
                }
                <div class="ciit-course-hero-overlay" aria-hidden="true"></div>

                <div class="ciit-course-hero-content">
                    <span class="ciit-course-experience-eyebrow">Course access active</span>
                    <h1>Welcome to @Model.Title</h1>
                    <p>@(string.IsNullOrWhiteSpace(Model.ShortDescription) ? "Build your skills through a structured, hands-on learning path." : Model.ShortDescription)</p>
                    <div class="ciit-course-hero-actions">
                        <a class="btn btn-light fw-semibold"
                           asp-controller="Courses"
                           asp-action="Learn"
                           asp-route-id="@Model.Id"
                           asp-route-contentId="@continueContentId"
                           asp-route-topicId="@continueTopicId">
                            <i class="bi bi-play-fill me-1"></i>
                            @(hasStartedLearning ? "Continue Learning" : "Start Learning")
                        </a>
                        <span class="ciit-course-access-badge">
                            <i class="bi bi-check-circle-fill"></i>
                            Access Active
                        </span>
                    </div>
                </div>
            </section>

            <section class="ciit-course-stat-grid" aria-label="Course summary">
                <div class="ciit-course-stat">
                    <strong>@totalChapters</strong>
                    <span>Chapters</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@Model.TopicCount</strong>
                    <span>Topics</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@Model.Level</strong>
                    <span>Level</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@totalDurationHours.ToString("0.##") hrs</strong>
                    <span>Duration</span>
                </div>
            </section>

            <section id="course-progress" class="ciit-course-experience-card">
                <div class="ciit-course-experience-card-header">
                    <div>
                        <h2>Your Progress</h2>
                        <p>Track your learning progress and continue from where you left off.</p>
                    </div>
                    <strong>@percentage%</strong>
                </div>
                <div class="ciit-progress-track"
                     role="progressbar"
                     aria-label="Course progress"
                     aria-valuenow="@percentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <span style="width: @percentage%"></span>
                </div>
                <div class="ciit-progress-meta">
                    <span>@completedLessons of @totalLessons learning resources completed</span>
                    <span>@Model.TopicCount topics</span>
                </div>
            </section>

            <section class="ciit-course-experience-card ciit-course-curriculum-section">
                <div class="ciit-course-experience-card-header">
                    <div>
                        <h2>Course Curriculum</h2>
                        <p>Open a topic to view its chapters and learning resources without leaving your course home.</p>
                    </div>
                    <span class="ciit-curriculum-summary">
                        <i class="bi bi-journal-check"></i>
                        @totalChapters Chapters · @Model.TopicCount Topics
                    </span>
                </div>

                @if (Model.Topics.Count == 0)
                {
                    <div class="ciit-curriculum-empty">No active chapters are available for this course yet.</div>
                }
                else
                {
                    <div class="ciit-course-curriculum-list">
                        @foreach (var topic in Model.Topics)
                        {
                            var topicKey = $"course-topic-{topic.Id}";
                            var topicCompleted = topic.Contents.Count > 0
                                && topic.Contents.All(content => completedContentIds.Contains(content.Id));

                            <div class="ciit-curriculum-accordion" data-curriculum-item>
                                <button type="button"
                                        class="ciit-curriculum-topic-toggle"
                                        aria-expanded="false"
                                        aria-controls="@topicKey">
                                    <span class="ciit-curriculum-topic-toggle-content">
                                        <span class="ciit-curriculum-topic-icon">
                                            <i class="bi bi-collection"></i>
                                        </span>
                                        <span class="@(topicCompleted ? "is-completed" : "")">
                                            <strong>@topic.Title</strong>
                                            <small>@topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")</small>
                                            @if (topicCompleted)
                                            {
                                                <span class="ciit-curriculum-topic-completed" title="Topic completed" aria-label="Topic completed">
                                                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                                </span>
                                            }
                                        </span>
                                    </span>
                                    <span class="ciit-curriculum-topic-toggle-end">
                                        <span class="ciit-curriculum-topic-status">Expand</span>
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </span>
                                </button>

                                                                <div id="@topicKey" class="ciit-curriculum-topic-panel" hidden>
                                    <div class="ciit-curriculum-topic-panel-inner">
                                        @if (topic.Chapters.Count == 0 && topic.Contents.Count == 0)
                                        {
                                            <div class="ciit-curriculum-empty">No learning resources are linked to this topic yet.</div>
                                        }
                                        else
                                        {
                                            @foreach (var chapter in topic.Chapters)
                                            {
                                                <section class="ciit-curriculum-chapter-map">
                                                    <div class="ciit-curriculum-chapter-map-heading">
                                                        <span class="ciit-curriculum-lesson-number">@chapter.SortOrder</span>
                                                        <div><strong>@chapter.Title</strong><small>Chapter learning map</small></div>
                                                    </div>
                                                    <div class="ciit-curriculum-resource-map">
                                                        @if (!string.IsNullOrWhiteSpace(chapter.NotesHtml)) { <span class="ciit-curriculum-resource-chip"><i class="bi bi-journal-text"></i> Notes</span> }
                                                        @if (chapter.Contents.Count > 0)
                                                        {
                                                            <div class="ciit-curriculum-resource-group">
                                                                <span class="ciit-curriculum-resource-chip"><i class="bi bi-play-btn"></i> Content (@chapter.Contents.Count)</span>
                                                                @foreach (var resource in chapter.Contents)
                                                                {
                                                                    <p class="ciit-curriculum-resource-detail">@resource.Title@if (!string.IsNullOrWhiteSpace(resource.VideoName)) { <span> · Video</span> }@if (!string.IsNullOrWhiteSpace(resource.Slides)) { <span> · Slides</span> }</p>
                                                                }
                                                            </div>
                                                        }
                                                        @if (chapter.Questions.Count > 0) { <span class="ciit-curriculum-resource-chip"><i class="bi bi-ui-checks-grid"></i> MCQs (@chapter.Questions.Count)</span> }
                                                        @if (chapter.InterviewQuestions.Count > 0) { <span class="ciit-curriculum-resource-chip"><i class="bi bi-chat-square-text"></i> Interview Questions (@chapter.InterviewQuestions.Count)</span> }
                                                        @if (chapter.PracticeQuestions.Count > 0) { <span class="ciit-curriculum-resource-chip"><i class="bi bi-code-square"></i> Practice Programs (@chapter.PracticeQuestions.Count)</span> }
                                                        @if (string.IsNullOrWhiteSpace(chapter.NotesHtml) && chapter.Contents.Count == 0 && chapter.Questions.Count == 0 && chapter.InterviewQuestions.Count == 0 && chapter.PracticeQuestions.Count == 0)
                                                        { <p class="ciit-curriculum-empty">No resources are linked to this chapter yet.</p> }
                                                    </div>
                                                </section>
                                            }
                                            @if (topic.Chapters.Count == 0 && topic.Contents.Count > 0)
                                            {
                                                <section class="ciit-curriculum-chapter-map"><div class="ciit-curriculum-chapter-map-heading"><strong>Learning content</strong></div>
                                                    @foreach (var resource in topic.Contents) { <p class="ciit-curriculum-resource-detail">@resource.Title</p> }
                                                </section>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

        </main>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-curriculum-item]').forEach(function (item) {
            const toggle = item.querySelector('.ciit-curriculum-topic-toggle');
            const panel = item.querySelector('.ciit-curriculum-topic-panel');
            const status = item.querySelector('.ciit-curriculum-topic-status');
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (!toggle || !panel) {
                return;
            }

            toggle.addEventListener('click', function () {
                const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
                const shouldExpand = !isExpanded;

                toggle.setAttribute('aria-expanded', String(shouldExpand));
                item.classList.toggle('is-expanded', shouldExpand);
                if (status) {
                    status.textContent = shouldExpand ? 'Collapse' : 'Expand';
                }

                if (reduceMotion) {
                    panel.hidden = !shouldExpand;
                    panel.style.maxHeight = shouldExpand ? 'none' : '';
                    return;
                }

                if (shouldExpand) {
                    panel.hidden = false;
                    panel.style.maxHeight = '0px';
                    requestAnimationFrame(function () {
                        panel.style.maxHeight = panel.scrollHeight + 'px';
                    });

                    panel.addEventListener('transitionend', function handleExpand(event) {
                        if (event.propertyName !== 'max-height') {
                            return;
                        }
                        panel.style.maxHeight = 'none';
                        panel.removeEventListener('transitionend', handleExpand);
                    });
                }
                else {
                    panel.style.maxHeight = panel.scrollHeight + 'px';
                    requestAnimationFrame(function () {
                        panel.style.maxHeight = '0px';
                    });

                    panel.addEventListener('transitionend', function handleCollapse(event) {
                        if (event.propertyName !== 'max-height') {
                            return;
                        }
                        panel.hidden = true;
                        panel.style.maxHeight = '';
                        panel.removeEventListener('transitionend', handleCollapse);
                    });
                }
            });
        });
    </script>
}
