@model CIITStackLab.Application.DTOs.CourseLearningDto

@{
    ViewData["Title"] = $"{Model.Title} - Curriculum";
    ViewData["CourseTitle"] = Model.Title;

    var progress = Model.Progress;
    var completedIds = progress?.CompletedContentIds ?? Array.Empty<int>();
    var lessonNumber = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-experience.css" asp-append-version="true" />
}

<section class="ciit-course-experience">
    <div class="container">
        <div class="ciit-course-experience-shell">
            <aside class="ciit-course-experience-sidebar" aria-label="Course navigation">
                <div class="ciit-course-experience-brand">
                    <small>Course</small>
                    <strong>@Model.Title</strong>
                </div>

                <nav class="ciit-course-experience-nav">
                    <a asp-controller="Courses" asp-action="CourseHome" asp-route-id="@Model.Id">
                        <i class="bi bi-house"></i> Course Home
                    </a>
                    <a class="active" asp-controller="Courses" asp-action="Curriculum" asp-route-id="@Model.Id">
                        <i class="bi bi-list-check"></i> Curriculum
                    </a>
                    <a asp-controller="Courses" asp-action="Learn" asp-route-id="@Model.Id" asp-route-contentId="@progress?.LastAccessedContentId">
                        <i class="bi bi-play-circle"></i> Continue Learning
                    </a>
                    <a asp-controller="Courses" asp-action="CourseHome" asp-route-id="@Model.Id" asp-fragment="course-progress">
                        <i class="bi bi-graph-up"></i> My Progress
                    </a>
                </nav>
            </aside>

            <main class="ciit-course-experience-main">
                <section class="ciit-course-experience-card ciit-course-experience-hero">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img class="ciit-course-hero-image"
                             src="@Model.ImageUrl"
                             alt="@Model.Title course cover"
                             loading="eager" />
                    }
                    <div class="ciit-course-hero-overlay" aria-hidden="true"></div>
                    <div class="ciit-course-hero-content">
                        <span class="ciit-course-experience-eyebrow">Course curriculum</span>
                        <h1>@Model.Title</h1>
                        <p>Follow the complete learning path, track completed lessons, and open any lesson without leaving the course environment.</p>
                        <span class="ciit-course-access-badge">
                            <i class="bi bi-journal-check"></i>
                            @Model.ContentCount Lessons · @Model.TopicCount Topics
                        </span>
                    </div>
                </section>

                <section class="ciit-course-experience-card">
                    <div class="ciit-course-experience-card-header">
                        <div>
                            <h2>Course Curriculum</h2>
                            <p>Lessons are grouped by topic for a clear learning path.</p>
                        </div>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-controller="Courses"
                           asp-action="CourseHome"
                           asp-route-id="@Model.Id">
                            Course Home
                        </a>
                    </div>

                    @if (Model.Topics.Count == 0)
                    {
                        <div class="ciit-curriculum-empty">No active lessons are available for this course yet.</div>
                    }
                    else
                    {
                        @foreach (var topic in Model.Topics)
                        {
                            <section class="ciit-curriculum-topic">
                                <div class="ciit-curriculum-topic-header">
                                    <strong>@topic.Title</strong>
                                    <span>@topic.Contents.Count lessons</span>
                                </div>

                                @if (topic.Contents.Count == 0)
                                {
                                    <div class="ciit-curriculum-empty">No lessons are available in this topic yet.</div>
                                }
                                else
                                {
                                    @foreach (var lesson in topic.Contents)
                                    {
                                        lessonNumber++;
                                        var completed = completedIds.Contains(lesson.Id);

                                        <div class="ciit-curriculum-lesson">
                                            <div class="ciit-curriculum-lesson-title">
                                                <span class="ciit-curriculum-lesson-number">@lessonNumber.ToString("00")</span>
                                                <div>
                                                    <strong>@lesson.Title</strong>
                                                    <small>
                                                        @if (completed)
                                                        {
                                                            <span>Completed</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Ready to learn</span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>

                                            <a class="btn @(completed ? "btn-outline-primary" : "btn-primary") btn-sm"
                                               asp-controller="Courses"
                                               asp-action="Learn"
                                               asp-route-id="@Model.Id"
                                               asp-route-contentId="@lesson.Id">
                                                @(completed ? "Review" : "Start")
                                                <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    }
                                }
                            </section>
                        }
                    }
                </section>
            </main>
        </div>
    </div>
</section>
