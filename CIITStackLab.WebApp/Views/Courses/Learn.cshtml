@model CIITStackLab.Application.DTOs.CourseLearningDto

@{
    ViewData["Title"] = $"Learn — {Model.Title}";

    var orderedContents = Model.Topics
        .SelectMany(topic => topic.Contents.Select(content => new
        {
            Topic = topic,
            Content = content
        }))
        .ToList();

    var currentIndex = Model.CurrentContentId.HasValue
        ? orderedContents.FindIndex(x => x.Content.Id == Model.CurrentContentId.Value)
        : 0;

    if (currentIndex < 0)
    {
        currentIndex = 0;
    }

    var currentItem = orderedContents.ElementAtOrDefault(currentIndex);
    var currentContent = currentItem?.Content;
    var learningProgress = Model.Progress;
    var previousItem = currentIndex > 0 ? orderedContents[currentIndex - 1] : null;
    var nextItem = currentIndex < orderedContents.Count - 1
        ? orderedContents.ElementAtOrDefault(currentIndex + 1)
        : null;

    string ResolveResourceUrl(string? value, string folder)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var resource = value.Trim().Replace('\\', '/');

        if (Uri.TryCreate(resource, UriKind.Absolute, out var absoluteUri)
            && (absoluteUri.Scheme == Uri.UriSchemeHttp
                || absoluteUri.Scheme == Uri.UriSchemeHttps))
        {
            return resource;
        }

        if (resource.StartsWith("~/", StringComparison.Ordinal))
        {
            return resource[1..];
        }

        if (resource.StartsWith("/", StringComparison.Ordinal))
        {
            return resource;
        }

        if (resource.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + resource;
        }

        return $"/uploads/{folder}/{Uri.EscapeDataString(System.IO.Path.GetFileName(resource))}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-learning.css" asp-append-version="true" />
}

@if (currentContent is null)
{
    <main class="ciit-learning-empty container py-5">
        <div class="ciit-learning-empty-card text-center">
            <span class="ciit-learning-eyebrow">COURSE MATERIAL</span>
            <h1>Learning content is not available yet</h1>
            <p>This course does not have any active lessons at the moment.</p>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-arrow-left me-2"></i>Back to Course
            </a>
        </div>
    </main>
}
else
{
    <section class="ciit-learning-page">
        <header class="ciit-learning-header">
            <div class="container">
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="ciit-learning-back-link">
                    <i class="bi bi-arrow-left"></i>
                    <span>Course Overview</span>
                </a>

                <div class="ciit-learning-header-row">
                    <div class="ciit-learning-course-intro">
                        <div class="ciit-learning-pills">
                            <span class="ciit-learning-badge">@Model.Category</span>
                            <span class="ciit-learning-meta-pill">@Model.Level</span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-clock me-1"></i>@Model.DurationHours hrs
                            </span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-play-circle me-1"></i>@Model.ContentCount lessons
                            </span>
                        </div>

                        <h1>@Model.Title</h1>
                        <p>@Model.ShortDescription</p>

                        @if (User.IsInRole("Student") && learningProgress is not null)
                        {
                            <div class="ciit-learning-course-progress"
                                 role="group"
                                 aria-label="Course completion progress">
                                <div class="ciit-learning-course-progress-heading">
                                    <span><i class="bi bi-graph-up-arrow me-2"></i>Your progress</span>
                                    <strong>@learningProgress.Percentage%</strong>
                                </div>
                                <div class="progress ciit-learning-course-progress-track"
                                     role="progressbar"
                                     aria-label="Course completion"
                                     aria-valuenow="@learningProgress.Percentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar"
                                         style="width: @learningProgress.Percentage%"></div>
                                </div>
                                <small>@learningProgress.CompletedLessons of @learningProgress.TotalLessons lessons completed</small>
                            </div>
                        }
                    </div>

                    <div class="ciit-learning-price-card">
                        <span>Course value</span>
                        <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                        <small><i class="bi bi-journal-check me-1"></i>Learn at your own pace</small>
                    </div>
                </div>
            </div>
        </header>

        <div class="container ciit-learning-shell">
            <aside class="ciit-learning-sidebar" aria-label="Course chapters and resources">
                <div class="ciit-learning-sidebar-head">
                    <div>
                        <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
                        <h2>Chapters &amp; Resources</h2>
                    </div>
                    <span class="ciit-learning-count">@Model.ContentCount</span>
                </div>

                <div class="ciit-learning-sidebar-scroll">
                    @foreach (var topic in Model.Topics)
                    {
                        var chapterContentIds = topic.Chapters
                            .SelectMany(chapter => chapter.Contents)
                            .Select(content => content.Id)
                            .ToHashSet();

                        var additionalContents = topic.Contents
                            .Where(content => !chapterContentIds.Contains(content.Id))
                            .ToList();

                        var topicHasCurrentContent = topic.Contents.Any(
                            content => content.Id == currentContent.Id);

                        var completedTopicLessons = learningProgress is null
                            ? 0
                            : topic.Contents.Count(content =>
                                learningProgress.CompletedContentIds.Contains(content.Id));

                        var topicProgressPercentage = topic.Contents.Count == 0
                            ? 0
                            : (int)Math.Round(
                                completedTopicLessons * 100d / topic.Contents.Count,
                                MidpointRounding.AwayFromZero);

                        <section class="ciit-learning-topic @(topicHasCurrentContent ? "is-active-topic" : "")">
                            <div class="ciit-learning-topic-heading">
                                <div class="ciit-learning-topic-icon">
                                    <i class="bi bi-collection-play"></i>
                                </div>
                                <div class="ciit-learning-topic-heading-text">
                                    <strong>@topic.Title</strong>
                                    <span>
                                        @topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")
                                        <span class="ciit-learning-dot">·</span>
                                        @topic.Contents.Count lesson@(topic.Contents.Count == 1 ? "" : "s")
                                    </span>
                                </div>
                            </div>

                            @if (User.IsInRole("Student") && learningProgress is not null && topic.Contents.Count > 0)
                            {
                                <div class="ciit-learning-topic-progress">
                                    <div class="ciit-learning-topic-progress-labels">
                                        <span>Topic progress</span>
                                        <strong>@completedTopicLessons / @topic.Contents.Count</strong>
                                    </div>
                                    <div class="ciit-learning-topic-progress-track"
                                         role="progressbar"
                                         aria-label="@topic.Title completion"
                                         aria-valuenow="@topicProgressPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span style="width: @topicProgressPercentage%"></span>
                                    </div>
                                </div>
                            }

                            @if (topic.Chapters.Count > 0)
                            {
                                @for (var chapterIndex = 0; chapterIndex < topic.Chapters.Count; chapterIndex++)
                                {
                                    var chapter = topic.Chapters[chapterIndex];
                                    var chapterHasCurrentContent = chapter.Contents.Any(
                                        content => content.Id == currentContent.Id);

                                    <details class="ciit-learning-chapter"
                                             open="@(chapterHasCurrentContent ? "open" : null)">
                                        <summary class="ciit-learning-chapter-summary">
                                            <span class="ciit-learning-chapter-number">
                                                @((chapterIndex + 1).ToString("00"))
                                            </span>
                                            <span class="ciit-learning-chapter-title">
                                                <strong>@chapter.Title</strong>
                                                <small>
                                                    @chapter.Contents.Count resource@(chapter.Contents.Count == 1 ? "" : "s")
                                                </small>
                                            </span>
                                            <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                        </summary>

                                        <div class="ciit-learning-chapter-body">
                                            <a asp-controller="Notes"
                                               asp-action="Index"
                                               asp-route-topicId="@topic.Id"
                                               asp-route-chapterId="@chapter.ChapterId"
                                               class="ciit-learning-read-notes">
                                                <span><i class="bi bi-journal-text"></i> Read chapter notes</span>
                                                <i class="bi bi-arrow-up-right"></i>
                                            </a>

                                            @if (chapter.Contents.Count == 0)
                                            {
                                                <p class="ciit-learning-no-resources">
                                                    Notes are ready for this chapter. Learning resources will appear here when linked.
                                                </p>
                                            }
                                            else
                                            {
                                                @foreach (var content in chapter.Contents)
                                                {
                                                    var isCurrentChapterLesson = content.Id == currentContent.Id;

                                                    <details class="ciit-learning-resource-node"
                                                             open="@(isCurrentChapterLesson ? "open" : null)">
                                                        <summary class="ciit-learning-resource-summary">
                                                            <span class="ciit-learning-resource-play">
                                                                <i class="bi bi-play-fill"></i>
                                                            </span>
                                                            <span class="ciit-learning-resource-name">
                                                                <strong>@content.Title</strong>
                                                                @if (learningProgress?.CompletedContentIds.Contains(content.Id) == true)
                                                                {
                                                                    <small class="ciit-learning-completed-indicator">
                                                                        <i class="bi bi-check-circle-fill me-1"></i>Completed
                                                                    </small>
                                                                }
                                                                @if (content.Questions.Count > 0)
                                                                {
                                                                    <small>
                                                                        <i class="bi bi-patch-question me-1"></i>
                                                                        @content.Questions.Count assessment question@(content.Questions.Count == 1 ? "" : "s")
                                                                    </small>
                                                                }
                                                            </span>
                                                            <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                                        </summary>

                                                        <div class="ciit-learning-resource-body">
                                                            <div class="ciit-learning-resource-links">
                                                                @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                                                {
                                                                    <a href="@ResolveResourceUrl(content.VideoName, "videos")"
                                                                       target="_blank"
                                                                       rel="noopener noreferrer">
                                                                        <i class="bi bi-play-circle"></i>
                                                                        Watch video
                                                                    </a>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(content.Slides))
                                                                {
                                                                    <a href="@ResolveResourceUrl(content.Slides, "slides")"
                                                                       target="_blank"
                                                                       rel="noopener noreferrer">
                                                                        <i class="bi bi-file-earmark-slides"></i>
                                                                        Open slides
                                                                    </a>
                                                                }

                                                                @if (string.IsNullOrWhiteSpace(content.VideoName)
                                                                     && string.IsNullOrWhiteSpace(content.Slides))
                                                                {
                                                                    <span class="ciit-learning-resource-unavailable">
                                                                        <i class="bi bi-info-circle"></i>
                                                                        No video or slides linked
                                                                    </span>
                                                                }
                                                            </div>

                                                            @if (content.Questions.Count > 0)
                                                            {
                                                                <div class="ciit-learning-assessment-preview">
                                                                    <div class="ciit-learning-assessment-heading">
                                                                        <span><i class="bi bi-patch-check"></i> Assessment</span>
                                                                        <small>@content.Questions.Count question@(content.Questions.Count == 1 ? "" : "s")</small>
                                                                    </div>

                                                                    @for (var questionIndex = 0; questionIndex < content.Questions.Count; questionIndex++)
                                                                    {
                                                                        var question = content.Questions[questionIndex];

                                                                        <div class="ciit-learning-assessment-question">
                                                                            <strong>@(questionIndex + 1). @question.Question</strong>
                                                                            <ol type="A">
                                                                                @foreach (var option in question.Options)
                                                                                {
                                                                                    if (!string.IsNullOrWhiteSpace(option))
                                                                                    {
                                                                                        <li>@option</li>
                                                                                    }
                                                                                }
                                                                            </ol>
                                                                        </div>
                                                                    }

                                                                    <a asp-action="Learn"
                                                                       asp-route-id="@Model.Id"
                                                                       asp-route-contentId="@content.Id"
                                                                       asp-fragment="lesson-assessment"
                                                                       class="ciit-learning-practice-link">
                                                                        Open lesson to practise
                                                                        <i class="bi bi-arrow-right"></i>
                                                                    </a>
                                                                </div>
                                                            }

                                                            <a asp-action="Learn"
                                                               asp-route-id="@Model.Id"
                                                               asp-route-contentId="@content.Id"
                                                               class="ciit-learning-open-lesson @(isCurrentChapterLesson ? "is-current" : "")">
                                                                <i class="bi bi-play-circle"></i>
                                                                @(isCurrentChapterLesson ? "Currently learning" : "Open lesson")
                                                            </a>
                                                        </div>
                                                    </details>
                                                }
                                            }
                                        </div>
                                    </details>
                                }
                            }

                            @if (additionalContents.Count > 0)
                            {
                                <details class="ciit-learning-chapter ciit-learning-additional">
                                    <summary class="ciit-learning-chapter-summary">
                                        <span class="ciit-learning-chapter-number">
                                            <i class="bi bi-collection"></i>
                                        </span>
                                        <span class="ciit-learning-chapter-title">
                                            <strong>Additional lessons</strong>
                                            <small>@additionalContents.Count lesson@(additionalContents.Count == 1 ? "" : "s")</small>
                                        </span>
                                        <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                    </summary>

                                    <div class="ciit-learning-chapter-body">
                                        @foreach (var content in additionalContents)
                                        {
                                            var isCurrentAdditionalLesson = content.Id == currentContent.Id;

                                            <div class="ciit-learning-additional-row">
                                                <a asp-action="Learn"
                                                   asp-route-id="@Model.Id"
                                                   asp-route-contentId="@content.Id"
                                                   class="ciit-learning-additional-link @(isCurrentAdditionalLesson ? "is-current" : "")">
                                                    <i class="bi bi-play-circle"></i>
                                                    <span>@content.Title</span>
                                                </a>

                                                @if (learningProgress?.CompletedContentIds.Contains(content.Id) == true)
                                                {
                                                    <span class="ciit-learning-completed-indicator"
                                                          title="Lesson completed">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    </span>
                                                }

                                                <div class="ciit-learning-additional-meta">
                                                    @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                                    {
                                                        <a href="@ResolveResourceUrl(content.VideoName, "videos")"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           aria-label="Open video for @content.Title"
                                                           title="Open video">
                                                            <i class="bi bi-play-btn"></i>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(content.Slides))
                                                    {
                                                        <a href="@ResolveResourceUrl(content.Slides, "slides")"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           aria-label="Open slides for @content.Title"
                                                           title="Open slides">
                                                            <i class="bi bi-file-earmark-slides"></i>
                                                        </a>
                                                    }
                                                    @if (content.Questions.Count > 0)
                                                    {
                                                        <span title="Assessment questions">
                                                            <i class="bi bi-patch-question"></i> @content.Questions.Count
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </section>
                    }
                </div>
            </aside>

            <main class="ciit-learning-main">
                <article class="ciit-learning-main-card">
                    <div class="ciit-learning-lesson-header">
                        <div class="ciit-learning-lesson-heading">
                            <span class="ciit-learning-eyebrow">
                                LESSON @(currentIndex + 1) OF @orderedContents.Count
                            </span>
                            <h2>@currentContent.Title</h2>
                            <p><i class="bi bi-collection me-1"></i>@currentItem?.Topic.Title</p>
                        </div>

                        <div class="ciit-learning-lesson-actions">
                            @if (previousItem is not null)
                            {
                                <a asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-contentId="@previousItem.Content.Id"
                                   class="btn btn-outline-secondary">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            }

                            @if (nextItem is not null)
                            {
                                <a asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-contentId="@nextItem.Content.Id"
                                   class="btn btn-primary">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            }
                        </div>
                    </div>

                    @if (User.IsInRole("Student") && learningProgress is not null)
                    {
                        var isCurrentLessonCompleted =
                            learningProgress.CompletedContentIds.Contains(currentContent.Id);

                        <div class="ciit-learning-lesson-status">
                            <div class="ciit-learning-lesson-status-copy">
                                <span class="ciit-learning-lesson-status-icon @(isCurrentLessonCompleted ? "is-completed" : "")">
                                    <i class="bi @(isCurrentLessonCompleted ? "bi-check2-circle" : "bi-hourglass-split")"></i>
                                </span>
                                <div>
                                    <strong>@(isCurrentLessonCompleted ? "Lesson completed" : "Keep your progress moving")</strong>
                                    <small>
                                        @(isCurrentLessonCompleted
                                            ? "This lesson is saved as complete."
                                            : "Mark this lesson complete when you are done.")
                                    </small>
                                </div>
                            </div>

                            @if (isCurrentLessonCompleted)
                            {
                                <span class="ciit-learning-completed-pill">
                                    <i class="bi bi-check-lg"></i> Completed
                                </span>
                            }
                            else
                            {
                                <form asp-action="CompleteLesson"
                                      asp-route-id="@Model.Id"
                                      asp-route-contentId="@currentContent.Id"
                                      method="post"
                                      class="ciit-learning-completion-form">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check2-circle me-2"></i>Mark as complete
                                    </button>
                                </form>
                            }
                        </div>

                        @if (TempData["LearningProgressMessage"] is string progressMessage)
                        {
                            <div class="alert alert-success ciit-learning-progress-alert" role="status">
                                <i class="bi bi-check-circle-fill me-2"></i>@progressMessage
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(currentContent.VideoName))
                    {
                        var videoUrl = ResolveResourceUrl(currentContent.VideoName, "videos");
                        var videoPath = Uri.TryCreate(videoUrl, UriKind.Absolute, out var absoluteVideoUri)
                            ? absoluteVideoUri.AbsolutePath
                            : videoUrl;
                        var videoExtension = System.IO.Path.GetExtension(videoPath);
                        var isDirectVideoFile = videoExtension.Equals(".mp4", StringComparison.OrdinalIgnoreCase)
                            || videoExtension.Equals(".webm", StringComparison.OrdinalIgnoreCase)
                            || videoExtension.Equals(".mov", StringComparison.OrdinalIgnoreCase);

                        <section class="ciit-learning-resource ciit-learning-video-section">
                            <div class="ciit-learning-resource-title">
                                <span class="ciit-learning-resource-icon"><i class="bi bi-play-circle"></i></span>
                                <div>
                                    <h3>Video lesson</h3>
                                    <p>Watch the lesson at your own pace.</p>
                                </div>
                            </div>

                            @if (isDirectVideoFile)
                            {
                                var videoType = videoExtension.Equals(".webm", StringComparison.OrdinalIgnoreCase)
                                    ? "video/webm"
                                    : videoExtension.Equals(".mov", StringComparison.OrdinalIgnoreCase)
                                        ? "video/quicktime"
                                        : "video/mp4";

                                <div class="ciit-learning-video-frame">
                                    <video controls preload="metadata" playsinline>
                                        <source src="@videoUrl" type="@videoType" />
                                        Your browser does not support embedded video.
                                    </video>
                                </div>
                            }
                            else
                            {
                                <div class="ratio ratio-16x9 ciit-learning-video-frame">
                                    <iframe src="@videoUrl"
                                            title="@currentContent.Title video"
                                            loading="lazy"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            referrerpolicy="strict-origin-when-cross-origin"
                                            allowfullscreen></iframe>
                                </div>
                            }
                        </section>
                    }

                    @if (!string.IsNullOrWhiteSpace(currentContent.Slides))
                    {
                        <section class="ciit-learning-resource">
                            <div class="ciit-learning-resource-title">
                                <span class="ciit-learning-resource-icon"><i class="bi bi-file-earmark-slides"></i></span>
                                <div>
                                    <h3>Study material</h3>
                                    <p>Review the slides and keep your learning on track.</p>
                                </div>
                            </div>

                            <a href="@ResolveResourceUrl(currentContent.Slides, "slides")"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="ciit-learning-open-resource">
                                <span class="ciit-learning-open-resource-icon">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </span>
                                <span>
                                    <strong>Open lesson slides</strong>
                                    <small>Opens in a new tab</small>
                                </span>
                                <i class="bi bi-arrow-up-right ms-auto"></i>
                            </a>
                        </section>
                    }

                    @if (currentContent.Questions.Count > 0)
                    {
                        <section id="lesson-assessment" class="ciit-learning-resource ciit-learning-assessment-section">
                            <div class="ciit-learning-resource-title">
                                <span class="ciit-learning-resource-icon"><i class="bi bi-patch-check"></i></span>
                                <div>
                                    <h3>Knowledge check</h3>
                                    <p>Your answers are evaluated securely when you submit.</p>
                                </div>
                                <span class="ciit-learning-question-count">
                                    @currentContent.Questions.Count question@(currentContent.Questions.Count == 1 ? "" : "s")
                                </span>
                            </div>

                            @if (TempData["AssessmentError"] is string assessmentError)
                            {
                                <div class="alert alert-warning ciit-assessment-error" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@assessmentError
                                </div>
                            }

                            @if (User.IsInRole("Student"))
                            {
                                <form asp-controller="Courses"
                                      asp-action="SubmitAssessment"
                                      asp-route-id="@Model.Id"
                                      asp-route-contentId="@currentContent.Id"
                                      method="post"
                                      class="ciit-assessment-form">
                                    @for (var i = 0; i < currentContent.Questions.Count; i++)
                                    {
                                        var question = currentContent.Questions[i];

                                        <input type="hidden"
                                               name="answers[@i].QuestionId"
                                               value="@question.Id" />

                                        <div class="ciit-learning-question">
                                            <strong class="ciit-learning-question-title">
                                                <span>@(i + 1)</span>
                                                @question.Question
                                            </strong>

                                            <div class="ciit-learning-options">
                                                @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                                                {
                                                    var option = question.Options[optionIndex];

                                                    if (!string.IsNullOrWhiteSpace(option))
                                                    {
                                                        <label>
                                                            <input type="radio"
                                                                   name="answers[@i].SelectedOptionNumber"
                                                                   value="@(optionIndex + 1)"
                                                                   required />
                                                            <span class="ciit-learning-option-letter">@((char)('A' + optionIndex))</span>
                                                            <span>@option</span>
                                                        </label>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="ciit-assessment-submit-row">
                                        <p><i class="bi bi-shield-check me-2"></i>Correct answers stay hidden until after submission.</p>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-send-check me-2"></i>Submit assessment
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="ciit-assessment-signin">
                                    <div>
                                        <strong>Ready to test your knowledge?</strong>
                                        <p>Sign in with your student account to submit answers and save your result.</p>
                                    </div>
                                    <a asp-controller="Account"
                                       asp-action="Login"
                                       class="btn btn-primary">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Student sign in
                                    </a>
                                </div>
                            }
                        </section>
                    }
                </article>
            </main>
        </div>
    </section>
}
