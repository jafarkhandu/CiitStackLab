@model CIITStackLab.Application.DTOs.CourseLearningDto

@{
    ViewData["Title"] = $"Learn — {Model.Title}";

    var orderedContents = Model.Topics
        .SelectMany(topic => topic.Contents.Select(content => new
        {
            Topic = topic,
            Content = content
        }))
        .ToList();

    var currentIndex = Model.CurrentContentId.HasValue
        ? orderedContents.FindIndex(x => x.Content.Id == Model.CurrentContentId.Value)
        : 0;

    if (currentIndex < 0)
    {
        currentIndex = 0;
    }

    var currentItem = orderedContents.ElementAtOrDefault(currentIndex);
    var selectedTopic = Model.CurrentTopicId.HasValue
        ? Model.Topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId.Value)
        : null;
    var currentTopic = selectedTopic ?? currentItem?.Topic;
    var currentContent = selectedTopic is not null && selectedTopic.Contents.Count == 0
        ? null
        : currentItem?.Content;
    var learningProgress = Model.Progress;
    var completedContentIds = learningProgress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var courseTopicProgress = Model.Topics.Select(topic =>
    {
        var topicContentIds = topic.Contents
            .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
            .Select(content => content.Id)
            .Distinct()
            .ToList();

        return new
        {
            TopicId = topic.Id,
            HasResources = topicContentIds.Count > 0,
            IsCompleted = topicContentIds.Count > 0
                && topicContentIds.All(completedContentIds.Contains)
        };
    }).ToList();
    var courseTotalTopics = Model.Topics.Count;
    var courseCompletedTopics = courseTopicProgress.Count(topic => topic.IsCompleted);
    var courseProgressPercentage = courseTotalTopics == 0
        ? 0
        : (int)Math.Round(courseCompletedTopics * 100d / courseTotalTopics, MidpointRounding.AwayFromZero);
    var orderedChapters = Model.Topics.SelectMany(topic => topic.Chapters).ToList();
    var currentChapter = currentContent?.NoteId is int currentNoteId
        ? orderedChapters.FirstOrDefault(chapter => chapter.Id == currentNoteId)
        : currentTopic?.Chapters.FirstOrDefault();
    var currentChapterIndex = currentContent?.NoteId.HasValue == true
        ? orderedChapters.FindIndex(chapter => chapter.Id == currentContent.NoteId.Value)
        : currentChapter is not null
            ? orderedChapters.FindIndex(chapter => chapter.Id == currentChapter.Id)
            : 0;
    if (currentChapterIndex < 0) currentChapterIndex = 0;
    var topicAssessmentQuestions = currentTopic is null
        ? new List<CIITStackLab.Application.DTOs.ContentQuestionDto>()
        : currentTopic.Contents
            .SelectMany(content => content.Questions)
            .Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Questions))
            .DistinctBy(question => question.Id)
            .ToList();
    var previousItem = currentIndex > 0 ? orderedContents[currentIndex - 1] : null;
    var nextItem = currentIndex < orderedContents.Count - 1
        ? orderedContents.ElementAtOrDefault(currentIndex + 1)
        : null;

    string FormatLearningTitle(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var title = value.Trim();
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=[a-z0-9])(?=[A-Z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=[A-Z])(?=[A-Z][a-z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=\d)(?=[A-Z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=\d)(?=[a-z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?i)andthe", "and the");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"\s{2,}", " ");
        return title;
    }

    string? ResolveMuxPlaybackId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var candidate = value.Trim();
        if (Uri.TryCreate(candidate, UriKind.Absolute, out var uri))
        {
            var path = uri.AbsolutePath.Trim('/');
            if (uri.Host.Equals("player.mux.com", StringComparison.OrdinalIgnoreCase))
            {
                candidate = path.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? string.Empty;
            }
            else if (uri.Host.Equals("stream.mux.com", StringComparison.OrdinalIgnoreCase))
            {
                candidate = path.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
                candidate = System.IO.Path.GetFileNameWithoutExtension(candidate);
            }
            else if (path.StartsWith("uploads/videos/", StringComparison.OrdinalIgnoreCase))
            {
                candidate = path["uploads/videos/".Length..];
            }
            else
            {
                return null;
            }
        }
        else
        {
            candidate = candidate.TrimStart('/');
            if (candidate.StartsWith("uploads/videos/", StringComparison.OrdinalIgnoreCase))
            {
                candidate = candidate["uploads/videos/".Length..];
            }
            else if (candidate.Contains('/') || candidate.Contains('.'))
            {
                return null;
            }
        }

        return System.Text.RegularExpressions.Regex.IsMatch(candidate, @"^[A-Za-z0-9_-]{20,100}$")
            ? candidate
            : null;
    }

    string ResolveResourceUrl(string? value, string folder)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var resource = value.Trim().Replace('\\', '/');

        if (Uri.TryCreate(resource, UriKind.Absolute, out var absoluteUri)
            && (absoluteUri.Scheme == Uri.UriSchemeHttp
                || absoluteUri.Scheme == Uri.UriSchemeHttps))
        {
            return resource;
        }

        if (resource.StartsWith("~/", StringComparison.Ordinal))
        {
            return resource[1..];
        }

        if (resource.StartsWith("/", StringComparison.Ordinal))
        {
            return resource;
        }

        if (resource.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + resource;
        }

        return $"/uploads/{folder}/{Uri.EscapeDataString(System.IO.Path.GetFileName(resource))}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-learning.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.querySelectorAll('.ciit-learning-topic').forEach(function (topic) {
            const heading = topic.querySelector(':scope > .ciit-learning-topic-heading');
            const firstContentUrl = topic.dataset.topicFirstContentUrl;

            if (!heading || !firstContentUrl || topic.classList.contains('is-active-topic') || topic.classList.contains('is-locked-topic')) {
                return;
            }

            heading.addEventListener('click', function (event) {
                event.preventDefault();
                window.location.assign(firstContentUrl);
            });
        });
        document.querySelectorAll('.exam-timezone-offset').forEach(function (input) {
            input.value = new Date().getTimezoneOffset();
        });
        const examApplicationModal = document.getElementById('topicExamApplicationModal');
        if (examApplicationModal && window.bootstrap) {
            window.bootstrap.Modal.getOrCreateInstance(examApplicationModal).show();
        }
    </script>
}

@if (currentContent is null && currentTopic is null)
{
    <main class="ciit-learning-empty container py-5">
        <div class="ciit-learning-empty-card text-center">
            <span class="ciit-learning-eyebrow">COURSE MATERIAL</span>
            <h1>Learning content is not available yet</h1>
            <p>This course does not have any active lessons at the moment.</p>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-arrow-left me-2"></i>Back to Course
            </a>
        </div>
    </main>
}
else if (currentContent is null && currentTopic is not null)
{
    <section class="ciit-learning-page">
        <header class="ciit-learning-header">
            <div class="container">
                <div class="ciit-learning-header-row">
                    <div class="ciit-learning-course-intro">
                        <div class="ciit-learning-pills">
                            <span class="ciit-learning-badge">@Model.Category</span>
                            <span class="ciit-learning-meta-pill">@Model.Level</span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-clock me-1"></i>@Model.DurationHours.ToString("0.##") hrs
                            </span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-journal-bookmark me-1"></i>@Model.Topics.Sum(topic => topic.Chapters.Count) chapters
                            </span>
                        </div>
                        <h1>@Model.Title</h1>
                        <p>@Model.ShortDescription</p>
                        @if (User.IsInRole("Student") && learningProgress is not null)
                        {
                            <div class="ciit-learning-course-progress" role="group" aria-label="Course completion progress">
                                <div class="ciit-learning-course-progress-heading">
                                    <span><i class="bi bi-graph-up-arrow me-2"></i>Your progress</span>
                                    <strong>@courseProgressPercentage%</strong>
                                </div>
                                <div class="progress ciit-learning-course-progress-track"
                                     role="progressbar"
                                     aria-label="Course completion"
                                     aria-valuenow="@courseProgressPercentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar" style="width: @courseProgressPercentage%"></div>
                                </div>
                                <small>@courseCompletedTopics of @courseTotalTopics topics completed</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </header>

        <div class="container ciit-learning-shell">
            <aside class="ciit-learning-sidebar" aria-label="Course chapters and resources">
                <div class="ciit-learning-sidebar-head">
                    <div>
                        <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
                        <h2>Chapters &amp; Resources</h2>
                    </div>
                    <span class="ciit-learning-count">@Model.ContentCount</span>
                </div>
                <div class="ciit-learning-sidebar-scroll">
                    @foreach (var topic in Model.Topics)
                    {
                        var topicLearningContents = topic.Contents
                            .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
                            .DistinctBy(content => content.Id)
                            .ToList();
                        var completedTopicLessons = learningProgress is null
                            ? 0
                            : topicLearningContents.Count(content => learningProgress.CompletedContentIds.Contains(content.Id));
                        var topicIsCompleted = topicLearningContents.Count > 0
                            && completedTopicLessons == topicLearningContents.Count;
                        var topicProgressPercentage = topicLearningContents.Count == 0
                            ? 0
                            : (int)Math.Round(completedTopicLessons * 100d / topicLearningContents.Count, MidpointRounding.AwayFromZero);

                        var topicPosition = Model.Topics.ToList().FindIndex(item => item.Id == topic.Id);
                        var allowedTopicPosition = ViewBag.AllowedTopicId is int allowedTopicId
                            ? Model.Topics.ToList().FindIndex(item => item.Id == allowedTopicId)
                            : -1;
                        var topicIsLocked = User.IsInRole("Student")
                            && allowedTopicPosition >= 0
                            && topicPosition > allowedTopicPosition;

                        <details class="ciit-learning-topic @(topic.Id == currentTopic.Id ? "is-active-topic" : "") @(topicIsLocked ? "is-locked-topic" : "")"
                                 data-topic-first-content-url="@Url.Action("Learn", "Courses", new { id = Model.Id, topicId = topic.Id })"
                                 open="@(topic.Id == currentTopic.Id ? "open" : null)">
                            <summary class="ciit-learning-topic-heading">
                                <div class="ciit-learning-topic-icon"><i class="bi @(topicIsLocked ? "bi-lock-fill" : "bi-collection-play")"></i></div>
                                <div class="ciit-learning-topic-heading-text @(topicIsCompleted ? "is-completed" : "")">
                                    <strong>@topic.Title</strong>
                                    @if (topicIsCompleted)
                                    {
                                        <span class="ciit-learning-topic-completed" title="Topic completed" aria-label="Topic completed">
                                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span>@topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")</span>
                                </div>
                            </summary>
                            @if (User.IsInRole("Student") && learningProgress is not null && topicLearningContents.Count > 0)
                            {
                                <div class="ciit-learning-topic-progress">
                                    <div class="ciit-learning-topic-progress-labels">
                                        <span>Topic progress</span>
                                        <strong>@completedTopicLessons / @topicLearningContents.Count</strong>
                                    </div>
                                    <div class="ciit-learning-topic-progress-track"
                                         role="progressbar"
                                         aria-label="@topic.Title completion"
                                         aria-valuenow="@topicProgressPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span style="width: @topicProgressPercentage%"></span>
                                    </div>
                                </div>
                            }
                            @foreach (var chapter in topic.Chapters)
                            {
                                var chapterResourceCount =
                                    (string.IsNullOrWhiteSpace(chapter.NotesHtml) ? 0 : 1)
                                    + chapter.Contents.Count
                                    + chapter.Questions.Count
                                    + chapter.InterviewQuestions.Count
                                    + chapter.PracticeQuestions.Count;
                                <details class="ciit-learning-chapter">
                                    <summary class="ciit-learning-chapter-summary">
                                        <span class="ciit-learning-chapter-number">@chapter.SortOrder.ToString("00")</span>
                                        <span class="ciit-learning-chapter-title">
                                            <strong>@FormatLearningTitle(chapter.Title)</strong>
                                            <small>@chapterResourceCount resource@(chapterResourceCount == 1 ? "" : "s")</small>
                                        </span>
                                        <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                    </summary>
                                    <div class="ciit-learning-chapter-body">
                                        @if (!string.IsNullOrWhiteSpace(chapter.NotesHtml))
                                        {
                                            <button type="button" class="ciit-learning-category-link ciit-learning-category-notes" data-learning-page="notes">
                                                <i class="bi bi-journal-text" aria-hidden="true"></i><span>Chapter notes</span><small>Read notes</small>
                                            </button>
                                        }
                                        @foreach (var content in chapter.Contents)
                                        {
                                            <a class="ciit-learning-content-link" asp-action="Learn" asp-route-id="@Model.Id" asp-route-contentId="@content.Id">
                                                <span class="ciit-learning-content-link-icon"><i class="bi bi-play-circle" aria-hidden="true"></i></span>
                                                <span><strong>@content.Title</strong><small>@(string.IsNullOrWhiteSpace(content.VideoName) ? "Learning resource" : "Video lesson")</small></span>
                                                <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                                            </a>
                                        }
                                        @if (chapterResourceCount == 0)
                                        {
                                            <p class="ciit-learning-no-resources">No resources have been linked to this chapter yet.</p>
                                        }
                                    </div>
                                </details>
                            }
                        </details>
                    }
                </div>
            </aside>

            <main class="ciit-learning-main">
                <div class="ciit-learning-panel-pager" aria-label="Learning sections">
                    <button type="button" data-learning-page="notes">1. Notes</button>
                    <button type="button" data-learning-page="content">2. Content</button>
                    <button type="button" data-learning-page="assessment">3. Assessments</button>
                </div>
                <article class="ciit-learning-main-card">
                    <a asp-action="CourseEnvironment"
                       asp-route-id="@Model.Id"
                       class="ciit-learning-back-button">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        Back to Start Learning
                    </a>

                    <div class="ciit-learning-lesson-header">
                        <div class="ciit-learning-lesson-heading">
                            <span class="ciit-learning-eyebrow">
                                TOPIC @(Math.Max(0, Model.Topics.ToList().FindIndex(topic => topic.Id == currentTopic.Id)) + 1) OF @Math.Max(Model.Topics.Count, 1)
                            </span>
                            <h2 class="ciit-learning-chapter-title">@FormatLearningTitle(currentTopic.Title)</h2>
                        </div>
                    </div>

                    <div class="ciit-learning-lesson-status">
                        <div class="ciit-learning-lesson-status-copy">
                            <span class="ciit-learning-lesson-status-icon @(learningProgress is not null && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).Any() && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).All(content => learningProgress.CompletedContentIds.Contains(content.Id)) ? "is-completed" : "")">
                                <i class="bi @(learningProgress is not null && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).Any() && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).All(content => learningProgress.CompletedContentIds.Contains(content.Id)) ? "bi-check2-circle" : "bi-journal-bookmark")"></i>
                            </span>
                            <div>
                                <strong>@(learningProgress is not null && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).Any() && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).All(content => learningProgress.CompletedContentIds.Contains(content.Id)) ? "Topic completed" : "Topic learning material")</strong>
                                <small>@(currentTopic.Contents.Count > 0 ? "Review the notes, lesson content and assessments for this topic." : "Review the notes and assessments available for this topic.")</small>
                            </div>
                        </div>
                        @if (learningProgress is not null && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).Any() && currentTopic.Contents.Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents)).DistinctBy(content => content.Id).All(content => learningProgress.CompletedContentIds.Contains(content.Id)))
                        {
                            <span class="ciit-learning-completed-pill"><i class="bi bi-check-lg"></i> Completed</span>
                        }
                        @if (User.IsInRole("Student") && learningProgress is not null && currentTopic is not null)
                        {
                            var topicContentIdsForCompletion = currentTopic.Contents
                                .Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents))
                                .Select(content => content.Id).Distinct().ToList();
                            var topicMarkedComplete = topicContentIdsForCompletion.Count == 0
                                || topicContentIdsForCompletion.All(learningProgress.CompletedContentIds.Contains);
                            <form asp-controller="Courses" asp-action="CompleteTopic" asp-route-id="@Model.Id" asp-route-topicId="@currentTopic.Id" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ciit-topic-completion-button">
                                    <i class="bi @(topicMarkedComplete ? "bi-calendar2-check" : "bi-check2-circle")" aria-hidden="true"></i>
                                    <span>@(topicMarkedComplete ? "Apply for Examination" : "Mark as Complete")</span>
                                    <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </div>

                    <section class="ciit-learning-resource ciit-learning-notes-panel" data-learning-panel-content="notes">
                        <div class="ciit-learning-resource-title">
                            <span class="ciit-learning-resource-icon"><i class="bi bi-journal-text"></i></span>
                            <div><h3>Chapter Notes</h3><p>Notes for @currentTopic.Title.</p></div>
                        </div>
                        @if (currentTopic.Chapters.Count == 0)
                        {
                            <p class="ciit-learning-category-empty">No notes or chapters have been added to this topic yet.</p>
                        }
                        @foreach (var chapter in currentTopic.Chapters)
                        {
                            <article class="ciit-learning-notes-content">
                                <h4>@FormatLearningTitle(chapter.Title)</h4>
                                @if (!string.IsNullOrWhiteSpace(chapter.NotesHtml))
                                {
                                    @Html.Raw(chapter.NotesHtml)
                                }
                                else
                                {
                                    <p class="ciit-learning-category-empty">No notes have been added to this chapter yet.</p>
                                }
                            </article>
                        }
                    </section>

                    <section class="ciit-learning-resource ciit-learning-content-overview"
                             data-learning-panel-content="content"
                             data-learning-content-page="overview">
                        <div class="ciit-learning-resource-title">
                            <span class="ciit-learning-resource-icon"><i class="bi bi-lightbulb"></i></span>
                            <div><h3>Topic content</h3><p>Learning material linked to this topic.</p></div>
                        </div>
                        @if (currentTopic.Contents.Count > 0)
                        {
                            @foreach (var content in currentTopic.Contents)
                            {
                                <article class="ciit-learning-assessment-question">
                                    <strong>@content.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(content.Slides))
                                    {
                                        <p>@content.Slides</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                    {
                                        <p><i class="bi bi-play-circle me-2"></i>@content.VideoName</p>
                                    }
                                </article>
                            }
                        }
                        else
                        {
                            <p class="ciit-learning-category-empty">This topic has notes and assessments but no separate video/slide lesson.</p>
                        }
                    </section>

                    <section class="ciit-learning-resource ciit-learning-all-assessments" data-learning-panel-content="assessment">
                        <div class="ciit-learning-resource-title">
                            <span class="ciit-learning-resource-icon"><i class="bi bi-patch-check"></i></span>
                            <div><h3>Chapter Assessments</h3><p>MCQs, interview questions and practice programs for this topic.</p></div>
                        </div>
                        @foreach (var chapter in currentTopic.Chapters)
                        {
                            <section class="ciit-learning-chapter-assessment" id="chapter-assessment-@chapter.Id">
                                <h4>@FormatLearningTitle(chapter.Title)</h4>
                                @if (chapter.Id == currentTopic.Chapters.First().Id)
                                {
                                    <section class="ciit-learning-assessment-subsection" id="chapter-mcqs-@chapter.Id">
                                        <h5>MCQs</h5>
                                        @if (topicAssessmentQuestions.Count == 0)
                                        {
                                            <p class="ciit-learning-category-empty">No MCQs have been added to this topic yet.</p>
                                        }
                                        else
                                        {
                                            <section id="lesson-assessment-@currentTopic.Id" class="ciit-learning-resource ciit-learning-assessment-section">
                                                <div class="ciit-learning-resource-title">
                                                    <span class="ciit-learning-resource-icon"><i class="bi bi-patch-check"></i></span>
                                                    <div>
                                                        <h3>Knowledge check</h3>
                                                        <p>Your answers are evaluated securely when you submit.</p>
                                                    </div>
                                                    <span class="ciit-learning-question-count">
                                                        @topicAssessmentQuestions.Count question@(topicAssessmentQuestions.Count == 1 ? "" : "s")
                                                    </span>
                                                </div>
                                                @if (TempData["AssessmentError"] is string assessmentError)
                                                {
                                                    <div class="alert alert-warning ciit-assessment-error" role="alert">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@assessmentError
                                                    </div>
                                                }
                                                @if (User.IsInRole("Student"))
                                                {
                                                    <form asp-controller="Courses"
                                                          asp-action="SubmitAssessment"
                                                          asp-route-id="@Model.Id"
                                                          asp-route-topicId="@currentTopic.Id"
                                                          method="post"
                                                          class="ciit-assessment-form">
                                                        @for (var i = 0; i < topicAssessmentQuestions.Count; i++)
                                                        {
                                                            var question = topicAssessmentQuestions[i];
                                                            <input type="hidden" name="answers[@i].QuestionId" value="@question.Id" />
                                                            <div class="ciit-learning-question">
                                                                <strong class="ciit-learning-question-title">
                                                                    <span>@(i + 1)</span>
                                                                    @question.Question
                                                                </strong>
                                                                <div class="ciit-learning-options">
                                                                    @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                                                                    {
                                                                        var option = question.Options[optionIndex];
                                                                        if (!string.IsNullOrWhiteSpace(option))
                                                                        {
                                                                            <label>
                                                                                <input type="radio" name="answers[@i].SelectedOptionNumber" value="@(optionIndex + 1)" required />
                                                                                <span class="ciit-learning-option-letter">@((char)('A' + optionIndex))</span>
                                                                                <span>@option</span>
                                                                            </label>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        <div class="ciit-assessment-submit-row">
                                                            <p><i class="bi bi-shield-check me-2"></i>Correct answers stay hidden until after submission.</p>
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="bi bi-send-check me-2"></i>Submit assessment
                                                            </button>
                                                        </div>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="ciit-assessment-signin">
                                                        <div>
                                                            <strong>Ready to test your knowledge?</strong>
                                                            <p>Sign in with your student account to submit answers and save your result.</p>
                                                        </div>
                                                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                                                            <i class="bi bi-box-arrow-in-right me-2"></i>Student sign in
                                                        </a>
                                                    </div>
                                                }
                                            </section>
                                        }
                                    </section>
                                }
                                <section class="ciit-learning-assessment-subsection" id="chapter-interview-@chapter.Id">
                                    <h5>Interview Questions</h5>
                                    @if (chapter.InterviewQuestions.Count == 0)
                                    {
                                        <p class="ciit-learning-category-empty">No interview questions have been added to this chapter yet.</p>
                                    }
                                    @foreach (var question in chapter.InterviewQuestions)
                                    {
                                        <article class="ciit-learning-assessment-question">
                                            <strong>@question.Question</strong>
                                            @if (!string.IsNullOrWhiteSpace(question.Answer))
                                            {
                                                <p>@question.Answer</p>
                                            }
                                        </article>
                                    }
                                </section>
                                <section class="ciit-learning-assessment-subsection" id="chapter-practice-@chapter.Id">
                                    <h5>Practice Programs</h5>
                                    @if (chapter.PracticeQuestions.Count == 0)
                                    {
                                        <p class="ciit-learning-category-empty">No practice programs have been added to this chapter yet.</p>
                                    }
                                    @foreach (var question in chapter.PracticeQuestions)
                                    {
                                        <article class="ciit-learning-assessment-question">
                                            <strong>@question.QuestionTitle</strong>
                                            @if (!string.IsNullOrWhiteSpace(question.QuestionDescription))
                                            {
                                                <p>@question.QuestionDescription</p>
                                            }
                                        </article>
                                    }
                                </section>
                            </section>
                        }
                    </section>
                </article>
            </main>
        </div>
    </section>
}

else
{
    <section class="ciit-learning-page">
        <header class="ciit-learning-header">
            <div class="container">
                                <div class="ciit-learning-header-row">
                    <div class="ciit-learning-course-intro">
                        <div class="ciit-learning-pills">
                            <span class="ciit-learning-badge">@Model.Category</span>
                            <span class="ciit-learning-meta-pill">@Model.Level</span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-clock me-1"></i>@Model.DurationHours.ToString("0.##") hrs
                            </span>
                            <span class="ciit-learning-meta-pill">
                                <i class="bi bi-journal-bookmark me-1"></i>@Model.Topics.Sum(topic => topic.Chapters.Count) chapters
                            </span>
                        </div>

                        <h1>@Model.Title</h1>
                        <p>@Model.ShortDescription</p>

                        @if (User.IsInRole("Student") && learningProgress is not null)
                        {
                            <div class="ciit-learning-course-progress"
                                 role="group"
                                 aria-label="Course completion progress">
                                <div class="ciit-learning-course-progress-heading">
                                    <span><i class="bi bi-graph-up-arrow me-2"></i>Your progress</span>
                                    <strong>@learningProgress.Percentage%</strong>
                                </div>
                                <div class="progress ciit-learning-course-progress-track"
                                     role="progressbar"
                                     aria-label="Course completion"
                                     aria-valuenow="@learningProgress.Percentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar"
                                         style="width: @learningProgress.Percentage%"></div>
                                </div>
                                <small>@learningProgress.CompletedLessons of @learningProgress.TotalLessons learning resources completed</small>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </header>

        <div class="container ciit-learning-shell">
            <aside class="ciit-learning-sidebar" aria-label="Course chapters and resources">
                <div class="ciit-learning-sidebar-head">
                    <div>
                        <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
                        <h2>Chapters &amp; Resources</h2>
                    </div>
                    <span class="ciit-learning-count">@Model.ContentCount</span>
                </div>

                <div class="ciit-learning-sidebar-scroll">
                    @foreach (var topic in Model.Topics)
                    {
                        var chapterContentIds = topic.Chapters
                            .SelectMany(chapter => chapter.Contents)
                            .Select(content => content.Id)
                            .ToHashSet();

                        var additionalContents = topic.Contents
                            .Where(content => !chapterContentIds.Contains(content.Id))
                            .ToList();

                        var topicHasCurrentContent = currentTopic?.Id == topic.Id
                            || (currentContent is not null && topic.Contents.Any(
                                content => content.Id == currentContent.Id));

                        var topicLearningContents = topic.Contents
                            .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
                            .DistinctBy(content => content.Id)
                            .ToList();

                        var completedTopicLessons = learningProgress is null
                            ? 0
                            : topicLearningContents.Count(content =>
                                learningProgress.CompletedContentIds.Contains(content.Id));

                        var topicProgressPercentage = topicLearningContents.Count == 0
                            ? 0
                            : (int)Math.Round(
                                completedTopicLessons * 100d / topicLearningContents.Count,
                                MidpointRounding.AwayFromZero);

                        var topicIsLocked = User.IsInRole("Student") && ViewBag.AllowedTopicId is int allowedTopicId && topic.Id != allowedTopicId;

                        <details class="ciit-learning-topic @(topicHasCurrentContent ? "is-active-topic" : "") @(topicIsLocked ? "is-locked-topic" : "")"
                                 data-topic-first-content-url="@Url.Action("Learn", "Courses", new { id = Model.Id, topicId = topic.Id })"
                                 open="@(topicHasCurrentContent ? "open" : null)">
                            <summary class="ciit-learning-topic-heading">
                                <div class="ciit-learning-topic-icon">
                                    <i class="bi @(topicIsLocked ? "bi-lock-fill" : "bi-collection-play")"></i>
                                </div>
                                <div class="ciit-learning-topic-heading-text @(topicLearningContents.Count > 0 && completedTopicLessons == topicLearningContents.Count ? "is-completed" : "")">
                                    <strong>@topic.Title</strong>
                                    @if (topicLearningContents.Count > 0 && completedTopicLessons == topicLearningContents.Count)
                                    {
                                        <span class="ciit-learning-topic-completed" title="Topic completed" aria-label="Topic completed">
                                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span>
                                        @topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")
 
                                    </span>
                                </div>
                            </summary>

                            @if (User.IsInRole("Student") && learningProgress is not null && topic.Contents.Count > 0)
                            {
                                <div class="ciit-learning-topic-progress">
                                    <div class="ciit-learning-topic-progress-labels">
                                        <span>Topic progress</span>
                                        <strong>@completedTopicLessons / @topic.Contents.Count</strong>
                                    </div>
                                    <div class="ciit-learning-topic-progress-track"
                                         role="progressbar"
                                         aria-label="@topic.Title completion"
                                         aria-valuenow="@topicProgressPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span style="width: @topicProgressPercentage%"></span>
                                    </div>
                                </div>
                            }

                            @if (topic.Chapters.Count > 0)
                            {
                                @for (var chapterIndex = 0; chapterIndex < topic.Chapters.Count; chapterIndex++)
                                {
                                    var chapter = topic.Chapters[chapterIndex];
                                    var chapterHasCurrentContent = currentContent is not null && chapter.Contents.Any(
                                        content => content.Id == currentContent.Id);
                                    var chapterResourceCount =
                                        (string.IsNullOrWhiteSpace(chapter.NotesHtml) ? 0 : 1)
                                        + chapter.Contents.Count
                                        + chapter.Questions.Count
                                        + chapter.InterviewQuestions.Count
                                        + chapter.PracticeQuestions.Count;

                                    <details class="ciit-learning-chapter"
                                             open="@(chapterHasCurrentContent ? "open" : null)">
                                        <summary class="ciit-learning-chapter-summary">
                                            <span class="ciit-learning-chapter-number">
                                                @((chapterIndex + 1).ToString("00"))
                                            </span>
                                            <span class="ciit-learning-chapter-title">
                                                <strong>@FormatLearningTitle(chapter.Title)</strong>
                                                <small>
                                                    @chapterResourceCount resource@(chapterResourceCount == 1 ? "" : "s")
                                                </small>
                                            </span>
                                            <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                        </summary>

                                        <div class="ciit-learning-chapter-body ciit-learning-chapter-categories">
                                            <button type="button"
                                                    class="ciit-learning-category-link ciit-learning-category-notes"
                                                    data-learning-panel="notes"
                                                    data-chapter-id="@chapter.Id">
                                                <span class="ciit-learning-category-icon"><i class="bi bi-journal-text"></i></span>
                                                <span class="ciit-learning-category-copy">
                                                    <strong>Notes</strong>
                                                    <small>Chapter notes</small>
                                                </span>
                                                <i class="bi bi-arrow-right ciit-learning-category-arrow"></i>
                                            </button>

                                            <details class="ciit-learning-category">
                                                <summary class="ciit-learning-category-heading">
                                                    <span class="ciit-learning-category-icon"><i class="bi bi-play-btn"></i></span>
                                                    <span class="ciit-learning-category-copy">
                                                        <strong>Content</strong>
                                                        <small>Slides and video lessons</small>
                                                    </span>
                                                    <span class="ciit-learning-category-count">@chapter.Contents.Count</span>
                                                    <i class="bi bi-chevron-down ciit-learning-disclosure-icon"></i>
                                                </summary>
                                                <div class="ciit-learning-category-body">
                                                    @if (chapter.Contents.Count == 0)
                                                    {
                                                        <p class="ciit-learning-category-empty">No video or slide content is linked to this chapter yet.</p>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var content in chapter.Contents)
                                                        {
                                                            <div class="ciit-learning-content-item">
                                                                <div class="ciit-learning-content-item-title">
                                                                    <i class="bi bi-collection-play"></i>
                                                                    <strong>@content.Title</strong>
                                                                </div>
                                                                <div class="ciit-learning-resource-links">
                                                                    @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                                                    {
                                                                        <a href="@ResolveResourceUrl(content.VideoName, "videos")"
                                                                           target="_blank" rel="noopener noreferrer">
                                                                            <i class="bi bi-play-circle"></i> Watch video
                                                                        </a>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(content.Slides))
                                                                    {
                                                                        <a href="@ResolveResourceUrl(content.Slides, "slides")"
                                                                           target="_blank" rel="noopener noreferrer">
                                                                            <i class="bi bi-file-earmark-slides"></i> Open slides
                                                                        </a>
                                                                    }
                                                                    @if (string.IsNullOrWhiteSpace(content.VideoName) && string.IsNullOrWhiteSpace(content.Slides))
                                                                    {
                                                                        <span class="ciit-learning-resource-unavailable">
                                                                            <i class="bi bi-info-circle"></i> No video or slides linked
                                                                        </span>
                                                                    }
                                                                </div>
                                                                <a asp-action="Learn" asp-route-id="@Model.Id" asp-route-contentId="@content.Id"
                                                                   class="ciit-learning-open-lesson @(content.Id == currentContent.Id ? "is-current" : "")">
                                                                    <i class="bi bi-play-circle"></i>
                                                                    @(content.Id == currentContent.Id ? "Currently learning" : "Open lesson")
                                                                </a>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </details>

                                            <div class="ciit-learning-assessment-links">
                                                <a class="ciit-learning-category-link" href="#chapter-mcqs-@chapter.Id" data-learning-panel="assessment">
                                                    <span class="ciit-learning-category-icon"><i class="bi bi-ui-radios-grid"></i></span>
                                                    <span class="ciit-learning-category-copy"><strong>MCQs</strong><small>@chapter.Questions.Count questions</small><span class="ciit-learning-category-count">@chapter.Questions.Count</span></span>
                                                    <i class="bi bi-arrow-right ciit-learning-category-arrow"></i>
                                                </a>
                                                <a class="ciit-learning-category-link" href="#chapter-interview-@chapter.Id" data-learning-panel="assessment">
                                                    <span class="ciit-learning-category-icon"><i class="bi bi-chat-square-text"></i></span>
                                                    <span class="ciit-learning-category-copy"><strong>Interview Questions</strong><small>@chapter.InterviewQuestions.Count questions</small><span class="ciit-learning-category-count">@chapter.InterviewQuestions.Count</span></span>
                                                    <i class="bi bi-arrow-right ciit-learning-category-arrow"></i>
                                                </a>
                                                <a class="ciit-learning-category-link" href="#chapter-practice-@chapter.Id" data-learning-panel="assessment">
                                                    <span class="ciit-learning-category-icon"><i class="bi bi-code-square"></i></span>
                                                    <span class="ciit-learning-category-copy"><strong>Practice Programs</strong><small>@chapter.PracticeQuestions.Count questions</small><span class="ciit-learning-category-count">@chapter.PracticeQuestions.Count</span></span>
                                                    <i class="bi bi-arrow-right ciit-learning-category-arrow"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </details>
                                }
                            }

                            @if (additionalContents.Count > 0)
                            {
                                <details class="ciit-learning-chapter ciit-learning-additional">
                                    <summary class="ciit-learning-chapter-summary">
                                        <span class="ciit-learning-chapter-number">
                                            <i class="bi bi-collection"></i>
                                        </span>
                                        <span class="ciit-learning-chapter-title">
                                            <strong>Additional lessons</strong>
                                            <small>@additionalContents.Count lesson@(additionalContents.Count == 1 ? "" : "s")</small>
                                        </span>
                                        <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                                    </summary>

                                    <div class="ciit-learning-chapter-body">
                                        @foreach (var content in additionalContents)
                                        {
                                            var isCurrentAdditionalLesson = content.Id == currentContent.Id;

                                            <div class="ciit-learning-additional-row">
                                                <a asp-action="Learn"
                                                   asp-route-id="@Model.Id"
                                                   asp-route-contentId="@content.Id"
                                                   class="ciit-learning-additional-link @(isCurrentAdditionalLesson ? "is-current" : "")">
                                                    <i class="bi bi-play-circle"></i>
                                                    <span>@content.Title</span>
                                                </a>

                                                @if (learningProgress?.CompletedContentIds.Contains(content.Id) == true)
                                                {
                                                    <span class="ciit-learning-completed-indicator"
                                                          title="Lesson completed">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    </span>
                                                }

                                                <div class="ciit-learning-additional-meta">
                                                    @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                                    {
                                                        <a href="@ResolveResourceUrl(content.VideoName, "videos")"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           aria-label="Open video for @content.Title"
                                                           title="Open video">
                                                            <i class="bi bi-play-btn"></i>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(content.Slides))
                                                    {
                                                        <a href="@ResolveResourceUrl(content.Slides, "slides")"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           aria-label="Open slides for @content.Title"
                                                           title="Open slides">
                                                            <i class="bi bi-file-earmark-slides"></i>
                                                        </a>
                                                    }
                                                    @if (content.Questions.Count > 0)
                                                    {
                                                        <span title="Assessment questions">
                                                            <i class="bi bi-patch-question"></i> @content.Questions.Count
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </details>
                    }
                </div>
            </aside>

            <main class="ciit-learning-main">
                <div class="ciit-learning-panel-pager" aria-label="Learning sections">
                    <button type="button" data-learning-page="notes">1. Notes</button>
                    <button type="button" data-learning-page="content">2. Content</button>
                    <button type="button" data-learning-page="assessment">3. Assessments</button>
                </div>
                <article class="ciit-learning-main-card">
                    <a asp-action="CourseEnvironment"
                       asp-route-id="@Model.Id"
                       class="ciit-learning-back-button">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        Back to Start Learning
                    </a>
                    <div class="ciit-learning-lesson-header">
                        <div class="ciit-learning-lesson-heading">
                            <span class="ciit-learning-eyebrow">
                                TOPIC @(Math.Max(0, Model.Topics.ToList().FindIndex(topic => topic.Id == currentTopic?.Id)) + 1) OF @Math.Max(Model.Topics.Count, 1)
                            </span>
                            <h2 class="ciit-learning-chapter-title">@FormatLearningTitle(currentChapter?.Title ?? currentTopic?.Title ?? currentContent.Title)</h2>
                        </div>

                        <div class="ciit-learning-lesson-actions">
                            @if (previousItem is not null)
                            {
                                <a asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-contentId="@previousItem.Content.Id"
                                   class="btn btn-outline-secondary">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            }

                            @if (nextItem is not null)
                            {
                                <a asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-contentId="@nextItem.Content.Id"
                                   class="btn btn-primary">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            }
                        </div>
                    </div>

                    @if (User.IsInRole("Student") && learningProgress is not null)
                    {
                        var isCurrentLessonCompleted =
                            learningProgress.CompletedContentIds.Contains(currentContent.Id);

                        <div class="ciit-learning-lesson-status">
                            <div class="ciit-learning-lesson-status-copy">
                                <span class="ciit-learning-lesson-status-icon @(isCurrentLessonCompleted ? "is-completed" : "")">
                                    <i class="bi @(isCurrentLessonCompleted ? "bi-check2-circle" : "bi-hourglass-split")"></i>
                                </span>
                                <div>
                                    <strong>@(isCurrentLessonCompleted ? "Lesson completed" : "Keep your progress moving")</strong>
                                    <small>
                                        @(isCurrentLessonCompleted
                                            ? "This lesson is saved as complete."
                                            : "Mark this lesson complete when you are done.")
                                    </small>
                                </div>
                            </div>

                            @if (isCurrentLessonCompleted)
                            {
                                <span class="ciit-learning-completed-pill">
                                    <i class="bi bi-check-lg"></i> Completed
                                </span>
                            }
                            else
                            {
                                <form asp-action="CompleteLesson"
                                      asp-route-id="@Model.Id"
                                      asp-route-contentId="@currentContent.Id"
                                      method="post"
                                      class="ciit-learning-completion-form">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check2-circle me-2"></i>Mark as complete
                                    </button>
                                </form>
                            }
                        </div>

                        @if (TempData["LearningProgressMessage"] is string progressMessage)
                        {
                            <div class="alert alert-success ciit-learning-progress-alert" role="status">
                                <i class="bi bi-check-circle-fill me-2"></i>@progressMessage
                            </div>
                        }
                    }

                    <section class="ciit-learning-resource ciit-learning-notes-panel" data-learning-panel-content="notes">
                        <div class="ciit-learning-resource-title">
                            <span class="ciit-learning-resource-icon"><i class="bi bi-journal-text"></i></span>
                            <div>
                                <h3>Chapter Notes</h3>
                                <p>Start with the notes, then review content and assessments.</p>
                            </div>
                        </div>
                        @if (currentChapter is not null)
                        {
                            <article class="ciit-learning-notes-content">
                                @if (!string.IsNullOrWhiteSpace(currentChapter.NotesHtml))
                                {
                                    @Html.Raw(currentChapter.NotesHtml)
                                }
                                else
                                {
                                    <p class="ciit-learning-category-empty">No notes have been added to this chapter yet.</p>
                                }
                            </article>
                        }
                    </section>

                    <section class="ciit-learning-resource ciit-learning-content-overview" data-learning-panel-content="content" data-learning-content-combined="overview">
                                <div class="ciit-learning-resource-title">
                                    <span class="ciit-learning-resource-icon"><i class="bi bi-lightbulb"></i></span>
                                    <div><h3>What you'll cover</h3><p>A quick overview of this lesson's learning resources.</p></div>
                                </div>
                                <ul>
                                    <li><strong>Lesson:</strong> @currentContent.Title</li>
                                    <li><strong>Video:</strong> @(string.IsNullOrWhiteSpace(currentContent.VideoName) ? "Not provided for this lesson" : "Available — load it when you're ready")</li>
                                    <li><strong>Slides:</strong> @(string.IsNullOrWhiteSpace(currentContent.Slides) ? "Not provided for this lesson" : "Available as supplementary study material")</li>
                                    <li><strong>Practice:</strong> Review the chapter assessment section after studying the notes and lesson resources.</li>
                                    <li><strong>Suggested order:</strong> Notes → lesson content → chapter assessments.</li>
                                </ul>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(currentContent.VideoName))
                    {
                        var videoUrl = ResolveResourceUrl(currentContent.VideoName, "videos");
                        var videoPath = Uri.TryCreate(videoUrl, UriKind.Absolute, out var absoluteVideoUri)
                            ? absoluteVideoUri.AbsolutePath
                            : videoUrl;
                        var videoExtension = System.IO.Path.GetExtension(videoPath);
                        var isDirectVideoFile = videoExtension.Equals(".mp4", StringComparison.OrdinalIgnoreCase)
                            || videoExtension.Equals(".webm", StringComparison.OrdinalIgnoreCase)
                            || videoExtension.Equals(".mov", StringComparison.OrdinalIgnoreCase);
                        var muxPlaybackId = ResolveMuxPlaybackId(currentContent.VideoName);

                        <section class="ciit-learning-resource ciit-learning-video-section" data-learning-panel-content="content" data-learning-content-combined="video">
                            <div class="ciit-learning-resource-title">
                                <span class="ciit-learning-resource-icon"><i class="bi bi-play-circle"></i></span>
                                <div>
                                    <h3>Video lesson</h3>
                                    <p>Watch the lesson at your own pace.</p>
                                </div>
                            </div>

                            @if (muxPlaybackId is not null)
                            {
                                <div class="ciit-learning-video-frame ciit-mux-watch-player"
                                     data-playback-id="@muxPlaybackId"
                                     data-title="@currentContent.Title"
                                     aria-label="@currentContent.Title video player">
                                    <div class="ciit-video-fallback">
                                        <i class="bi bi-play-circle"></i>
                                        <span>Preparing video player…</span>
                                        <a href="@videoUrl" target="_blank" rel="noopener noreferrer" class="ciit-video-fallback-link">Open video in a new tab</a>
                                    </div>
                                </div>
                            }
                            else if (isDirectVideoFile)
                            {
                                var videoType = videoExtension.Equals(".webm", StringComparison.OrdinalIgnoreCase)
                                    ? "video/webm"
                                    : videoExtension.Equals(".mov", StringComparison.OrdinalIgnoreCase)
                                        ? "video/quicktime"
                                        : "video/mp4";

                                <div class="ciit-learning-video-frame ciit-learning-direct-video-frame">
                                    <video controls preload="metadata" playsinline>
                                        <source src="@videoUrl" type="@videoType" />
                                        Your browser does not support embedded video.
                                    </video>
                                </div>
                            }
                            else
                            {
                                <div class="ratio ratio-16x9 ciit-learning-video-frame">
                                    <iframe src="@videoUrl"
                                            title="@currentContent.Title video"
                                            loading="lazy"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            referrerpolicy="strict-origin-when-cross-origin"
                                            allowfullscreen></iframe>
                                </div>
                            }
                        </section>
                    }

                    @if (!string.IsNullOrWhiteSpace(currentContent.Slides))
                    {
                        <section class="ciit-learning-resource" data-learning-panel-content="content" data-learning-content-page="slides">
                            <div class="ciit-learning-resource-title">
                                <span class="ciit-learning-resource-icon"><i class="bi bi-file-earmark-slides"></i></span>
                                <div>
                                    <h3>Study material</h3>
                                    <p>Review the slides and keep your learning on track.</p>
                                </div>
                            </div>

                            <a href="@ResolveResourceUrl(currentContent.Slides, "slides")"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="ciit-learning-open-resource">
                                <span class="ciit-learning-open-resource-icon">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </span>
                                <span>
                                    <strong>Open lesson slides</strong>
                                    <small>Opens in a new tab</small>
                                </span>
                                <i class="bi bi-arrow-up-right ms-auto"></i>
                            </a>
                        </section>
                    }

                    <section class="ciit-learning-resource ciit-learning-all-assessments" data-learning-panel-content="assessment">
                        <div class="ciit-learning-resource-title">
                            <span class="ciit-learning-resource-icon"><i class="bi bi-patch-check"></i></span>
                            <div><h3>Chapter Assessments</h3><p>MCQs, interview questions and practice programs for this chapter.</p></div>
                        </div>
                        @if (currentChapter is not null)
                        {
                                var assessmentChapter = currentChapter;
                                <section class="ciit-learning-chapter-assessment" id="chapter-assessment-@assessmentChapter.Id">
                                    <h4>@FormatLearningTitle(assessmentChapter.Title)</h4>


                                    <section id="chapter-mcqs-@assessmentChapter.Id" class="ciit-learning-assessment-subsection">
                                        <h5>MCQs</h5>
                                        @if (topicAssessmentQuestions.Count == 0)
                                        {
                                            <p class="ciit-learning-category-empty">No MCQs have been added to this topic yet.</p>
                                        }
                                        else
                                        {
                                            <section id="lesson-assessment" class="ciit-learning-resource ciit-learning-assessment-section">
                                                <div class="ciit-learning-resource-title">
                                                    <span class="ciit-learning-resource-icon"><i class="bi bi-patch-check"></i></span>
                                                    <div>
                                                        <h3>Knowledge check</h3>
                                                        <p>Your answers are evaluated securely when you submit.</p>
                                                    </div>
                                                    <span class="ciit-learning-question-count">
                                                        @topicAssessmentQuestions.Count question@(topicAssessmentQuestions.Count == 1 ? "" : "s")
                                                    </span>
                                                </div>
                                                @if (TempData["AssessmentError"] is string assessmentError)
                                                {
                                                    <div class="alert alert-warning ciit-assessment-error" role="alert">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@assessmentError
                                                    </div>
                                                }
                                                @if (User.IsInRole("Student"))
                                                {
                                                    <form asp-controller="Courses"
                                                          asp-action="SubmitAssessment"
                                                          asp-route-id="@Model.Id"
                                                          asp-route-topicId="@currentTopic!.Id"
                                                          method="post"
                                                          class="ciit-assessment-form">
                                                        @for (var i = 0; i < topicAssessmentQuestions.Count; i++)
                                                        {
                                                            var question = topicAssessmentQuestions[i];
                                                            <input type="hidden" name="answers[@i].QuestionId" value="@question.Id" />
                                                            <div class="ciit-learning-question">
                                                                <strong class="ciit-learning-question-title">
                                                                    <span>@(i + 1)</span>
                                                                    @question.Question
                                                                </strong>
                                                                <div class="ciit-learning-options">
                                                                    @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                                                                    {
                                                                        var option = question.Options[optionIndex];
                                                                        if (!string.IsNullOrWhiteSpace(option))
                                                                        {
                                                                            <label>
                                                                                <input type="radio" name="answers[@i].SelectedOptionNumber" value="@(optionIndex + 1)" required />
                                                                                <span class="ciit-learning-option-letter">@((char)('A' + optionIndex))</span>
                                                                                <span>@option</span>
                                                                            </label>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        <div class="ciit-assessment-submit-row">
                                                            <p><i class="bi bi-shield-check me-2"></i>Correct answers stay hidden until after submission.</p>
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="bi bi-send-check me-2"></i>Submit assessment
                                                            </button>
                                                        </div>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="ciit-assessment-signin">
                                                        <div>
                                                            <strong>Ready to test your knowledge?</strong>
                                                            <p>Sign in with your student account to submit answers and save your result.</p>
                                                        </div>
                                                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                                                            <i class="bi bi-box-arrow-in-right me-2"></i>Student sign in
                                                        </a>
                                                    </div>
                                                }
                                            </section>
                                        }
                                    </section>
                                    <section id="chapter-interview-@assessmentChapter.Id" class="ciit-learning-assessment-subsection">
                                        <h5>Interview Questions</h5>
                                        @if (assessmentChapter.InterviewQuestions.Count == 0)
                                        {
                                            <p class="ciit-learning-category-empty">No interview questions are linked to this chapter yet.</p>
                                        }
                                        else
                                        {
                                            @for (var qi = 0; qi < assessmentChapter.InterviewQuestions.Count; qi++)
                                            {
                                                var q = assessmentChapter.InterviewQuestions[qi];
                                                <article class="ciit-learning-assessment-question">
                                                    <strong>@(qi + 1). @q.Question</strong>
                                                    @if (!string.IsNullOrWhiteSpace(q.Answer)) { <p>@q.Answer</p> }
                                                </article>
                                            }
                                        }
                                    </section>
                                    <section id="chapter-practice-@assessmentChapter.Id" class="ciit-learning-assessment-subsection">
                                        <h5>Practice Programs</h5>
                                        @if (assessmentChapter.PracticeQuestions.Count == 0)
                                        {
                                            <p class="ciit-learning-category-empty">No practice programs are linked to this chapter yet.</p>
                                        }
                                        else
                                        {
                                            @for (var qi = 0; qi < assessmentChapter.PracticeQuestions.Count; qi++)
                                            {
                                                var q = assessmentChapter.PracticeQuestions[qi];
                                                <article class="ciit-learning-assessment-question">
                                                    <strong>@(qi + 1). @q.QuestionTitle</strong>
                                                    <div class="ciit-practice-import-description">@q.QuestionDescription</div>
                                                </article>
                                            }
                                        }
                                    </section>
                                </section>
                        }
                    </section>
                </article>
            </main>
        </div>
    </section>
}
@if (User.IsInRole("Student") && ViewBag.ShowExamApplicationModal == true && currentTopic is not null)
{
    <div class="modal fade" id="topicExamApplicationModal" tabindex="-1" aria-labelledby="topicExamApplicationTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="text-uppercase text-primary small fw-bold">Topic completed</span>
                        <h2 class="modal-title fs-5 mt-1" id="topicExamApplicationTitle">Apply for @currentTopic.Title examination</h2>
                    </div>
                </div>
                <form asp-controller="StudentExaminations" asp-action="Schedule" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p>Your topic is complete. Schedule your 50-question examination. You can revise this topic while waiting for the scheduled time.</p>
                        <input type="hidden" name="CourseId" value="@Model.Id" />
                        <input type="hidden" name="TopicId" value="@currentTopic.Id" />
                        <input type="hidden" name="TimezoneOffsetMinutes" class="exam-timezone-offset" />
                        <label class="form-label" for="topicExamScheduledAt">Exam date and time</label>
                        <input class="form-control" type="datetime-local" id="topicExamScheduledAt" name="ScheduledAtLocal" required />
                        <div class="form-text">The exam instructions button opens 30 minutes before your scheduled time. The exam itself starts only at the scheduled time.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Later</button>
                        <button type="submit" class="btn btn-primary" formaction="/Examinations/StartNow" formnovalidate>Start now <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
                        <button type="submit" class="btn btn-outline-primary">Schedule examination</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
