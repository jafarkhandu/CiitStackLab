@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var currentTopic = Model.Topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? Model.Topics.FirstOrDefault(topic => topic.Contents.Any(content => content.Id == Model.CurrentContentId));
    var currentContentId = Model.CurrentContentId;
    var learningProgress = Model.Progress;
    var completedContentIds = learningProgress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var topics = Model.Topics.ToList();
    var allowedTopicId = ViewBag.AllowedTopicId as int?;
    var allowedTopicPosition = allowedTopicId.HasValue
        ? topics.FindIndex(topic => topic.Id == allowedTopicId.Value)
        : -1;

    string FormatLearningTitle(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var title = value.Trim();
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=[a-z0-9])(?=[A-Z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=[A-Z])(?=[A-Z][a-z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=\d)(?=[A-Z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?<=\d)(?=[a-z])", " ");
        title = System.Text.RegularExpressions.Regex.Replace(title, @"(?i)andthe", "and the");
        return System.Text.RegularExpressions.Regex.Replace(title, @"\s{2,}", " ");
    }

    string ResolveResourceUrl(string? value, string folder)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var resource = value.Trim().Replace('\\', '/');
        if (Uri.TryCreate(resource, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)) return resource;
        if (resource.StartsWith("~/", StringComparison.Ordinal)) return resource[1..];
        if (resource.StartsWith("/", StringComparison.Ordinal)) return resource;
        if (resource.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return "/" + resource;
        return $"/uploads/{folder}/{Uri.EscapeDataString(System.IO.Path.GetFileName(resource))}";
    }
}
<aside class="ciit-learning-sidebar" aria-label="Course chapters and resources">
    <div class="ciit-learning-sidebar-head">
        <div>
            <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
            <h2>Chapters &amp; Resources</h2>
        </div>
        <span class="ciit-learning-count">@Model.ContentCount</span>
    </div>
    <div class="ciit-learning-sidebar-scroll">
        @for (var topicIndex = 0; topicIndex < topics.Count; topicIndex++)
        {
            var topic = topics[topicIndex];
            var topicContents = topic.Contents
                .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
                .DistinctBy(content => content.Id)
                .ToList();
            var completedCount = topicContents.Count(content => completedContentIds.Contains(content.Id));
            var topicComplete = topicContents.Count > 0 && completedCount == topicContents.Count;
            var progress = topicContents.Count == 0 ? 0 :
                (int)Math.Round(completedCount * 100d / topicContents.Count, MidpointRounding.AwayFromZero);
            var isCurrentTopic = currentTopic?.Id == topic.Id;
            var isLocked = User.IsInRole("Student") && allowedTopicPosition >= 0 && topicIndex > allowedTopicPosition;
            var chapterContentIds = topic.Chapters.SelectMany(chapter => chapter.Contents).Select(content => content.Id).ToHashSet();
            var additionalContents = topic.Contents.Where(content => !chapterContentIds.Contains(content.Id)).ToList();

            <details class="ciit-learning-topic @(isCurrentTopic ? "is-active-topic" : "") @(isLocked ? "is-locked-topic" : "")"
                     data-topic-first-content-url="@Url.Action("Learn", "Courses", new { id = Model.Id, topicId = topic.Id })"
                     open="@(isCurrentTopic ? "open" : null)">
                <summary class="ciit-learning-topic-heading">
                    <div class="ciit-learning-topic-icon"><i class="bi @(isLocked ? "bi-lock-fill" : "bi-collection-play")"></i></div>
                    <div class="ciit-learning-topic-heading-text @(topicComplete ? "is-completed" : "")">
                        <strong>@topic.Title</strong>
                        @if (topicComplete)
                        {
                            <span class="ciit-learning-topic-completed" title="Topic completed" aria-label="Topic completed"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
                        }
                        <span>@topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")</span>
                    </div>
                </summary>
                @if (User.IsInRole("Student") && learningProgress is not null && topicContents.Count > 0)
                {
                    <div class="ciit-learning-topic-progress">
                        <div class="ciit-learning-topic-progress-labels"><span>Topic progress</span><strong>@completedCount / @topicContents.Count</strong></div>
                        <div class="ciit-learning-topic-progress-track" role="progressbar" aria-label="@topic.Title completion" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                            <span style="width: @progress%"></span>
                        </div>
                    </div>
                }
                @for (var chapterIndex = 0; chapterIndex < topic.Chapters.Count; chapterIndex++)
                {
                    var chapter = topic.Chapters[chapterIndex];
                    var chapterResourceCount = (chapter.HasNotes ? 1 : 0)
                        + chapter.Contents.Count + chapter.Questions.Count
                        + chapter.InterviewQuestions.Count + chapter.PracticeQuestions.Count;
                    var chapterIsCurrent = currentContentId.HasValue && chapter.Contents.Any(content => content.Id == currentContentId.Value);
                    <details class="ciit-learning-chapter" open="@(chapterIsCurrent ? "open" : null)">
                        <summary class="ciit-learning-chapter-summary">
                            <span class="ciit-learning-chapter-number">@((chapterIndex + 1).ToString("00"))</span>
                            <span class="ciit-learning-chapter-title"><strong>@FormatLearningTitle(chapter.Title)</strong><small>@chapterResourceCount resource@(chapterResourceCount == 1 ? "" : "s")</small></span>
                            <i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i>
                        </summary>
                        <div class="ciit-learning-chapter-body ciit-learning-chapter-categories">
                            <button type="button" class="ciit-learning-category-link ciit-learning-category-notes" data-learning-panel="notes" data-chapter-id="@chapter.Id">
                                <span class="ciit-learning-category-icon"><i class="bi bi-journal-text"></i></span>
                                <span class="ciit-learning-category-copy"><strong>Notes</strong><small>Chapter notes</small></span>
                                <i class="bi bi-arrow-right ciit-learning-category-arrow"></i>
                            </button>
                            <details class="ciit-learning-category">
                                <summary class="ciit-learning-category-heading">
                                    <span class="ciit-learning-category-icon"><i class="bi bi-play-btn"></i></span>
                                    <span class="ciit-learning-category-copy"><strong>Content</strong><small>Slides and video lessons</small></span>
                                    <span class="ciit-learning-category-count">@chapter.Contents.Count</span>
                                    <i class="bi bi-chevron-down ciit-learning-disclosure-icon"></i>
                                </summary>
                                <div class="ciit-learning-category-body">
                                    @if (chapter.Contents.Count == 0)
                                    {
                                        <p class="ciit-learning-category-empty">No video or slide content is linked to this chapter yet.</p>
                                    }
                                    @foreach (var content in chapter.Contents)
                                    {
                                        <div class="ciit-learning-content-item">
                                            <div class="ciit-learning-content-item-title"><i class="bi bi-collection-play"></i><strong>@content.Title</strong></div>
                                            <div class="ciit-learning-resource-links">
                                                @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                                {
                                                    <a href="@ResolveResourceUrl(content.VideoName, "videos")" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-circle"></i> Watch video</a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(content.Slides))
                                                {
                                                    <a href="@ResolveResourceUrl(content.Slides, "slides")" target="_blank" rel="noopener noreferrer"><i class="bi bi-file-earmark-slides"></i> Open slides</a>
                                                }
                                                @if (string.IsNullOrWhiteSpace(content.VideoName) && string.IsNullOrWhiteSpace(content.Slides))
                                                {
                                                    <span class="ciit-learning-resource-unavailable"><i class="bi bi-info-circle"></i> No video or slides linked</span>
                                                }
                                            </div>
                                            <a asp-action="Learn" asp-route-id="@Model.Id" asp-route-contentId="@content.Id" class="ciit-learning-open-lesson @(content.Id == currentContentId ? "is-current" : "")">
                                                <i class="bi bi-play-circle"></i>@(content.Id == currentContentId ? "Currently learning" : "Open lesson")
                                            </a>
                                        </div>
                                    }
                                </div>
                            </details>
                            <div class="ciit-learning-assessment-links">
                                <a class="ciit-learning-category-link" href="#chapter-mcqs-@chapter.Id" data-learning-panel="assessment"><span class="ciit-learning-category-icon"><i class="bi bi-ui-radios-grid"></i></span><span class="ciit-learning-category-copy"><strong>MCQs</strong><small>@chapter.Questions.Count questions</small><span class="ciit-learning-category-count">@chapter.Questions.Count</span></span><i class="bi bi-arrow-right ciit-learning-category-arrow"></i></a>
                                <a class="ciit-learning-category-link" href="#chapter-interview-@chapter.Id" data-learning-panel="assessment"><span class="ciit-learning-category-icon"><i class="bi bi-chat-square-text"></i></span><span class="ciit-learning-category-copy"><strong>Interview Questions</strong><small>@chapter.InterviewQuestions.Count questions</small><span class="ciit-learning-category-count">@chapter.InterviewQuestions.Count</span></span><i class="bi bi-arrow-right ciit-learning-category-arrow"></i></a>
                                <a class="ciit-learning-category-link" href="#chapter-practice-@chapter.Id" data-learning-panel="assessment"><span class="ciit-learning-category-icon"><i class="bi bi-code-square"></i></span><span class="ciit-learning-category-copy"><strong>Practice Programs</strong><small>@chapter.PracticeQuestions.Count questions</small><span class="ciit-learning-category-count">@chapter.PracticeQuestions.Count</span></span><i class="bi bi-arrow-right ciit-learning-category-arrow"></i></a>
                            </div>
                        </div>
                    </details>
                }
                @if (additionalContents.Count > 0)
                {
                    <details class="ciit-learning-chapter ciit-learning-additional">
                        <summary class="ciit-learning-chapter-summary"><span class="ciit-learning-chapter-number"><i class="bi bi-collection"></i></span><span class="ciit-learning-chapter-title"><strong>Additional lessons</strong><small>@additionalContents.Count lesson@(additionalContents.Count == 1 ? "" : "s")</small></span><i class="bi bi-chevron-down ciit-learning-disclosure-icon" aria-hidden="true"></i></summary>
                        <div class="ciit-learning-chapter-body">
                            @foreach (var content in additionalContents)
                            {
                                <div class="ciit-learning-additional-row">
                                    <a asp-action="Learn" asp-route-id="@Model.Id" asp-route-contentId="@content.Id" class="ciit-learning-additional-link @(content.Id == currentContentId ? "is-current" : "")"><i class="bi bi-play-circle"></i><span>@content.Title</span></a>
                                    @if (completedContentIds.Contains(content.Id))
                                    {
                                        <span class="ciit-learning-completed-indicator" title="Lesson completed"><i class="bi bi-check-circle-fill"></i></span>
                                    }
                                    <div class="ciit-learning-additional-meta">
                                        @if (!string.IsNullOrWhiteSpace(content.VideoName))
                                        {
                                            <a href="@ResolveResourceUrl(content.VideoName, "videos")" target="_blank" rel="noopener noreferrer" aria-label="Open video for @content.Title" title="Open video"><i class="bi bi-play-btn"></i></a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(content.Slides))
                                        {
                                            <a href="@ResolveResourceUrl(content.Slides, "slides")" target="_blank" rel="noopener noreferrer" aria-label="Open slides for @content.Title" title="Open slides"><i class="bi bi-file-earmark-slides"></i></a>
                                        }
                                        @if (content.Questions.Count > 0)
                                        {
                                            <span title="Assessment questions"><i class="bi bi-patch-question"></i> @content.Questions.Count</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                }
            </details>
        }
    </div>
</aside>
