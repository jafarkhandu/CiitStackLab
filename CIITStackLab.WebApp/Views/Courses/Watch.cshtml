@{
    Layout = "_CourseLayout";
    ViewData["Title"] = $"Watch — {ViewData["VideoTitle"]}";

    var playbackId = ViewData["MuxPlaybackId"]?.ToString() ?? string.Empty;
    var videoTitle = ViewData["VideoTitle"]?.ToString() ?? "Video lesson";
    var courseTitle = ViewData["CourseTitle"]?.ToString() ?? "Course video";
    var courseId = ViewData["CourseId"]?.ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/mux-watch.css" asp-append-version="true" />
}

<section class="ciit-watch-page">
    <div class="ciit-watch-container">
        <a asp-controller="Courses"
           asp-action="Learn"
           asp-route-id="@courseId"
           class="ciit-watch-back-link">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Learn</span>
        </a>

        <main class="ciit-watch-main">
            <section class="ciit-watch-player-card" aria-label="Video player">
                <div class="ciit-mux-watch-player"
                     data-playback-id="@playbackId"
                     data-title="@videoTitle">
                </div>
            </section>

            <section class="ciit-watch-video-info">
                <span class="ciit-watch-eyebrow">VIDEO LESSON</span>
                <h1>@videoTitle</h1>
                <p><i class="bi bi-collection-play me-1"></i>@courseTitle</p>
            </section>
        </main>
    </div>
</section>
