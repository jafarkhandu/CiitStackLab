@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    Layout = action.Equals("CourseHome", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Curriculum", StringComparison.OrdinalIgnoreCase)
        || action.Equals("Learn", StringComparison.OrdinalIgnoreCase)
        ? "~/Views/Shared/_CourseLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}
