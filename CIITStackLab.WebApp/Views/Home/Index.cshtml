@{
    ViewData["Title"] = "Home";
}

<section class="ciit-hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT CONTENT -->
            <div class="col-lg-6">

                <h1 class="ciit-hero-title">
                    Master Programming
                    <br />
                    with
                    <span>CIIT</span>
                </h1>

                <p class="ciit-hero-description">
                    Learn programming through interactive tutorials,
                    hands-on coding practice and real-world projects.
                    Build your skills step by step with CIIT Training Institute.
                    Designed for beginners, students, developers and career changers.
                </p>

                <div class="ciit-hero-buttons">

                    <a href="#tutorials"
                       class="btn btn-primary btn-lg ciit-primary-btn">
                        Explore All Tutorials
                    </a>

                    <a href="#compiler"
                       class="btn btn-outline-dark btn-lg ciit-secondary-btn">

                        <i class="bi bi-play-circle me-2"></i>
                        Try Code Runner

                    </a>

                </div>


                <!-- STATS -->
                <div class="ciit-stats-row">

                    <div class="ciit-stat">

                        <h4>50K+</h4>
                        <span>Learners</span>

                    </div>

                    <div class="ciit-stat">

                        <h4>100+</h4>
                        <span>Projects</span>

                    </div>

                    <div class="ciit-stat">

                        <h4>4.9 ★</h4>
                        <span>Rating</span>

                    </div>

                </div>

            </div>


            <!-- RIGHT SLIDER -->
            <div class="col-lg-6">

                <div class="ciit-hero-slider" id="ciitHeroSlider">

                    <!-- SLIDE 1 -->
                    <div class="ciit-hero-slide active">

                        <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80"
                             alt="Web Development" />

                        <div class="ciit-hero-overlay"></div>

                        <div class="ciit-slide-content">

                            <span class="ciit-slide-category">
                                WEB DEVELOPMENT
                            </span>

                            <h2>HTML</h2>

                            <p>
                                Build the foundation of modern websites.
                            </p>

                        </div>

                    </div>


                    <!-- SLIDE 2 -->
                    <div class="ciit-hero-slide">

                        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80"
                             alt="JavaScript" />

                        <div class="ciit-hero-overlay"></div>

                        <div class="ciit-slide-content">

                            <span class="ciit-slide-category">
                                PROGRAMMING
                            </span>

                            <h2>JavaScript</h2>

                            <p>
                                Create interactive web applications.
                            </p>

                        </div>

                    </div>


                    <!-- SLIDE 3 -->
                    <div class="ciit-hero-slide">

                        <img src="https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=1200&q=80"
                             alt="Python Programming" />

                        <div class="ciit-hero-overlay"></div>

                        <div class="ciit-slide-content">

                            <span class="ciit-slide-category">
                                DATA & AI
                            </span>

                            <h2>Python</h2>

                            <p>
                                Learn programming, automation and data science.
                            </p>

                        </div>

                    </div>


                    <!-- SLIDE 4 -->
                    <div class="ciit-hero-slide">

                        <img src="https://images.unsplash.com/photo-1516116216624-53e697fedbea?auto=format&fit=crop&w=1200&q=80"
                             alt="C Sharp .NET" />

                        <div class="ciit-hero-overlay"></div>

                        <div class="ciit-slide-content">

                            <span class="ciit-slide-category">
                                SOFTWARE DEVELOPMENT
                            </span>

                            <h2>C# .NET</h2>

                            <p>
                                Build modern enterprise applications.
                            </p>

                        </div>

                    </div>


                    <!-- SLIDE 5 -->
                    <div class="ciit-hero-slide">

                        <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80"
                             alt="Full Stack Development" />

                        <div class="ciit-hero-overlay"></div>

                        <div class="ciit-slide-content">

                            <span class="ciit-slide-category">
                                FULL STACK
                            </span>

                            <h2>Full Stack Development</h2>

                            <p>
                                Learn frontend, backend and modern development tools.
                            </p>

                        </div>

                    </div>


                    <!-- DOTS -->
                    <div class="ciit-slider-dots">

                        <button type="button"
                                class="ciit-slider-dot active"
                                data-slide="0"
                                aria-label="Slide 1"></button>

                        <button type="button"
                                class="ciit-slider-dot"
                                data-slide="1"
                                aria-label="Slide 2"></button>

                        <button type="button"
                                class="ciit-slider-dot"
                                data-slide="2"
                                aria-label="Slide 3"></button>

                        <button type="button"
                                class="ciit-slider-dot"
                                data-slide="3"
                                aria-label="Slide 4"></button>

                        <button type="button"
                                class="ciit-slider-dot"
                                data-slide="4"
                                aria-label="Slide 5"></button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
