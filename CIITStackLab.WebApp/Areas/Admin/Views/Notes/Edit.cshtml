@model CIITStackLab.Application.DTOs.AdminNotesDto

@{
    ViewData["Title"] = "Edit HTML";
    var message = TempData["AdminNotesMessage"] as string;
    var messageType = TempData["AdminNotesMessageType"] as string;
    var htmlContent = ViewData["HtmlContent"] as string ?? Model.HtmlContent ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-notes.css" asp-append-version="true" />
}

<section class="ciit-notes-page ciit-notes-editor-page">
    <div class="ciit-notes-header">
        <div>
            <a asp-area="Admin" asp-controller="Notes" asp-action="Index" class="ciit-notes-back-link">
                <i class="bi bi-arrow-left"></i> Back to Notes
            </a>
            <span class="ciit-notes-eyebrow">HTML Content</span>
            <h1>@Model.Title</h1>
            <p>@Model.CourseTitle <span>·</span> @Model.TopicTitle</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-notes-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert">
            <i class="bi @(messageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
            <span>@message</span>
        </div>
    }

    <div class="ciit-notes-editor-layout">
        <section class="ciit-notes-editor-card">
            <div class="ciit-notes-editor-head">
                <div>
                    <span class="ciit-notes-eyebrow">HTML body</span>
                    <h2>Lesson HTML</h2>
                </div>
                <span class="ciit-notes-content-id">Content #@Model.Id</span>
            </div>

            <div class="ciit-notes-editor-help">
                <i class="bi bi-info-circle-fill"></i>
                <span>Paste the HTML fragment that should appear in this lesson. Include the markup and any styles the lesson requires. Do not paste <code>&lt;html&gt;</code>, <code>&lt;head&gt;</code> or <code>&lt;body&gt;</code> wrappers.</span>
            </div>

            <form asp-area="Admin" asp-controller="Notes" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="ciit-notes-field">
                    <label for="HtmlContent">HTML code</label>
                    <textarea id="HtmlContent"
                              name="HtmlContent"
                              spellcheck="false"
                              autocomplete="off"
                              placeholder="Paste lesson HTML here...">@htmlContent</textarea>
                    <div class="ciit-notes-field-footer">
                        <span>Stored against this existing course lesson.</span>
                        <span id="htmlCharCount">@htmlContent.Length characters</span>
                    </div>
                    @Html.ValidationMessage("HtmlContent", null, new { @class = "text-danger" })
                </div>

                <div class="ciit-notes-editor-actions">
                    <a asp-area="Admin" asp-controller="Notes" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="ciit-notes-save-btn">
                        <i class="bi bi-check2-circle"></i>
                        Save HTML
                    </button>
                </div>
            </form>
        </section>

        <aside class="ciit-notes-context-card">
            <span class="ciit-notes-eyebrow">Where this goes</span>
            <h2>Learning Site</h2>
            <dl>
                <div><dt>Course</dt><dd>@Model.CourseTitle</dd></div>
                <div><dt>Topic</dt><dd>@Model.TopicTitle</dd></div>
                <div><dt>Lesson</dt><dd>@Model.Title</dd></div>
            </dl>
            <p>The saved body is loaded from the database when this lesson is displayed, so the learning page no longer needs that lesson's HTML hardcoded in the Razor view.</p>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const editor = document.getElementById('HtmlContent');
            const counter = document.getElementById('htmlCharCount');
            if (!editor || !counter) return;

            const updateCount = () => {
                counter.textContent = `${editor.value.length.toLocaleString()} characters`;
            };

            editor.addEventListener('input', updateCount);
            updateCount();
        })();
    </script>
}
