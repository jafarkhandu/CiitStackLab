@model CIITStackLab.Application.DTOs.AdminNoteInputDto
@using CIITStackLab.Application.DTOs

@{
    var options = (IReadOnlyList<NoteTopicOptionDto>)(ViewBag.Options ?? Array.Empty<NoteTopicOptionDto>());
    var edit = Model.Id > 0;
}

<section class="ciit-notes-page ciit-notes-editor-page">
    <div class="ciit-notes-header">
        <div>
            <a asp-area="Admin"
               asp-controller="Notes"
               asp-action="Index"
               class="ciit-notes-back-link">
                <i class="bi bi-arrow-left"></i>
                Back to Notes
            </a>

            <span class="ciit-notes-eyebrow">
                @(edit ? "Edit chapter" : "New chapter")
            </span>

            <h1>@ViewData["Title"]</h1>

            <p>
                Notes, HTML, videos and slides now share the same content record.
            </p>
        </div>
    </div>

    <section>
        <form asp-area="Admin"
              asp-controller="Notes"
              asp-action="@(edit ? "Edit" : "Create")"
              method="post"
              enctype="multipart/form-data"
              class="ciit-notes-editor-card ciit-content-form-card">

            @Html.AntiForgeryToken()
            <input type="hidden" name="vimeoVideoUrl" class="js-vimeo-video-url" />

            @if (edit)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="ciit-notes-form-grid">
                <div class="ciit-notes-field">
                    <label asp-for="TopicId">Topic</label>

                    <select asp-for="TopicId"
                            class="form-select"
                            required>
                        <option value="">Select topic</option>

                        @foreach (var option in options)
                        {
                            <option value="@option.TopicId">
                                @option.TopicTitle
                            </option>
                        }
                    </select>

                    <span asp-validation-for="TopicId"
                          class="text-danger"></span>
                </div>

                <div class="ciit-notes-field">
                    <label asp-for="Title"></label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Introduction" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="ciit-notes-field">
                <label asp-for="HtmlContent">Chapter Content</label>

                <textarea asp-for="HtmlContent"
                          class="ciit-notes-html-editor"
                          spellcheck="false"
                          placeholder="Paste the Notes HTML fragment here..."></textarea>

                <span asp-validation-for="HtmlContent"
                      class="text-danger"></span>
            </div>

            <div class="ciit-notes-media-grid">
                <div class="ciit-notes-field">
                    <label for="slidesFile">Slides (PDF)</label>
                    <input type="file" id="slidesFile" name="slidesFile" class="form-control" accept=".pdf,application/pdf" />
                    @if (edit && !string.IsNullOrWhiteSpace(Model.Slides))
                    {
                        <small>Current slides: @System.IO.Path.GetFileName(Model.Slides)</small>
                    }
                    <small>Optional. Upload a PDF to attach or replace slides.</small>
                </div>
                <div class="ciit-notes-field">
                    <label for="videoFile">Video</label>
                    <input type="file" id="videoFile" name="videoFile" class="form-control" accept=".mp4,.webm,.mov" />
                    @if (edit && !string.IsNullOrWhiteSpace(Model.VideoName))
                    {
                        <small>Video already attached to this note.</small>
                    }
                    <small>Optional. Video uploads directly to Vimeo.</small>
                </div>
            </div>

            <div class="ciit-notes-editor-actions">
                <a asp-area="Admin"
                   asp-controller="Notes"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button class="ciit-notes-primary-btn"
                        type="submit">
                    <i class="bi bi-check2-circle"></i>
                    @(edit ? "Save Changes" : "Create Note")
                </button>
            </div>
        </form>
    </section>
</section>

