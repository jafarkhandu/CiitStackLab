@model CIITStackLab.Application.DTOs.AdminNoteInputDto
@using CIITStackLab.Application.DTOs
@{var options=(IReadOnlyList<NoteCourseTopicOptionDto>)(ViewBag.Options??Array.Empty<NoteCourseTopicOptionDto>());var edit=Model.Id>0;}
<section class="ciit-notes-page ciit-notes-editor-page"><div class="ciit-notes-header"><div><a asp-area="Admin" asp-controller="Notes" asp-action="Index" class="ciit-notes-back-link"><i class="bi bi-arrow-left"></i> Back to Notes</a><span class="ciit-notes-eyebrow">@(edit?"Edit chapter":"New chapter")</span><h1>@ViewData["Title"]</h1><p>Notes are independent from lessons, videos, slides and MCQs.</p></div></div>
<section class="ciit-notes-editor-card"><form asp-area="Admin" asp-controller="Notes" asp-action="@(edit?"Edit":"Create")" method="post">@Html.AntiForgeryToken()@if(edit){<input type="hidden" asp-for="Id" />}<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="ciit-notes-form-grid"><div class="ciit-notes-field"><label>Course & Topic</label><select id="courseTopic" class="form-select" required><option value="">Select mapped course topic</option>@foreach(var o in options){<option value="@($"{o.CourseId}:{o.TopicId}")" selected="@(o.CourseId==Model.CourseId&&o.TopicId==Model.TopicId)">@o.CourseTitle → @o.TopicTitle</option>}</select><input type="hidden" asp-for="CourseId" id="CourseId"/><input type="hidden" asp-for="TopicId" id="TopicId"/></div><div class="ciit-notes-field"><label asp-for="PageId"></label><input asp-for="PageId" class="form-control" placeholder="ch1"/><span asp-validation-for="PageId" class="text-danger"/></div><div class="ciit-notes-field"><label asp-for="Title"></label><input asp-for="Title" class="form-control" placeholder="Introduction"/><span asp-validation-for="Title" class="text-danger"/></div><div class="ciit-notes-field"><label asp-for="TitleWithNumber"></label><input asp-for="TitleWithNumber" class="form-control" placeholder="1. Introduction to C#"/><span asp-validation-for="TitleWithNumber" class="text-danger"/></div><div class="ciit-notes-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" class="form-control" type="number" min="1"/><span asp-validation-for="SortOrder" class="text-danger"/></div></div>
<div class="ciit-notes-field"><label asp-for="HtmlContent">Chapter Content</label><textarea asp-for="HtmlContent" class="ciit-notes-html-editor" spellcheck="false" placeholder="Paste the Notes HTML fragment here..."></textarea><span asp-validation-for="HtmlContent" class="text-danger"/></div>
<div class="ciit-notes-editor-actions"><a asp-area="Admin" asp-controller="Notes" asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="ciit-notes-primary-btn" type="submit"><i class="bi bi-check2-circle"></i> @(edit?"Save Changes":"Create Chapter")</button></div></form></section></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const s=document.getElementById('courseTopic'),c=document.getElementById('CourseId'),t=document.getElementById('TopicId');const sync=()=>{const v=s.value.split(':');c.value=v[0]||'';t.value=v[1]||''};s?.addEventListener('change',sync);if(s?.value)sync()})()</script>}