@model IReadOnlyList<CIITStackLab.Application.DTOs.AdminNoteDto>
@using CIITStackLab.Application.DTOs

@{
    ViewData["Title"] = "Notes";

    var message = TempData["AdminNotesMessage"] as string;
    var type = TempData["AdminNotesMessageType"] as string;
    var topicGroups = Model
        .GroupBy(note => new { note.TopicId, note.TopicTitle })
        .OrderBy(group => group.Key.TopicTitle)
        .ToList();
}

<section class="ciit-notes-page">
    <div class="ciit-notes-header">
        <div>
            <span class="ciit-notes-eyebrow">Learning</span>
            <h1>Learning Content Studio</h1>
            <p>Add and organize notes, interview questions, and coding practice for each Notes chapter from one workspace.</p>
        </div>


    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-notes-alert @(type == "success" ? "is-success" : "is-error")">
            <i class="bi @(type == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
            <span>@message</span>
        </div>
    }

    <section class="ciit-notes-content-hub" aria-label="Add learning content">
        <article class="ciit-notes-hub-card ciit-notes-hub-card--notes">
            <div class="ciit-notes-hub-icon"><i class="bi bi-journal-richtext"></i></div>
            <span class="ciit-notes-hub-kicker">01 · Learning material</span>
            <h2>Notes & media</h2>
            <p>Create a chapter with formatted notes, video and slides attached to its topic.</p>
            <a asp-area="Admin" asp-controller="Notes" asp-action="Create" class="ciit-notes-hub-action js-content-modal-link">
                <i class="bi bi-plus-lg"></i> Add chapter
            </a>
        </article>
        <article class="ciit-notes-hub-card ciit-notes-hub-card--interview">
            <div class="ciit-notes-hub-icon"><i class="bi bi-chat-square-text"></i></div>
            <span class="ciit-notes-hub-kicker">02 · Interview preparation</span>
            <h2>Interview questions</h2>
            <p>Add a question and answer to an existing Notes chapter so it stays with its learning content.</p>
            <div class="ciit-notes-hub-actions">
                <button type="button" class="ciit-notes-hub-action" data-bs-toggle="modal" data-bs-target="#createInterviewQuestionModal">
                    <i class="bi bi-plus-lg"></i> Add question
                </button>
                <a asp-area="Admin" asp-controller="Assessments" asp-action="InterviewQuestions" class="ciit-notes-hub-secondary" data-bs-toggle="modal" data-bs-target="#interviewQuestionImportModal">Open analyzer <i class="bi bi-arrow-up-right"></i></a>
            </div>
        </article>
        <article class="ciit-notes-hub-card ciit-notes-hub-card--practice">
            <div class="ciit-notes-hub-icon"><i class="bi bi-code-square"></i></div>
            <span class="ciit-notes-hub-kicker">03 · Hands-on learning</span>
            <h2>Practice programs</h2>
            <p>Add coding problems to a Notes chapter and manage their solutions through the existing practice workspace.</p>
            <div class="ciit-notes-hub-actions">
                <button type="button" class="ciit-notes-hub-action" data-bs-toggle="modal" data-bs-target="#createPracticeProgramModal">
                    <i class="bi bi-plus-lg"></i> Add program
                </button>
                <a asp-area="Admin" asp-controller="Assessments" asp-action="PracticePrograms" class="ciit-notes-hub-secondary" data-bs-toggle="modal" data-bs-target="#practiceProgramImportModal">Open analyzer <i class="bi bi-arrow-up-right"></i></a>
            </div>
        </article>
    </section>

    <section class="ciit-notes-card">
        <div class="ciit-notes-toolbar ciit-notes-toolbar--combined">
            <div class="ciit-notes-search">
                <i class="bi bi-search"></i>
                <input id="notesSearch" type="search" placeholder="Search notes, interview questions, programs..." aria-label="Search all learning content" />
            </div>
            <span id="notesVisibleCount" class="ciit-notes-count">@Model.Count chapters</span>
        </div>
        <div class="ciit-notes-tabs" role="tablist" aria-label="Learning content tables">
            <button type="button" class="ciit-notes-tab is-active" role="tab" aria-selected="true" data-content-tab="all">All results</button>
            <button type="button" class="ciit-notes-tab" role="tab" aria-selected="false" data-content-tab="notes">Notes</button>
            <button type="button" class="ciit-notes-tab" role="tab" aria-selected="false" data-content-tab="interview">Interview Questions</button>
            <button type="button" class="ciit-notes-tab" role="tab" aria-selected="false" data-content-tab="practice">Practice Programs</button>
        </div>
        <div class="ciit-notes-tab-panel is-active" role="tabpanel" data-content-panel="notes">
        <div class="table-responsive">
            <table class="ciit-notes-table">
                <thead>
                    <tr>
                        <th>Topic / Chapter</th>
                        <th>Content ID</th>
                        <th>Title</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var group in topicGroups)
                    {
                        var topicSearch = string.Join(
                            " ",
                            group.Select(note => $"{note.TopicTitle} {note.ChapterId} {note.Title}"));

                        <tr class="ciit-notes-topic-row"
                            data-topic-row
                            data-topic-id="@group.Key.TopicId"
                            data-search="@topicSearch">
                            <td colspan="5">
                                <button type="button"
                                        class="ciit-notes-topic-toggle"
                                        data-notes-topic-toggle
                                        data-topic-id="@group.Key.TopicId"
                                        aria-expanded="false">
                                    <span class="ciit-notes-topic-chevron" aria-hidden="true">
                                        <i class="bi bi-chevron-right"></i>
                                    </span>

                                    <span class="ciit-notes-topic-main">
                                        <strong>@group.Key.TopicTitle</strong>
                                        <small>Topic #@group.Key.TopicId</small>
                                    </span>

                                    <span class="ciit-notes-topic-count">
                                        @group.Count() @(group.Count() == 1 ? "chapter" : "chapters")
                                    </span>
                                </button>
                            </td>
                        </tr>

                        @foreach (var note in group.OrderBy(note => note.Id))
                        {
                            <tr class="ciit-notes-chapter-row"
                                data-chapter-row
                                data-topic-id="@group.Key.TopicId"
                                data-search="@($"{note.TopicTitle} {note.ChapterId} {note.Title}")"
                                hidden>
                                <td>
                                    <div class="ciit-notes-chapter-label">
                                        <span class="ciit-notes-chapter-branch" aria-hidden="true"></span>
                                        <span class="ciit-notes-chapter-index">
                                            <i class="bi bi-journal-text"></i>
                                        </span>
                                        <span>Chapter</span>
                                    </div>
                                </td>

                                <td>
                                    <code>@note.Id</code>
                                </td>

                                <td>
                                    <div class="ciit-notes-name">
                                        <div>
                                            <strong>@note.Title</strong>
                                        </div>
                                    </div>
                                </td>


                                <td>
                                    @((note.UpdatedAt ?? note.CreatedAt)?.ToString("dd MMM yyyy") ?? "—")
                                </td>

                                <td class="text-nowrap">
                                    <a asp-area="Admin"
                                       asp-controller="Notes"
                                       asp-action="Edit"
                                       asp-route-id="@note.Id"
                                       class="ciit-notes-edit-btn js-content-modal-link">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Notes"
                                          asp-action="Delete"
                                          asp-route-id="@note.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this Notes chapter?');">

                                        @Html.AntiForgeryToken()

                                        <button class="ciit-notes-delete-btn"
                                                type="submit"
                                                aria-label="Delete @note.Title">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        </div>

        <div class="ciit-notes-tab-panel ciit-notes-hierarchy-panel" role="tabpanel" data-content-panel="interview" hidden>
            <div class="ciit-notes-panel-heading"><div><h2>Interview Questions</h2><p>Browse questions and answers by topic and Notes chapter.</p></div></div>
            @{
                var interviewIndex = ViewBag.InterviewImportModel as AdminInterviewQuestionIndexDto ?? new AdminInterviewQuestionIndexDto();
            }
            @if (interviewIndex.ActiveQuestions.Count == 0)
            {
                <div class="ciit-notes-empty" data-content-empty="interview"><i class="bi bi-chat-square-text"></i><h3>No interview questions yet</h3><p>Add or analyze questions from the Interview Preparation card above.</p></div>
            }
            else
            {
                <div class="ciit-assessment-tree ciit-notes-content-tree" data-single-open-tree="interview">
                    @foreach (var topicGroup in interviewIndex.ActiveQuestions.GroupBy(x => new { x.TopicId, x.TopicTitle }).OrderBy(x => x.Key.TopicTitle))
                    {
                        var topicName = string.IsNullOrWhiteSpace(topicGroup.Key.TopicTitle) ? "Unassigned topic" : topicGroup.Key.TopicTitle;
                        <details class="ciit-assessment-tree-topic" data-topic-node data-search="@($"{topicName} {string.Join(" ", topicGroup.Select(x => x.Question + " " + x.Answer + " " + x.ChapterTitle))}")">
                            <summary>
                                <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-diagram-3"></i><strong>@topicName</strong></span>
                                <span class="ciit-assessment-tree-count">@topicGroup.Count() @(topicGroup.Count() == 1 ? "question" : "questions")</span>
                            </summary>
                            <div class="ciit-assessment-tree-children">
                                @foreach (var chapterGroup in topicGroup.GroupBy(x => new { x.NoteId, x.ChapterTitle }).OrderBy(x => x.Key.ChapterTitle))
                                {
                                    var chapterName = string.IsNullOrWhiteSpace(chapterGroup.Key.ChapterTitle) ? "Unassigned chapter" : chapterGroup.Key.ChapterTitle;
                                    if (chapterName.StartsWith(topicName + " / ", StringComparison.OrdinalIgnoreCase))
                                    {
                                        chapterName = chapterName.Substring(topicName.Length + 3);
                                    }
                                    <details class="ciit-assessment-tree-chapter" data-chapter-node data-search="@($"{chapterName} {string.Join(" ", chapterGroup.Select(x => x.Question + " " + x.Answer))}")">
                                        <summary>
                                            <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-journal-text"></i><strong>@chapterName</strong></span>
                                            <span class="ciit-assessment-tree-count">@chapterGroup.Count()</span>
                                        </summary>
                                        <div class="ciit-assessment-question-list ciit-notes-content-records">
                                            @foreach (var question in chapterGroup.OrderByDescending(x => x.Id))
                                            {
                                                <article class="ciit-assessment-question-item ciit-assessment-interview-item" data-content-row data-content-type="interview" data-search="@($"{topicName} {chapterName} {question.Id} {question.Question} {question.Answer}")">
                                                    <div class="ciit-assessment-question-copy">
                                                        <strong>@question.Question</strong>
                                                        <span>Question #@question.Id</span>
                                                        <p>@question.Answer</p>
                                                    </div>
                                                    <div class="ciit-mcq-actions">
                                                        <a asp-area="Admin" asp-controller="Assessments" asp-action="EditInterviewQuestion" asp-route-id="@question.Id" title="Edit interview question" aria-label="Edit interview question @question.Id"><i class="bi bi-pencil-square"></i></a>
                                                        <form asp-area="Admin" asp-controller="Assessments" asp-action="DeleteInterviewQuestion" method="post" onsubmit="return confirm('Archive this interview question?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@question.Id" />
                                                            <button type="submit" title="Archive question" aria-label="Archive interview question @question.Id"><i class="bi bi-archive"></i></button>
                                                        </form>
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </details>
                    }
                </div>
                <div class="ciit-notes-empty" data-content-empty="interview" hidden><i class="bi bi-search"></i><h3>No matching interview questions</h3><p>Try another search.</p></div>
            }
        </div>

        <div class="ciit-notes-tab-panel ciit-notes-hierarchy-panel" role="tabpanel" data-content-panel="practice" hidden>
            <div class="ciit-notes-panel-heading"><div><h2>Practice Programs</h2><p>Browse programs and solutions by topic and Notes chapter.</p></div></div>
            @{
                var practiceIndex = ViewBag.PracticeImportModel as AdminPracticeProgramIndexDto ?? new AdminPracticeProgramIndexDto();
            }
            @if (practiceIndex.ActivePrograms.Count == 0)
            {
                <div class="ciit-notes-empty" data-content-empty="practice"><i class="bi bi-code-square"></i><h3>No practice programs yet</h3><p>Add or analyze programs from the Hands-on Learning card above.</p></div>
            }
            else
            {
                <div class="ciit-assessment-tree ciit-notes-content-tree" data-single-open-tree="practice">
                    @foreach (var topicGroup in practiceIndex.ActivePrograms.GroupBy(x => x.TopicTitle).OrderBy(x => x.Key.TopicTitle))
                    {
                        var topicName = string.IsNullOrWhiteSpace(topicGroup.Key) ? "Unassigned topic" : topicGroup.Key;
                        <details class="ciit-assessment-tree-topic" data-topic-node data-search="@($"{topicName} {string.Join(" ", topicGroup.Select(x => x.QuestionTitle + " " + x.QuestionDescription + " " + x.ChapterTitle))}")">
                            <summary>
                                <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-diagram-3"></i><strong>@topicName</strong></span>
                                <span class="ciit-assessment-tree-count">@topicGroup.Count() @(topicGroup.Count() == 1 ? "program" : "programs")</span>
                            </summary>
                            <div class="ciit-assessment-tree-children">
                                @foreach (var chapterGroup in topicGroup.GroupBy(x => new { x.NoteId, x.ChapterTitle }).OrderBy(x => x.Key.ChapterTitle))
                                {
                                    var chapterName = string.IsNullOrWhiteSpace(chapterGroup.Key.ChapterTitle) ? "Unassigned chapter" : chapterGroup.Key.ChapterTitle;
                                    if (chapterName.StartsWith(topicName + " / ", StringComparison.OrdinalIgnoreCase))
                                    {
                                        chapterName = chapterName.Substring(topicName.Length + 3);
                                    }
                                    <details class="ciit-assessment-tree-chapter" data-chapter-node data-search="@($"{chapterName} {string.Join(" ", chapterGroup.Select(x => x.QuestionTitle + " " + x.QuestionDescription))}")">
                                        <summary>
                                            <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-journal-text"></i><strong>@chapterName</strong></span>
                                            <span class="ciit-assessment-tree-count">@chapterGroup.Count()</span>
                                        </summary>
                                        <div class="ciit-practice-list ciit-assessment-practice-list ciit-notes-content-records">
                                            @foreach (var program in chapterGroup.OrderByDescending(x => x.Id))
                                            {
                                                <article class="ciit-practice-program ciit-notes-program" data-content-row data-content-type="practice" data-search="@($"{topicName} {chapterName} {program.Id} {program.QuestionTitle} {program.QuestionDescription} {string.Join(" ", program.Answers.Select(a => a.Answer + " " + a.Description))}")">
                                                    <div class="ciit-practice-program-header">
                                                        <div>
                                                            <span class="ciit-practice-id">#@program.Id</span>
                                                            <h3>@program.QuestionTitle</h3>
                                                            <p class="ciit-practice-meta">@chapterName</p>
                                                        </div>
                                                        <div class="ciit-practice-actions">
                                                            <a asp-area="Admin" asp-controller="Assessments" asp-action="EditPracticeProgram" asp-route-id="@program.Id" title="Edit program"><i class="bi bi-pencil-square"></i></a>
                                                            <button type="button" title="Add solution" data-bs-toggle="modal" data-bs-target="#createPracticeSolutionModal" data-program-question-id="@program.Id"><i class="bi bi-plus-circle"></i></button>
                                                            <form asp-area="Admin" asp-controller="Assessments" asp-action="DeletePracticeProgram" method="post" onsubmit="return confirm('Archive this practice program?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@program.Id" />
                                                                <button type="submit" title="Archive"><i class="bi bi-archive"></i></button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <div class="ciit-practice-description">@program.QuestionDescription</div>
                                                    <div class="ciit-practice-solutions">
                                                        <div class="ciit-practice-solutions-header"><h4>Solutions</h4><span>@program.Answers.Count</span></div>
                                                        @if (program.Answers.Count == 0)
                                                        {
                                                            <p class="ciit-practice-no-solution">No active solution has been added yet.</p>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var answer in program.Answers)
                                                            {
                                                                <div class="ciit-practice-solution">
                                                                    <div><strong>@answer.Answer</strong><p>@answer.Description</p></div>
                                                                    <div class="ciit-practice-actions">
                                                                        <a asp-area="Admin" asp-controller="Assessments" asp-action="EditPracticeAnswer" asp-route-id="@answer.Id" title="Edit solution"><i class="bi bi-pencil-square"></i></a>
                                                                        <form asp-area="Admin" asp-controller="Assessments" asp-action="DeletePracticeAnswer" method="post" onsubmit="return confirm('Archive this solution?');">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="id" value="@answer.Id" />
                                                                            <button type="submit" title="Archive solution"><i class="bi bi-archive"></i></button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    </details>
                                }
                            </div>
                        </details>
                    }
                </div>
                <div class="ciit-notes-empty" data-content-empty="practice" hidden><i class="bi bi-search"></i><h3>No matching practice programs</h3><p>Try another search.</p></div>
            }
        </div>

        <div id="notesSearchEmpty"
             class="ciit-notes-empty"
             hidden>
            <i class="bi bi-search"></i>
            <h3>No matching topics or chapters</h3>
            <p>Try a different topic, chapter ID, or title.</p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="ciit-notes-empty" data-notes-no-data hidden>
                <i class="bi bi-journal-plus"></i>
                <h3>No Notes chapters yet</h3>
                <p>
                    Create your first chapter and attach it to a topic.
                </p>
            </div>
        }
    </section>
</section>

@await Html.PartialAsync("~/Areas/Admin/Views/Assessments/_CreateInterviewQuestionModal.cshtml", ViewBag.InterviewInput as AdminInterviewQuestionInputDto ?? new AdminInterviewQuestionInputDto())
@await Html.PartialAsync("~/Areas/Admin/Views/Assessments/_CreatePracticeProgramModal.cshtml", ViewBag.PracticeInput as AdminPracticeProgramInputDto ?? new AdminPracticeProgramInputDto())
@await Html.PartialAsync("~/Areas/Admin/Views/Assessments/_InterviewQuestionImportModal.cshtml", ViewBag.InterviewImportModel as AdminInterviewQuestionIndexDto ?? new AdminInterviewQuestionIndexDto())
@await Html.PartialAsync("~/Areas/Admin/Views/Assessments/_PracticeProgramImportModal.cshtml", ViewBag.PracticeImportModel as AdminPracticeProgramIndexDto ?? new AdminPracticeProgramIndexDto())

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-content-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-notes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-assessment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-mcqs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-practice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-interview-import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-mcq-import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-practice-import.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin/admin-content-modal.js" asp-append-version="true"></script>
    <script src="~/js/admin-interview-import.js" asp-append-version="true"></script>
    <script src="~/js/admin-practice-import.js" asp-append-version="true"></script>
    <script>
        (() => {
            const searchInput = document.getElementById("notesSearch");
            const count = document.getElementById("notesVisibleCount");
            const tabs = [...document.querySelectorAll("[data-content-tab]")];
            const panels = [...document.querySelectorAll("[data-content-panel]")];
            const noteTopicRows = [...document.querySelectorAll("[data-topic-row]")];
            const noteChapterRows = [...document.querySelectorAll("[data-chapter-row]")];
            const contentRows = [...document.querySelectorAll("[data-content-row]")];
            let activeTab = "all";
            let expandedNotesTopicId = null;

            const noteChaptersFor = id => noteChapterRows.filter(row => row.dataset.topicId === id);
            const setNotesTopic = (id, expanded) => {
                noteTopicRows.forEach(topic => {
                    const open = expanded && topic.dataset.topicId === id;
                    topic.classList.toggle("is-expanded", open);
                    topic.querySelector("[data-notes-topic-toggle]")?.setAttribute("aria-expanded", open ? "true" : "false");
                    noteChaptersFor(topic.dataset.topicId).forEach(row => row.hidden = !open);
                });
                expandedNotesTopicId = expanded ? id : null;
            };

            const closeSiblingDetails = node => {
                const parent = node.parentElement;
                if (!parent) return;
                [...parent.children].forEach(sibling => {
                    if (sibling !== node && sibling.matches("details.ciit-assessment-tree-topic, details.ciit-assessment-tree-chapter")) sibling.open = false;
                });
            };

            document.querySelectorAll("[data-single-open-tree]").forEach(tree => {
                tree.querySelectorAll("details.ciit-assessment-tree-topic, details.ciit-assessment-tree-chapter").forEach(node => {
                    node.addEventListener("toggle", () => {
                        if (node.open) closeSiblingDetails(node);
                    });
                });
            });

            const refresh = () => {
                const query = (searchInput?.value || "").trim().toLowerCase();
                let visibleNotes = 0;
                let visibleInterviews = 0;
                let visiblePrograms = 0;

                const matchingNoteTopic = query
                    ? noteTopicRows.find(topic => (topic.dataset.search || "").toLowerCase().includes(query) ||
                        noteChaptersFor(topic.dataset.topicId).some(row => (row.dataset.search || "").toLowerCase().includes(query)))?.dataset.topicId ?? null
                    : null;

                noteTopicRows.forEach(topic => {
                    const id = topic.dataset.topicId;
                    const topicMatches = (topic.dataset.search || "").toLowerCase().includes(query);
                    const rows = noteChaptersFor(id);
                    const matching = rows.filter(row => (row.dataset.search || "").toLowerCase().includes(query));
                    const showTopic = !query || topicMatches || matching.length > 0;
                    topic.hidden = !showTopic;
                    const shouldExpand = query ? id === matchingNoteTopic : expandedNotesTopicId === id;
                    topic.classList.toggle("is-expanded", shouldExpand);
                    topic.querySelector("[data-notes-topic-toggle]")?.setAttribute("aria-expanded", shouldExpand ? "true" : "false");
                    rows.forEach(row => {
                        row.hidden = !showTopic || !shouldExpand || (query && !(topicMatches || (row.dataset.search || "").toLowerCase().includes(query)));
                        if (!row.hidden) visibleNotes++;
                    });
                });
                if (query && matchingNoteTopic) expandedNotesTopicId = matchingNoteTopic;

                document.querySelectorAll("[data-single-open-tree]").forEach(tree => {
                    const topics = [...tree.querySelectorAll(":scope > details.ciit-assessment-tree-topic")];
                    let firstMatchingTopic = null;
                    topics.forEach(topic => {
                        const topicMatch = (topic.dataset.search || "").toLowerCase().includes(query);
                        const chapters = [...topic.querySelectorAll(":scope > .ciit-assessment-tree-children > details.ciit-assessment-tree-chapter")];
                        let topicHasMatch = !query || topicMatch;
                        chapters.forEach(chapter => {
                            const chapterMatch = (chapter.dataset.search || "").toLowerCase().includes(query);
                            const rows = [...chapter.querySelectorAll("[data-content-row]")];
                            const matchingRows = rows.filter(row => (row.dataset.search || "").toLowerCase().includes(query));
                            const chapterHasMatch = !query || topicMatch || chapterMatch || matchingRows.length > 0;
                            chapter.hidden = !chapterHasMatch;
                            rows.forEach(row => {
                                row.hidden = query.length > 0 && !(topicMatch || chapterMatch || (row.dataset.search || "").toLowerCase().includes(query));
                                if (!row.hidden) {
                                    if (row.dataset.contentType === "interview") visibleInterviews++;
                                    if (row.dataset.contentType === "practice") visiblePrograms++;
                                }
                            });
                            if (chapterHasMatch) topicHasMatch = true;
                            if (query && chapterHasMatch && !firstMatchingTopic) firstMatchingTopic = topic;
                        });
                        topic.hidden = !topicHasMatch;
                    });

                    if (query && firstMatchingTopic) {
                        topics.forEach(topic => topic.open = topic === firstMatchingTopic);
                        const chapters = [...firstMatchingTopic.querySelectorAll(":scope > .ciit-assessment-tree-children > details.ciit-assessment-tree-chapter")];
                        const matchingChapter = chapters.find(chapter => !chapter.hidden);
                        chapters.forEach(chapter => chapter.open = chapter === matchingChapter);
                    }
                });

                tabs.forEach(tab => {
                    const selected = tab.dataset.contentTab === activeTab;
                    tab.classList.toggle("is-active", selected);
                    tab.setAttribute("aria-selected", selected ? "true" : "false");
                });
                panels.forEach(panel => {
                    const selected = activeTab === "all" || panel.dataset.contentPanel === activeTab;
                    panel.hidden = !selected;
                    panel.classList.toggle("is-active", selected);
                });

                if (count) count.textContent = query
                    ? `${visibleNotes} notes · ${visibleInterviews} interview questions · ${visiblePrograms} practice programs`
                    : `${noteChapterRows.length} chapters · ${contentRows.filter(row => row.dataset.contentType === "interview").length} interview questions · ${contentRows.filter(row => row.dataset.contentType === "practice").length} practice programs`;

                const notesEmpty = document.getElementById("notesSearchEmpty");
                const hasNotes = noteTopicRows.some(row => !row.hidden);
                const hasInterview = contentRows.some(row => row.dataset.contentType === "interview" && !row.hidden);
                const hasPractice = contentRows.some(row => row.dataset.contentType === "practice" && !row.hidden);
                if (notesEmpty) notesEmpty.hidden = hasNotes || activeTab === "interview" || activeTab === "practice" || (activeTab === "all" && (hasInterview || hasPractice));
                ["interview", "practice"].forEach(type => {
                    const empty = document.querySelector(`[data-content-empty="${type}"]`);
                    if (empty) empty.hidden = contentRows.some(row => row.dataset.contentType === type && !row.hidden) || (activeTab !== type && activeTab !== "all");
                });
            };

            tabs.forEach(tab => tab.addEventListener("click", () => { activeTab = tab.dataset.contentTab; refresh(); }));
            noteTopicRows.forEach(topic => topic.querySelector("[data-notes-topic-toggle]")?.addEventListener("click", () => {
                const id = topic.dataset.topicId;
                setNotesTopic(id, expandedNotesTopicId !== id);
                refresh();
            }));
            searchInput?.addEventListener("input", refresh);
            searchInput?.addEventListener("search", refresh);
            refresh();
        })();
    </script>
}
