@model CIITStackLab.Application.DTOs.AdminInterviewQuestionInputDto

@{
    ViewData["Title"] = "Add Interview Question";
    var chapters = ViewBag.InterviewQuestionChapters as IEnumerable<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>
        ?? Array.Empty<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>();
}

@section Styles { <link rel="stylesheet" href="~/css/admin-mcqs.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/css/admin-assessment-detail.css" asp-append-version="true" />
}

<section class="ciit-mcq-form-page">
    <div class="ciit-assessment-standalone-nav">
        <a asp-area="Admin" asp-controller="Assessments" asp-action="Index" class="ciit-assessment-back-link"><i class="bi bi-arrow-left"></i><span>Back to Assessments</span></a>
    </div>
    <div class="ciit-mcq-header"><div><span class="ciit-admin-eyebrow">Assessment</span><h1>Add Interview Question</h1><p>Create an interview question for a specific Notes chapter.</p></div></div>
    <form asp-area="Admin" asp-controller="Assessments" asp-action="CreateInterviewQuestion" method="post" class="ciit-mcq-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ciit-mcq-validation"></div>
        <label>Notes Chapter<select asp-for="NoteId">
            <option value="0">Select chapter</option>
            @foreach (var chapter in chapters)
            {
                <option value="@chapter.NoteId" selected="@(Model.NoteId == chapter.NoteId ? "selected" : null)">
                    @chapter.TopicTitle / @chapter.ChapterId — @chapter.ChapterTitle
                </option>
            }
        </select><span asp-validation-for="NoteId"></span></label>
        <label>Question<textarea asp-for="Question" rows="4"></textarea><span asp-validation-for="Question"></span></label>
        <label>Answer<textarea asp-for="Answer" rows="8"></textarea><span asp-validation-for="Answer"></span></label>
        <div class="ciit-mcq-form-actions"><a asp-action="InterviewQuestions">Cancel</a><button type="submit">Create Interview Question</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
