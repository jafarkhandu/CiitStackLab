@model CIITStackLab.Application.DTOs.AdminPracticeProgramInputDto
@{
    var chapters = ViewBag.PracticeProgramChapters as IEnumerable<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>
        ?? Array.Empty<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>();
}
<div class="modal fade ciit-assessment-form-modal" id="createPracticeProgramModal" tabindex="-1"
     aria-labelledby="createPracticeProgramModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="ciit-admin-eyebrow">Coding workspace</span>
                    <h2 class="modal-title" id="createPracticeProgramModalTitle">Add Practice Program</h2>
                    <p class="mb-0">Create a programming problem. Add solutions separately after saving.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="Admin" asp-controller="Assessments" asp-action="CreatePracticeProgram" method="post" class="ciit-assessment-modal-form">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <label class="ciit-assessment-form-field">
                        <span>Notes Chapter <b>*</b></span>
                        <select asp-for="NoteId" required>
                            <option value="0">Select Notes chapter</option>
                            @foreach (var chapter in chapters)
                            {
                                <option value="@chapter.NoteId">@chapter.TopicTitle / @chapter.ChapterId — @chapter.ChapterTitle</option>
                            }
                        </select>
                        <span asp-validation-for="NoteId" class="text-danger"></span>
                    </label>
                    <label class="ciit-assessment-form-field">
                        <span>Problem Title <b>*</b></span>
                        <input asp-for="QuestionTitle" placeholder="e.g. Implement an LRU cache in C#" required />
                        <span asp-validation-for="QuestionTitle" class="text-danger"></span>
                    </label>
                    <label class="ciit-assessment-form-field">
                        <span>Problem Description <b>*</b></span>
                        <textarea asp-for="QuestionDescription" rows="9" placeholder="Describe the problem, constraints, sample input/output and multiline requirements..." required></textarea>
                        <span asp-validation-for="QuestionDescription" class="text-danger"></span>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="ciit-assessment-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="ciit-assessment-modal-submit"><i class="bi bi-check-lg"></i> Create Program</button>
                </div>
            </form>
        </div>
    </div>
</div>
