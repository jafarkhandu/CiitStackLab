@model CIITStackLab.Application.DTOs.AdminPracticeProgramIndexDto

@{
    ViewData["Title"] = "Practice Programs";
    var message = ViewBag.PracticeMessage as string;
    var messageType = ViewBag.PracticeMessageType as string;
    var openImportModal = ViewBag.OpenPracticeProgramImportModal as string;
    var openPracticeModal = ViewBag.OpenPracticeModal as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-assessment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-assessment-tree.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-practice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mcq-import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-practice-import.css" asp-append-version="true" />
}

<section class="ciit-practice-page ciit-assessment-subpage ciit-assessment-subpage--practice">
    <div class="ciit-practice-header ciit-assessment-subpage-hero ciit-assessment-subpage-hero--practice">
        <div>
            <span class="ciit-admin-eyebrow">Assessment</span>
            <h1>Practice Programs</h1>
            <p>Manage programming problems and their associated solutions using the existing assessment data.</p>
        </div>
        <div class="ciit-practice-header-actions">
            <a asp-area="Admin" asp-controller="Assessments" asp-action="Index" class="ciit-assessment-back-link">
                <i class="bi bi-arrow-left"></i><span>Assessments</span>
            </a>
            <button type="button" class="ciit-practice-secondary-btn"
                    data-bs-toggle="modal" data-bs-target="#practiceProgramImportModal">
                <i class="bi bi-file-earmark-arrow-up"></i><span>Analyze Questions</span>
            </button>
            <button type="button" class="ciit-practice-secondary-btn"
                    data-bs-toggle="modal" data-bs-target="#createPracticeSolutionModal">
                <i class="bi bi-lightbulb"></i><span>Add Solution</span>
            </button>
            <button type="button" class="ciit-practice-primary-btn"
                    data-bs-toggle="modal" data-bs-target="#createPracticeProgramModal">
                <i class="bi bi-plus-lg"></i><span>Add Program</span>
            </button>
            @if (Model.ArchivedPrograms.Count > 0 || Model.ArchivedAnswers.Count > 0)
            {
                <button type="button" class="ciit-practice-archive-header-btn" data-bs-toggle="modal" data-bs-target="#archivedPracticeModal">
                    <i class="bi bi-archive"></i><span>Archived (@(Model.ArchivedPrograms.Count + Model.ArchivedAnswers.Count))</span>
                </button>
            }
        </div>
    </div>

    <div class="ciit-assessment-summary" aria-label="Practice programs summary">
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-teal"><i class="bi bi-code-square"></i></span>
            <span><small>Active programs</small><strong>@Model.ActivePrograms.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-blue"><i class="bi bi-lightbulb"></i></span>
            <span><small>Active solutions</small><strong>@Model.ActivePrograms.Sum(program => program.Answers.Count)</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-slate"><i class="bi bi-archive"></i></span>
            <span><small>Archived programs</small><strong>@Model.ArchivedPrograms.Count</strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-practice-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert">
            <i class="bi @(messageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
            <span>@message</span>
        </div>
    }

    <section class="ciit-practice-card ciit-assessment-data-card">
        <div class="ciit-practice-card-header">
            <div>
                <h2>Active Practice Programs</h2>
                <p>@Model.ActivePrograms.Count active program@(Model.ActivePrograms.Count == 1 ? "" : "s")</p>
            </div>
        </div>

        @if (Model.ActivePrograms.Count == 0)
        {
            <div class="ciit-practice-empty">
                <i class="bi bi-code-square"></i>
                <h3>No active practice programs</h3>
                <p>Create a programming problem and attach it to a Notes chapter.</p>
                <button type="button" class="ciit-practice-secondary-btn" data-bs-toggle="modal" data-bs-target="#createPracticeProgramModal">Add Program</button>
            </div>
        }
        else
        {
            <div class="ciit-practice-list">
                @foreach (var topicGroup in Model.ActivePrograms
                    .GroupBy(x => x.TopicTitle)
                    .OrderBy(x => x.Key.TopicTitle))
                {
                    var topicPrograms = topicGroup.ToList();
                    var topicName = string.IsNullOrWhiteSpace(topicGroup.Key.TopicTitle) ? "Unassigned topic" : topicGroup.Key.TopicTitle;
                    <details class="ciit-assessment-tree-topic">
                        <summary>
                            <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-diagram-3"></i><strong>@topicName</strong></span>
                            <span class="ciit-assessment-tree-count">@topicPrograms.Count @(topicPrograms.Count == 1 ? "program" : "programs")</span>
                        </summary>
                        <div class="ciit-assessment-tree-children">
                            @foreach (var chapterGroup in topicGroup.GroupBy(x => new { x.NoteId, x.ChapterTitle }).OrderBy(x => x.Key.ChapterTitle))
                            {
                                var chapterPrograms = chapterGroup.ToList();
                                var chapterName = string.IsNullOrWhiteSpace(chapterGroup.Key.ChapterTitle) ? "Unassigned chapter" : chapterGroup.Key.ChapterTitle;
                                <details class="ciit-assessment-tree-chapter">
                                    <summary>
                                        <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-journal-text"></i><strong>@chapterName</strong></span>
                                        <span class="ciit-assessment-tree-count">@chapterPrograms.Count</span>
                                    </summary>
                                    <div class="ciit-practice-list ciit-assessment-practice-list">
                                        @foreach (var program in chapterPrograms.OrderByDescending(x => x.Id))
                                        {
                    <article class="ciit-practice-program">
                        <div class="ciit-practice-program-header">
                            <div>
                                <span class="ciit-practice-id">#@program.Id</span>
                                <h3>@program.QuestionTitle</h3>
                                <p class="ciit-practice-meta">@program.ChapterTitle</p>
                            </div>
                            <div class="ciit-practice-actions">
                                <a asp-area="Admin" asp-controller="Assessments" asp-action="EditPracticeProgram" asp-route-id="@program.Id" title="Edit program"><i class="bi bi-pencil-square"></i></a>
                                <button type="button" title="Add solution"
                                        data-bs-toggle="modal" data-bs-target="#createPracticeSolutionModal"
                                        data-program-question-id="@program.Id">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                                <form asp-area="Admin" asp-controller="Assessments" asp-action="DeletePracticeProgram" method="post" onsubmit="return confirm('Archive this practice program?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@program.Id" />
                                    <button type="submit" title="Archive"><i class="bi bi-archive"></i></button>
                                </form>
                            </div>
                        </div>
                        <div class="ciit-practice-description">@program.QuestionDescription</div>

                        <div class="ciit-practice-solutions">
                            <div class="ciit-practice-solutions-header">
                                <h4>Solutions</h4>
                                <span>@program.Answers.Count</span>
                            </div>
                            @if (program.Answers.Count == 0)
                            {
                                <p class="ciit-practice-no-solution">No active solution has been added yet.</p>
                            }
                            else
                            {
                                foreach (var answer in program.Answers)
                                {
                                    <div class="ciit-practice-solution">
                                        <div>
                                            <strong>@answer.Answer</strong>
                                            <p>@answer.Description</p>
                                        </div>
                                        <div class="ciit-practice-actions">
                                            <a asp-area="Admin" asp-controller="Assessments" asp-action="EditPracticeAnswer" asp-route-id="@answer.Id" title="Edit solution"><i class="bi bi-pencil-square"></i></a>
                                            <form asp-area="Admin" asp-controller="Assessments" asp-action="DeletePracticeAnswer" method="post" onsubmit="return confirm('Archive this solution?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@answer.Id" />
                                                <button type="submit" title="Archive solution"><i class="bi bi-archive"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </article>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>

    @if (Model.ArchivedPrograms.Count > 0 || Model.ArchivedAnswers.Count > 0)
    {
        <div class="modal fade ciit-assessment-archive-modal" id="archivedPracticeModal" tabindex="-1" aria-labelledby="archivedPracticeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div><span class="ciit-admin-eyebrow">Recovery</span><h2 class="modal-title" id="archivedPracticeModalLabel">Archived Practice Items</h2><p>Restore archived programs or solutions.</p></div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (Model.ArchivedPrograms.Count > 0)
                        {
                            <h3 class="ciit-assessment-archive-subtitle">Archived Programs (@Model.ArchivedPrograms.Count)</h3>
                            @foreach (var program in Model.ArchivedPrograms.OrderBy(x => x.TopicTitle).ThenBy(x => x.ChapterTitle).ThenByDescending(x => x.Id))
                            {
                                <div class="ciit-assessment-archive-row">
                                    <div><strong>@program.QuestionTitle</strong><span>@program.TopicTitle · @program.ChapterTitle</span></div>
                                    <form asp-area="Admin" asp-controller="Assessments" asp-action="RestorePracticeProgram" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@program.Id" />
                                        <button type="submit" class="ciit-practice-restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                                    </form>
                                </div>
                            }
                        }
                        @if (Model.ArchivedAnswers.Count > 0)
                        {
                            <h3 class="ciit-assessment-archive-subtitle">Archived Solutions (@Model.ArchivedAnswers.Count)</h3>
                            @foreach (var answer in Model.ArchivedAnswers.OrderBy(x => x.QuestionTitle).ThenByDescending(x => x.Id))
                            {
                                <div class="ciit-assessment-archive-row">
                                    <div><strong>@answer.Answer</strong><span>@answer.QuestionTitle</span></div>
                                    <form asp-area="Admin" asp-controller="Assessments" asp-action="RestorePracticeAnswer" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@answer.Id" />
                                        <button type="submit" class="ciit-practice-restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @await Html.PartialAsync("_PracticeProgramImportModal", Model)
    @await Html.PartialAsync("_CreatePracticeProgramModal",
        ViewBag.PracticeProgramInput as CIITStackLab.Application.DTOs.AdminPracticeProgramInputDto
        ?? new CIITStackLab.Application.DTOs.AdminPracticeProgramInputDto())
    @await Html.PartialAsync("_CreatePracticeAnswerModal",
        ViewBag.PracticeSolutionInput as CIITStackLab.Application.DTOs.AdminPracticeProgramAnswerInputDto
        ?? new CIITStackLab.Application.DTOs.AdminPracticeProgramAnswerInputDto())
</section>

@section Scripts {
    <script src="~/js/admin-practice-import.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const solutionModal = document.getElementById("createPracticeSolutionModal");
            if (solutionModal) {
                solutionModal.addEventListener("show.bs.modal", function (event) {
                    const trigger = event.relatedTarget;
                    const questionId = trigger && trigger.getAttribute("data-program-question-id");
                    const selector = solutionModal.querySelector('[name="ProgramQuestionId"]');
                    if (!selector) return;

                    // Start a fresh selection for the general Add Solution button.
                    // When opened from a specific question, preselect that question;
                    // the user can still deliberately choose a different active question.
                    selector.value = questionId && Array.from(selector.options).some(option => option.value === questionId)
                        ? questionId
                        : "0";
                    selector.dispatchEvent(new Event("change", { bubbles: true }));
                });
            }

            const openTarget = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(openPracticeModal));
            const modalIds = {
                program: "createPracticeProgramModal",
                solution: "createPracticeSolutionModal"
            };
            const id = openTarget && modalIds[openTarget];
            const element = id && document.getElementById(id);
            if (element && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(element).show();
            }
        });
    </script>
    @if (string.Equals(openImportModal, "import", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("practiceProgramImportModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
}
