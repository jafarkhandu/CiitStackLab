@model CIITStackLab.Application.DTOs.AdminMcqIndexDto

@{
    ViewData["Title"] = "MCQs";
    var message = ViewBag.McqMessage as string;
    var messageType = ViewBag.McqMessageType as string;
    var openModal = ViewBag.OpenMcqModal as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-assessment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-assessment-tree.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mcqs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mcq-import.css" asp-append-version="true" />
}

<section class="ciit-mcq-page ciit-assessment-subpage ciit-assessment-subpage--mcq">
    <div class="ciit-mcq-header ciit-assessment-subpage-hero">
        <div><span class="ciit-admin-eyebrow">Assessment</span><h1>MCQs</h1><p>Manage multiple-choice questions organized by chapter.</p></div>
        <div class="ciit-mcq-header-actions">
            <a asp-area="Admin" asp-controller="Assessments" asp-action="Index" class="ciit-assessment-back-link">
                <i class="bi bi-arrow-left"></i><span>Assessments</span>
            </a>
            <button type="button" class="ciit-mcq-import-header-btn"
                    data-bs-toggle="modal" data-bs-target="#bulkImportMcqModal">
                <i class="bi bi-file-earmark-arrow-up"></i><span>Bulk Import</span>
            </button>
            <button type="button" class="ciit-mcq-primary-btn"
                    data-bs-toggle="modal" data-bs-target="#addMcqModal">
                <i class="bi bi-plus-lg"></i><span>Add MCQ</span>
            </button>
            @if (Model.ArchivedMcqs.Count > 0)
            {
                <button type="button" class="ciit-mcq-archive-header-btn" data-bs-toggle="modal" data-bs-target="#archivedMcqsModal">
                    <i class="bi bi-archive"></i><span>Archived (@Model.ArchivedMcqs.Count)</span>
                </button>
            }
        </div>
    </div>

    <div class="ciit-assessment-summary" aria-label="MCQ summary">
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-blue"><i class="bi bi-check2-circle"></i></span>
            <span><small>Active questions</small><strong>@Model.ActiveMcqs.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-slate"><i class="bi bi-archive"></i></span>
            <span><small>Archived questions</small><strong>@Model.ArchivedMcqs.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-violet"><i class="bi bi-file-earmark-spreadsheet"></i></span>
            <span><small>Bulk import</small><strong>Excel .xlsx <em>· up to 100 questions</em></strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-mcq-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert"><i class="bi @(messageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i><span>@message</span></div>
    }

    <section class="ciit-mcq-card">
        <div class="ciit-mcq-card-header"><div><h2>Active MCQs</h2><p>@Model.ActiveMcqs.Count active question@(Model.ActiveMcqs.Count == 1 ? "" : "s")</p></div></div>
        @if (Model.ActiveMcqs.Count == 0)
        {
            <div class="ciit-mcq-empty">
                <i class="bi bi-ui-checks-grid"></i>
                <h3>No active MCQs</h3>
                <p>Create an MCQ and attach it to a chapter.</p>
                <button type="button" data-bs-toggle="modal" data-bs-target="#addMcqModal" class="ciit-mcq-secondary-btn">Add MCQ</button>
            </div>
        }
        else
        {
            <div class="ciit-assessment-tree">
                @foreach (var topicGroup in Model.ActiveMcqs
                    .GroupBy(x => new { x.TopicId, x.TopicTitle })
                    .OrderBy(x => x.Key.TopicTitle))
                {
                    var topicQuestions = topicGroup.ToList();
                    var topicName = string.IsNullOrWhiteSpace(topicGroup.Key.TopicTitle) ? "Unassigned topic" : topicGroup.Key.TopicTitle;
                    <details class="ciit-assessment-tree-topic">
                        <summary>
                            <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-diagram-3"></i><strong>@topicName</strong></span>
                            <span class="ciit-assessment-tree-count">@topicQuestions.Count @(topicQuestions.Count == 1 ? "MCQ" : "MCQs")</span>
                        </summary>
                        <div class="ciit-assessment-tree-children">
                            @foreach (var chapterGroup in topicGroup.GroupBy(x => new { x.NoteId, x.ChapterTitle }).OrderBy(x => x.Key.ChapterTitle))
                            {
                                var chapterQuestions = chapterGroup.ToList();
                                var chapterName = string.IsNullOrWhiteSpace(chapterGroup.Key.ChapterTitle) ? "Unassigned chapter" : chapterGroup.Key.ChapterTitle;
                                if (chapterName.StartsWith(topicName + " / ", StringComparison.OrdinalIgnoreCase))
                                {
                                    chapterName = chapterName.Substring(topicName.Length + 3);
                                }
                                <details class="ciit-assessment-tree-chapter">
                                    <summary>
                                        <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-journal-text"></i><strong>@chapterName</strong></span>
                                        <span class="ciit-assessment-tree-count">@chapterQuestions.Count</span>
                                    </summary>
                                    <div class="ciit-assessment-question-list">
                                        @foreach (var mcq in chapterQuestions.OrderByDescending(x => x.Id))
                                        {
                                            <article class="ciit-assessment-question-item">
                                                <div class="ciit-assessment-question-copy">
                                                    <strong>@mcq.Question</strong>
                                                    <span>#@mcq.Id · Correct option @mcq.CorrectOptionNumber</span>
                                                </div>
                                                <div class="ciit-mcq-actions">
                                                    <a asp-area="Admin" asp-controller="Assessments" asp-action="Mcqs" asp-route-editId="@mcq.Id" title="Edit MCQ" aria-label="Edit MCQ @mcq.Id"><i class="bi bi-pencil-square"></i></a>
                                                    <form asp-area="Admin" asp-controller="Assessments" asp-action="DeleteMcq" method="post" onsubmit="return confirm('Archive this MCQ?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@mcq.Id" />
                                                        <button type="submit" title="Archive MCQ" aria-label="Archive MCQ @mcq.Id"><i class="bi bi-archive"></i></button>
                                                    </form>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>

    @if (Model.ArchivedMcqs.Count > 0)
    {
        <div class="modal fade ciit-assessment-archive-modal" id="archivedMcqsModal" tabindex="-1" aria-labelledby="archivedMcqsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div><span class="ciit-admin-eyebrow">Recovery</span><h2 class="modal-title" id="archivedMcqsModalLabel">Archived MCQs</h2><p>Archived questions can be restored.</p></div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @foreach (var mcq in Model.ArchivedMcqs.OrderBy(x => x.TopicTitle).ThenBy(x => x.ChapterTitle).ThenByDescending(x => x.Id))
                        {
                            <div class="ciit-assessment-archive-row">
                                <div><strong>@mcq.Question</strong><span>@mcq.TopicTitle · @mcq.ChapterTitle</span></div>
                                <form asp-area="Admin" asp-controller="Assessments" asp-action="RestoreMcq" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mcq.Id" />
                                    <button type="submit" class="ciit-mcq-restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @await Html.PartialAsync("_McqModals", Model)
</section>

@section Scripts {
    <script src="~/js/admin-assessment-tree.js" asp-append-version="true"></script>
    <script src="~/js/admin-mcq-import.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (openModal == "add")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("addMcqModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
    else if (openModal == "import")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("bulkImportMcqModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
    else if (openModal == "edit")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("editMcqModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
}
