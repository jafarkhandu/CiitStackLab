@model CIITStackLab.Application.DTOs.AdminChapterMcqInputDto

@{
    ViewData["Title"] = "Edit MCQ";
    var mcqChapters = ViewBag.McqChapters as IEnumerable<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>
        ?? Array.Empty<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>();
}

@section Styles { <link rel="stylesheet" href="~/css/admin-mcqs.css" asp-append-version="true" /> }

<section class="ciit-mcq-form-page">
    <div class="ciit-mcq-header"><div><span class="ciit-admin-eyebrow">Assessment</span><h1>Edit MCQ</h1><p>Update the question under a chapter and its answer options.</p></div></div>
    <form asp-area="Admin" asp-controller="Assessments" asp-action="EditMcq" method="post" class="ciit-mcq-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ciit-mcq-validation"></div>
        <label>Chapter<select asp-for="NoteId"><option value="0">Select Notes chapter</option>
            @foreach (var chapter in mcqChapters)
            {
                <option value="@chapter.NoteId" selected="@(Model.NoteId == chapter.NoteId ? "selected" : null)">@chapter.TopicTitle / @chapter.ChapterId — @chapter.ChapterTitle</option>
            }
        </select><span asp-validation-for="NoteId"></span></label>
        <label>Question<textarea asp-for="Question" rows="4"></textarea><span asp-validation-for="Question"></span></label>
        <div class="ciit-mcq-option-grid">
            <label>Option A<input asp-for="Option1" /><span asp-validation-for="Option1"></span></label>
            <label>Option B<input asp-for="Option2" /><span asp-validation-for="Option2"></span></label>
            <label>Option C<input asp-for="Option3" /><span asp-validation-for="Option3"></span></label>
            <label>Option D<input asp-for="Option4" /><span asp-validation-for="Option4"></span></label>
        </div>
        <label>Correct Option<select asp-for="CorrectOptionNumber"><option value="0">Select correct option</option><option value="1">A</option><option value="2">B</option><option value="3">C</option><option value="4">D</option></select><span asp-validation-for="CorrectOptionNumber"></span></label>
        <div class="ciit-mcq-form-actions"><a asp-action="Mcqs">Cancel</a><button type="submit">Save Changes</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
