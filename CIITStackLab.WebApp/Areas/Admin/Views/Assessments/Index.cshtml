@{
    ViewData["Title"] = "Assessments";
}

<section class="ciit-admin-page assessment-page">
    <div class="ciit-admin-page-header">
        <div>
            <span class="ciit-admin-eyebrow">Assessment</span>
            <h1>Assessments</h1>
            <p>Choose an assessment type to continue.</p>
        </div>
    </div>

    <div class="assessment-list">
        <a asp-area="Admin" asp-controller="Assessments" asp-action="Mcqs" class="assessment-item">
            <span class="assessment-item-icon"><i class="bi bi-ui-checks-grid"></i></span>
            <span class="assessment-item-content">
                <strong>MCQs</strong>
                <span>Multiple-choice questions</span>
            </span>
            <i class="bi bi-chevron-right assessment-item-arrow" aria-hidden="true"></i>
        </a>

        <a asp-area="Admin" asp-controller="Assessments" asp-action="InterviewQuestions" class="assessment-item">
            <span class="assessment-item-icon"><i class="bi bi-chat-square-text"></i></span>
            <span class="assessment-item-content">
                <strong>Interview Questions</strong>
                <span>Interview question management</span>
            </span>
            <i class="bi bi-chevron-right assessment-item-arrow" aria-hidden="true"></i>
        </a>

        <a asp-area="Admin" asp-controller="Assessments" asp-action="PracticePrograms" class="assessment-item">
            <span class="assessment-item-icon"><i class="bi bi-code-square"></i></span>
            <span class="assessment-item-content">
                <strong>Practice Programs</strong>
                <span>Coding practice program management</span>
            </span>
            <i class="bi bi-chevron-right assessment-item-arrow" aria-hidden="true"></i>
        </a>
    </div>
</section>
