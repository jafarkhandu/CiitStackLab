@{
    ViewData["Title"] = "Assessments";
}

<section class="ciit-admin-page assessment-page">
    <div class="ciit-admin-page-header">
        <div>
            <span class="ciit-admin-eyebrow">Assessment</span>
            <h1>Assessments</h1>
            <p>Manage the three assessment types used in the learning platform.</p>
        </div>
    </div>

    <div class="assessment-grid">
        <article class="assessment-card">
            <div class="assessment-card-icon"><i class="bi bi-ui-checks-grid"></i></div>
            <div>
                <h2>MCQs</h2>
                <p>Manage multiple-choice questions for course assessments.</p>
            </div>
        </article>

        <article class="assessment-card">
            <div class="assessment-card-icon"><i class="bi bi-chat-square-text"></i></div>
            <div>
                <h2>Interview Questions</h2>
                <p>Manage interview questions linked to the learning content.</p>
            </div>
        </article>

        <article class="assessment-card">
            <div class="assessment-card-icon"><i class="bi bi-code-square"></i></div>
            <div>
                <h2>Practice Programs</h2>
                <p>Manage coding practice programs and their expected solutions.</p>
            </div>
        </article>
    </div>
</section>
