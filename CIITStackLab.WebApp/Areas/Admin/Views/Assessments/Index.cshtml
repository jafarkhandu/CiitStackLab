@{
    ViewData["Title"] = "Assessments";
}

<section class="ciit-admin-page assessment-page">
    <header class="assessment-hero">
        <div class="assessment-hero-copy">
            <span class="assessment-hero-kicker">
                <span class="assessment-live-dot" aria-hidden="true"></span>
                ASSESSMENT CENTER
            </span>
            <h1>Assessment workspace</h1>
            <p>Build your question bank, prepare interview material, and manage coding practice—all from one place.</p>
        </div>
        <div class="assessment-hero-art" aria-hidden="true">
            <span class="assessment-art-orbit assessment-art-orbit--outer"></span>
            <span class="assessment-art-orbit assessment-art-orbit--inner"></span>
            <span class="assessment-art-icon assessment-art-icon--one"><i class="bi bi-ui-checks-grid"></i></span>
            <span class="assessment-art-icon assessment-art-icon--two"><i class="bi bi-chat-square-text"></i></span>
            <span class="assessment-art-icon assessment-art-icon--three"><i class="bi bi-code-square"></i></span>
            <span class="assessment-art-core"><i class="bi bi-layers"></i></span>
        </div>
    </header>

    <div class="assessment-section-heading">
        <div>
            <span class="ciit-admin-eyebrow">YOUR WORKSPACE</span>
            <h2>Choose an assessment</h2>
        </div>
        <p>Select a tool to open its question bank and manage its content.</p>
    </div>

    <nav class="assessment-list" aria-label="Assessment types">
        <a asp-area="Admin" asp-controller="Assessments" asp-action="Mcqs"
           class="assessment-item assessment-item--mcq">
            <span class="assessment-item-top">
                <span class="assessment-item-index">01 <span>/ QUESTION BANK</span></span>
                <span class="assessment-item-open" aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
            </span>
            <span class="assessment-item-icon"><i class="bi bi-ui-checks-grid"></i></span>
            <span class="assessment-item-content">
                <strong>MCQs</strong>
                <span>Create and organize multiple-choice questions chapter by chapter.</span>
            </span>
            <span class="assessment-item-footer"><span>Manage MCQs</span><i class="bi bi-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a asp-area="Admin" asp-controller="Assessments" asp-action="InterviewQuestions"
           class="assessment-item assessment-item--interview">
            <span class="assessment-item-top">
                <span class="assessment-item-index">02 <span>/ INTERVIEW PREP</span></span>
                <span class="assessment-item-open" aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
            </span>
            <span class="assessment-item-icon"><i class="bi bi-chat-square-text"></i></span>
            <span class="assessment-item-content">
                <strong>Interview Questions</strong>
                <span>Maintain technical interview prompts and their answers.</span>
            </span>
            <span class="assessment-item-footer"><span>Manage interviews</span><i class="bi bi-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a asp-area="Admin" asp-controller="Assessments" asp-action="PracticePrograms"
           class="assessment-item assessment-item--practice">
            <span class="assessment-item-top">
                <span class="assessment-item-index">03 <span>/ CODING LAB</span></span>
                <span class="assessment-item-open" aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
            </span>
            <span class="assessment-item-icon"><i class="bi bi-code-square"></i></span>
            <span class="assessment-item-content">
                <strong>Practice Programs</strong>
                <span>Manage coding problems and add solutions linked to each question.</span>
            </span>
            <span class="assessment-item-footer"><span>Open coding lab</span><i class="bi bi-arrow-right" aria-hidden="true"></i></span>
        </a>
    </nav>

    <footer class="assessment-page-note">
        <span class="assessment-page-note-icon"><i class="bi bi-diagram-3"></i></span>
        <p><strong>Keep assessments organized.</strong> Each assessment type has its own workspace, with questions managed independently.</p>
    </footer>
</section>
