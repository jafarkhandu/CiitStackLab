@model CIITStackLab.Application.DTOs.AdminInterviewQuestionIndexDto

@{
    ViewData["Title"] = "Interview Questions";
    var message = ViewBag.InterviewMessage as string;
    var messageType = ViewBag.InterviewMessageType as string;
    var openImportModal = ViewBag.OpenInterviewImportModal as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-assessment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mcqs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-interview-import.css" asp-append-version="true" />
}

<section class="ciit-mcq-page ciit-assessment-subpage ciit-assessment-subpage--interview">
    <div class="ciit-mcq-header ciit-assessment-subpage-hero">
        <div><span class="ciit-admin-eyebrow">Assessment</span><h1>Interview Questions</h1><p>Manage interview questions by their Notes chapter.</p></div>
        <div class="ciit-mcq-header-actions">
            <button type="button" class="ciit-mcq-import-header-btn" data-bs-toggle="modal" data-bs-target="#interviewQuestionImportModal">
                <i class="bi bi-file-earmark-arrow-up"></i><span>Analyze Notes</span>
            </button>
            <a asp-area="Admin" asp-controller="Assessments" asp-action="CreateInterviewQuestion" class="ciit-mcq-primary-btn">
                <i class="bi bi-plus-lg"></i><span>Add Interview Question</span>
            </a>
        </div>
    </div>

    <div class="ciit-assessment-summary" aria-label="Interview questions summary">
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-violet"><i class="bi bi-chat-square-text"></i></span>
            <span><small>Active questions</small><strong>@Model.ActiveQuestions.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-slate"><i class="bi bi-archive"></i></span>
            <span><small>Archived questions</small><strong>@Model.ArchivedQuestions.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-blue"><i class="bi bi-file-earmark-spreadsheet"></i></span>
            <span><small>Interview import</small><strong>Excel .xlsx <em>· 20 Q&amp;A rows</em></strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-mcq-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert"><i class="bi @(messageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i><span>@message</span></div>
    }

    <section class="ciit-mcq-card ciit-assessment-data-card">
        <div class="ciit-mcq-card-header"><div><h2>Active Interview Questions</h2><p>@Model.ActiveQuestions.Count active question@(Model.ActiveQuestions.Count == 1 ? "" : "s")</p></div></div>
        @if (Model.ActiveQuestions.Count == 0)
        {
            <div class="ciit-mcq-empty"><i class="bi bi-chat-left-text"></i><h3>No active interview questions</h3><p>Create an interview question and attach it to a Notes chapter.</p><a asp-area="Admin" asp-controller="Assessments" asp-action="CreateInterviewQuestion" class="ciit-mcq-secondary-btn">Add Interview Question</a></div>
        }
        else
        {
            <div class="ciit-mcq-table-wrap">
                <table class="ciit-mcq-table"><thead><tr><th>Question</th><th>Notes Chapter</th><th>Answer</th><th>Actions</th></tr></thead><tbody>
                @foreach (var question in Model.ActiveQuestions)
                {
                    <tr><td><div class="ciit-mcq-question"><strong>@question.Question</strong><span>#@question.Id</span></div></td><td>@question.ChapterTitle</td><td>@question.Answer</td><td><div class="ciit-mcq-actions"><a asp-area="Admin" asp-controller="Assessments" asp-action="EditInterviewQuestion" asp-route-id="@question.Id" title="Edit"><i class="bi bi-pencil-square"></i></a><form asp-area="Admin" asp-controller="Assessments" asp-action="DeleteInterviewQuestion" method="post" onsubmit="return confirm('Archive this interview question?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@question.Id" /><button type="submit" title="Archive"><i class="bi bi-archive"></i></button></form></div></td></tr>
                }
                </tbody></table>
            </div>
        }
    </section>

    <section class="ciit-mcq-card ciit-mcq-archive ciit-assessment-data-card">
        <div class="ciit-mcq-card-header"><div><h2>Archived Interview Questions</h2><p>Archived questions can be restored.</p></div><span class="ciit-mcq-count">@Model.ArchivedQuestions.Count</span></div>
        @if (Model.ArchivedQuestions.Count == 0) { <div class="ciit-mcq-empty compact"><p>No archived interview questions.</p></div> }
        else
        {
            <div class="ciit-mcq-archive-list">
            @foreach (var question in Model.ArchivedQuestions)
            {
                <div class="ciit-mcq-archive-row"><div><strong>@question.Question</strong><span>@question.ChapterTitle</span></div><form asp-area="Admin" asp-controller="Assessments" asp-action="RestoreInterviewQuestion" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@question.Id" /><button type="submit" class="ciit-mcq-restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button></form></div>
            }
            </div>
        }
    </section>
    @await Html.PartialAsync("_InterviewQuestionImportModal", Model)
</section>

@section Scripts {
    <script src="~/js/admin-interview-import.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (string.Equals(openImportModal, "import", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("interviewQuestionImportModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
}
