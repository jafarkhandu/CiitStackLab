@model CIITStackLab.Application.DTOs.AdminInterviewQuestionIndexDto

@{
    ViewData["Title"] = "Interview Questions";
    var message = ViewBag.InterviewMessage as string;
    var messageType = ViewBag.InterviewMessageType as string;
    var openImportModal = ViewBag.OpenInterviewImportModal as string;
    var openQuestionModal = ViewBag.OpenInterviewQuestionModal as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-assessment-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-assessment-tree.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mcqs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-interview-import.css" asp-append-version="true" />
}

<section class="ciit-mcq-page ciit-assessment-subpage ciit-assessment-subpage--interview">
    <div class="ciit-mcq-header ciit-assessment-subpage-hero">
        <div><span class="ciit-admin-eyebrow">Assessment</span><h1>Interview Questions</h1><p>Manage interview questions by their Notes chapter.</p></div>
        <div class="ciit-mcq-header-actions">
            <a asp-area="Admin" asp-controller="Assessments" asp-action="Index" class="ciit-assessment-back-link">
                <i class="bi bi-arrow-left"></i><span>Assessments</span>
            </a>
            <button type="button" class="ciit-mcq-import-header-btn" data-bs-toggle="modal" data-bs-target="#interviewQuestionImportModal">
                <i class="bi bi-file-earmark-arrow-up"></i><span>Analyze Notes</span>
            </button>
            <button type="button" class="ciit-mcq-primary-btn" data-bs-toggle="modal" data-bs-target="#createInterviewQuestionModal">
                <i class="bi bi-plus-lg"></i><span>Add Interview Question</span>
            </button>
            @if (Model.ArchivedQuestions.Count > 0)
            {
                <button type="button" class="ciit-mcq-archive-header-btn" data-bs-toggle="modal" data-bs-target="#archivedInterviewQuestionsModal">
                    <i class="bi bi-archive"></i><span>Archived (@Model.ArchivedQuestions.Count)</span>
                </button>
            }
        </div>
    </div>

    <div class="ciit-assessment-summary" aria-label="Interview questions summary">
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-violet"><i class="bi bi-chat-square-text"></i></span>
            <span><small>Active questions</small><strong>@Model.ActiveQuestions.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-slate"><i class="bi bi-archive"></i></span>
            <span><small>Archived questions</small><strong>@Model.ArchivedQuestions.Count</strong></span>
        </div>
        <div class="ciit-assessment-summary-card">
            <span class="ciit-assessment-summary-icon is-blue"><i class="bi bi-file-earmark-spreadsheet"></i></span>
            <span><small>Interview import</small><strong>Excel .xlsx <em>· 1–100 Q&amp;A rows</em></strong></span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ciit-mcq-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert"><i class="bi @(messageType == "success" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i><span>@message</span></div>
    }

    <section class="ciit-mcq-card ciit-assessment-data-card">
        <div class="ciit-mcq-card-header"><div><h2>Active Interview Questions</h2><p>@Model.ActiveQuestions.Count active question@(Model.ActiveQuestions.Count == 1 ? "" : "s")</p></div></div>
        @if (Model.ActiveQuestions.Count == 0)
        {
            <div class="ciit-mcq-empty">
                <i class="bi bi-chat-left-text"></i>
                <h3>No active interview questions</h3>
                <p>Create an interview question and attach it to a Notes chapter.</p>
                <button type="button" class="ciit-mcq-secondary-btn" data-bs-toggle="modal" data-bs-target="#createInterviewQuestionModal">Add Interview Question</button>
            </div>
        }
        else
        {
            <div class="ciit-assessment-tree">
                @foreach (var topicGroup in Model.ActiveQuestions
                    .GroupBy(x => new { x.TopicId, x.TopicTitle })
                    .OrderBy(x => x.Key.TopicTitle))
                {
                    var topicQuestions = topicGroup.ToList();
                    var topicName = string.IsNullOrWhiteSpace(topicGroup.Key.TopicTitle) ? "Unassigned topic" : topicGroup.Key.TopicTitle;
                    <details class="ciit-assessment-tree-topic">
                        <summary>
                            <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-diagram-3"></i><strong>@topicName</strong></span>
                            <span class="ciit-assessment-tree-count">@topicQuestions.Count @(topicQuestions.Count == 1 ? "question" : "questions")</span>
                        </summary>
                        <div class="ciit-assessment-tree-children">
                            @foreach (var chapterGroup in topicGroup.GroupBy(x => new { x.NoteId, x.ChapterTitle }).OrderBy(x => x.Key.ChapterTitle))
                            {
                                var chapterQuestions = chapterGroup.ToList();
                                var chapterName = string.IsNullOrWhiteSpace(chapterGroup.Key.ChapterTitle) ? "Unassigned chapter" : chapterGroup.Key.ChapterTitle;
                                if (chapterName.StartsWith(topicName + " / ", StringComparison.OrdinalIgnoreCase))
                                {
                                    chapterName = chapterName.Substring(topicName.Length + 3);
                                }
                                <details class="ciit-assessment-tree-chapter">
                                    <summary>
                                        <span class="ciit-assessment-tree-title"><i class="bi bi-chevron-right"></i><i class="bi bi-journal-text"></i><strong>@chapterName</strong></span>
                                        <span class="ciit-assessment-tree-count">@chapterQuestions.Count</span>
                                    </summary>
                                    <div class="ciit-assessment-question-list">
                                        @foreach (var question in chapterQuestions.OrderByDescending(x => x.Id))
                                        {
                                            <article class="ciit-assessment-question-item ciit-assessment-interview-item">
                                                <div class="ciit-assessment-question-copy">
                                                    <strong>@question.Question</strong>
                                                    <span>#@question.Id</span>
                                                    <p>@question.Answer</p>
                                                </div>
                                                <div class="ciit-mcq-actions">
                                                    <a asp-area="Admin" asp-controller="Assessments" asp-action="EditInterviewQuestion" asp-route-id="@question.Id" title="Edit interview question" aria-label="Edit interview question @question.Id"><i class="bi bi-pencil-square"></i></a>
                                                    <form asp-area="Admin" asp-controller="Assessments" asp-action="DeleteInterviewQuestion" method="post" onsubmit="return confirm('Archive this interview question?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@question.Id" />
                                                        <button type="submit" title="Archive question" aria-label="Archive interview question @question.Id"><i class="bi bi-archive"></i></button>
                                                    </form>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>

    @if (Model.ArchivedQuestions.Count > 0)
    {
        <div class="modal fade ciit-assessment-archive-modal" id="archivedInterviewQuestionsModal" tabindex="-1" aria-labelledby="archivedInterviewQuestionsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div><span class="ciit-admin-eyebrow">Recovery</span><h2 class="modal-title" id="archivedInterviewQuestionsModalLabel">Archived Interview Questions</h2><p>Archived questions can be restored.</p></div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @foreach (var question in Model.ArchivedQuestions.OrderBy(x => x.TopicTitle).ThenBy(x => x.ChapterTitle).ThenByDescending(x => x.Id))
                        {
                            <div class="ciit-assessment-archive-row">
                                <div><strong>@question.Question</strong><span>@question.TopicTitle · @question.ChapterTitle</span></div>
                                <form asp-area="Admin" asp-controller="Assessments" asp-action="RestoreInterviewQuestion" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@question.Id" />
                                    <button type="submit" class="ciit-mcq-restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @await Html.PartialAsync("_InterviewQuestionImportModal", Model)
    @await Html.PartialAsync("_CreateInterviewQuestionModal",
        ViewBag.InterviewQuestionInput as CIITStackLab.Application.DTOs.AdminInterviewQuestionInputDto
        ?? new CIITStackLab.Application.DTOs.AdminInterviewQuestionInputDto())
</section>

@section Scripts {
    <script src="~/js/admin-interview-import.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (string.Equals(openQuestionModal, "add", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("createInterviewQuestionModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
    @if (string.Equals(openImportModal, "import", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const element = document.getElementById("interviewQuestionImportModal");
                if (element && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(element).show();
                }
            });
        </script>
    }
}
