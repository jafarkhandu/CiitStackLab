@model CIITStackLab.Application.DTOs.McqImportPreviewDto

@{
    ViewData["Title"] = "Bulk MCQ Import";
    var importMessage = ViewBag.McqImportMessage as string;
    var importMessageType = ViewBag.McqImportMessageType as string;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-mcq-import.css"
          asp-append-version="true" />
}

<section class="ciit-mcq-import-page">
    <header class="ciit-mcq-import-header">
        <div>
            <span class="ciit-admin-eyebrow">Assessment tools</span>
            <h1>Smart MCQ Import</h1>
            <p>Upload a complete question file, review the analysis, and import every valid question in one step.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Assessments"
           asp-action="Mcqs"
           class="ciit-mcq-import-back">
            <i class="bi bi-arrow-left"></i>
            Back to MCQs
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(importMessage))
    {
        <div class="ciit-mcq-import-alert is-error" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@importMessage</span>
        </div>
    }

    <section class="ciit-mcq-import-upload-card">
        <div class="ciit-mcq-import-section-heading">
            <span class="ciit-mcq-import-step">01</span>
            <div>
                <h2>Upload your question file</h2>
                <p>Choose the learning content item that should receive these MCQs.</p>
            </div>
        </div>

        <form asp-area="Admin"
              asp-controller="Assessments"
              asp-action="PreviewBulkMcq"
              method="post"
              enctype="multipart/form-data"
              class="ciit-mcq-import-upload-form">
            @Html.AntiForgeryToken()

            <label class="ciit-mcq-import-field">
                <span>Target content <strong>*</strong></span>
                <select name="contentId" required>
                    <option value="0">Select topic / content</option>
                    @if (ViewBag.McqContent is IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> contentItems)
                    {
                        foreach (var item in contentItems)
                        {
                            <option value="@item.Value" selected="@(Model.ContentId.ToString() == item.Value)">
                                @item.Text
                            </option>
                        }
                    }
                </select>
                <small>All imported questions will be linked to this existing content item.</small>
            </label>

            <label class="ciit-mcq-import-file-drop">
                <input type="file"
                       name="file"
                       accept=".txt,.docx"
                       required />
                <span class="ciit-mcq-import-file-icon">
                    <i class="bi bi-cloud-arrow-up"></i>
                </span>
                <strong>Choose a .txt or .docx file</strong>
                <span>Maximum size: 5 MB · Up to 500 MCQs per batch</span>
            </label>

            @if (Model.FileErrors.Count > 0 && Model.Questions.Count == 0)
            {
                <div class="ciit-mcq-import-file-errors" role="alert">
                    <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>File needs attention</strong>
                    <ul>
                        @foreach (var error in Model.FileErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <div class="ciit-mcq-import-format">
                <div class="ciit-mcq-import-format-heading">
                    <i class="bi bi-file-earmark-text"></i>
                    <div>
                        <strong>Required question format</strong>
                        <span>Keep each question, option and answer on its own line.</span>
                    </div>
                </div>
                <pre>Q1: What is the JVM?
A) Java Variable Method
B) Java Virtual Machine
C) Java Visual Model
D) Java Verified Module
ANSWER: B

Q2: Which keyword inherits a class?
A) implements
B) interface
C) extends
D) import
ANSWER: C</pre>
                <p>Question numbers are optional. Answers may be A–D or 1–4. A chapter heading such as <code>CHAPTER: Core Java</code> is allowed.</p>
            </div>

            <div class="ciit-mcq-import-upload-actions">
                <a asp-area="Admin"
                   asp-controller="Assessments"
                   asp-action="Mcqs"
                   class="ciit-mcq-import-cancel">Cancel</a>
                <button type="submit" class="ciit-mcq-import-primary">
                    <i class="bi bi-magic"></i>
                    Analyze file
                </button>
            </div>
        </form>
    </section>

    @if (Model.Questions.Count > 0)
    {
        <section class="ciit-mcq-import-preview-section">
            <header class="ciit-mcq-import-preview-header">
                <div>
                    <span class="ciit-mcq-import-step">02</span>
                    <div>
                        <span class="ciit-admin-eyebrow">Analysis preview</span>
                        <h2>Review before importing</h2>
                        <p>@Model.FileName <span>·</span> @Model.ContentLabel</p>
                    </div>
                </div>

                <span class="ciit-mcq-import-review-pill">
                    <i class="bi bi-shield-check"></i>
                    Nothing saved yet
                </span>
            </header>

            <div class="ciit-mcq-import-stats">
                <div class="ciit-mcq-import-stat">
                    <span>Total detected</span>
                    <strong>@Model.Questions.Count</strong>
                </div>
                <div class="ciit-mcq-import-stat is-valid">
                    <span>Valid questions</span>
                    <strong>@Model.ValidQuestionCount</strong>
                </div>
                <div class="ciit-mcq-import-stat @(Model.InvalidQuestionCount > 0 ? "is-invalid" : "")">
                    <span>Needs attention</span>
                    <strong>@Model.InvalidQuestionCount</strong>
                </div>
                <div class="ciit-mcq-import-stat">
                    <span>Already in database</span>
                    <strong>@Model.Questions.Count(question => question.IsDuplicateInDatabase)</strong>
                </div>
            </div>

            @if (Model.FileErrors.Count > 0)
            {
                <div class="ciit-mcq-import-global-errors" role="alert">
                    <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>File-level issues</strong>
                    <ul>
                        @foreach (var error in Model.FileErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <div class="ciit-mcq-import-question-list">
                @foreach (var question in Model.Questions)
                {
                    <article class="ciit-mcq-import-question @(question.IsValid ? "is-valid" : "is-invalid")">
                        <header class="ciit-mcq-import-question-header">
                            <span class="ciit-mcq-import-question-number">Q@question.Number</span>
                            <div class="ciit-mcq-import-question-status">
                                @if (question.IsValid)
                                {
                                    <span class="is-valid"><i class="bi bi-check-circle-fill"></i> Ready to import</span>
                                }
                                else
                                {
                                    <span class="is-invalid"><i class="bi bi-exclamation-circle-fill"></i> Needs attention</span>
                                }
                            </div>
                            @if (question.IsDuplicateInDatabase)
                            {
                                <span class="ciit-mcq-import-duplicate-pill">Database duplicate</span>
                            }
                        </header>

                        <div class="ciit-mcq-import-question-body">
                            <h3>@question.Question</h3>
                            <div class="ciit-mcq-import-options">
                                <div class="@(question.CorrectOptionNumber == 1 ? "is-correct" : "")">
                                    <span>A</span><p>@question.Option1</p>
                                    @if (question.CorrectOptionNumber == 1)
                                    {
                                        <i class="bi bi-check-circle-fill" title="Correct answer"></i>
                                    }
                                </div>
                                <div class="@(question.CorrectOptionNumber == 2 ? "is-correct" : "")">
                                    <span>B</span><p>@question.Option2</p>
                                    @if (question.CorrectOptionNumber == 2)
                                    {
                                        <i class="bi bi-check-circle-fill" title="Correct answer"></i>
                                    }
                                </div>
                                <div class="@(question.CorrectOptionNumber == 3 ? "is-correct" : "")">
                                    <span>C</span><p>@question.Option3</p>
                                    @if (question.CorrectOptionNumber == 3)
                                    {
                                        <i class="bi bi-check-circle-fill" title="Correct answer"></i>
                                    }
                                </div>
                                <div class="@(question.CorrectOptionNumber == 4 ? "is-correct" : "")">
                                    <span>D</span><p>@question.Option4</p>
                                    @if (question.CorrectOptionNumber == 4)
                                    {
                                        <i class="bi bi-check-circle-fill" title="Correct answer"></i>
                                    }
                                </div>
                            </div>

                            <div class="ciit-mcq-import-question-footer">
                                <span><i class="bi bi-check2-square me-1"></i>Answer key: <strong>@question.CorrectOptionLabel</strong></span>
                                <span>Source line @question.SourceLine</span>
                            </div>

                            @if (question.Issues.Count > 0)
                            {
                                <div class="ciit-mcq-import-row-errors">
                                    <strong>Fix these issues in the file</strong>
                                    <ul>
                                        @foreach (var issue in question.Issues)
                                        {
                                            <li>@issue</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            <footer class="ciit-mcq-import-confirm-card">
                <div>
                    @if (Model.CanImport)
                    {
                        <strong><i class="bi bi-check-circle-fill me-2"></i>All questions passed validation</strong>
                        <p>Confirming will import @Model.Questions.Count MCQs into <b>@Model.ContentLabel</b>.</p>
                    }
                    else
                    {
                        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Import is blocked</strong>
                        <p>Correct the file issues and analyze it again. No questions have been saved.</p>
                    }
                </div>

                <form asp-area="Admin"
                      asp-controller="Assessments"
                      asp-action="ConfirmBulkMcq"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="previewToken" value="@Model.PreviewToken" />
                    <button type="submit"
                            class="ciit-mcq-import-primary"
                            disabled="@(!Model.CanImport)">
                        <i class="bi bi-database-check"></i>
                        Import all @Model.Questions.Count MCQs
                    </button>
                </form>
            </footer>
        </section>
    }
</section>
