@{
    ViewData["Title"] = "Bulk MCQ Import";
}

<section class="ciit-mcq-import-page">
    <header class="ciit-mcq-import-header">
        <div>
            <span class="ciit-admin-eyebrow">Assessment tools</span>
            <h1>Smart MCQ Import</h1>
            <p>Bulk import now opens in a modal directly from the MCQ management screen.</p>
        </div>
        <a asp-area="Admin"
           asp-controller="Assessments"
           asp-action="Mcqs"
           class="ciit-mcq-import-back">
            <i class="bi bi-arrow-left"></i>
            Back to MCQs
        </a>
    </header>
</section>
