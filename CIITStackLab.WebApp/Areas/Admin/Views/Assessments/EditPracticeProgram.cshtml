@model CIITStackLab.Application.DTOs.AdminPracticeProgramInputDto

@{
    ViewData["Title"] = "Edit Practice Program";
    var chapters = ViewBag.PracticeProgramChapters as IEnumerable<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>
        ?? Array.Empty<CIITStackLab.Application.DTOs.AdminAssessmentChapterLookupDto>();
}

@section Styles { <link rel="stylesheet" href="~/css/admin-practice.css" asp-append-version="true" /> }

<section class="ciit-practice-form-page">
    <div class="ciit-practice-header">
        <div><span class="ciit-admin-eyebrow">Assessment</span><h1>Edit Practice Program</h1><p>Update the programming problem and its Notes chapter association.</p></div>
    </div>

    <div class="ciit-practice-form-card">
        <form asp-area="Admin" asp-controller="Assessments" asp-action="EditPracticeProgram" method="post" class="ciit-practice-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="ciit-practice-field">
                <label asp-for="NoteId">Notes Chapter</label>
                <select asp-for="NoteId">
                    <option value="0">Select chapter</option>
                    @foreach (var chapter in chapters)
                    {
                        <option value="@chapter.NoteId" selected="@(Model.NoteId == chapter.NoteId ? "selected" : null)">
                            @chapter.TopicTitle / @chapter.ChapterId — @chapter.ChapterTitle
                        </option>
                    }
                </select>
                <span asp-validation-for="NoteId" class="text-danger"></span>
            </div>
            <div class="ciit-practice-field">
                <label asp-for="QuestionTitle">Problem Title</label>
                <input asp-for="QuestionTitle" />
                <span asp-validation-for="QuestionTitle" class="text-danger"></span>
            </div>
            <div class="ciit-practice-field">
                <label asp-for="QuestionDescription">Problem Description</label>
                <textarea asp-for="QuestionDescription" rows="8"></textarea>
                <span asp-validation-for="QuestionDescription" class="text-danger"></span>
            </div>
            <div class="ciit-practice-form-actions">
                <a asp-area="Admin" asp-controller="Assessments" asp-action="PracticePrograms" class="ciit-practice-secondary-btn">Cancel</a>
                <button type="submit" class="ciit-practice-primary-btn"><i class="bi bi-check-lg"></i> Save Changes</button>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
