@model CIITStackLab.Application.DTOs.AdminRevenueReportPageDto

@{
    ViewData["Title"] = "Revenue & Payments";
    ViewData["ReportSection"] = "Revenue";
}

<section class="ciit-admin-reports">
    <header class="ciit-admin-reports-page-header">
        <div><span class="ciit-admin-eyebrow">FINANCIAL ANALYTICS</span><h1>Revenue &amp; Payments</h1><p>Review recorded payments, paid amounts and pending amounts from the existing ERP payment data.</p></div>
        <div class="ciit-admin-report-page-stat"><strong>₹@Model.TotalPaid.ToString("N0")</strong><span>Paid in selected period</span></div>
    </header>

    <partial name="_ReportSectionNav" />

    <form method="get" class="ciit-admin-report-filter-bar">
        <div class="ciit-admin-report-date-field"><label for="startDate">From</label><input id="startDate" name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></div>
        <div class="ciit-admin-report-date-field"><label for="endDate">To</label><input id="endDate" name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></div>
        <button type="submit" class="ciit-admin-report-filter-button"><i class="bi bi-filter"></i> Update</button>
    </form>

    <section class="ciit-admin-report-stat-grid">
        <article class="ciit-admin-report-stat-card"><span>Paid amount</span><strong>₹@Model.TotalPaid.ToString("N0")</strong><small>@Model.PaidPaymentCount paid payments</small></article>
        <article class="ciit-admin-report-stat-card"><span>Recorded amount</span><strong>₹@Model.TotalRecorded.ToString("N0")</strong><small>@Model.PaymentCount total records</small></article>
        <article class="ciit-admin-report-stat-card"><span>Pending amount</span><strong>₹@Model.PendingAmount.ToString("N0")</strong><small>@Model.PendingPaymentCount pending records</small></article>
    </section>

    <section class="ciit-admin-report-panel ciit-admin-report-table-panel">
        <div class="ciit-admin-report-panel-header"><div><span class="ciit-admin-panel-kicker">PAYMENT LEDGER</span><h2>Recent payments</h2><p>Recorded payments from @Model.StartDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy").</p></div><span class="ciit-admin-report-panel-badge">@Model.RecentPayments.Count shown</span></div>
        <div class="ciit-admin-report-table-wrap">
            <table class="ciit-admin-report-table">
                <thead><tr><th>PAYMENT</th><th>REGISTRATION</th><th>AMOUNT</th><th>MODE</th><th>DATE</th><th>STATUS</th></tr></thead>
                <tbody>
                @if (Model.RecentPayments.Count == 0)
                {
                    <tr><td colspan="6"><div class="ciit-admin-report-empty"><i class="bi bi-wallet2"></i><strong>No payments found</strong><span>Try a wider reporting period.</span></div></td></tr>
                }
                else
                {
                    foreach (var payment in Model.RecentPayments)
                    {
                        <tr>
                            <td><strong>#@payment.PaymentId</strong><small class="ciit-report-muted">@payment.Description</small></td>
                            <td>#@payment.RegistrationId</td>
                            <td><strong>₹@payment.Amount.ToString("N2")</strong></td>
                            <td>@payment.PaymentMode</td>
                            <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="ciit-admin-status-pill @(payment.IsPaid ? "" : "inactive")">@(payment.IsPaid ? "Paid" : "Pending")</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
