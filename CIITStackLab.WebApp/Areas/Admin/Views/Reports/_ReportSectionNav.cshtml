@{
    var active = ViewData["ReportSection"]?.ToString() ?? "Overview";
}

<nav class="ciit-admin-report-nav" aria-label="Report sections">
    <a class="@(active == "Overview" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Overview</a>
    <a class="@(active == "Courses" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="CourseReports"><i class="bi bi-journal-text"></i> Course Reports</a>
    <a class="@(active == "Students" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="StudentReports"><i class="bi bi-people"></i> Student Reports</a>
    <a class="@(active == "Assessments" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="AssessmentReports"><i class="bi bi-ui-checks"></i> Assessment Reports</a>
    <a class="@(active == "Revenue" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="RevenuePayments"><i class="bi bi-wallet2"></i> Revenue &amp; Payments</a>
    <a class="@(active == "Activity" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="ActivityReports"><i class="bi bi-clock-history"></i> Activity Reports</a>
</nav>
