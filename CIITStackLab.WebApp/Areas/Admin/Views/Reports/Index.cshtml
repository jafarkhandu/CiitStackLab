@model CIITStackLab.Application.DTOs.AdminReportsOverviewDto

@{
    ViewData["Title"] = "Reports";
    var maxTrendValue = Math.Max(1, Model.Trend.Any() ? Model.Trend.Max(x => x.TotalChanges) : 0);
}

<section class="ciit-admin-reports">
    <div class="ciit-admin-reports-topbar">
        <div>
            <span class="ciit-admin-eyebrow">REPORTS</span>
            <h1>Reports Overview</h1>
            <p>Monitor your learning platform, content and assessment activity from one place.</p>
        </div>

        <div class="ciit-admin-reports-top-actions">
            <span class="ciit-admin-live-pill"><span></span> Live data</span>
            <form method="get" asp-area="Admin" asp-controller="Reports" asp-action="Index" class="ciit-admin-report-filter">
                <div class="ciit-admin-report-date-field">
                    <label for="startDate">From</label>
                    <input id="startDate" name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="ciit-admin-report-date-field">
                    <label for="endDate">To</label>
                    <input id="endDate" name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <button type="submit" class="ciit-admin-report-filter-button">
                    <i class="bi bi-funnel"></i>
                    Apply Filter
                </button>
            </form>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="ciit-admin-report-validation" role="alert">
            <i class="bi bi-exclamation-circle"></i>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="ciit-admin-report-nav">
        <a class="active" asp-area="Admin" asp-controller="Reports" asp-action="Index">
            <i class="bi bi-grid-1x2"></i>
            Overview
        </a>
        <span>Course Reports</span>
        <span>Student Reports</span>
        <span>Assessment Reports</span>
        <span>Revenue &amp; Payments</span>
        <span>Activity Reports</span>
    </div>

    <div class="ciit-admin-report-period">
        <div>
            <span>Selected reporting period</span>
            <strong>@Model.StartDate.ToString("dd MMM yyyy") — @Model.EndDate.ToString("dd MMM yyyy")</strong>
        </div>
        <span class="ciit-admin-period-note">Reporting period</span>
    </div>

    <div class="ciit-admin-report-stat-grid">
        <article class="ciit-admin-report-stat-card featured">
            <div class="ciit-admin-report-stat-icon"><i class="bi bi-journal-code"></i></div>
            <div class="ciit-admin-report-stat-copy">
                <span>Active Courses</span>
                <strong>@Model.ActiveCourseCount</strong>
                <small>Current learning catalog</small>
            </div>
        </article>

        <article class="ciit-admin-report-stat-card">
            <div class="ciit-admin-report-stat-icon"><i class="bi bi-people"></i></div>
            <div class="ciit-admin-report-stat-copy">
                <span>Active Students</span>
                <strong>@Model.ActiveStudentCount</strong>
                <small>Active student accounts</small>
            </div>
        </article>

        <article class="ciit-admin-report-stat-card">
            <div class="ciit-admin-report-stat-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="ciit-admin-report-stat-copy">
                <span>Learning Content</span>
                <strong>@Model.ActiveContentCount</strong>
                <small>Published learning items</small>
            </div>
        </article>

        <article class="ciit-admin-report-stat-card">
            <div class="ciit-admin-report-stat-icon"><i class="bi bi-ui-checks-grid"></i></div>
            <div class="ciit-admin-report-stat-copy">
                <span>Assessment Items</span>
                <strong>@Model.ActiveAssessmentCount</strong>
                <small>MCQs, interviews &amp; programs</small>
            </div>
        </article>

        <article class="ciit-admin-report-stat-card">
            <div class="ciit-admin-report-stat-icon"><i class="bi bi-activity"></i></div>
            <div class="ciit-admin-report-stat-copy">
                <span>Period Activity</span>
                <strong>@(Model.CourseActivityCount + Model.ContentActivityCount + Model.AssessmentActivityCount)</strong>
                <small>Changes in selected period</small>
            </div>
        </article>
    </div>

    <div class="ciit-admin-report-main-grid">
        <section class="ciit-admin-report-panel ciit-admin-report-trend-panel">
            <div class="ciit-admin-report-panel-header">
                <div>
                    <span class="ciit-admin-panel-kicker">ACTIVITY ANALYTICS</span>
                    <h2>Platform activity</h2>
                    <p>Content and assessment changes during the selected period.</p>
                </div>
                <span class="ciit-admin-report-period-note">@Model.Trend.Count days</span>
            </div>

            <div class="ciit-admin-report-chart-area">
                <div class="ciit-admin-report-chart-scale">
                    <span>@maxTrendValue</span>
                    <span>@Math.Max(1, maxTrendValue / 2)</span>
                    <span>0</span>
                </div>

                <div class="ciit-admin-report-chart-wrap">
                    @foreach (var point in Model.Trend)
                    {
                        var courseHeight = point.CourseChanges == 0 ? 0 : Math.Max(7, point.CourseChanges * 100.0 / maxTrendValue);
                        var contentHeight = point.ContentChanges == 0 ? 0 : Math.Max(7, point.ContentChanges * 100.0 / maxTrendValue);
                        var assessmentHeight = point.AssessmentChanges == 0 ? 0 : Math.Max(7, point.AssessmentChanges * 100.0 / maxTrendValue);

                        <div class="ciit-admin-report-chart-day" title="@point.Date.ToString("dd MMM yyyy") — Courses: @point.CourseChanges, Content: @point.ContentChanges, Assessments: @point.AssessmentChanges">
                            <div class="ciit-admin-report-bars">
                                <span class="course-bar" style="height:@courseHeight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                <span class="content-bar" style="height:@contentHeight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                <span class="assessment-bar" style="height:@assessmentHeight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                            </div>
                            <span class="ciit-admin-report-day-label">@point.Date.ToString("dd")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="ciit-admin-report-legend">
                <span><i class="legend-course"></i> Courses</span>
                <span><i class="legend-content"></i> Learning Content</span>
                <span><i class="legend-assessment"></i> Assessments</span>
            </div>
        </section>

        <section class="ciit-admin-report-panel ciit-admin-report-snapshot-panel">
            <div class="ciit-admin-report-panel-header">
                <div>
                    <span class="ciit-admin-panel-kicker">PLATFORM SNAPSHOT</span>
                    <h2>Learning inventory</h2>
                    <p>Current active inventory across the platform.</p>
                </div>
            </div>

            <div class="ciit-admin-report-inventory">
                <div class="inventory-row">
                    <div class="inventory-icon"><i class="bi bi-journal-code"></i></div>
                    <div><span>Courses</span><small>Active catalog</small></div>
                    <strong>@Model.ActiveCourseCount</strong>
                </div>
                <div class="inventory-row">
                    <div class="inventory-icon"><i class="bi bi-diagram-3"></i></div>
                    <div><span>Topics</span><small>Active topics</small></div>
                    <strong>@Model.ActiveTopicCount</strong>
                </div>
                <div class="inventory-row">
                    <div class="inventory-icon"><i class="bi bi-file-earmark-text"></i></div>
                    <div><span>Learning Content</span><small>Published items</small></div>
                    <strong>@Model.ActiveContentCount</strong>
                </div>
                <div class="inventory-row">
                    <div class="inventory-icon"><i class="bi bi-ui-checks-grid"></i></div>
                    <div><span>Assessments</span><small>All assessment types</small></div>
                    <strong>@Model.ActiveAssessmentCount</strong>
                </div>
            </div>
        </section>
    </div>

    <section class="ciit-admin-report-panel">
        <div class="ciit-admin-report-panel-header">
            <div>
                <span class="ciit-admin-panel-kicker">RECENT ACTIVITY</span>
                <h2>Latest platform changes</h2>
                <p>The most recent course, content and assessment updates.</p>
            </div>
            <span class="ciit-admin-report-period-note">10 latest</span>
        </div>

        @if (Model.RecentActivity.Count == 0)
        {
            <div class="ciit-admin-report-empty">
                <i class="bi bi-activity"></i>
                <strong>No activity in this period</strong>
                <span>Try a wider date range.</span>
            </div>
        }
        else
        {
            <div class="ciit-admin-report-table-wrap">
                <table class="ciit-admin-report-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Activity</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in Model.RecentActivity)
                        {
                            <tr>
                                <td>
                                    <span class="ciit-admin-report-type-badge">
                                        <i class="@(activity.Type switch
                                        {
                                            "Course" => "bi bi-journal-code",
                                            "Learning Content" => "bi bi-file-earmark-text",
                                            "MCQ" => "bi bi-ui-checks",
                                            "Interview Question" => "bi bi-chat-square-text",
                                            _ => "bi bi-code-slash"
                                        })"></i>
                                        @activity.Type
                                    </span>
                                </td>
                                <td class="activity-title" title="@activity.Title">@activity.Title</td>
                                <td>@activity.Date.ToString("dd MMM yyyy")</td>
                                <td><span class="ciit-admin-status-pill">Active</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
