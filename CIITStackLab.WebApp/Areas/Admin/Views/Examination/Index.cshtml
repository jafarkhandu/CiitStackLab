@section Styles {
    <link rel="stylesheet" href="~/css/admin-assessments.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Topic Examinations";
    var topics = ViewBag.Topics as IReadOnlyList<CIITStackLab.WebApp.Areas.Admin.Controllers.ExaminationController.ExaminationTopicRow>
        ?? Array.Empty<CIITStackLab.WebApp.Areas.Admin.Controllers.ExaminationController.ExaminationTopicRow>();
    var preview = ViewBag.Preview as CIITStackLab.WebApp.Areas.Admin.Controllers.ExaminationController.ExamImportPreview;
    var previewToken = ViewBag.PreviewToken as string;
}

<section class="container py-4 ciit-admin-page assessment-page ciit-topic-exam-admin">
    <header class="assessment-hero">
        <div class="assessment-hero-copy">
            <span class="assessment-hero-kicker"><span class="assessment-live-dot" aria-hidden="true"></span> EXAMINATION CENTER</span>
            <h1>Topic examination question bank</h1>
            <p>Manage topic-specific exam MCQs separately from practice questions. Excel imports have no fixed question-count limit.</p>
        </div>
        <div class="assessment-hero-art" aria-hidden="true">
            <span class="assessment-art-orbit assessment-art-orbit--outer"></span>
            <span class="assessment-art-orbit assessment-art-orbit--inner"></span>
            <span class="assessment-art-core"><i class="bi bi-shield-check"></i></span>
        </div>
    </header>

    @if (ViewBag.Message is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (preview is not null && !string.IsNullOrWhiteSpace(previewToken))
    {
        <div class="card border-primary shadow-sm mb-4 assessment-workspace-card">
            <div class="card-body p-4">
                <h2 class="h5">Excel analysis report</h2>
                <p class="text-secondary mb-2">File: <strong>@preview.FileName</strong> · Topic: <strong>@preview.TopicTitle</strong></p>

                @if (preview.HeaderIssues.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <h3 class="h6">Header problems — fix these first</h3>
                        <ul class="mb-2">
                            @foreach (var issue in preview.HeaderIssues)
                            {
                                <li>@issue</li>
                            }
                        </ul>
                        <p class="mb-0">Required first row, in this exact order: <code>Question, Option1, Option2, Option3, Option4, CorrectOptionNumber</code></p>
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-3">
                        <div class="col-sm-4"><div class="border rounded p-3 h-100"><small class="text-secondary">Valid questions</small><div class="fs-4 fw-bold text-success">@preview.Questions.Count</div></div></div>
                        <div class="col-sm-4"><div class="border rounded p-3 h-100"><small class="text-secondary">Rows needing fixes</small><div class="fs-4 fw-bold text-danger">@preview.InvalidRows</div></div></div>
                        <div class="col-sm-4"><div class="border rounded p-3 h-100"><small class="text-secondary">Rows analyzed</small><div class="fs-4 fw-bold">@preview.Rows.Count</div></div></div>
                    </div>
                    @if (preview.InvalidRows > 0)
                    {
                        <div class="alert alert-warning" role="status">
                            <strong>What needs fixing:</strong> Review the issue shown for each invalid row below. Correct the named cell, then upload the workbook again. Invalid rows will not be imported.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success" role="status">All non-empty question rows passed validation. Review the sample, then confirm to save.</div>
                    }
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-hover align-middle">
                            <thead><tr><th>Excel row</th><th>Status</th><th>Question / issue</th><th>Correct option</th></tr></thead>
                            <tbody>
                            @foreach (var row in preview.Rows)
                            {
                                <tr class="@(row.IsValid ? "" : "table-warning")">
                                    <td>@row.RowNumber</td>
                                    <td>
                                        @if (row.IsValid) { <span class="badge text-bg-success">Valid</span> }
                                        else { <span class="badge text-bg-danger">Needs fix</span> }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(row.Question) ? row.Question : "(Question cell is empty)")</div>
                                        @if (row.Issues.Count > 0)
                                        {
                                            <ul class="small text-danger mb-0 mt-1">
                                                @foreach (var issue in row.Issues) { <li>@issue</li> }
                                            </ul>
                                        }
                                    </td>
                                    <td>@(row.CorrectOptionNumber?.ToString() ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (preview.Questions.Count > 0)
                    {
                        <details class="mb-3">
                            <summary class="fw-semibold">Preview first 10 valid questions</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm">
                                    <thead><tr><th>Question</th><th>Option A</th><th>Option B</th><th>Option C</th><th>Option D</th><th>Answer</th></tr></thead>
                                    <tbody>
                                    @foreach (var question in preview.Questions.Take(10))
                                    {
                                        <tr><td>@question.Question</td><td>@question.Option1</td><td>@question.Option2</td><td>@question.Option3</td><td>@question.Option4</td><td>@("ABCD"[question.CorrectOptionNumber - 1])</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                    @if (preview.Questions.Count > 0)
                    {
                        <form asp-area="Admin" asp-controller="Examination" asp-action="ConfirmImport" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="previewToken" value="@previewToken" />
                            <button type="submit" class="btn btn-primary">Confirm and save @preview.Questions.Count valid questions</button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Discard preview</a>
                        </form>
                    }
                    else
                    {
                        <p class="text-danger mb-0">No valid questions to save. Fix the workbook and analyze it again.</p>
                    }
                }
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4 assessment-workspace-card">
        <div class="card-body p-4">
            <h2 class="h5">Bulk import questions</h2>
            <p class="text-secondary">The importer validates each row and skips invalid or duplicate questions. Examination questions are stored separately from practice questions.</p>
            <form asp-area="Admin" asp-controller="Examination" asp-action="Import" method="post" enctype="multipart/form-data" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label class="form-label" for="topicId">Topic</label>
                    <select class="form-select" id="topicId" name="topicId" required>
                        <option value="">Select topic</option>
                        @foreach (var topic in topics)
                        {
                            <option value="@topic.Id">@topic.Title (@topic.QuestionCount questions)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="file">Excel workbook</label>
                    <input class="form-control" id="file" name="file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">Analyze Excel</button>
                </div>
            </form>
            <div class="mt-3 small text-secondary">
                Required first-row headers in this exact order: <code>Question, Option1, Option2, Option3, Option4, CorrectOptionNumber</code>
                <p class="mb-0 mt-2">Upload an .xlsx workbook. CorrectOptionNumber must be 1, 2, 3, or 4 (1=A, 2=B, 3=C, 4=D). The analyzer identifies missing cells, invalid answers, duplicate questions, and header mismatches before anything is saved.</p>
            </div>
        </div>
    </div>

    <div class="card shadow-sm assessment-workspace-card">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Topic question availability</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Topic</th><th class="text-end">Valid question count</th><th class="text-end">Exam readiness</th></tr></thead>
                    <tbody>
                    @foreach (var topic in topics)
                    {
                        <tr>
                            <td>@topic.Title</td>
                            <td class="text-end">@topic.QuestionCount</td>
                            <td class="text-end">
                                @if (topic.QuestionCount >= 50)
                                {
                                    <span class="badge text-bg-success">Ready</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Need @(50 - topic.QuestionCount) more</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
