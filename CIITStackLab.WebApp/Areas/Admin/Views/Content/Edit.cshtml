@model CIITStackLab.Application.DTOs.AdminContentInputDto

@{
    ViewData["Title"] = "Edit Content";
    var isModal = string.Equals(Context.Request.Query["modal"], "true", StringComparison.OrdinalIgnoreCase)
        || (Context.Request.HasFormContentType && string.Equals(Context.Request.Form["modal"], "true", StringComparison.OrdinalIgnoreCase));
    if (isModal)
    {
        Layout = "~/Areas/Admin/Views/Shared/_ContentModalLayout.cshtml";
    }
}

@section Styles {
    @if (!isModal)
    {
        <link rel="stylesheet" href="~/css/admin/admin-content.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin/admin-content-redesign.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/admin/admin-content-modal.css" asp-append-version="true" />
}

<section class="ciit-content-form-page">
    <div class="ciit-content-form-header">
        <div>
            @if (!isModal)
            {
                <a asp-action="Index" class="ciit-content-back"><i class="bi bi-arrow-left"></i> Back to Content</a>
            }
            <span class="ciit-content-eyebrow">Learning content</span>
            <h1>Edit Content</h1>
            <p>Keep the existing record and update its chapter media.</p>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="ciit-content-form-card">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input type="hidden" name="modal" value="@(isModal ? "true" : "false")" />
        <input type="hidden" name="vimeoVideoUrl" class="js-vimeo-video-url" />

        <div asp-validation-summary="ModelOnly" class="ciit-content-validation"></div>

        <div class="ciit-content-form-section">
            <div class="ciit-content-form-section-heading">
                <div class="ciit-content-form-section-icon"><i class="bi bi-pencil-square"></i></div>
                <div>
                    <h2>Content details</h2>
                    <p>Update the learning resource placement and title.</p>
                </div>
            </div>

            <div class="ciit-content-form-grid">
                <div class="ciit-content-field">
                    <label asp-for="TopicId">Topic</label>
                    <select asp-for="TopicId" asp-items="ViewBag.Topics" class="form-select" id="contentTopic">
                        <option value="0">Select topic</option>
                    </select>
                    <span asp-validation-for="TopicId" class="text-danger"></span>
                </div>

                <div class="ciit-content-field">
                    <label asp-for="NoteId">Notes / Chapter</label>
                    <select asp-for="NoteId" asp-items="ViewBag.Notes" class="form-select" id="contentNote">
                        <option value="0">Select note chapter</option>
                    </select>
                    <span asp-validation-for="NoteId" class="text-danger"></span>
                    <small>Only note chapters belonging to the selected topic are available.</small>
                </div>

                <div class="ciit-content-field full-width">
                    <label asp-for="Title">Content Name</label>
                    <input asp-for="Title" class="form-control" maxlength="100" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="ciit-content-form-section">
            <div class="ciit-content-form-section-heading">
                <div class="ciit-content-form-section-icon is-media"><i class="bi bi-collection-play"></i></div>
                <div>
                    <h2>Learning media</h2>
                    <p>Replace either resource without changing the existing one you want to keep.</p>
                </div>
            </div>

            <div class="ciit-content-form-grid">
                <div class="ciit-content-field">
                    <label>Replace Slides</label>
                    <input type="file" name="slidesFile" class="form-control" accept=".pdf,application/pdf" />
                    <div class="ciit-content-existing-media">
                        <span class="ciit-content-existing-media-label">Current slides</span>
                        @if (string.IsNullOrWhiteSpace(Model.Slides))
                        {
                            <strong class="is-muted">No slides uploaded</strong>
                        }
                        else
                        {
                            <strong title="@Model.Slides">@System.IO.Path.GetFileName(Model.Slides)</strong>
                            <span>Currently attached to this content.</span>
                        }
                    </div>
                    <small>Choose a PDF file to replace the current slides.</small>
                </div>

                <div class="ciit-content-field">
                    <label>Replace Video</label>
                    <input type="file" name="videoFile" class="form-control" accept=".mp4,.webm,.mov" />
                    <div class="ciit-content-existing-media">
                        <span class="ciit-content-existing-media-label">Current video</span>
                        @if (string.IsNullOrWhiteSpace(Model.VideoName))
                        {
                            <strong class="is-muted">No video uploaded</strong>
                        }
                        else if (Uri.TryCreate(Model.VideoName, UriKind.Absolute, out var currentVideoUri))
                        {
                            <strong><a href="@currentVideoUri" target="_blank" rel="noopener noreferrer">Open current video</a></strong>
                            <span>Current video is attached to this content.</span>
                        }
                        else
                        {
                            <strong title="@Model.VideoName">@Model.VideoName</strong>
                            <span>Current video is attached to this content.</span>
                        }
                    </div>
                    <small>Choose a video file to replace the current video.</small>
                </div>
            </div>
        </div>

        <div class="ciit-content-form-footer">
            @if (!isModal)
            {
                <a asp-action="Index" class="ciit-content-secondary-btn">Cancel</a>
            }
            <button type="submit" class="ciit-content-primary-btn"><i class="bi bi-check2-circle"></i> Save Changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/admin-content.js" asp-append-version="true"></script>
}
