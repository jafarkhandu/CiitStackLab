@model CIITStackLab.WebApp.Models.MeetBatchIndexViewModel

@{
    ViewData["Title"] = "Meet Batches";
    var message = TempData["MeetBatchMessage"] as string;
    var messageType = TempData["MeetBatchMessageType"] as string;
}

<section class="ciit-admin-page meet-batches-page">
    <div class="meet-page-header">
        <div>
            <span class="ciit-admin-eyebrow">Meet Management</span>
            <h1>Batch Management</h1>
            <p>Create meeting batches and manage registered student access.</p>
        </div>
        <div class="meet-header-count">
            <strong>@Model.ActiveBatches.Count</strong>
            <span>Active batches</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="meet-alert @(messageType == "success" ? "is-success" : "is-error")" role="alert">
            <span>@message</span>
            <button type="button" class="meet-alert-close" aria-label="Close message">&times;</button>
        </div>
    }

    <section class="meet-panel" style="margin-top:24px;">
        <div class="meet-section-heading">
            <div>
                <span class="ciit-admin-eyebrow">Meeting sessions</span>
                <h2>Create a meeting</h2>
                <p>Start an instant session or schedule it for an active batch.</p>
            </div>
        </div>
        @if (Model.ActiveBatches.Count == 0)
        {
            <p class="meet-empty-state">Create an active batch and assign students before scheduling a meeting.</p>
        }
        else
        {
            <form asp-area="Admin" asp-controller="Meet" asp-action="CreateSession" method="post" class="meet-modal-form" id="meetSessionForm">
                @Html.AntiForgeryToken()
                <div class="meet-form-field">
                    <label for="sessionTitle">Meeting title</label>
                    <input id="sessionTitle" name="Title" type="text" maxlength="150" required placeholder="e.g. Weekly doubt session" />
                </div>
                <div class="meet-form-field">
                    <label for="sessionDescription">Description <span>(optional)</span></label>
                    <textarea id="sessionDescription" name="Description" rows="2" maxlength="1000" placeholder="Meeting agenda or instructions"></textarea>
                </div>
                <div class="meet-form-field">
                    <label for="sessionBatch">Batch</label>
                    <select id="sessionBatch" name="MeetBatchId" required>
                        <option value="">Select active batch</option>
                        @foreach (var batch in Model.ActiveBatches)
                        {
                            <option value="@batch.Id">@batch.Name (@batch.MemberCount students)</option>
                        }
                    </select>
                </div>
                <div class="meet-form-field">
                    <label for="sessionDuration">Duration</label>
                    <select id="sessionDuration" name="DurationMinutes">
                        <option value="30">30 minutes</option>
                        <option value="45">45 minutes</option>
                        <option value="60" selected>60 minutes</option>
                        <option value="90">90 minutes</option>
                        <option value="120">2 hours</option>
                        <option value="240">4 hours</option>
                        <option value="480">8 hours</option>
                    </select>
                </div>
                <div class="meet-form-field">
                    <label for="sessionStart">Schedule date and time <span>(required only for scheduled meetings)</span></label>
                    <input id="sessionStart" name="StartsAtLocal" type="datetime-local" />
                    <input id="clientUtcOffset" name="ClientUtcOffsetMinutes" type="hidden" value="0" />
                </div>
                <div class="meet-modal-feedback" role="alert" hidden></div>
                <div class="meet-batch-actions">
                    <button type="submit" name="meetingMode" value="instant" class="meet-primary-button">
                        <i class="bi bi-camera-video-fill"></i> Start instant meeting
                    </button>
                    <button type="submit" name="meetingMode" value="scheduled" class="meet-secondary-button">
                        <i class="bi bi-calendar-plus"></i> Schedule meeting
                    </button>
                </div>
            </form>
        }
    </section>

    <section class="meet-batch-list-section" style="margin-top:28px;">
        <div class="meet-section-heading">
            <div>
                <span class="ciit-admin-eyebrow">Batch calendar</span>
                <h2>Meetings</h2>
            </div>
            <span class="meet-count-pill">@Model.Sessions.Count sessions</span>
        </div>
        @if (Model.Sessions.Count == 0)
        {
            <div class="meet-empty-state">
                <i class="bi bi-camera-video"></i>
                <h3>No meetings yet</h3>
                <p>Instant and scheduled meetings will appear here.</p>
            </div>
        }
        else
        {
            <div class="meet-archived-list">
                @foreach (var session in Model.Sessions)
                {
                    <div class="meet-archived-item">
                        <div>
                            <strong>@session.Title</strong>
                            <span>@session.BatchName · @session.StartsAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") · @session.DurationMinutes min</span>
                        </div>
                        <span class="meet-archived-label">@session.Status</span>
                    </div>
                }
            </div>
        }
    </section>

    <div class="meet-batch-layout">
        <section class="meet-create-launch">
            <div class="meet-panel-icon"><i class="bi bi-people-fill"></i></div>
            <h2>Create batch</h2>
            <p>Choose a name and add registered students.</p>
            <button type="button" class="meet-primary-button" data-open-create-modal>
                <i class="bi bi-plus-lg"></i> Create batch
            </button>
        </section>

        <section class="meet-batch-list-section">
            <div class="meet-section-heading">
                <div>
                    <span class="ciit-admin-eyebrow">Your workspace</span>
                    <h2>Active batches</h2>
                </div>
                <span class="meet-count-pill">@Model.ActiveBatches.Count batches</span>
            </div>

            @if (Model.ActiveBatches.Count == 0)
            {
                <div class="meet-empty-state">
                    <i class="bi bi-people"></i>
                    <h3>No batches created yet</h3>
                    <p>Create your first batch to start organizing meeting participants.</p>
                </div>
            }
            else
            {
                <div class="meet-batch-grid">
                    @foreach (var batch in Model.ActiveBatches)
                    {
                        <article class="meet-batch-card">
                            <div class="meet-batch-card-top">
                                <span class="meet-batch-status"><span></span> Active</span>
                                <span class="meet-batch-code">@batch.BatchCode</span>
                            </div>
                            <h3>@batch.Name</h3>
                            <p class="meet-batch-description">@(string.IsNullOrWhiteSpace(batch.Description) ? "No description added." : batch.Description)</p>
                            <div class="meet-batch-meta">
                                <span><i class="bi bi-people"></i> @batch.MemberCount students</span>
                                <span><i class="bi bi-calendar3"></i> @batch.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="meet-batch-actions">
                                <a href="@Url.Action("Details", "Meet", new { area = "Admin", id = batch.Id })"
                                   class="meet-secondary-button"
                                   data-open-manage-modal
                                   data-url="@Url.Action("Details", "Meet", new { area = "Admin", id = batch.Id })">
                                    Manage batch <i class="bi bi-arrow-right"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Meet" asp-action="Archive" method="post" onsubmit="return confirm('Move this batch to archive?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@batch.Id" />
                                    <button type="submit" class="meet-icon-button" title="Archive batch" aria-label="Archive @batch.Name"><i class="bi bi-archive"></i></button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    @if (Model.ArchivedBatches.Count > 0)
    {
        <section class="meet-archive-section">
            <div class="meet-section-heading">
                <div>
                    <span class="ciit-admin-eyebrow">Stored batches</span>
                    <h2>Archived batches</h2>
                </div>
                <span class="meet-count-pill">@Model.ArchivedBatches.Count archived</span>
            </div>
            <div class="meet-archived-list">
                @foreach (var batch in Model.ArchivedBatches)
                {
                    <div class="meet-archived-item">
                        <div>
                            <strong>@batch.Name</strong>
                            <span>@batch.BatchCode · @batch.MemberCount students</span>
                        </div>
                        <span class="meet-archived-label">Archived</span>
                    </div>
                }
            </div>
        </section>
    }
</section>

<div class="meet-modal-backdrop" id="meetModal" aria-hidden="true">
    <section class="meet-modal" role="dialog" aria-modal="true" aria-labelledby="meetModalTitle">
        <div class="meet-modal-header">
            <div>
                <span class="ciit-admin-eyebrow">Meet Management</span>
                <h2 id="meetModalTitle">Create batch</h2>
            </div>
            <button type="button" class="meet-modal-close" data-close-meet-modal aria-label="Close">&times;</button>
        </div>
        <div class="meet-modal-content" id="meetModalContent"></div>
    </section>
</div>

<template id="meetCreateTemplate">
    <form action="@Url.Action("Create", "Meet", new { area = "Admin" })" method="post" class="meet-modal-form">
        @Html.AntiForgeryToken()
        <div class="meet-form-field">
            <label for="batchName">Batch name</label>
            <input id="batchName" name="name" type="text" maxlength="100" required placeholder="e.g. Full Stack - Morning" />
        </div>
        <div class="meet-form-field">
            <label for="batchDescription">Description <span>(optional)</span></label>
            <textarea id="batchDescription" name="description" rows="3" maxlength="500" placeholder="Add a short description"></textarea>
        </div>
        <div class="meet-form-field">
            <div class="meet-student-picker-heading">
                <label>Assign students</label>
                <span>@Model.Students.Count available</span>
            </div>
            <input class="meet-student-search" id="meetStudentSearch" type="search" placeholder="Search students..." autocomplete="off" />
            <div class="meet-student-picker" id="meetStudentPicker">
                @if (Model.Students.Count == 0)
                {
                    <p class="meet-no-students">No active registered students are available.</p>
                }
                @foreach (var student in Model.Students)
                {
                    <label class="meet-student-option" data-search="@(string.Join(" ", new[] { student.UserName, student.Email }).ToLowerInvariant())">
                        <input type="checkbox" name="studentIds" value="@student.Id" />
                        <span class="meet-student-option-copy">
                            <strong>@student.UserName</strong>
                            <small>@(string.IsNullOrWhiteSpace(student.Email) ? "No email available" : student.Email)</small>
                        </span>
                    </label>
                }
            </div>
        </div>
        <div class="meet-modal-feedback" role="alert" hidden></div>
        <button type="submit" class="meet-primary-button">
            <i class="bi bi-plus-lg"></i>
            Create batch
        </button>
    </form>
</template>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-meet-batches.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin/admin-meet-batches.js" asp-append-version="true"></script>
}
