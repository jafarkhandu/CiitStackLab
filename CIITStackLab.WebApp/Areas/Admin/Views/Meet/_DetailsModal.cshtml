@model CIITStackLab.WebApp.Models.MeetBatchDetailsViewModel

@{
    var selectedIds = Model.SelectedStudentIds.ToHashSet(StringComparer.Ordinal);
}

<div class="meet-details-code"><span>Batch code</span><strong>@Model.BatchCode</strong></div>
<form asp-area="Admin" asp-controller="Meet" asp-action="Update" method="post" class="meet-modal-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="meet-form-field">
        <label asp-for="Name">Batch name</label>
        <input asp-for="Name" maxlength="100" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="meet-form-field">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" rows="3" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="meet-form-field">
        <div class="meet-student-picker-heading"><label>Assigned students</label><span>@Model.Students.Count active students available</span></div>
        <input class="meet-student-search" id="meetStudentSearch" type="search" placeholder="Search students..." autocomplete="off" />
        <div class="meet-student-picker meet-student-picker-large" id="meetStudentPicker">
            @if (Model.Students.Count == 0) { <p class="meet-no-students">No active registered students are available.</p> }
            @foreach (var student in Model.Students)
            {
                <label class="meet-student-option" data-search="@(string.Join(" ", new[] { student.UserName, student.Email }).ToLowerInvariant())">
                    <input type="checkbox" name="SelectedStudentIds" value="@student.Id" checked="@selectedIds.Contains(student.Id)" />
                    <span class="meet-student-option-copy"><strong>@student.UserName</strong><small>@(string.IsNullOrWhiteSpace(student.Email) ? "No email available" : student.Email)</small></span>
                    @if (selectedIds.Contains(student.Id)) { <span class="meet-assigned-tag">Assigned</span> }
                </label>
            }
        </div>
    </div>
    <div class="meet-modal-feedback" role="alert" hidden></div>
    <div class="meet-details-footer"><span>Created @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span><button type="submit" class="meet-primary-button"><i class="bi bi-check2"></i> Save changes</button></div>
</form>