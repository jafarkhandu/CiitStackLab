@model IReadOnlyList<CIITStackLab.Application.DTOs.TopicExamSummaryDto>
@{
    Layout = "_CourseLayout";
    ViewData["Title"] = "Examinations";
    var options = ViewBag.AvailableTopics as IReadOnlyList<CIITStackLab.WebApp.Controllers.StudentExaminationsController.ExamTopicOption>
        ?? Array.Empty<CIITStackLab.WebApp.Controllers.StudentExaminationsController.ExamTopicOption>();
    var pendingExams = Model
        .GroupBy(item => new { item.CourseId, item.TopicId })
        .Select(group =>
        {
            var ordered = group.OrderByDescending(item => item.AttemptId).ToList();
            return new
            {
                Latest = ordered[0],
                AttemptCount = group.Count(),
                HasPassed = group.Any(item => item.Passed && item.Status == "Passed")
            };
        })
        .Where(item => item.Latest.Status is "Failed" or "Terminated" or "TimedOut")
        .ToList();
}
@section Styles {
<style>
.ciit-examination-page{max-width:1280px;padding-top:34px;padding-bottom:54px;color:#1b3153}
.ciit-exam-hero{position:relative;overflow:hidden;padding:30px 34px;border:1px solid rgba(255,255,255,.88);border-radius:26px;background:linear-gradient(125deg,rgba(255,255,255,.92),rgba(229,240,255,.76));box-shadow:0 20px 55px rgba(44,83,140,.1),inset 0 1px 0 #fff;-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px)}
.ciit-exam-hero:before{content:"";position:absolute;left:0;top:24px;bottom:24px;width:4px;border-radius:0 5px 5px 0;background:linear-gradient(180deg,#2f7cff,rgba(88,157,255,.18));pointer-events:none}
.ciit-exam-hero:after{content:"";position:absolute;width:300px;height:300px;right:-78px;top:-155px;border-radius:50%;background:radial-gradient(circle,rgba(63,132,255,.24),rgba(104,164,255,.08) 38%,transparent 72%);pointer-events:none}
.ciit-exam-hero>*{position:relative;z-index:1}
.ciit-exam-kicker{display:inline-flex;align-items:center;gap:9px;color:#2368e8;font-size:.73rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
.ciit-exam-kicker:before{content:"";width:7px;height:7px;border-radius:50%;background:#3a8cff;box-shadow:0 0 0 5px rgba(58,140,255,.12)}
.ciit-exam-hero h1{margin:12px 0 8px;font-size:clamp(1.8rem,3vw,2.55rem);font-weight:850;letter-spacing:-.045em}
.ciit-exam-hero p{max-width:650px;margin:0;color:#71839e;line-height:1.7}
.ciit-exam-panel{margin-top:24px;border:1px solid rgba(255,255,255,.94);border-radius:23px;background:linear-gradient(145deg,rgba(255,255,255,.84),rgba(246,250,255,.76));box-shadow:0 18px 46px rgba(38,74,125,.085),inset 0 1px 0 #fff;-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);overflow:hidden}
.ciit-exam-panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px 26px;border-bottom:1px solid rgba(211,226,247,.8)}
.ciit-exam-panel-head h2{margin:0;font-size:1.08rem;font-weight:820}.ciit-exam-panel-head p{margin:6px 0 0;color:#7c8da5;font-size:.86rem}
.ciit-exam-count{display:grid;place-items:center;min-width:40px;height:40px;padding:0 12px;border:1px solid rgba(195,218,255,.95);border-radius:14px;background:linear-gradient(145deg,#fff,#eaf2ff);color:#2167ee;font-weight:850;box-shadow:0 5px 14px rgba(37,99,235,.08)}
.ciit-exam-table-wrap{padding:8px 24px 18px}.ciit-exam-table{width:100%;margin:0;border-collapse:separate;border-spacing:0 8px}
.ciit-exam-table thead th{padding:12px 14px;border:0;color:#8191a9;font-size:.7rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap}
.ciit-exam-table{border-spacing:0 10px}
.ciit-exam-table tbody tr{background:linear-gradient(115deg,rgba(255,255,255,.96),rgba(239,246,255,.88));filter:drop-shadow(0 5px 12px rgba(39,78,138,.045));transition:transform .24s ease,filter .24s ease}
.ciit-exam-table tbody tr:hover{background:linear-gradient(115deg,#fff,#edf5ff);transform:translateY(-3px);filter:drop-shadow(0 12px 18px rgba(39,91,170,.12))}
.ciit-exam-table tbody td{padding:18px 14px;border-top:1px solid rgba(207,224,249,.9);border-bottom:1px solid rgba(207,224,249,.9);color:#526783;vertical-align:middle}
.ciit-exam-table tbody td:first-child{border-left:1px solid #d4e4fb;border-radius:16px 0 0 16px}.ciit-exam-table tbody td:last-child{border-right:1px solid #d4e4fb;border-radius:0 16px 16px 0}
.ciit-exam-topic{font-size:.93rem;letter-spacing:-.015em}
.ciit-exam-action{position:relative;overflow:hidden;min-height:41px;padding:10px 16px;border-color:#c9ddff;border-radius:12px;background:linear-gradient(135deg,#fff 0%,#eaf2ff 100%);box-shadow:0 4px 10px rgba(37,99,235,.07);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
.ciit-exam-action:hover{transform:translateY(-2px);box-shadow:0 8px 17px rgba(37,99,235,.16)}
.ciit-exam-action:focus-visible{outline:3px solid rgba(37,99,235,.25);outline-offset:3px}
.ciit-exam-status{box-shadow:inset 0 1px 0 rgba(255,255,255,.8)}
.ciit-exam-table tbody tr{animation:exam-row-enter .42s both;animation-delay:calc(var(--row-index,0)*35ms)}
@@keyframes exam-row-enter{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}
@@media(prefers-reduced-motion:reduce){.ciit-exam-table tbody tr{animation:none;transition:none}.ciit-exam-action{transition:none}}
.ciit-exam-topic{display:block;color:#243c60;font-weight:820}.ciit-exam-sub{display:block;margin-top:5px;color:#8a9ab0;font-size:.76rem}
.ciit-exam-status{display:inline-flex;padding:6px 10px;border:1px solid #dbe8fa;border-radius:999px;background:#f1f6ff;color:#52709a;font-size:.74rem;font-weight:800}
.ciit-exam-status[data-status="Passed"]{border-color:#c8f0dd;background:#edfbf4;color:#168154}.ciit-exam-status[data-status="Failed"],.ciit-exam-status[data-status="Terminated"],.ciit-exam-status[data-status="TimedOut"]{border-color:#f7d9d9;background:#fff3f3;color:#b74747}
.ciit-exam-action{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:9px 13px;border:1px solid #cfe0ff;border-radius:11px;background:linear-gradient(135deg,#fff,#edf4ff);color:#2167ed;font-size:.78rem;font-weight:820;text-decoration:none;white-space:nowrap}.ciit-exam-action:hover{border-color:#8fb7ff;background:#eaf2ff;color:#1354d7}.ciit-exam-action.disabled{opacity:.45;pointer-events:none}
.ciit-exam-empty{padding:54px 20px;text-align:center}.ciit-exam-empty-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 16px;border:1px solid #dce9ff;border-radius:19px;background:linear-gradient(145deg,#fff,#eaf3ff);color:#3679ef;font-size:1.35rem;box-shadow:0 10px 25px rgba(45,101,184,.1)}
.ciit-exam-empty h3{margin:0 0 7px;color:#294365;font-size:1rem;font-weight:820}.ciit-exam-empty p{margin:0;color:#8494aa;font-size:.87rem}.ciit-exam-flash{margin-top:18px;border-radius:14px}
.ciit-result-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;margin-top:20px;padding:24px 28px;border:1px solid rgba(191,219,254,.95);border-radius:22px;background:radial-gradient(circle at 90% 0%,rgba(147,197,253,.24),transparent 38%),linear-gradient(125deg,rgba(255,255,255,.97),rgba(239,246,255,.92));box-shadow:0 16px 40px rgba(37,99,235,.09),inset 0 1px 0 #fff}
.ciit-result-card.is-passed{border-color:#b7e8d1;background:radial-gradient(circle at 90% 0%,rgba(110,231,183,.2),transparent 38%),linear-gradient(125deg,#fff,#effdf5)}
.ciit-result-eyebrow{display:flex;align-items:center;gap:8px;margin-bottom:8px;color:#4776bd;font-size:.7rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
.ciit-result-title{margin:0;color:#20395f;font-size:clamp(1.15rem,2vw,1.55rem);font-weight:850;letter-spacing:-.035em}
.ciit-result-copy{margin:7px 0 0;color:#71839e;font-size:.86rem;line-height:1.6}
.ciit-result-score{min-width:130px;padding:14px 18px;border:1px solid #d7e6ff;border-radius:17px;background:rgba(255,255,255,.8);text-align:center}
.ciit-result-score strong{display:block;color:#2466dc;font-size:1.8rem;line-height:1.2;font-weight:900;letter-spacing:-.05em}
.ciit-result-score span{display:block;margin-top:4px;color:#7c8da5;font-size:.72rem;font-weight:800}
.ciit-result-metrics{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}
.ciit-result-metric{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid #dce8fa;border-radius:999px;background:rgba(255,255,255,.76);color:#506783;font-size:.75rem;font-weight:750}
.ciit-result-metric strong{color:#263f63}
.ciit-exam-result-detail{display:block;margin-top:8px;color:#536d91;font-size:.76rem;line-height:1.55}
.ciit-exam-result-detail strong{color:#263f63}
@media(max-width:575.98px){.ciit-result-card{grid-template-columns:1fr;padding:21px}.ciit-result-score{justify-self:start;min-width:120px}}
@@media(max-width:767.98px){.ciit-exam-hero{padding:24px 21px;border-radius:20px}.ciit-exam-panel-head{padding:20px;align-items:flex-start}.ciit-exam-table-wrap{padding:8px 12px 14px}.ciit-exam-table{min-width:760px}.ciit-examination-page{padding-top:20px}}
@@media(prefers-reduced-motion:reduce){.ciit-exam-table tbody tr{transition:none}}
</style>
}
<section class="container ciit-examination-page">
    <header class="ciit-exam-hero">
        <span class="ciit-exam-kicker">Student workspace</span>
        <h1>Your examinations</h1>
        <p>Track every exam attempt. You get two free attempts before passing; re-exams after a pass and later attempts require payment.</p>
    </header>
    @if (TempData["ExamMessage"] is string message) { <div class="alert alert-success ciit-exam-flash" role="status">@message</div> }
    @if (TempData["ExamError"] is string error) { <div class="alert alert-warning ciit-exam-flash" role="alert">@error</div> }

    @if (TempData["LastExamResultStatus"] is string lastResultStatus)
    {
        var lastResultScore = Convert.ToInt32(TempData["LastExamResultScore"] ?? 0);
        var lastResultTotal = Convert.ToInt32(TempData["LastExamResultTotal"] ?? 0);
        var lastResultAnswered = Convert.ToInt32(TempData["LastExamResultAnswered"] ?? 0);
        var lastResultPassed = Convert.ToBoolean(TempData["LastExamResultPassed"] ?? false);
        var lastResultAttemptId = Convert.ToInt64(TempData["LastExamResultAttemptId"] ?? 0);
        <section class="ciit-result-card @(lastResultPassed ? "is-passed" : "")" aria-labelledby="latest-exam-result-title" role="status">
            <div>
                <div class="ciit-result-eyebrow"><i class="bi bi-award"></i> Examination result</div>
                <h2 class="ciit-result-title" id="latest-exam-result-title">@(lastResultPassed ? "Congratulations! You passed." : "Exam completed — keep practising.")</h2>
                <p class="ciit-result-copy">Attempt #@lastResultAttemptId has been evaluated. Your result is saved in Exam Attempts below.</p>
                <div class="ciit-result-metrics">
                    <span class="ciit-result-metric"><i class="bi bi-check2-circle"></i> Answered <strong>@lastResultAnswered/@lastResultTotal</strong></span>
                    <span class="ciit-result-metric"><i class="bi bi-flag"></i> Passing mark <strong>35/@lastResultTotal</strong></span>
                    <span class="ciit-result-metric"><i class="bi bi-clipboard-check"></i> Status <strong>@lastResultStatus</strong></span>
                </div>
            </div>
            <div class="ciit-result-score">
                <strong>@lastResultScore<span style="display:inline;font-size:1rem">/@lastResultTotal</span></strong>
                <span>@(lastResultPassed ? "PASSED" : lastResultStatus == "Terminated" ? "TERMINATED" : lastResultStatus == "TimedOut" ? "TIME EXPIRED" : "NOT PASSED")</span>
            </div>
        </section>
    }

    @if (pendingExams.Count > 0)
    {
        <section class="ciit-exam-panel" aria-labelledby="pending-exam-heading">
            <div class="ciit-exam-panel-head">
                <div><h2 id="pending-exam-heading">Pending Exam</h2><p>Your latest attempt needs another attempt before progression can continue.</p></div>
                <span class="ciit-exam-count">!</span>
            </div>
            <div class="ciit-exam-table-wrap">
                @foreach (var pending in pendingExams)
                {
                    var exam = pending.Latest;
                    var nextAttemptNumber = pending.AttemptCount + 1;
                    var paymentKey = $"{exam.CourseId}:{exam.TopicId}:{nextAttemptNumber}";
                    var paidKeys = ViewBag.UnusedPaidRetakeKeys as IReadOnlyList<string> ?? Array.Empty<string>();
                    var pendingKeys = ViewBag.PendingRetakeKeys as IReadOnlyList<string> ?? Array.Empty<string>();
                    var hasPaidRetake = paidKeys.Contains(paymentKey);
                    var hasPendingPayment = pendingKeys.Contains(paymentKey);
                    var paymentRequired = nextAttemptNumber > 2 || pending.HasPassed;
                    var feeBase = Math.Max(1, nextAttemptNumber - 2) * 100m;
                    var fee = feeBase + Math.Round(feeBase * 0.18m, 2, MidpointRounding.AwayFromZero);
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 mb-2 rounded-4 border border-danger-subtle bg-white bg-opacity-75">
                        <div>
                            <strong class="ciit-exam-topic">@exam.TopicTitle</strong>
                            <div class="ciit-exam-sub">Attempt #@nextAttemptNumber required</div>
                            @if (paymentRequired)
                            {
                                <div class="fw-bold text-danger">Exam fee: ₹@fee.ToString("0.00")</div>
                            }
                            else
                            {
                                <div class="small text-success fw-semibold">Free attempt remaining</div>
                            }
                        </div>
                        @if (hasPendingPayment)
                        {
                            <span class="badge rounded-pill text-bg-warning">Payment pending</span>
                        }
                        else
                        {
                            <form asp-controller="StudentExaminations" asp-action="@(paymentRequired && !hasPaidRetake ? "PayForReExam" : "ReExam")" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId" value="@exam.CourseId" />
                                <input type="hidden" name="topicId" value="@exam.TopicId" />
                                @if (paymentRequired && !hasPaidRetake)
                                {
                                    <button type="submit" class="ciit-exam-action">Pay ₹@fee.ToString("0.00") and re-exam</button>
                                }
                                else
                                {
                                    <button type="submit" class="ciit-exam-action">Start re-exam</button>
                                }
                            </form>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="ciit-exam-panel" aria-labelledby="exam-records-heading">
        <div class="ciit-exam-panel-head">
            <div><h2 id="exam-records-heading">Exam Attempts</h2><p>Current and previous examination sessions</p></div>
            <span class="ciit-exam-count">@Model.Count</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="ciit-exam-empty">
                <span class="ciit-exam-empty-icon" aria-hidden="true"><i class="bi bi-calendar2-check"></i></span>
                <h3>No exam records yet</h3><p>Complete a topic in your learning area to apply for its examination.</p>
            </div>
        }
        else
        {
            <div class="table-responsive ciit-exam-table-wrap">
                <table class="ciit-exam-table">
                    <thead><tr><th>Topic</th><th>Scheduled time</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Select((item, rowIndex) => new { Exam = item, RowIndex = rowIndex }))
                    {
                        var exam = row.Exam;
                        var topicAttempts = Model
                            .Where(item => item.CourseId == exam.CourseId && item.TopicId == exam.TopicId)
                            .OrderBy(item => item.AttemptId)
                            .ToList();
                        var attemptNumber = topicAttempts.FindIndex(item => item.AttemptId == exam.AttemptId) + 1;
                        var hasEverPassedTopic = topicAttempts.Any(item => item.Passed && item.Status == "Passed");
                        var hasPassedBeforeThisAttempt = topicAttempts
                            .Take(Math.Max(0, attemptNumber - 1))
                            .Any(item => item.Passed && item.Status == "Passed");
                        var isPaidRetake = attemptNumber > 2 || hasPassedBeforeThisAttempt;
                        var retakeFeeBase = Math.Max(1, attemptNumber - 2) * 100m;
                        var retakeFee = retakeFeeBase + Math.Round(retakeFeeBase * 0.18m, 2, MidpointRounding.AwayFromZero);
                        <tr style="--row-index: @row.RowIndex">
                            <td>
                                <span class="ciit-exam-topic">@exam.TopicTitle</span>
                                <span class="ciit-exam-sub">Attempt #@attemptNumber</span>
                                @if (attemptNumber > 1)
                                {
                                    <span class="badge rounded-pill text-bg-info ms-1">Re-exam</span>
                                    @if (isPaidRetake)
                                    {
                                        <span class="ciit-exam-sub">Fee: ₹@retakeFee.ToString("0.00")</span>
                                    }
                                }
                            </td>
                            <td><time class="exam-local-time" datetime="@DateTime.SpecifyKind(exam.ScheduledAtUtc, DateTimeKind.Utc).ToString("O")">@exam.ScheduledAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></td>
                            <td>
                                <span class="ciit-exam-status" data-status="@exam.Status">@(exam.Status == "TimedOut" ? "Time’s up" : exam.Status)</span>
                                @if (exam.Status is "Passed" or "Failed" or "Terminated" or "TimedOut" or "Submitted")
                                {
                                    <span class="ciit-exam-result-detail"><strong>Score:</strong> @exam.Score/@exam.TotalQuestions</span>
                                    <span class="ciit-exam-result-detail"><strong>Answered:</strong> @exam.AnsweredQuestionsCount/@exam.TotalQuestions questions</span>
                                    @if (exam.Status == "Passed")
                                    {
                                        <span class="ciit-exam-result-detail">Passing score achieved</span>
                                    }
                                    else if (exam.Status == "Failed")
                                    {
                                        <span class="ciit-exam-result-detail">Passing score: 35/@exam.TotalQuestions</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(exam.TerminationReason))
                                    {
                                        <span class="ciit-exam-result-detail">Reason: @exam.TerminationReason</span>
                                    }
                                }
                            </td>
                            <td class="text-end">
                                @if (exam.Status is "Scheduled" or "Ready")
                                {
                                    var openAtUtc = exam.ScheduledAtUtc.AddMinutes(-30);
                                    var examEndUtc = exam.ScheduledAtUtc.AddMinutes(60);
                                    var canOpen = DateTime.UtcNow >= openAtUtc && DateTime.UtcNow < examEndUtc;
                                    <a class="ciit-exam-action exam-open-button @(canOpen ? "" : "disabled")" href="@(canOpen ? Url.Action("Instructions", "StudentExaminations", new { attemptId = exam.AttemptId }) : "#")" data-open-at="@DateTime.SpecifyKind(openAtUtc, DateTimeKind.Utc).ToString("O")" data-exam-end="@DateTime.SpecifyKind(examEndUtc, DateTimeKind.Utc).ToString("O")" data-target-url="@Url.Action("Instructions", "StudentExaminations", new { attemptId = exam.AttemptId })" aria-disabled="@(!canOpen ? "true" : "false")" tabindex="@(!canOpen ? "-1" : "0")">@(DateTime.UtcNow >= examEndUtc ? "Time's up" : "Instructions / Start")</a>
                                    <span class="ciit-exam-sub exam-open-countdown" data-open-at="@DateTime.SpecifyKind(openAtUtc, DateTimeKind.Utc).ToString("O")" data-exam-end="@DateTime.SpecifyKind(examEndUtc, DateTimeKind.Utc).ToString("O")"></span>
                                }
                                else if (exam.Status == "InProgress") { <a class="ciit-exam-action" asp-action="Instructions" asp-route-attemptId="@exam.AttemptId">Resume exam</a> }
                                else if (exam.Status is "Terminated" or "Failed" or "TimedOut" or "Passed")
                                {
                                    var isLatestAttempt = topicAttempts.All(item => item.AttemptId <= exam.AttemptId);
                                    var nextAttemptNumber = topicAttempts.Count + 1;
                                    var paidKeys = ViewBag.UnusedPaidRetakeKeys as IReadOnlyList<string> ?? Array.Empty<string>();
                                    var paymentKey = $"{exam.CourseId}:{exam.TopicId}:{nextAttemptNumber}";
                                    var hasPaidRetake = paidKeys.Contains(paymentKey);
                                    var pendingKeys = ViewBag.PendingRetakeKeys as IReadOnlyList<string> ?? Array.Empty<string>();
                                    var hasPendingPayment = pendingKeys.Contains(paymentKey);
                                    var nextAttemptIsPaid = nextAttemptNumber > 2 || hasEverPassedTopic;
                                    if (isLatestAttempt && hasPendingPayment)
                                    {
                                        <span class="badge rounded-pill text-bg-warning">Payment pending</span>
                                    }
                                    else if (isLatestAttempt)
                                    {
                                        <form asp-controller="StudentExaminations" asp-action="@(nextAttemptIsPaid && !hasPaidRetake ? "PayForReExam" : "ReExam")" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="courseId" value="@exam.CourseId" />
                                            <input type="hidden" name="topicId" value="@exam.TopicId" />
                                            @if (nextAttemptIsPaid && !hasPaidRetake)
                                            {
                                                var baseFee = Math.Max(1, nextAttemptNumber - 2) * 100m;
                                                var gst = Math.Round(baseFee * 0.18m, 2, MidpointRounding.AwayFromZero);
                                                <button type="submit" class="ciit-exam-action">Pay ₹@((baseFee + gst).ToString("0.00")) and re-exam</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="ciit-exam-action">Start re-exam</button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="ciit-exam-sub">Previous attempt</span>
                                    }
                                }
                                else { <span class="ciit-exam-sub">Closed</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
@section Scripts {
<script>
    document.querySelectorAll('.ciit-exam-flash').forEach(function (alert) {
        window.setTimeout(function () {
            if (!alert.isConnected) return;
            alert.style.transition = 'opacity .25s ease, transform .25s ease';
            alert.style.opacity = '0';
            alert.style.transform = 'translateY(-5px)';
            window.setTimeout(function () { alert.remove(); }, 280);
        }, 5000);
    });
    document.querySelectorAll('.exam-local-time').forEach(function (element) {
        const date = new Date(element.dateTime);
        if (!Number.isNaN(date.getTime())) element.textContent = date.toLocaleString();
    });
    function updateExamOpenButtons() {
        document.querySelectorAll('.exam-open-button').forEach(function (button) {
            const now = Date.now();
            const openAt = new Date(button.dataset.openAt).getTime();
            const examEnd = new Date(button.dataset.examEnd).getTime();
            const remaining = openAt - now;
            const label = button.parentElement.querySelector('.exam-open-countdown');
            if (Number.isFinite(examEnd) && now >= examEnd) {
                button.href = '#';
                button.classList.add('disabled');
                button.setAttribute('aria-disabled', 'true');
                button.tabIndex = -1;
                button.textContent = "Time's up";
                if (label) label.textContent = 'Scheduled exam window has ended';
            } else if (remaining <= 0) {
                button.href = button.dataset.targetUrl;
                button.classList.remove('disabled');
                button.setAttribute('aria-disabled', 'false');
                button.tabIndex = 0;
                if (label) label.textContent = 'Instructions available now';
            } else {
                const seconds = Math.ceil(remaining / 1000);
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = seconds % 60;
                if (label) label.textContent = 'Instructions open in ' + [hours, minutes, secs].map(x => String(x).padStart(2, '0')).join(':');
            }
        });
    }
    document.querySelectorAll('.exam-open-button').forEach(function (button) {
        button.addEventListener('click', function (event) {
            if (button.getAttribute('aria-disabled') === 'true') event.preventDefault();
        });
    });
    updateExamOpenButtons();
    window.setInterval(updateExamOpenButtons, 1000);
</script>
}
