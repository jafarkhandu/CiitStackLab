@model CIITStackLab.Application.DTOs.CourseDetailsDto

@{
    ViewData["Title"] = Model.Title;
    var totalTopicDurationMinutes = Model.Topics.Sum(topic => topic.DurationMinutes ?? 0);
    var totalDurationHours = totalTopicDurationMinutes / 60m;
    var originalCoursePrice = Model.Topics.Sum(topic => Math.Max(0m, topic.Price));
    var displayedSavings = Math.Max(0m, originalCoursePrice - Model.TotalPrice);
    var displayedDiscountPercentage = originalCoursePrice > 0m && displayedSavings > 0m
        ? Math.Round(displayedSavings / originalCoursePrice * 100m, 2)
        : (decimal?)null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student/course-payment-modal.css" />
}

<section class="ciit-course-details-section ciit-student-course-details">
    <div class="container">
        <div class="ciit-course-details-card ciit-student-course-hero">
            <div class="ciit-course-details-kicker"><i class="bi bi-mortarboard-fill"></i> CIIT LEARNING EXPERIENCE</div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="ciit-course-hero-logo">
                    <img src="@Model.ImageUrl" alt="@Model.Title logo" />
                </div>
            }
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <section class="ciit-course-topic-flow" aria-label="Topics included in @Model.Title">
                        <div class="ciit-course-topic-flow-heading">
                            <span class="ciit-course-topic-flow-mark"><i class="bi bi-signpost-split-fill" aria-hidden="true"></i></span>
                            <div>
                                <span class="ciit-course-flow-eyebrow">YOUR LEARNING PATH</span>
                                <h2>From first steps to real skills</h2>
                            </div>
                        </div>
                        @if (Model.Topics.Count > 0)
                        {
                            <ol class="ciit-course-topic-timeline">
                                @foreach (var topic in Model.Topics)
                                {
                                    <li>
                                        <span class="ciit-course-topic-node" aria-hidden="true"><i class="bi bi-book-half"></i></span>
                                        <div class="ciit-course-topic-flow-copy">
                                            <strong>@topic.Title</strong>
                                            <span>@topic.ChapterCount chapter@(topic.ChapterCount == 1 ? "" : "s")</span>
                                        </div>
                                    </li>
                                }
                            </ol>
                            <div class="ciit-course-flow-footer">
                                <span class="ciit-course-flow-complete"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
                                <div><strong>Course roadmap</strong><span>@Model.Topics.Count topics in your learning path</span></div>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary mb-0">The learning path will appear here when topics are added to this course.</p>
                        }
                    </section>
                </div>

                <div class="col-lg-7">
                    <span class="ciit-course-details-badge"><i class="bi bi-bookmark-star me-1"></i>@Model.Category</span>
                    <h1 class="ciit-course-details-title">@Model.Title</h1>
                    <p class="ciit-course-details-summary">@Model.ShortDescription</p>
                    <p class="ciit-course-details-description">@Model.Description</p>

                    <div class="ciit-course-meta-row ciit-student-course-stats">
                        <div><strong>@Model.Level</strong><span>Level</span></div>
                        <div><strong>@totalDurationHours.ToString("0.##") hrs</strong><span>Duration</span></div>
                        <div><strong>@Model.Topics.Count</strong><span>Topics</span></div>
                    </div>

                    <div class="ciit-course-price-card">
                        <span>Course price</span>
                        @if (Model.TotalPrice <= 0m)
                        {
                            <strong>Free</strong>
                            <small>Immediate access</small>
                        }
                        else
                        {
                            <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                            @if (displayedSavings > 0m)
                            {
                                <div class="ciit-course-discount-pricing">
                                    <del class="text-secondary small">₹@originalCoursePrice.ToString("N2")</del>
                                    @if (displayedDiscountPercentage.HasValue)
                                    {
                                        <span class="badge text-bg-success">@displayedDiscountPercentage.Value.ToString("0.##")% OFF</span>
                                    }
                                    <small class="d-block text-success">You save ₹@displayedSavings.ToString("N2") on this course</small>
                                </div>
                            }
                            else
                            {
                                <small>Topic prices combined</small>
                            }
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4 align-items-center">
                        @if (Model.IsStudent && Model.HasAccess)
                        {
                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="ciit-learning-hub-switch"
                               data-learning-hub-transition>
                                <i class="bi bi-stars me-2" aria-hidden="true"></i>Switch Hub
                            </a>
                        }
                        else if (Model.TotalPrice <= 0m)
                        {
                            <a asp-controller="Courses"
                               asp-action="CourseHome"
                               asp-route-id="@Model.Id"
                               class="btn btn-primary btn-lg">
                                <i class="bi bi-play-circle me-2"></i>Start Learning
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                class="btn btn-primary btn-lg"
                                data-bs-toggle="modal"
                                data-bs-target="#coursePaymentModal">
                            <i class="bi bi-bag-check me-2"></i>Enroll Now
                        </button>
                        }

                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="tutorials"
                           class="btn btn-outline-dark btn-lg">
                            Back to Courses
                        </a>
                    </div>

                    @if (User.Identity?.IsAuthenticated != true && Model.TotalPrice > 0m)
                    {
                        <small class="text-secondary d-block mt-2">
                            Sign in before completing payment for this course.
                        </small>
                    }


                </div>
            </div>
        </div>

        @if (Model.TotalPrice > 0m)
        {
            <div class="modal fade ciit-payment-modal"
                 id="coursePaymentModal"
                 tabindex="-1"
                 aria-labelledby="coursePaymentModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <div>
                                <span class="ciit-payment-modal-eyebrow">Secure Razorpay checkout</span>
                                <h2 class="modal-title" id="coursePaymentModalLabel">Complete your purchase</h2>
                                <p class="ciit-payment-modal-subtitle">You will be redirected to Razorpay to complete your payment.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body pt-0">
                            <div id="ciit-payment-form-state">
                                <div class="ciit-payment-course-summary">
                                    <img src="@Model.ImageUrl" alt="@Model.Title" />
                                    <div>
                                        <span>@Model.Category</span>
                                        <h3>@Model.Title</h3>
                                        <p>@Model.ShortDescription</p>
                                        <div class="ciit-payment-course-meta">
                                            <span><i class="bi bi-bar-chart"></i>@Model.Level</span>
                                            <span><i class="bi bi-clock"></i>@totalDurationHours.ToString("0.##") hrs</span>
                                            <span><i class="bi bi-collection-play"></i>@Model.Topics.Count topics</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ciit-payment-order-box">
                                    <div>
                                        <span>Course price</span>
                                        <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                                    </div>
                                    <div class="ciit-payment-order-total">
                                        <span>Total payable</span>
                                        <strong>₹@Model.TotalPrice.ToString("N2")</strong>
                                    </div>
                                </div>

                                <div class="ciit-payment-method-box">
                                    <div class="ciit-payment-section-heading">
                                        <div>
                                            <span>Payment method</span>
                                            <strong>Choose how you want to pay</strong>
                                        </div>
                                        <i class="bi bi-shield-check"></i>
                                    </div>

                                    <div class="ciit-payment-methods" role="radiogroup" aria-label="Payment method">
                                        <label class="ciit-payment-method">
                                            <input type="radio" name="paymentMethod" value="upi" checked />
                                            <span class="ciit-payment-method-icon"><i class="bi bi-phone"></i></span>
                                            <span>
                                                <strong>UPI</strong>
                                                <small>Google Pay, PhonePe, Paytm and more</small>
                                            </span>
                                            <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                        </label>

                                        <label class="ciit-payment-method">
                                            <input type="radio" name="paymentMethod" value="card" />
                                            <span class="ciit-payment-method-icon"><i class="bi bi-credit-card"></i></span>
                                            <span>
                                                <strong>Card</strong>
                                                <small>Credit or debit card</small>
                                            </span>
                                            <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                        </label>

                                        <label class="ciit-payment-method">
                                            <input type="radio" name="paymentMethod" value="netbanking" />
                                            <span class="ciit-payment-method-icon"><i class="bi bi-bank"></i></span>
                                            <span>
                                                <strong>Net banking</strong>
                                                <small>Pay directly through your bank</small>
                                            </span>
                                            <i class="bi bi-check-circle-fill ciit-payment-method-check"></i>
                                        </label>
                                    </div>
                                </div>

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form id="ciit-demo-payment-form"
                                          asp-controller="Courses"
                                          asp-action="DemoPayment"
                                          asp-route-id="@Model.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                id="ciit-demo-payment-button"
                                                class="btn btn-primary btn-lg w-100 ciit-payment-pay-button">
                                            <i class="bi bi-lock-fill me-2"></i>
                                            Pay ₹@Model.TotalPrice.ToString("N2")
                                        </button>
                                    </form>
                                    <p class="ciit-payment-modal-note">
                                        Your course access will be enabled after Razorpay confirms your payment.
                                    </p>
                                }
                                else
                                {
                                    <a asp-controller="Account"
                                       asp-action="Login"
                                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                       class="btn btn-primary btn-lg w-100 ciit-payment-pay-button">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        Sign in to continue
                                    </a>
                                    <p class="ciit-payment-modal-note">
                                        Sign in to continue to Razorpay checkout.
                                    </p>
                                }
                            </div>

                            <div id="ciit-payment-processing-state" class="ciit-payment-state" hidden aria-live="polite">
                                <div class="ciit-payment-processing-icon" aria-hidden="true">
                                    <span class="ciit-payment-spinner"></span>
                                    <i class="bi bi-credit-card-2-front"></i>
                                </div>
                                <strong>Preparing secure payment</strong>
                                <span>Connecting to Razorpay and verifying your payment...</span>

                                <div class="ciit-payment-processing-steps" aria-label="Payment processing status">
                                    <div class="ciit-payment-processing-step" data-payment-step="gateway">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        <span>Connecting to payment gateway...</span>
                                    </div>
                                    <div class="ciit-payment-processing-step" data-payment-step="verify">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        <span>Verifying payment details...</span>
                                    </div>
                                    <div class="ciit-payment-processing-step" data-payment-step="process">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        <span>Opening secure checkout...</span>
                                    </div>
                                </div>
                            </div>

                            <div id="ciit-payment-success-state" class="ciit-payment-state ciit-payment-success-state" hidden aria-live="polite">
                                <div class="ciit-payment-success-icon" aria-hidden="true">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <strong>Payment Successful</strong>
                                <span class="ciit-payment-success-course">Your access to @Model.Title is ready.</span>
                                <span class="ciit-payment-success-note">Payment confirmed.</span>
                                <small>Opening your learning page...</small>
                                <div class="ciit-payment-redirect-bar" aria-hidden="true">
                                    <span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <nav class="ciit-course-details-nav" aria-label="Course details sections">
            <a href="#course-overview"><i class="bi bi-info-circle"></i> Overview</a>
            <a href="#course-roadmap"><i class="bi bi-list-check"></i> Syllabus</a>
            <a href="#course-benefits"><i class="bi bi-stars"></i> What you'll gain</a>
        </nav>

        <section id="course-overview" class="ciit-student-info-panel">
            <div class="ciit-student-section-heading">
                <span class="ciit-student-eyebrow">YOUR LEARNING JOURNEY</span>
                <h2>Build skills you can put into practice.</h2>
                <p>Follow a structured learning path, explore lesson resources, and check your understanding as you progress through the course.</p>
            </div>
            <div class="ciit-student-benefit-grid">
                <article><span class="ciit-student-benefit-icon"><i class="bi bi-signpost-split"></i></span><h3>Structured roadmap</h3><p>Course topics are organized so you can learn in a clear, guided sequence.</p></article>
                <article><span class="ciit-student-benefit-icon"><i class="bi bi-journal-code"></i></span><h3>Learning resources</h3><p>Open available notes and lesson content directly from your course learning flow.</p></article>
                <article><span class="ciit-student-benefit-icon"><i class="bi bi-patch-check"></i></span><h3>Knowledge checks</h3><p>Practice with available assessments to reinforce concepts as you learn.</p></article>
            </div>
        </section>

        <div id="course-roadmap" class="ciit-course-outline-card ciit-student-course-roadmap mt-4">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="mb-1">Course Roadmap</h2>
                    <p class="text-secondary mb-0">Explore notes, learning content and assessments by topic.</p>
                </div>
                <span class="badge rounded-pill text-bg-light border">@Model.Topics.Count Topics</span>
            </div>

            @if (Model.Topics.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No active topics have been mapped to this course yet.
                </div>
            }
            else
            {
                <div class="accordion ciit-premium-roadmap" id="courseTopicsAccordion">
                    @{ var topicNumber = 0; }
                    @foreach (var topic in Model.Topics)
                    {
                        topicNumber++;
                        var headingId = $"heading-{topic.Id}";
                        var collapseId = $"collapse-{topic.Id}";

                        <div class="accordion-item">
                            <h3 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    <span class="ciit-roadmap-number">@topicNumber.ToString("D2")</span>
                                    <span class="ciit-roadmap-topic-icon"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i></span>
                                    <span class="ciit-roadmap-topic-copy">
                                        <strong>@topic.Title</strong>
                                        <small>
                                            @topic.ChapterCount note@(topic.ChapterCount == 1 ? "" : "s")
                                            <span aria-hidden="true">·</span>
                                            @topic.Contents.Count content item@(topic.Contents.Count == 1 ? "" : "s")
                                            <span aria-hidden="true">·</span>
                                            @(topic.McqCount + topic.InterviewQuestionCount + topic.PracticeProgramCount) assessment resources
                                        </small>
                                    </span>
                                    <span class="ciit-roadmap-badges" aria-label="Topic resource counts">
                                        <span class="ciit-roadmap-badge ciit-roadmap-badge-notes">
                                            <i class="bi bi-journal-text" aria-hidden="true"></i>
                                            @topic.ChapterCount Notes
                                        </span>
                                        <span class="ciit-roadmap-badge ciit-roadmap-badge-content">
                                            <i class="bi bi-play-circle" aria-hidden="true"></i>
                                            @topic.Contents.Count Content
                                        </span>
                                        <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                            <i class="bi bi-patch-check" aria-hidden="true"></i>
                                            @(topic.McqCount + topic.InterviewQuestionCount + topic.PracticeProgramCount) Assessments
                                        </span>
                                    </span>
                                </button>
                            </h3>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#courseTopicsAccordion">
                                <div class="accordion-body">
                                    @if (topic.ChapterTitles.Count > 0)
                                    {
                                        <section class="mb-3" aria-label="Notes chapters">
                                            <div class="fw-semibold small mb-2">Notes chapters</div>
                                            <div class="ciit-roadmap-badges">
                                                @foreach (var chapterTitle in topic.ChapterTitles)
                                                {
                                                    <span class="ciit-roadmap-badge ciit-roadmap-badge-notes">
                                                        <i class="bi bi-journal-text" aria-hidden="true"></i>
                                                        @chapterTitle
                                                    </span>
                                                }
                                            </div>
                                        </section>
                                    }

                                    @if (topic.Contents.Count > 0)
                                    {
                                        <section class="mb-3" aria-label="Learning content">
                                            <div class="fw-semibold small mb-2">Content</div>
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var contentItem in topic.Contents)
                                                {
                                                    <div class="ciit-content-item">
                                                        <div class="fw-semibold ciit-roadmap-content-title mb-2">@contentItem.Title</div>
                                                        <div class="ciit-roadmap-badges">
                                                            @if (contentItem.HasVideo)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-content">
                                                                    <i class="bi bi-camera-video" aria-hidden="true"></i>
                                                                    Video
                                                                </span>
                                                            }
                                                            @if (contentItem.HasSlides)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-content">
                                                                    <i class="bi bi-file-earmark-slides" aria-hidden="true"></i>
                                                                    Slides
                                                                </span>
                                                            }
                                                            @if (!contentItem.HasVideo && !contentItem.HasSlides)
                                                            {
                                                                <span class="ciit-roadmap-badge ciit-roadmap-badge-content">Content item</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }

                                    @if (topic.McqCount > 0 || topic.InterviewQuestionCount > 0 || topic.PracticeProgramCount > 0)
                                    {
                                        <section aria-label="Assessments">
                                            <div class="fw-semibold small mb-2">Assessments</div>
                                            <div class="ciit-roadmap-badges">
                                                @if (topic.McqCount > 0)
                                                {
                                                    <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                                        <i class="bi bi-patch-check" aria-hidden="true"></i>
                                                        @topic.McqCount MCQs
                                                    </span>
                                                }
                                                @if (topic.InterviewQuestionCount > 0)
                                                {
                                                    <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                                        <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                                                        @topic.InterviewQuestionCount Interview questions
                                                    </span>
                                                }
                                                @if (topic.PracticeProgramCount > 0)
                                                {
                                                    <span class="ciit-roadmap-badge ciit-roadmap-badge-assessment">
                                                        <i class="bi bi-code-square" aria-hidden="true"></i>
                                                        @topic.PracticeProgramCount Practice programs
                                                    </span>
                                                }
                                            </div>
                                        </section>
                                    }

                                    @if (topic.ChapterTitles.Count == 0 && topic.Contents.Count == 0
                                        && topic.McqCount == 0 && topic.InterviewQuestionCount == 0 && topic.PracticeProgramCount == 0)
                                    {
                                        <p class="text-secondary mb-0">Learning resources will be available here soon.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <section id="course-benefits" class="ciit-student-outcome-panel">
            <div>
                <span class="ciit-student-eyebrow">WHY THIS COURSE</span>
                <h2>Learn at your pace. Build with confidence.</h2>
                <p>Use the roadmap to explore each topic, revisit learning material when needed, and practice with the assessments available in the course.</p>
            </div>
            <div class="ciit-student-outcome-points">
                <span><i class="bi bi-check-circle-fill"></i> Topic-by-topic learning</span>
                <span><i class="bi bi-check-circle-fill"></i> Clear lesson organization</span>
                <span><i class="bi bi-check-circle-fill"></i> Practice opportunities where available</span>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const loadRazorpay = () => new Promise((resolve, reject) => {
                if (window.Razorpay) return resolve();
                const existing = document.querySelector('script[src="https://checkout.razorpay.com/v1/checkout.js"]');
                if (existing) {
                    existing.addEventListener('load', resolve, { once: true });
                    existing.addEventListener('error', reject, { once: true });
                    return;
                }
                const script = document.createElement('script');
                script.src = 'https://checkout.razorpay.com/v1/checkout.js';
                script.async = true;
                script.onload = resolve;
                script.onerror = () => reject(new Error('Razorpay Checkout could not be loaded.'));
                document.head.appendChild(script);
            });

            const showGatewayMessage = message => {
                document.getElementById('ciit-razorpay-gateway-message')?.remove();
                const host = document.querySelector('.ciit-payment-modal .modal-body') || document.body;
                const alert = document.createElement('div');
                alert.id = 'ciit-razorpay-gateway-message';
                alert.className = 'alert alert-danger mt-3';
                alert.setAttribute('role', 'alert');
                alert.textContent = message;
                host.prepend(alert);
            };

            window.PhonePeCheckout = {
                transact: async function (options) {
                    try {
                        const checkoutUrl = new URL(options.tokenUrl, window.location.origin);
                        const orderId = checkoutUrl.searchParams.get('razorpayOrderId');
                        const keyId = checkoutUrl.searchParams.get('keyId');
                        const amount = Number(checkoutUrl.searchParams.get('amount'));
                        const merchantOrderId = checkoutUrl.searchParams.get('merchantOrderId');
                        const form = document.getElementById('ciit-demo-payment-form');
                        const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value;

                        if (!orderId || !keyId || !merchantOrderId || !Number.isSafeInteger(amount) || amount <= 0) {
                            throw new Error('Razorpay order details are incomplete.');
                        }

                        await loadRazorpay();

                        const checkout = new Razorpay({
                            key: keyId,
                            amount,
                            currency: 'INR',
                            order_id: orderId,
                            name: 'CIIT Stack Lab',
                            description: 'Course payment',
                            handler: async function (response) {
                                try {
                                    const verification = await fetch('/Payments/Razorpay/Verify', {
                                        method: 'POST',
                                        credentials: 'same-origin',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'RequestVerificationToken': token || ''
                                        },
                                        body: JSON.stringify({
                                            merchantOrderId,
                                            razorpayOrderId: response.razorpay_order_id,
                                            razorpayPaymentId: response.razorpay_payment_id,
                                            razorpaySignature: response.razorpay_signature
                                        })
                                    });

                                    const result = await verification.json().catch(() => ({}));
                                    if (!verification.ok || !result.success) {
                                        throw new Error(result.message || 'Payment verification failed.');
                                    }

                                    window.location.assign(result.redirectUrl);
                                } catch (error) {
                                    showGatewayMessage(error instanceof Error ? error.message : 'Payment verification failed.');
                                    if (typeof options.callback === 'function') options.callback('USER_CANCEL');
                                }
                            },
                            modal: {
                                ondismiss: function () {
                                    window.location.assign('/Payments/Razorpay/PaymentExit'
                                        + '?merchantOrderId=' + encodeURIComponent(merchantOrderId)
                                        + '&razorpayOrderId=' + encodeURIComponent(orderId)
                                        + '&outcome=cancelled');
                                }
                            }
                        });

                        checkout.on('payment.failed', function () {
                            window.location.assign('/Payments/Razorpay/PaymentExit'
                                + '?merchantOrderId=' + encodeURIComponent(merchantOrderId)
                                + '&razorpayOrderId=' + encodeURIComponent(orderId)
                                + '&outcome=declined');
                        });

                        checkout.open();
                    } catch (error) {
                        showGatewayMessage(error instanceof Error ? error.message : 'Unable to start Razorpay checkout.');
                        if (typeof options.callback === 'function') options.callback('USER_CANCEL');
                    }
                }
            };

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('[data-bs-target="#coursePaymentModal"]').forEach(button => {
                    button.innerHTML = '<i class="bi bi-bag-check me-2"></i>Enroll Now';
                });
            });
        })();

        (() => {
            const form = document.getElementById('ciit-demo-payment-form');
            const button = document.querySelector('button[form="ciit-demo-payment-form"]');

            if (!form) {
                return;
            }

            form.addEventListener('submit', () => {
                if (button) {
                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Redirecting to Razorpay...';
                }
            });
        })();
    </script>
}
