@model CIITStackLab.Application.DTOs.CourseLearningDto

@{
    Layout = "_CourseLayout";

    ViewData["Title"] = $"{Model.Title} - Course Home";
    ViewData["CourseTitle"] = Model.Title;

    var progress = Model.Progress;
    var completedContentIds = progress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var topicProgress = Model.Topics.Select(topic =>
    {
        var topicContentIds = topic.Contents
            .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
            .Select(content => content.Id)
            .Distinct()
            .ToList();

        return new
        {
            TopicId = topic.Id,
            HasResources = topicContentIds.Count > 0,
            IsCompleted = topicContentIds.Count > 0
                && topicContentIds.All(completedContentIds.Contains)
        };
    }).ToList();
    var totalTopics = Model.Topics.Count;
    var completedTopics = topicProgress.Count(topic => topic.IsCompleted);
    var percentage = totalTopics == 0
        ? 0
        : (int)Math.Round(completedTopics * 100d / totalTopics, MidpointRounding.AwayFromZero);
    var totalLessons = totalTopics;
    var completedLessons = completedTopics;
    var orderedLessons = Model.Topics
        .SelectMany(topic => topic.Contents.Concat(topic.Chapters.SelectMany(chapter => chapter.Contents)))
        .DistinctBy(content => content.Id)
        .ToList();
    var firstLesson = orderedLessons.FirstOrDefault();
    var hasStartedLearning = completedContentIds.Count > 0;
    var lastAccessedLesson = progress?.LastAccessedContentId is int lastAccessedId
        ? orderedLessons.FirstOrDefault(lesson => lesson.Id == lastAccessedId)
        : null;
    var lastAccessedLessonIsIncomplete = lastAccessedLesson is not null
        && !completedContentIds.Contains(lastAccessedLesson.Id);
    var continueLesson = lastAccessedLessonIsIncomplete
        ? lastAccessedLesson
        : orderedLessons.FirstOrDefault(lesson => !completedContentIds.Contains(lesson.Id));
    var continueTopic = continueLesson is not null
        ? Model.Topics.FirstOrDefault(topic => topic.Contents.Any(content => content.Id == continueLesson.Id))
        : Model.Topics.FirstOrDefault(topic => topic.Contents.Count == 0 && topic.Chapters.Count > 0)
            ?? Model.Topics.FirstOrDefault(topic => topic.Chapters.Count > 0)
            ?? Model.Topics.FirstOrDefault();
    var continueTopicId = continueTopic?.Id;
    var totalTopicDurationMinutes = Model.Topics.Sum(topic => topic.DurationMinutes ?? 0);
    var totalDurationHours = totalTopicDurationMinutes / 60m;
    var totalChapters = Model.Topics.Sum(topic => topic.Chapters.Count);
}

@section Styles {
    <link rel="stylesheet" href="~/css/student/course-experience.css" asp-append-version="true" />
}

<section class="ciit-course-experience">
    <div class="container-fluid px-3 px-lg-4">
        <main class="ciit-course-experience-main">
            <section class="ciit-course-experience-card ciit-course-experience-hero">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img class="ciit-course-hero-image"
                         src="@Model.ImageUrl"
                         alt="@Model.Title course cover"
                         loading="eager" />
                }
                <div class="ciit-course-hero-overlay" aria-hidden="true"></div>

                <div class="ciit-course-hero-content">
                    <span class="ciit-course-experience-eyebrow">Course access active</span>
                    <h1>Welcome to @Model.Title</h1>
                    <p>@(string.IsNullOrWhiteSpace(Model.ShortDescription) ? "Build your skills through a structured, hands-on learning path." : Model.ShortDescription)</p>
                    <div class="ciit-course-hero-actions">
                        <a class="btn btn-light fw-semibold"
                           asp-controller="Courses"
                           asp-action="Learn"
                           asp-route-id="@Model.Id"
                           asp-route-topicId="@continueTopicId">
                            <i class="bi bi-play-fill me-1"></i>
                            @(hasStartedLearning ? "Continue Learning" : "Start Learning")
                        </a>
                        <span class="ciit-course-access-badge">
                            <i class="bi bi-check-circle-fill"></i>
                            Access Active
                        </span>
                    </div>
                </div>
            </section>

            <section class="ciit-course-stat-grid" aria-label="Course summary">
                <div class="ciit-course-stat">
                    <strong>@totalChapters</strong>
                    <span>Chapters</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@Model.TopicCount</strong>
                    <span>Topics</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@Model.Level</strong>
                    <span>Level</span>
                </div>
                <div class="ciit-course-stat">
                    <strong>@totalDurationHours.ToString("0.##") hrs</strong>
                    <span>Duration</span>
                </div>
            </section>

            <section id="course-progress" class="ciit-course-experience-card ciit-course-progress-glass">
                <div class="ciit-course-experience-card-header">
                    <div>
                        <h2>Your Progress</h2>
                        <p>Track your learning progress and continue from where you left off.</p>
                    </div>
                    <strong>@percentage%</strong>
                </div>
                <div class="ciit-progress-track"
                     role="progressbar"
                     aria-label="Course progress"
                     aria-valuenow="@percentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <span style="width: @percentage%"></span>
                </div>
                <div class="ciit-progress-meta">
                    <span>@completedLessons of @totalLessons topics completed</span>
                    <span>@Model.TopicCount topics</span>
                </div>
            </section>

            <section class="ciit-course-experience-card ciit-course-curriculum-section">
                <div class="ciit-course-experience-card-header">
                    <div>
                        <h2>Course Curriculum</h2>
                        <p>Each topic is shown as a simple learning block.</p>
                    </div>
                    <span class="ciit-curriculum-summary">
                        <i class="bi bi-journal-check"></i>
                        @totalChapters Chapters · @Model.TopicCount Topics
                    </span>
                </div>

                @if (Model.Topics.Count == 0)
                {
                    <div class="ciit-curriculum-empty">No active chapters are available for this course yet.</div>
                }
                else
                {
                    <div class="ciit-course-curriculum-list">
                        @foreach (var topic in Model.Topics)
                        {
                            <div class="ciit-curriculum-topic">
                                <div class="ciit-curriculum-topic-header">
                                    <strong>@topic.Title</strong>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </main>
    </div>
</section>
