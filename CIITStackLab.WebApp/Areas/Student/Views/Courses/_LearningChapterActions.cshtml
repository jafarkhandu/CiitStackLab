@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var topics = Model.Topics.ToList();
    var chapterEntries = topics.SelectMany(topic => topic.Chapters.OrderBy(chapter => chapter.SortOrder)
        .ThenBy(chapter => chapter.Id).Select(chapter => new { Topic = topic, Chapter = chapter })).ToList();
    var contentId = Model.CurrentContentId;
    var currentChapter = Model.CurrentChapterId.HasValue
        ? chapterEntries.FirstOrDefault(entry => entry.Chapter.Id == Model.CurrentChapterId.Value)?.Chapter
        : contentId.HasValue ? chapterEntries.FirstOrDefault(entry => entry.Chapter.Contents.Any(content => content.Id == contentId.Value))?.Chapter : null;
    var currentTopic = topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? (currentChapter is not null ? topics.FirstOrDefault(topic => topic.Chapters.Any(chapter => chapter.Id == currentChapter.Id)) : null)
        ?? topics.FirstOrDefault(topic => topic.Contents.Any(content => contentId.HasValue && content.Id == contentId.Value));
    currentChapter ??= currentTopic?.Chapters.OrderBy(chapter => chapter.SortOrder).ThenBy(chapter => chapter.Id).FirstOrDefault();
    var currentIndex = currentChapter is null ? -1 : chapterEntries.FindIndex(entry => entry.Chapter.Id == currentChapter.Id);
    var previousEntry = currentIndex > 0 ? chapterEntries[currentIndex - 1] : null;
    var nextEntry = currentIndex >= 0 && currentIndex < chapterEntries.Count - 1 ? chapterEntries[currentIndex + 1] : null;
    var allowedTopicId = ViewBag.AllowedTopicId as int?;
    var previousLocked = User.IsInRole("Student") && allowedTopicId.HasValue && previousEntry is not null && previousEntry.Topic.Id != allowedTopicId.Value;
    var nextLocked = User.IsInRole("Student") && allowedTopicId.HasValue && nextEntry is not null && nextEntry.Topic.Id != allowedTopicId.Value;
    var orderedTopicChapters = currentTopic?.Chapters.OrderBy(chapter => chapter.SortOrder).ThenBy(chapter => chapter.Id).ToList()
        ?? new List<CIITStackLab.Application.DTOs.CourseLearningChapterDto>();
    var isFinalChapter = currentChapter is not null && (orderedTopicChapters.Count <= 1 || orderedTopicChapters[^1].Id == currentChapter.Id);
}
<nav class="ciit-learning-bottom-actions" aria-label="Lesson actions and chapter navigation">
    <div class="ciit-learning-bottom-actions-start">
        @if (previousEntry is not null && !previousLocked)
        {
            <a class="ciit-learning-bottom-button learn-btn learn-btn-ghost" asp-controller="Courses" asp-action="Learn"
               asp-route-id="@Model.Id" asp-route-topicId="@previousEntry.Topic.Id" asp-route-chapterId="@previousEntry.Chapter.Id">
                <i class="bi bi-arrow-left" aria-hidden="true"></i><span>Previous</span>
            </a>
        }
        else
        {
            <span class="ciit-learning-bottom-button learn-btn learn-btn-ghost is-disabled" aria-disabled="true">
                <i class="bi bi-arrow-left" aria-hidden="true"></i><span>Previous</span>
            </span>
        }
    </div>
    <div class="ciit-learning-bottom-actions-end">
        @if (User.IsInRole("Student") && Model.Progress is not null && currentTopic is not null && currentChapter is not null)
        {
            if (currentChapter.IsCompleted)
            {
                <span class="ciit-learning-bottom-button ciit-learning-bottom-button-completed learn-btn" role="status" aria-label="Chapter completed">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>Completed</span>
                </span>
            }
            else if (!isFinalChapter)
            {
                <form asp-route="CompleteCourseChapter" asp-route-id="@Model.Id"
                      asp-route-topicId="@currentTopic.Id" asp-route-chapterId="@currentChapter.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ciit-learning-bottom-button learn-btn learn-btn-ghost"
                            aria-label="Mark complete" title="Mark complete">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i><span class="learn-mark-label">Mark complete</span>
                    </button>
                </form>
            }
            else
            {
                <span class="ciit-learning-bottom-button learn-btn learn-btn-ghost is-disabled"
                      aria-disabled="true" title="Use Apply for Examination in the learning path panel for the final chapter.">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i><span class="learn-mark-label">Mark complete</span>
                </span>
            }
        }
    </div>
    <div class="ciit-learning-bottom-actions-next">
        @if (nextEntry is not null && !nextLocked)
        {
            <a class="ciit-learning-bottom-button learn-btn learn-btn-solid" asp-controller="Courses" asp-action="Learn"
               asp-route-id="@Model.Id" asp-route-topicId="@nextEntry.Topic.Id" asp-route-chapterId="@nextEntry.Chapter.Id">
                <span>@(nextEntry.Topic.Id == currentTopic?.Id ? "Next chapter" : "Next topic")</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        }
        else
        {
            <span class="ciit-learning-bottom-button learn-btn learn-btn-solid is-disabled" aria-disabled="true">
                <span>Next topic</span><i class="bi bi-arrow-right" aria-hidden="true"></i>
            </span>
        }
    </div>
</nav>
