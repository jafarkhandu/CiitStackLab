@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var topics = Model.Topics.ToList();
    var chapterEntries = topics.SelectMany(topic => topic.Chapters
        .OrderBy(chapter => chapter.SortOrder)
        .ThenBy(chapter => chapter.Id)
        .Select(chapter => new { Topic = topic, Chapter = chapter }))
        .ToList();

    var currentContentId = Model.CurrentContentId;
    var currentChapter = Model.CurrentChapterId.HasValue
        ? chapterEntries.FirstOrDefault(entry => entry.Chapter.Id == Model.CurrentChapterId.Value)?.Chapter
        : currentContentId.HasValue
            ? chapterEntries.FirstOrDefault(entry => entry.Chapter.Contents.Any(content => content.Id == currentContentId.Value))?.Chapter
            : null;
    var currentTopic = topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? (currentChapter is not null
            ? topics.FirstOrDefault(topic => topic.Chapters.Any(chapter => chapter.Id == currentChapter.Id))
            : null)
        ?? topics.FirstOrDefault(topic => topic.Contents.Any(content => currentContentId.HasValue && content.Id == currentContentId.Value));

    currentChapter ??= currentTopic?.Chapters
        .OrderBy(chapter => chapter.SortOrder)
        .ThenBy(chapter => chapter.Id)
        .FirstOrDefault();

    var currentEntryIndex = currentChapter is null
        ? -1
        : chapterEntries.FindIndex(entry => entry.Chapter.Id == currentChapter.Id);
    var previousEntry = currentEntryIndex > 0 ? chapterEntries[currentEntryIndex - 1] : null;
    var nextEntry = currentEntryIndex >= 0 && currentEntryIndex < chapterEntries.Count - 1
        ? chapterEntries[currentEntryIndex + 1]
        : null;
    var allowedTopicId = ViewBag.AllowedTopicId as int?;
    var previousIsLocked = User.IsInRole("Student")
        && allowedTopicId.HasValue
        && previousEntry is not null
        && previousEntry.Topic.Id != allowedTopicId.Value;
    var nextIsLocked = User.IsInRole("Student")
        && allowedTopicId.HasValue
        && nextEntry is not null
        && nextEntry.Topic.Id != allowedTopicId.Value;
}

<nav class="ciit-learning-bottom-actions" aria-label="Chapter navigation">
    <div class="ciit-learning-bottom-actions-start">
        @if (previousEntry is not null && !previousIsLocked)
        {
            <a class="ciit-learning-bottom-button ciit-learning-bottom-button-secondary"
               asp-controller="Courses"
               asp-action="Learn"
               asp-route-id="@Model.Id"
               asp-route-topicId="@previousEntry.Topic.Id"
               asp-route-chapterId="@previousEntry.Chapter.Id">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Previous
            </a>
        }
        else
        {
            <span class="ciit-learning-bottom-button ciit-learning-bottom-button-secondary is-disabled" aria-disabled="true">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Previous
            </span>
        }
    </div>

    <div class="ciit-learning-bottom-actions-end">
        @if (User.IsInRole("Student") && Model.Progress is not null && currentTopic is not null && currentChapter is not null && currentChapter.IsCompleted)
        {
            <span class="ciit-learning-bottom-button ciit-learning-bottom-button-completed" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                Completed
            </span>
        }
        else if (User.IsInRole("Student") && Model.Progress is not null && currentTopic is not null && currentChapter is not null)
        {
            var topicChapters = currentTopic.Chapters
                .OrderBy(chapter => chapter.SortOrder)
                .ThenBy(chapter => chapter.Id)
                .ToList();
            var isFinalChapter = topicChapters.Count <= 1 || topicChapters[^1].Id == currentChapter.Id;

            @if (!isFinalChapter)
            {
                <form asp-route="CompleteCourseChapter"
                      asp-route-id="@Model.Id"
                      asp-route-topicId="@currentTopic.Id"
                      asp-route-chapterId="@currentChapter.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ciit-learning-bottom-button ciit-learning-bottom-button-mark">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        Mark as complete
                    </button>
                </form>
            }
        }

        @if (nextEntry is not null && !nextIsLocked)
        {
            <a class="ciit-learning-bottom-button ciit-learning-bottom-button-primary"
               asp-controller="Courses"
               asp-action="Learn"
               asp-route-id="@Model.Id"
               asp-route-topicId="@nextEntry.Topic.Id"
               asp-route-chapterId="@nextEntry.Chapter.Id">
                @(nextEntry.Topic.Id == currentTopic?.Id ? "Next chapter" : "Next topic")
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        }
        else
        {
            <span class="ciit-learning-bottom-button ciit-learning-bottom-button-primary is-disabled" aria-disabled="true">
                Next topic
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </span>
        }
    </div>
</nav>
