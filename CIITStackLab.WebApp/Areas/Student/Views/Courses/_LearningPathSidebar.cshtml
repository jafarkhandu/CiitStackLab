@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var currentContentId = Model.CurrentContentId;
    var learningProgress = Model.Progress;
    var completedContentIds = learningProgress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var topics = Model.Topics.ToList();
    var currentTopic = topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? topics.FirstOrDefault(topic =>
            topic.Contents.Any(content => currentContentId.HasValue && content.Id == currentContentId.Value)
            || topic.Chapters.Any(chapter => chapter.Contents.Any(content =>
                currentContentId.HasValue && content.Id == currentContentId.Value)));
    var currentContentChapterId = currentContentId.HasValue
        ? topics.SelectMany(topic => topic.Contents)
            .FirstOrDefault(content => content.Id == currentContentId.Value)?.NoteId
        : null;
    var selectedChapterId = Model.CurrentChapterId ?? currentContentChapterId;
    var allowedTopicId = ViewBag.AllowedTopicId as int?;

}

<aside class="ciit-learning-sidebar" aria-label="Course topics and chapters">
    <div class="ciit-learning-sidebar-head">
        <div>
            <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
            <h2>Topics &amp; Chapters</h2>
        </div>
        <span class="ciit-learning-count" title="@topics.Count topics">@topics.Count</span>
    </div>
    <div class="ciit-learning-sidebar-scroll">
        @for (var topicIndex = 0; topicIndex < topics.Count; topicIndex++)
        {
            var topic = topics[topicIndex];
            var topicContents = topic.Contents
                .Concat(topic.Chapters.SelectMany(chapter => chapter.Contents))
                .DistinctBy(content => content.Id)
                .ToList();
            var completedCount = topicContents.Count(content => completedContentIds.Contains(content.Id));
            var topicComplete = topicContents.Count > 0 && completedCount == topicContents.Count;
            var progress = topicContents.Count == 0 ? 0 :
                (int)Math.Round(completedCount * 100d / topicContents.Count, MidpointRounding.AwayFromZero);
            var isCurrentTopic = currentTopic?.Id == topic.Id;
            var isLocked = User.IsInRole("Student") && allowedTopicId.HasValue && topic.Id != allowedTopicId.Value;

            <details class="ciit-learning-topic @(isCurrentTopic ? "is-active-topic" : "") @(isLocked ? "is-locked-topic" : "")"
                     data-topic-first-content-url="@Url.Action("Learn", "Courses", new { id = Model.Id, topicId = topic.Id })"
                     open="@(isCurrentTopic ? "open" : null)">
                <summary class="ciit-learning-topic-heading">
                    <span class="ciit-learning-topic-icon" aria-hidden="true">
                        <i class="bi @(isLocked ? "bi-lock-fill" : "bi-collection-play")"></i>
                    </span>
                    <span class="ciit-learning-topic-heading-text @(topicComplete ? "is-completed" : "")">
                        <strong>@topic.Title</strong>
                        <span>@topic.Chapters.Count chapter@(topic.Chapters.Count == 1 ? "" : "s")</span>
                    </span>
                    @if (topicComplete)
                    {
                        <span class="ciit-learning-topic-completed" title="Topic completed" aria-label="Topic completed">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </span>
                    }
                    <i class="bi bi-chevron-down ciit-learning-topic-chevron" aria-hidden="true"></i>
                </summary>

                @if (isCurrentTopic)
                {
                    if (topic.Chapters.Count == 0)
                    {
                        <p class="ciit-learning-topic-empty">No chapters are available for this topic yet.</p>
                    }
                    else
                    {
                        for (var chapterIndex = 0; chapterIndex < topic.Chapters.Count; chapterIndex++)
                        {
                            var chapter = topic.Chapters[chapterIndex];
                            var chapterIsCurrent = selectedChapterId == chapter.Id
                                || (currentContentId.HasValue && chapter.Contents.Any(content => content.Id == currentContentId.Value));
                            var chapterIsCompleted = chapter.IsCompleted;

                            <a class="ciit-learning-chapter-link @(chapterIsCurrent ? "is-current" : "")"
                               asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-id="@Model.Id"
                               asp-route-topicId="@topic.Id"
                               asp-route-chapterId="@chapter.Id"
                               aria-current="@(chapterIsCurrent ? "page" : null)">
                                <span class="ciit-learning-chapter-number">@((chapterIndex + 1).ToString("00"))</span>
                                <span class="ciit-learning-chapter-title">
                                    <strong>@CIITStackLab.WebApp.Helpers.LearningPagePresentation.FormatLearningTitle(chapter.Title)</strong>
                                </span>
                                @if (chapterIsCompleted)
                                {
                                    <span class="ciit-learning-chapter-completed" title="Chapter completed" aria-label="Chapter completed">
                                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                    </span>
                                }
                                else if (chapterIsCurrent)
                                {
                                    <span class="ciit-learning-chapter-current" aria-hidden="true"></span>
                                }
                            </a>
                        }
                    }
                }
            </details>
        }
    </div>
</aside>

<script defer src="/js/student/learning-slide-viewer.js?v=1"></script>
