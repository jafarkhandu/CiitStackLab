@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var currentContentId = Model.CurrentContentId;
    var completedContentIds = Model.Progress?.CompletedContentIds?.ToHashSet() ?? new HashSet<int>();
    var topics = Model.Topics.ToList();
    var currentTopic = topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? topics.FirstOrDefault(topic =>
            topic.Contents.Any(content => currentContentId.HasValue && content.Id == currentContentId.Value)
            || topic.Chapters.Any(chapter => chapter.Contents.Any(content =>
                currentContentId.HasValue && content.Id == currentContentId.Value)));
    var currentContentChapterId = currentContentId.HasValue
        ? topics.SelectMany(topic => topic.Chapters)
            .FirstOrDefault(chapter => chapter.Contents.Any(content => content.Id == currentContentId.Value))?.Id
        : (int?)null;
    var selectedChapterId = Model.CurrentChapterId ?? currentContentChapterId;
    var allowedTopicId = ViewBag.AllowedTopicId as int?;
    var isCurrentTopicLocked = User.IsInRole("Student")
        && allowedTopicId.HasValue
        && currentTopic is not null
        && currentTopic.Id != allowedTopicId.Value;
    var currentTopicContentIds = currentTopic is null
        ? new List<int>()
        : currentTopic.Contents
            .Concat(currentTopic.Chapters.SelectMany(chapter => chapter.Contents))
            .Select(content => content.Id)
            .Distinct()
            .ToList();
    var isCurrentTopicCompleted = currentTopicContentIds.Count > 0
        && currentTopicContentIds.All(completedContentIds.Contains);
    var completedChapterCount = currentTopic?.Chapters.Count(chapter => chapter.IsCompleted) ?? 0;
    var totalChapterCount = currentTopic?.Chapters.Count ?? 0;
}

<aside class="ciit-learning-sidebar" aria-label="Current topic chapters">
    <div class="ciit-learning-sidebar-head">
        <div>
            <span class="ciit-learning-eyebrow">YOUR LEARNING PATH</span>
            <h2>@(currentTopic is null ? "Chapters" : $"{currentTopic.Title} Chapters")</h2>
        </div>
        <div class="ciit-learning-current-topic-status">
            @if (isCurrentTopicCompleted)
            {
                <span class="ciit-learning-current-topic-completed" title="Topic completed" aria-label="Topic completed">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                </span>
            }
            <span class="ciit-learning-chapter-progress-count">@completedChapterCount / @totalChapterCount done</span>
        </div>
    </div>

    <div class="ciit-learning-sidebar-scroll">
        @if (currentTopic is null)
        {
            <p class="ciit-learning-current-topic-message">No active topic is available.</p>
        }
        else if (isCurrentTopicLocked)
        {
            <p class="ciit-learning-current-topic-message">
                <i class="bi bi-lock-fill" aria-hidden="true"></i>
                This topic is locked until you pass the current topic examination.
            </p>
        }
        else if (currentTopic.Chapters.Count == 0)
        {
            <p class="ciit-learning-current-topic-message">No chapters are available for this topic yet.</p>
        }
        else
        {
            <nav class="ciit-learning-current-chapters" aria-label="@($"{currentTopic.Title} chapters")">
                @for (var chapterIndex = 0; chapterIndex < currentTopic.Chapters.Count; chapterIndex++)
                {
                    var chapter = currentTopic.Chapters[chapterIndex];
                    var chapterIsCurrent = selectedChapterId == chapter.Id
                        || (currentContentId.HasValue && chapter.Contents.Any(content => content.Id == currentContentId.Value));
                    var chapterIsCompleted = chapter.IsCompleted;

                    <a class="ciit-learning-current-chapter-link @(chapterIsCurrent ? "is-current" : "")"
                       asp-controller="Courses"
                       asp-action="Learn"
                       asp-route-id="@Model.Id"
                       asp-route-topicId="@currentTopic.Id"
                       asp-route-chapterId="@chapter.Id"
                       aria-current="@(chapterIsCurrent ? "page" : null)">
                        <span class="ciit-learning-current-chapter-number">@((chapterIndex + 1).ToString("00"))</span>
                        <span class="ciit-learning-current-chapter-title">
                            <strong>@CIITStackLab.WebApp.Helpers.LearningPagePresentation.FormatLearningTitle(chapter.Title)</strong>
                        </span>
                        @if (chapterIsCompleted)
                        {
                            <span class="ciit-learning-current-chapter-completed" title="Chapter completed" aria-label="Chapter completed">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            </span>
                        }
                        else if (chapterIsCurrent)
                        {
                            <span class="ciit-learning-current-chapter-current" aria-hidden="true"></span>
                        }
                    </a>
                }
            </nav>
        }
    </div>
</aside>