@model CIITStackLab.Application.DTOs.CourseLearningDto
@{
    var topics = Model.Topics.ToList();
    var currentChapter = Model.CurrentChapterId.HasValue
        ? topics.SelectMany(topic => topic.Chapters)
            .FirstOrDefault(chapter => chapter.Id == Model.CurrentChapterId.Value)
        : Model.CurrentContentId.HasValue
            ? topics.SelectMany(topic => topic.Chapters)
                .FirstOrDefault(chapter => chapter.Contents.Any(content => content.Id == Model.CurrentContentId.Value))
            : null;

    var currentTopic = topics.FirstOrDefault(topic => topic.Id == Model.CurrentTopicId)
        ?? (currentChapter is not null
            ? topics.FirstOrDefault(topic => topic.Chapters.Any(chapter => chapter.Id == currentChapter.Id))
            : null);

    var topicChapters = currentTopic?.Chapters
        .OrderBy(chapter => chapter.SortOrder)
        .ThenBy(chapter => chapter.Id)
        .ToList() ?? new List<CIITStackLab.Application.DTOs.CourseLearningChapterDto>();

    var isFinalChapter = currentChapter is not null
        && (topicChapters.Count <= 1 || topicChapters[^1].Id == currentChapter.Id);

    var shouldShowExamApply = User.IsInRole("Student")
        && Model.Progress is not null
        && currentTopic is not null
        && currentChapter is not null
        && !currentChapter.IsCompleted
        && isFinalChapter;
}

@if (shouldShowExamApply)
{
    <section class="ciit-learning-exam-apply" aria-labelledby="ciit-learning-exam-apply-title">
        <h3 id="ciit-learning-exam-apply-title">Ready for the exam?</h3>
        <p>Complete this topic and apply for its examination when you are ready.</p>
        <form asp-controller="Courses"
              asp-action="CompleteTopic"
              asp-route-id="@Model.Id"
              asp-route-topicId="@currentTopic!.Id"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit">
                <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                Apply for Examination
            </button>
        </form>
    </section>
}
