@model CIITStackLab.Application.DTOs.TopicNotesDto

@{
    ViewData["Title"] = $"Notes — {Model.TopicTitle}";

    var courseId = ViewData["CourseId"]?.ToString();
    var chapters = Model.Chapters.ToList();
    var currentIndex = chapters.FindIndex(
        x => x.ChapterId == Model.CurrentChapterId);

    if (currentIndex < 0)
    {
        currentIndex = 0;
    }

    var previous = currentIndex > 0
        ? chapters[currentIndex - 1]
        : null;

    var next = currentIndex < chapters.Count - 1
        ? chapters[currentIndex + 1]
        : null;

    var progressUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? "guest";
    var progressUserKey = Convert.ToHexString(
        System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(progressUserId)))
        .ToLowerInvariant();
    var notesProgressKey = $"ciit-notes-progress:{progressUserKey}:{Model.TopicId}:{Model.CurrentChapter?.Id ?? 0}";

    Layout = string.IsNullOrWhiteSpace(courseId)
        ? "_Layout"
        : "_CourseLayout";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/student/notes.css"
          asp-append-version="true" />
}

<section class="ciit-notes-reader">
    <header class="ciit-notes-reader-header">
        <div class="ciit-notes-reader-header-inner">
            @if (!string.IsNullOrWhiteSpace(courseId))
            {
                <a asp-controller="Courses"
                   asp-action="Learn"
                   asp-route-id="@courseId"
                   class="ciit-notes-back">
                    <i class="bi bi-arrow-left"></i>
                    Back to Learn
                </a>
            }

            <div class="ciit-notes-reader-heading">
                <div>
                    <span class="ciit-notes-reader-kicker">COURSE NOTES</span>
                    <h1>@Model.TopicTitle</h1>
                    <p>Structured chapters and resources for this course topic.</p>
                </div>
                <span class="ciit-notes-reader-count">
                    <i class="bi bi-journal-text"></i>
                    @chapters.Count chapters
                </span>
            </div>
        </div>
    </header>

    <div class="ciit-notes-reader-shell">
        <main class="ciit-notes-reader-main">
            <article class="ciit-notes-reader-card">
                <div class="ciit-notes-reader-title">
                    <span>CHAPTER @(currentIndex + 1) OF @chapters.Count</span>
                    <h2>@Model.CurrentChapter?.Title</h2>
                </div>

                <div class="ciit-notes-page-reader"
                     data-progress-key="@notesProgressKey">
                    <div class="ciit-notes-page-controls" hidden>
                        <button type="button"
                                class="ciit-notes-page-button"
                                data-page-previous
                                disabled>
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </button>
                        <span class="ciit-notes-page-status" aria-live="polite"></span>
                        <div class="ciit-notes-page-actions">
                            <button type="button"
                                    class="ciit-notes-page-button ciit-notes-page-button-primary"
                                    data-page-mark-read>
                                Mark as Read
                            </button>
                            <button type="button"
                                    class="ciit-notes-page-button"
                                    data-page-next
                                    disabled>
                                Next
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <div class="ciit-notes-reader-content">
                        @Html.Raw(Model.CurrentChapter?.HtmlContent)
                    </div>
                </div>

                @if (Model.CurrentChapter?.Media.Any(media => !string.IsNullOrWhiteSpace(media.Slides) || !string.IsNullOrWhiteSpace(media.VideoName)) == true)
                {
                    <section class="ciit-notes-reader-media">
                        <div class="ciit-notes-reader-media-head">
                            <div>
                                <span>Chapter Resources</span>
                                <strong>Slides &amp; Video</strong>
                            </div>
                            <i class="bi bi-collection-play"></i>
                        </div>

                        @foreach (var media in Model.CurrentChapter.Media.Where(media => !string.IsNullOrWhiteSpace(media.Slides) || !string.IsNullOrWhiteSpace(media.VideoName)))
                        {
                            <div class="ciit-notes-reader-media-row">
                                <div class="ciit-notes-reader-media-copy">
                                    <strong>@media.Title</strong>
                                    <small>Resources attached to this chapter</small>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(media.Slides))
                                    {
                                        <a asp-controller="Notes"
                                           asp-action="SlideReader"
                                           asp-route-topicId="@Model.TopicId"
                                           asp-route-chapterId="@Model.CurrentChapterId"
                                           asp-route-contentId="@media.ContentId"
                                           asp-route-courseId="@courseId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-file-earmark-slides me-1"></i>Slides
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(media.VideoName))
                                    {
                                        <a href="@media.VideoName"
                                           target="_blank"
                                           rel="noopener"
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-play-circle me-1"></i>Video
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }

                <nav class="ciit-notes-reader-pager" aria-label="Chapter navigation">
                    @if (previous is not null)
                    {
                        <a asp-controller="Notes"
                           asp-action="Index"
                           asp-route-topicId="@Model.TopicId"
                           asp-route-chapterId="@previous.ChapterId"
                           asp-route-courseId="@courseId">
                            <i class="bi bi-chevron-left"></i>
                            <span>
                                <small>Previous</small>
                                @previous.Title
                            </span>
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    @if (next is not null)
                    {
                        <a class="next"
                           asp-controller="Notes"
                           asp-action="Index"
                           asp-route-topicId="@Model.TopicId"
                           asp-route-chapterId="@next.ChapterId"
                           asp-route-courseId="@courseId">
                            <span>
                                <small>Next</small>
                                @next.Title
                            </span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </nav>
            </article>
        </main>
    </div>
</section>

@section Scripts {
    <script src="~/js/student/notes-page-reader.js" asp-append-version="true"></script>
}
